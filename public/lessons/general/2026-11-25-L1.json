  "grammar": [
    {
      "id": "g1",
      "title": "분사구문 (~하면서, ~하고)",
      "tags": [
        "분사구문"
      ],
      "sentenceId": "s3",
      "highlight": [
        "Casting his burden on the ground"
      ],
      "explanation": "동사에 -ing를 붙여 문장 앞에 두면 '~하면서, ~하고 나서'라는 뜻의 분사구문이 돼요. He cast his burden on the ground, and he called ~ 를 짧게 줄인 것이에요.",
      "example": {
        "en": "Opening the door, she saw a cat.",
        "ko": "문을 열자 그녀는 고양이 한 마리를 보았다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "scarcely ~ when … (~하자마자 …했다)",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "scarcely",
        "when"
      ],
      "explanation": "scarcely는 '거의 ~않다'라는 뜻인데, scarcely A when B 형태로 쓰면 'A하자마자 B했다'가 돼요. hardly ~ when과 같은 뜻이에요.",
      "example": {
        "en": "I had scarcely sat down when the phone rang.",
        "ko": "내가 앉자마자 전화가 울렸다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "과거완료 had + 과거분사",
      "tags": [
        "시제"
      ],
      "sentenceId": "s2",
      "highlight": [
        "had got"
      ],
      "explanation": "before he had got ~ half-way에서 had got은 과거보다 더 앞선 일(절반을 가는 것)을 나타내는 과거완료예요. '절반을 가기도 전에 이미 지쳤다'는 순서를 보여 줘요.",
      "example": {
        "en": "The train had left before we arrived.",
        "ko": "우리가 도착하기 전에 기차는 이미 떠났다."
      },
      "note": null
    }
  ],
