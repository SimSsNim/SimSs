  "grammar": [
    {
      "id": "g1",
      "title": "so + 형용사 + that ~: 너무 …해서 ~하다",
      "tags": [
        "접속사",
        "부사절"
      ],
      "sentenceId": "s5",
      "highlight": [
        "so distorted that they were not to be recognised"
      ],
      "explanation": "so + 형용사/부사 + that절은 '너무 ~해서 …하다'라는 결과를 나타낸다. 얼굴이 너무 일그러져서(so distorted) 알아볼 수 없었다(that they were not to be recognised)는 뜻이다. were not to be recognised는 be to 용법으로 '알아볼 수 없었다'(가능)를 나타낸다.",
      "example": {
        "en": "The box was so heavy that I couldn't lift it.",
        "ko": "상자가 너무 무거워서 나는 들 수 없었다."
      },
      "note": "recognised는 영국식 철자(미국식 recognized)."
    },
    {
      "id": "g2",
      "title": "최상급: the most + 형용사 + of ~",
      "tags": [
        "비교"
      ],
      "sentenceId": "s3",
      "highlight": [
        "the most mischievous of all sprites"
      ],
      "explanation": "긴 형용사는 앞에 the most를 붙여 최상급을 만든다. of all sprites는 '모든 요정 가운데'라는 비교 범위를 나타낸다. 다음 문장의 the most beautiful landscapes, the best persons(good의 최상급)도 같은 최상급이다.",
      "example": {
        "en": "She is the most famous of all the singers.",
        "ko": "그녀는 모든 가수 중에서 가장 유명하다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "과거완료: had + 과거분사",
      "tags": [
        "시제"
      ],
      "sentenceId": "s8",
      "highlight": [
        "had happened"
      ],
      "explanation": "과거의 어느 시점(told)보다 더 먼저 일어난 일은 had + 과거분사(과거완료)로 쓴다. 꼬마 요정들이 서로 말한 것(told)보다 기적이 일어난 것(had happened)이 먼저다. 앞의 he had made a mirror도 같은 이유로 과거완료다.",
      "example": {
        "en": "When I arrived, the movie had already started.",
        "ko": "내가 도착했을 때 영화는 이미 시작했었다."
      },
      "note": null
    }
  ],
