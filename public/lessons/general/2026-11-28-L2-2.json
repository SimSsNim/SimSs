  "grammar": [
    {
      "id": "g1",
      "title": "과거완료진행형 (had been -ing)",
      "tags": [
        "시제"
      ],
      "sentenceId": "s2",
      "highlight": [
        "had been starving"
      ],
      "explanation": "had been starving은 과거완료진행형으로, 사자가 나타난 그 시점(과거)보다 더 앞에서부터 계속 굶주려 왔다는 뜻이에요. for days(며칠 동안)와 함께 쓰여 '며칠째 굶고 있던'으로 해석해요.",
      "example": {
        "en": "She had been waiting for an hour when the bus came.",
        "ko": "버스가 왔을 때 그녀는 한 시간째 기다리고 있었다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "no sooner A than B (A하자마자 B하다)",
      "tags": [
        "접속사",
        "시제"
      ],
      "sentenceId": "s3",
      "highlight": [
        "had no sooner heard",
        "than he fled"
      ],
      "explanation": "'주어 + had no sooner + 과거분사 + than + 주어 + 과거형'은 'A하자마자 B했다'는 뜻이에요. 먼저 일어난 일(heard)은 과거완료, 바로 뒤이은 일(fled)은 과거형으로 써요. as soon as로 바꾸면 As soon as he heard the noise, he fled.",
      "example": {
        "en": "I had no sooner sat down than the phone rang.",
        "ko": "내가 앉자마자 전화가 울렸다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "still less (훨씬 더 ~하지 않은)",
      "tags": [
        "비교"
      ],
      "sentenceId": "s4",
      "highlight": [
        "still less likely"
      ],
      "explanation": "less likely는 '~할 가능성이 더 적은'이라는 비교급이고, still이 비교급 앞에서 '훨씬'이라고 강조해요. 당나귀는 '사자가 작은 수탉도 못 당하니, 덩치 큰 당나귀에게 맞설 가능성은 훨씬 더 적겠지'라고 잘못 생각한 거예요.",
      "example": {
        "en": "He can't swim, still less dive.",
        "ko": "그는 수영도 못하는데, 잠수는 더더욱 못한다."
      },
      "note": null
    }
  ],
