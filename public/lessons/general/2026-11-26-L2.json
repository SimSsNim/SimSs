  "grammar": [
    {
      "id": "g1",
      "title": "동격의 that (~라는)",
      "tags": [
        "명사절"
      ],
      "sentenceId": "s1",
      "highlight": [
        "a vow that he would sacrifice"
      ],
      "explanation": "명사 뒤에 that절이 와서 그 명사의 내용을 설명할 수 있어요. a vow that ~은 '~하겠다는 맹세'예요. 이때 that은 '~라는'으로 해석해요.",
      "example": {
        "en": "I heard the news that she won.",
        "ko": "나는 그녀가 이겼다는 소식을 들었다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "cause + 목적어 + to부정사 (…가 ~하게 하다)",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "caused him to recover"
      ],
      "explanation": "cause A to ~는 'A가 ~하게 만들다(일으키다)'예요. 신들이 그를 낫게 했다는 뜻이에요. make A + 동사원형과 비슷하지만 cause 뒤에는 to가 붙어요.",
      "example": {
        "en": "The rain caused the river to rise.",
        "ko": "비 때문에 강물이 불어났다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "현재완료 have + 과거분사 (완료)",
      "tags": [
        "시제"
      ],
      "sentenceId": "s3",
      "highlight": [
        "have discharged"
      ],
      "explanation": "have + 과거분사는 과거에 한 일이 지금 완료되었음을 나타내요. I have discharged my vow는 '(지금) 맹세를 다 지켰다'는 뜻이에요.",
      "example": {
        "en": "I have finished my homework.",
        "ko": "나는 숙제를 다 끝냈다."
      },
      "note": null
    }
  ],
