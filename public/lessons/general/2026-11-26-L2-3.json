  "grammar": [
    {
      "id": "g1",
      "title": "no sooner ~ than … (~하자마자 …했다)",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "no sooner",
        "than"
      ],
      "explanation": "no sooner + had + 과거분사 + than + 과거형은 'A하자마자 B했다'라는 뜻이에요. 앞의 일이 끝나자마자 바로 뒤의 일이 일어났다는 느낌이에요.",
      "example": {
        "en": "I had no sooner left home than it began to rain.",
        "ko": "내가 집을 나서자마자 비가 오기 시작했다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "지각동사 + 목적어 + being + 과거분사 (…가 ~되고 있는 것)",
      "tags": [
        "수동태"
      ],
      "sentenceId": "s5",
      "highlight": [
        "saw him being carried"
      ],
      "explanation": "see A being + 과거분사는 'A가 ~되고 있는 것을 보다'예요. 여우가 스스로 가는 게 아니라 물살에 '실려 가고 있는' 모습이라서 being carried라고 썼어요.",
      "example": {
        "en": "We saw the car being towed away.",
        "ko": "우리는 차가 견인되어 가는 것을 보았다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "to부정사의 부정 not to (~하지 말라고)",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s1",
      "highlight": [
        "not to be afraid"
      ],
      "explanation": "to부정사를 부정할 때는 to 바로 앞에 not을 붙여요. encourage A not to ~는 'A에게 ~하지 말라고 격려하다'예요.",
      "example": {
        "en": "Mom told me not to be late.",
        "ko": "엄마는 나에게 늦지 말라고 하셨다."
      },
      "note": null
    }
  ],
