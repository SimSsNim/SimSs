  "grammar": [
    {
      "id": "g1",
      "title": "복합관계대명사 whoever = anyone who",
      "tags": [
        "관계사",
        "명사절"
      ],
      "sentenceId": "s1",
      "highlight": [
        "WHOEVER has made a voyage up the Hudson"
      ],
      "explanation": "whoever는 '~하는 사람은 누구나'라는 뜻으로, 그 자체가 선행사를 품고 있어 'anyone who'와 같다. 'Whoever + 동사 ~' 덩어리 전체가 명사절이 되어 문장의 주어로 쓰였다. 원문은 첫 단어를 대문자로 강조해 WHOEVER로 적었다.",
      "example": {
        "en": "Whoever finishes first will get a prize.",
        "ko": "먼저 끝내는 사람은 누구든 상을 받을 것이다."
      },
      "note": "whatever(~하는 것은 무엇이든), whichever(~하는 것은 어느 것이든)도 같은 원리다."
    },
    {
      "id": "g2",
      "title": "소유격 관계대명사 whose",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "a Village, whose shingle roofs gleam"
      ],
      "explanation": "whose는 앞의 명사(a Village)를 받아 '그것의'라는 소유의 뜻을 나타내며 바로 뒤에 명사(shingle roofs)가 온다. 'a Village, whose shingle roofs gleam ~' = '어느 마을, 그리고 그 마을의 지붕들은 반짝인다'. 쉼표가 있으므로 계속적 용법이다.",
      "example": {
        "en": "I met a girl whose father is a pilot.",
        "ko": "나는 아버지가 조종사인 소녀를 만났다."
      },
      "note": "같은 문장의 'may have descried'는 '조동사 + have p.p.'로 '(과거에) ~했을지도 모른다'는 추측이다."
    },
    {
      "id": "g3",
      "title": "완료 수동 분사구문 having been p.p.",
      "tags": [
        "분사구문",
        "수동태"
      ],
      "sentenceId": "s6",
      "highlight": [
        "having been founded by some of the Dutch colonists"
      ],
      "explanation": "'having been + 과거분사'는 주절보다 앞선 때에 '~되었다'는 수동의 뜻을 나타내는 분사구문이다. 마을이 '지금 오래된 마을이다(is)'보다 훨씬 전에 '세워졌다(was founded)'는 것을 보여 준다. = as it was founded by some of the Dutch colonists.",
      "example": {
        "en": "Having been written in haste, the letter had many mistakes.",
        "ko": "급하게 쓰였기 때문에 그 편지에는 실수가 많았다."
      },
      "note": null
    }
  ],
