  "grammar": [
    {
      "id": "g1",
      "title": "no sooner A than B (A하자마자 B했다)",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "had no sooner alighted than"
      ],
      "explanation": "no sooner는 '~하자마자'라는 뜻으로, 'had no sooner + 과거분사 + than + 과거' 형태로 써요. 내려앉는 일과 발톱이 걸리는 일이 거의 동시에 일어났다는 느낌이에요.",
      "example": {
        "en": "He had no sooner left than it began to rain.",
        "ko": "그가 떠나자마자 비가 오기 시작했다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "so + 형용사 + that (너무 ~해서 …하다)",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "so odd that"
      ],
      "explanation": "so 뒤에 형용사·부사를 쓰고 that 절을 붙이면 '너무 ~해서 …했다'는 원인과 결과를 나타내요.",
      "example": {
        "en": "The soup was so hot that I couldn't eat it.",
        "ko": "수프가 너무 뜨거워서 먹을 수 없었다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "수동태 to부정사 to be taken",
