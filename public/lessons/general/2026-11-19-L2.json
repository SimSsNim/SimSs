  "grammar": [
    {
      "id": "g1",
      "title": "escape + 동명사의 수동형 (being + p.p.)",
      "tags": [
        "동명사",
        "수동태"
      ],
      "sentenceId": "s2",
      "highlight": [
        "can't escape being eaten"
      ],
      "explanation": "escape는 뒤에 동명사를 써요. 내가 '먹히는' 것이므로 수동형 'being eaten'이 되었어요. '먹히는 것을 피할 수 없다'는 뜻이에요.",
      "example": {
        "en": "He narrowly escaped being hit by a car.",
        "ko": "그는 차에 치일 뻔한 것을 간신히 피했다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "전치사 to + 동명사",
      "tags": [
        "동명사",
        "전치사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "no objection to having some music"
      ],
      "explanation": "'objection to'의 to는 전치사라서 뒤에 동사원형이 아니라 동명사(having)가 와요. 'look forward to -ing'와 같은 원리예요.",
      "example": {
        "en": "I have no objection to staying here.",
        "ko": "나는 여기 머무는 것에 반대하지 않아."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "no sooner A than B (~하자마자 …하다)",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "no sooner",
        "than"
      ],
      "explanation": "'no sooner A than B'는 A가 일어나자 곧바로 B가 일어났다는 뜻이에요. 'As soon as A, B'로 바꿔 쓸 수 있어요.",
      "example": {
        "en": "She had no sooner arrived than it started to rain.",
        "ko": "그녀가 도착하자마자 비가 오기 시작했다."
      },
      "note": null
    }
  ],
