  "grammar": [
    {
      "id": "g1",
      "title": "so ~ that … (너무 ~해서 …하다)",
      "tags": [
        "접속사",
        "부사절"
      ],
      "sentenceId": "s1",
      "highlight": [
        "so excessively fond of new clothes",
        "that he spent all his money"
      ],
      "explanation": "'so + 형용사/부사 + that + 주어 + 동사'는 '너무 ~해서 …하다'라는 원인과 결과를 나타낸다. 황제가 새 옷을 너무 좋아한 결과, 돈을 모두 옷에 썼다는 뜻이다.",
      "example": {
        "en": "He was so tired that he fell asleep on the bus.",
        "ko": "그는 너무 피곤해서 버스에서 잠이 들었다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "부정어 nor 뒤의 도치",
      "tags": [
        "도치",
        "접속사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "nor did he care"
      ],
      "explanation": "nor(~도 또한 아니다)가 절 앞에 오면 의문문처럼 '조동사 + 주어 + 동사' 순서가 된다. he did not care → nor did he care.",
      "example": {
        "en": "I don't like coffee, nor do I like tea.",
        "ko": "나는 커피를 좋아하지 않고, 차도 좋아하지 않는다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "if를 생략한 가정법 도치 (Had I …)",
      "tags": [
        "가정법",
        "도치",
        "생략"
      ],
      "sentenceId": "s8",
      "highlight": [
        "Had I such a suit",
        "I might at once find out"
      ],
      "explanation": "Had I such a suit = If I had such a suit(그런 옷이 있다면). 가정법에서 if를 빼면 동사(had)가 주어 앞으로 나온다. 결과절에는 might(~할 수 있을 텐데)를 쓴다.",
      "example": {
        "en": "Had I more time, I would travel the world.",
        "ko": "시간이 더 있다면 세계를 여행할 텐데."
      },
      "note": "옛 문체에서 자주 보이는 표현이다."
    }
  ],
