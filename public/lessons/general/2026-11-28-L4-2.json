  "grammar": [
    {
      "id": "g1",
      "title": "완료부정사 to have p.p.",
      "tags": [
        "to부정사",
        "시제"
      ],
      "sentenceId": "s2",
      "highlight": [
        "not unworthy to have been the palace"
      ],
      "explanation": "to have been은 완료부정사로, 본동사(looked)보다 앞선 때의 일을 나타낸다. 즉 '(예전에) 귀족의 저택이었다고 해도 어울려 보였다'라는 뜻이다. not unworthy는 부정어 두 개가 겹친 이중부정(완곡한 긍정)으로 '충분히 ~할 만한'으로 이해한다.",
      "example": {
        "en": "He seems to have been ill last week.",
        "ko": "그는 지난주에 아팠던 것 같다."
      },
      "note": "s10의 seemed to have been cultivated도 같은 완료부정사(수동형)이다."
    },
    {
      "id": "g2",
      "title": "감탄문 what a + 명사 + 동사 + 주어",
      "tags": [
        "어순",
        "도치"
      ],
      "sentenceId": "s6",
      "highlight": [
        "what a sigh was that"
      ],
      "explanation": "보통 감탄문은 'What a + 명사 + 주어 + 동사!'(What a sigh that was!) 어순이지만, 옛 문체에서는 주어와 동사가 뒤바뀌어 what a sigh was that처럼 쓰이기도 한다. to come out of ~는 sigh를 꾸미는 to부정사로 '~에서 나오기에'라는 뜻이다.",
      "example": {
        "en": "What a beautiful day it is!",
        "ko": "정말 아름다운 날이구나!"
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "as + 원급 + as (that of)",
      "tags": [
        "비교",
        "대명사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "as cheerful as that of southern Italy"
      ],
      "explanation": "'as + 형용사 + as'는 동등 비교(~만큼 …한)다. 비교 대상을 맞추기 위해 the sunshine을 반복하지 않고 대명사 that으로 받았다(that = the sunshine). 복수 명사를 받을 때는 those를 쓴다.",
      "example": {
        "en": "The climate of Seoul is colder than that of Busan.",
        "ko": "서울의 기후는 부산의 기후보다 춥다."
      },
      "note": null
    }
  ],
