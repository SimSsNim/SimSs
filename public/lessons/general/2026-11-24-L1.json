  "grammar": [
    {
      "id": "g1",
      "title": "ought to + 동사원형 (~해야 한다)",
      "tags": [
        "조동사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "ought to honour"
      ],
      "explanation": "ought to는 should와 비슷하게 '~해야 한다, ~하는 게 마땅하다'는 뜻이에요. 뒤에는 동사원형이 와요. 여기서 honour는 영국식 철자로, 미국식은 honor예요.",
      "example": {
        "en": "You ought to say sorry to her.",
        "ko": "너는 그녀에게 사과해야 해."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "what + 주어 + 동사 (~인 것)",
      "tags": [
        "관계사",
        "명사절"
      ],
      "sentenceId": "s5",
      "highlight": [
        "what I have been",
        "what I am"
      ],
      "explanation": "what은 '~인 것'이라는 뜻으로 명사 덩어리를 만들어요. what I am은 '지금의 나', what I have been은 '(지금까지) 예전의 나'라는 뜻이에요. have been은 현재완료라서 과거부터 지금까지 이어진 모습을 말해요.",
      "example": {
        "en": "I like what you made.",
        "ko": "나는 네가 만든 것이 좋아."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "과거완료 had + 과거분사",
      "tags": [
        "시제"
      ],
      "sentenceId": "s1",
      "highlight": [
        "had served",
        "had run down"
      ],
      "explanation": "had served는 '(그 일이 있기 전까지) 섬겨 왔다'는 뜻이에요. 이야기 속 시점(나이 들어 힘을 잃기 시작한 때)보다 더 앞서 일어난 일을 말할 때 had + 과거분사를 써요.",
      "example": {
        "en": "When I arrived, the bus had already left.",
        "ko": "내가 도착했을 때 버스는 이미 떠나 버렸다."
      },
      "note": null
    }
  ],
