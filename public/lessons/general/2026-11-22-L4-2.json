  "grammar": [
    {
      "id": "g1",
      "title": "관계대명사 what: ~하는 것",
      "tags": [
        "관계사",
        "명사절"
      ],
      "sentenceId": "s3",
      "highlight": [
        "Of what she earned"
      ],
      "explanation": "what은 선행사를 품은 관계대명사로 '~하는 것'(= the thing which)이라는 뜻이다. what she earned는 '그녀가 번 것(돈)'이며 전치사 of의 목적어로 쓰였다. what절은 주어·목적어·보어 자리에 모두 올 수 있다.",
      "example": {
        "en": "What you said made me happy.",
        "ko": "네가 한 말이 나를 기쁘게 했다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "가주어 it + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "It would be instructive to know"
      ],
      "explanation": "to부정사 주어가 길면 주어 자리에 it을 두고 진짜 주어(to know how she lived on that amount)는 뒤로 보낸다. '그녀가 그 돈으로 어떻게 살았는지 아는 것은 교훈이 될 것이다'라는 뜻이다. how she lived ~는 know의 목적어인 간접의문문(의문사 + 주어 + 동사)이다.",
      "example": {
        "en": "It is important to drink enough water.",
        "ko": "충분한 물을 마시는 것은 중요하다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "수동태 + 전치사: be paid, be interested in",
      "tags": [
        "수동태"
      ],
      "sentenceId": "s5",
      "highlight": [
        "was paid five dollars"
      ],
      "explanation": "Dulcie was paid five dollars는 '덜시는 5달러를 받았다'(누군가가 덜시에게 5달러를 지급했다)는 수동태다. pay처럼 목적어를 두 개 가질 수 있는 동사는 사람을 주어로 한 수동태를 만들 수 있다. 뒤 문장의 you are interested in larger amounts도 '~에 관심이 있다'는 수동태 표현이다.",
      "example": {
        "en": "She was given a prize for her essay.",
        "ko": "그녀는 에세이로 상을 받았다."
      },
      "note": null
    }
  ],
