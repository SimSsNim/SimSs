  "grammar": [
    {
      "id": "g1",
      "title": "as soon as: ~하자마자",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "as soon as the cock crew"
      ],
      "explanation": "as soon as는 \"~하자마자\"라는 뜻의 접속사처럼 쓰인다. 수탉이 울자마자 하녀들은 일어나야 했다. crew는 crow(울다)의 옛날식 과거형이다.",
      "example": {
        "en": "I fell asleep as soon as I lay down.",
        "ko": "나는 눕자마자 잠이 들었다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "if it were not for ~: ~이 없다면 (가정법)",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s3",
      "highlight": [
        "if it were not for the cock",
        "they could sleep longer"
      ],
      "explanation": "\"if it were not for + 명사\"는 \"~이 없다면\"이라는 뜻의 가정법 과거 표현이다. 실제로는 수탉이 있지만, 없다고 상상하는 것이다. 뒤에는 \"could + 동사원형(~할 수 있을 텐데)\"이 온다.",
      "example": {
        "en": "If it were not for water, we could not live.",
        "ko": "물이 없다면 우리는 살 수 없을 것이다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "비교급 + than ever",
      "tags": [
        "비교"
      ],
      "sentenceId": "s6",
      "highlight": [
        "earlier than ever"
      ],
      "explanation": "\"비교급 + than ever\"는 \"어느 때보다 더 ~하게\"라는 뜻이다. earlier than ever = 그 어느 때보다 더 일찍.",
      "example": {
        "en": "She studied harder than ever.",
        "ko": "그녀는 어느 때보다 더 열심히 공부했다."
      },
      "note": null
    }
  ],
