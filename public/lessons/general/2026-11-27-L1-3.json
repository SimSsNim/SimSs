  "grammar": [
    {
      "id": "g1",
      "title": "과거진행형: was/were + -ing (~하고 있었다)",
      "tags": [
        "시제"
      ],
      "sentenceId": "s1",
      "highlight": [
        "were walking"
      ],
      "explanation": "was/were + 동사-ing는 과거의 어느 때에 '~하고 있던 중'이었음을 나타내요. 나그네들이 길을 걷고 있던 장면을 그려 줘요.",
      "example": {
        "en": "I was reading a book when you called.",
        "ko": "네가 전화했을 때 나는 책을 읽고 있었다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "감탄문: What + a + 형용사 + 명사 + 주어 + 동사!",
      "tags": [
        "어순"
      ],
      "sentenceId": "s3",
      "highlight": [
        "What a useless tree the Plane is!"
      ],
      "explanation": "What a + 형용사 + 명사 + 주어 + 동사!는 '정말 ~한 …이구나!'라는 감탄문이에요. 주어와 동사(the Plane is)가 맨 뒤에 와요.",
      "example": {
        "en": "What a beautiful day it is!",
        "ko": "정말 아름다운 날이구나!"
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "분사구문: -ing로 시작하는 부사구 (~하면서, ~할 때)",
      "tags": [
        "분사구문"
      ],
      "sentenceId": "s3",
      "highlight": [
        "looking up into the tree"
      ],
      "explanation": "동사에 -ing를 붙인 구가 문장에 덧붙으면 '~하면서'나 '~할 때'라는 뜻이 돼요. 여기서는 '나무를 올려다보면서'라는 뜻이에요.",
      "example": {
        "en": "She walked home, singing a song.",
        "ko": "그녀는 노래를 부르면서 집으로 걸어갔다."
      },
      "note": null
    }
  ],
