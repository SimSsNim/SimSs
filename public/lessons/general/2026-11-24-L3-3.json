          "text": "on Monday morning,",
          "role": "M",
          "sub": false,
          "ko": "월요일 아침에,"
        },
        {
          "text": "with a saddle on his back and a bit in his mouth,",
          "role": "M",
          "sub": false,
          "ko": "등에 안장을, 입에 재갈을 한 채로,"
        },
        {
          "text": "and",
          "role": "CONJ",
          "sub": false,
          "ko": "그리고"
        },
        {
          "text": "said,",
          "role": "V",
          "sub": false,
          "ko": "말했다,"
        },
        {
          "text": "'Camel, O Camel,",
          "role": "M",
          "sub": true,
          "ko": "\"낙타야, 오 낙타야,"
        },
        {
          "text": "come out",
          "role": "V",
