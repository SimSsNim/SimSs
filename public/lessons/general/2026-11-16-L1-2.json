  "grammar": [
    {
      "id": "g1",
      "title": "명령문, and ~ (~해라, 그러면 …)",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "Dig, and you will find it"
      ],
      "explanation": "명령문 뒤에 and가 오면 '~해라, 그러면 …할 것이다'라는 뜻이 돼요. 반대로 or가 오면 '~해라, 그렇지 않으면'이라는 뜻이에요.",
      "example": {
        "en": "Study hard, and you will pass the test.",
        "ko": "열심히 공부해라, 그러면 시험에 합격할 거야."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "as soon as (~하자마자)",
      "tags": [
        "접속사",
        "부사절"
      ],
      "sentenceId": "s3",
      "highlight": [
        "As soon as their father was dead"
      ],
      "explanation": "as soon as는 '~하자마자'라는 뜻의 접속사예요. 아버지가 죽자마자 아들들이 바로 땅을 팠다는 뜻이에요.",
      "example": {
        "en": "As soon as I got home, I took a shower.",
        "ko": "나는 집에 오자마자 샤워를 했다."
      },
      "note": null
    },
    {
      "id": "g3",
