  "grammar": [
    {
      "id": "g1",
      "title": "감탄문 형태의 명사절 what a + 형용사 + 명사",
      "tags": [
        "명사절"
      ],
      "sentenceId": "s2",
      "highlight": [
        "what a dainty morsel she would make"
      ],
      "explanation": "'what a + 형용사 + 명사 + 주어 + 동사'는 '얼마나 ~한 …인지'라는 뜻으로, 여기서는 thinking의 목적어가 되는 명사절이에요. make는 '~이 되다'라는 뜻이에요.",
      "example": {
        "en": "I know what a kind person she is.",
        "ko": "나는 그녀가 얼마나 친절한 사람인지 안다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "so + 형용사 + a + 명사 어순",
      "tags": [
