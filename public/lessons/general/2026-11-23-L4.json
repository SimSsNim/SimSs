      "chunks": [
        {
          "text": "The vision of her little brood",
          "role": "S",
          "sub": false,
          "ko": "어린 자식들의 모습(을 떠올린 것)이"
        },
        {
          "text": "looking fresh and dainty and new",
          "role": "M",
          "sub": false,
          "ko": "산뜻하고 말쑥하고 새것으로 보이는"
        },
        {
