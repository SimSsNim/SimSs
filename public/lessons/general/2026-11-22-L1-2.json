  "grammar": [
    {
      "id": "g1",
      "title": "neither A nor B",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "neither the Birds nor the Beasts"
      ],
      "explanation": "neither A nor B는 'A도 B도 ~ 아니다'라는 뜻이에요. 문장에 not이 없어도 부정의 뜻이 들어 있어요. 그래서 neither the Birds nor the Beasts would have anything to do with ~는 '새도 짐승도 ~와 상종하려 하지 않았다'예요.",
      "example": {
        "en": "Neither Tom nor Jane came to the party.",
        "ko": "톰도 제인도 파티에 오지 않았다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "be to + 동사원형 / be found + -ing",
      "tags": [
        "to부정사",
        "수동태"
      ],
      "sentenceId": "s2",
      "highlight": [
        "he was found fighting",
        "he was to be found"
      ],
      "explanation": "was found fighting은 '싸우고 있는 것이 발견되었다(싸우는 모습이 보였다)'라는 수동태예요. was to be found는 'be to 용법'으로 '찾아볼 수 있었다, 있었다'라는 뜻이에요. 두 표현 모두 박쥐가 어디에 있었는지를 말해요.",
      "example": {
        "en": "The cat was found sleeping under the bed.",
        "ko": "고양이는 침대 밑에서 자고 있는 채로 발견되었다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "so + 형용사 + a + 명사",
      "tags": [
        "어순"
      ],
      "sentenceId": "s3",
      "highlight": [
        "so double-faced a traitor"
      ],
      "explanation": "보통은 'such a 형용사 명사'라고 하지만, so를 쓰면 'so + 형용사 + a + 명사' 순서가 돼요. so double-faced a traitor는 '그렇게 두 얼굴을 가진 배신자'예요.",
      "example": {
        "en": "I have never seen so tall a man.",
        "ko": "나는 그렇게 키 큰 남자를 본 적이 없다."
      },
      "note": null
    }
  ],
