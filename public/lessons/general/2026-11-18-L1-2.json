  "grammar": [
    {
      "id": "g1",
      "title": "get + 목적어 + 과거분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s1",
      "highlight": [
        "got a bone stuck"
      ],
      "explanation": "'get A stuck'은 'A가 걸리게 되다'예요. 목적어 뒤의 과거분사가 목적어의 상태를 나타내요. 7번 문장 'get it bitten off(그것이 물어뜯기다)'도 같은 구조예요.",
      "example": {
        "en": "I got my finger caught in the door.",
        "ko": "나는 손가락이 문에 끼였다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "수동태 was asked",
      "tags": [
        "수동태"
      ],
      "sentenceId": "s4",
      "highlight": [
        "was asked"
      ],
      "explanation": "'be + 과거분사'는 '~되다, ~받다'라는 수동태예요. 'as she was asked'는 '그녀가 부탁받은 대로'라는 뜻이에요.",
      "example": {
        "en": "The window was broken by the ball.",
        "ko": "창문이 공에 깨졌다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "과거진행형 + when",
      "tags": [
        "시제",
        "접속사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "was just turning away",
        "when"
      ],
      "explanation": "'was turning'은 '돌아서고 있었다'라는 과거진행형이에요. 'just'가 붙으면 '막 ~하려던 참이었다'는 느낌이에요. 뒤의 when절이 그 순간 일어난 일을 말해요.",
      "example": {
        "en": "I was just leaving when it started to rain.",
        "ko": "막 나가려는데 비가 오기 시작했다."
      },
      "note": null
    }
  ],
