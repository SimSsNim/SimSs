  "grammar": [
    {
      "id": "g1",
      "title": "관계대명사 which (계속적 용법)",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s1",
      "highlight": [
        "which had got rather damp"
      ],
      "explanation": "쉼표 뒤의 which는 앞의 명사(their store of corn)를 다시 설명해요. '그런데 그것은 ~했다'처럼 이어서 해석하면 돼요.",
      "example": {
        "en": "I lost my pen, which was a gift from my dad.",
        "ko": "나는 펜을 잃어버렸는데, 그것은 아빠가 준 선물이었다."
      },
      "note": null
    },
    {
      "id": "g2",
      "title": "so + 형용사 + that ~",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "so busy singing that"
      ],
      "explanation": "'너무 ~해서 …하다'라는 뜻이에요. 'be busy -ing'는 '~하느라 바쁘다'예요.",
      "example": {
        "en": "She was so tired that she fell asleep at once.",
        "ko": "그녀는 너무 피곤해서 곧바로 잠들었다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "과거진행형 was/were + -ing",
      "tags": [
        "시제"
      ],
      "sentenceId": "s1",
      "highlight": [
        "were busy drying"
      ],
      "explanation": "'were busy drying'은 '말리느라 바빴다'로, 그때 하고 있던 일을 나타내요. 4번 문장의 'were doing'도 '하고 있었다'는 과거진행형이에요.",
      "example": {
        "en": "We were watching TV when the phone rang.",
        "ko": "전화가 울렸을 때 우리는 TV를 보고 있었다."
      },
      "note": null
    }
  ],
