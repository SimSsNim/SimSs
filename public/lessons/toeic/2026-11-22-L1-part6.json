  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Riverside Printing 연례 야유회"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5"
      ],
      "ko": "올해 연례 회사 야유회가 6월 12일 토요일에 열린다는 것을 알려 드리게 되어 기쁩니다. 올해 행사는 Cedar Lake 공원에서 열립니다. 모두를 위한 게임과 음악, 넉넉한 음식이 준비됩니다. 직원 여러분은 가족을 데려오셔도 좋습니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s6",
        "s7",
        "s8",
        "s9"
      ],
      "ko": "준비에 도움이 되도록 안내 데스크에 있는 신청서를 작성해 주세요. 데려올 손님 수를 꼭 적어 주세요. 그래야 알맞은 양의 음식을 주문할 수 있습니다. 버스는 오전 9시 정각에 본사에서 출발합니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s10"
      ],
      "ko": "그곳에서 뵙기를 바랍니다!"
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s11"
      ],
      "ko": "Riverside Printing 행사팀"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Riverside Printing Annual Picnic",
      "ko": "Riverside Printing 연례 야유회",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "We are happy to announce that our annual company picnic will take place on Saturday, June 12.",
      "ko": "올해 연례 회사 야유회가 6월 12일 토요일에 열린다는 것을 알려 드리게 되어 기쁩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "This year, the event will be held at Cedar Lake Park.",
      "ko": "올해 행사는 Cedar Lake 공원에서 열립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "There will be games, music, and plenty of food for everyone.",
      "ko": "모두를 위한 게임과 음악, 넉넉한 음식이 준비됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "Employees are welcome to bring their family members.",
      "ko": "직원 여러분은 가족을 데려오셔도 좋습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "To help us plan, please complete the sign-up sheet at the front desk.",
      "ko": "준비에 도움이 되도록 안내 데스크에 있는 신청서를 작성해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "Be sure to write down the number of guests you will bring.",
      "ko": "데려올 손님 수를 꼭 적어 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "This will help us order the right amount of food.",
      "ko": "그래야 알맞은 양의 음식을 주문할 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p3",
      "en": "Buses will leave the main office promptly at nine in the morning.",
      "ko": "버스는 오전 9시 정각에 본사에서 출발합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "We hope to see you there!",
      "ko": "그곳에서 뵙기를 바랍니다!",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p5",
      "en": "The Riverside Printing Events Team",
      "ko": "Riverside Printing 행사팀",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
