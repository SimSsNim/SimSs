  "grammar": [
    {
      "id": "g1",
      "title": "계속적 용법 관계부사 (, where)",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s10",
      "highlight": [
        "The Hotel Miradouro, where you were originally booked"
      ],
      "explanation": "콤마 + where는 앞의 장소 명사에 대한 정보를 덧붙인다. '그곳에 원래 예약되어 있었는데'로 해석한다. where 뒤에는 완전한 절이 온다.",
      "example": {
        "en": "We stayed at the Grand Inn, where the staff were very friendly.",
        "ko": "우리는 그랜드 인에 묵었는데, 그곳 직원들은 매우 친절했다."
      },
      "note": "장소 명사 + 콤마 뒤 빈칸, 뒤에 완전한 절 → where / 불완전한 절 → which."
    },
    {
      "id": "g2",
      "title": "Not only 도치 + but (also)",
      "tags": [
        "도치",
        "접속사"
      ],
      "sentenceId": "s12",
      "highlight": [
        "Not only is it closer"
      ],
      "explanation": "Not only가 문장 앞에 오면 바로 뒤가 의문문 어순(be동사/조동사 + 주어)이 된다. 뒤의 but (also) 절은 원래 어순 그대로.",
      "example": {
        "en": "Not only did the team finish early, but they also cut costs.",
        "ko": "그 팀은 일찍 끝냈을 뿐 아니라 비용도 줄였다."
      },
      "note": "Not only + 빈칸 + 주어 → be동사·조동사(do/does/did/has) 자리."
    },
    {
      "id": "g3",
      "title": "require + 목적어 + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s14",
      "highlight": [
        "requires you to keep"
      ],
      "explanation": "require, ask, allow, encourage 같은 동사는 '목적어 + to부정사' 형태로 '(누가) ~하도록 요구하다'라는 뜻이 된다. 수동태로는 You are required to keep ~.",
      "example": {
        "en": "The contract requires the supplier to deliver within ten days.",
        "ko": "계약서는 공급업체가 10일 이내에 납품하도록 요구한다."
      },
      "note": "require + 사람 + 빈칸 → to + 동사원형 / be required + 빈칸 → to + 동사원형."
    }
  ],
