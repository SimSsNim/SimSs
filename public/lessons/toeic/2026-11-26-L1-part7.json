  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "Why did Ms. Liu write to Mr. Ortiz?",
      "choices": [
        {
          "key": "A",
          "text": "To confirm that a payment was received"
        },
        {
          "key": "B",
          "text": "To explain that one item will arrive late"
        },
        {
          "key": "C",
          "text": "To advertise a new line of office chairs"
        },
        {
          "key": "D",
          "text": "To ask him to return a product"
        }
      ],
      "answer": "B",
      "explanationKo": "'part of your order has been delayed(주문 일부가 늦어졌다)'와 검은 의자 재고가 떨어졌다는 내용이 핵심. 이를 '한 물품이 늦게 도착할 것'으로 바꿔 말한 B가 정답.",
      "choiceNotesKo": {
        "C": "회색 의자가 나오지만 새 상품을 광고하는 글이 아니다.",
        "A": "결제 이야기는 나오지 않는다."
      },
      "skill": "글의 목적",
      "evidenceSentenceIds": [
        "s3",
        "s5"
      ]
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What is Mr. Ortiz offered if he does not want to wait?",
      "choices": [
        {
          "key": "A",
          "text": "A full refund for his order"
        },
        {
          "key": "B",
          "text": "A discount on his next purchase"
        },
        {
          "key": "C",
          "text": "Free delivery for one year"
        },
        {
          "key": "D",
          "text": "A similar item in a different color"
        }
      ],
      "answer": "D",
      "explanationKo": "'기다리고 싶지 않으면 같은 모델의 회색 의자를 고를 수 있다'고 했다. 같은 모델 → similar item, 회색 → different color로 바꿔 말한 D가 정답.",
      "choiceNotesKo": {
        "A": "환불은 언급되지 않았다.",
        "C": "no extra cost는 늦게 오는 의자를 추가 비용 없이 보내 준다는 뜻이지 1년 무료 배송이 아니다."
      },
      "skill": "세부 사항(패러프레이징)",
      "evidenceSentenceIds": [
        "s8",
        "s9"
      ]
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-not-true",
      "prompt": "What is NOT mentioned in the e-mail?",
      "choices": [
        {
          "key": "A",
          "text": "Some items have already been sent."
        },
        {
          "key": "B",
          "text": "The black chair is currently unavailable."
        },
        {
          "key": "C",
          "text": "The gray chair costs more than the black one."
        },
        {
          "key": "D",
          "text": "Mr. Ortiz can make his choice by replying."
        }
      ],
      "answer": "C",
      "explanationKo": "회색 의자의 가격이 더 비싸다는 말은 어디에도 없다. A는 '오늘 아침 발송', B는 '재고가 떨어졌다', D는 '이 이메일에 답장하라'에서 확인된다.",
      "choiceNotesKo": {
        "A": "s4의 were shipped this morning과 같은 내용.",
        "B": "has run out of(다 떨어졌다)를 unavailable로 바꿔 말한 것."
      },
      "skill": "사실이 아닌 것(NOT)",
      "evidenceSentenceIds": [
        "s4",
        "s5",
        "s10"
      ]
    }
  ]
