  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Ortiz 씨께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5",
        "s6"
      ],
      "ko": "Bluebird 사무용품에서 최근 주문해 주셔서 감사합니다. 주문하신 물품 중 일부가 늦어진다는 점을 알려 드리려고 연락드립니다. 프린터 용지와 책상 스탠드는 오늘 아침 발송되었으며 수요일에 도착할 예정입니다. 그러나 주문하신 검은색 사무용 의자는 저희 창고에 재고가 떨어졌습니다. 다음 주에 제조사로부터 의자를 더 받을 것으로 예상합니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s7",
        "s8",
        "s9",
        "s10"
      ],
      "ko": "의자가 들어오는 대로 추가 비용 없이 보내 드리겠습니다. 기다리고 싶지 않으시면 대신 같은 모델의 회색 의자를 고르실 수 있습니다. 회색 의자는 지금 재고가 있어 금요일까지 받아 보실 수 있습니다. 이 이메일에 답장하여 원하시는 쪽을 알려 주시기만 하면 됩니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s11"
      ],
      "ko": "배송이 늦어져 죄송합니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s12"
      ],
      "ko": "감사합니다,"
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s13"
      ],
      "ko": "Karen Liu"
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s14"
      ],
      "ko": "Bluebird 사무용품 고객 서비스팀"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Mr. Ortiz,",
      "ko": "Ortiz 씨께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for your recent order from Bluebird Office Supply.",
      "ko": "Bluebird 사무용품에서 최근 주문해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "We are writing to let you know that part of your order has been delayed.",
      "ko": "주문하신 물품 중 일부가 늦어진다는 점을 알려 드리려고 연락드립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "The printer paper and the desk lamp were shipped this morning and should arrive on Wednesday.",
      "ko": "프린터 용지와 책상 스탠드는 오늘 아침 발송되었으며 수요일에 도착할 예정입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "However, our warehouse has run out of the black office chair you ordered.",
      "ko": "그러나 주문하신 검은색 사무용 의자는 저희 창고에 재고가 떨어졌습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p2",
      "en": "We expect to receive more chairs from the manufacturer next week.",
      "ko": "다음 주에 제조사로부터 의자를 더 받을 것으로 예상합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "We will send the chair as soon as it arrives, at no extra cost to you.",
      "ko": "의자가 들어오는 대로 추가 비용 없이 보내 드리겠습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "If you would rather not wait, you can choose a gray chair of the same model instead.",
      "ko": "기다리고 싶지 않으시면 대신 같은 모델의 회색 의자를 고르실 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p3",
      "en": "It is in stock now and could reach you by Friday.",
      "ko": "회색 의자는 지금 재고가 있어 금요일까지 받아 보실 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p3",
      "en": "Simply reply to this e-mail to let us know your choice.",
      "ko": "이 이메일에 답장하여 원하시는 쪽을 알려 주시기만 하면 됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p4",
      "en": "We apologize for the delay.",
      "ko": "배송이 늦어져 죄송합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p5",
      "en": "Sincerely,",
      "ko": "감사합니다,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s13",
      "paragraphId": "p6",
      "en": "Karen Liu",
      "ko": "Karen Liu",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s14",
      "paragraphId": "p7",
      "en": "Customer Service, Bluebird Office Supply",
      "ko": "Bluebird 사무용품 고객 서비스팀",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
