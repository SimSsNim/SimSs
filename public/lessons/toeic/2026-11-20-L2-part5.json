  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Grant 씨는 학회에서 고객 충성도에 관해 매우 유익한 강연을 했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "동관의 고장 난 엘리베이터는 아직 수리되지 않았다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "주차 허가증이 만료된 직원들은 이달 말까지 갱신해야 한다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "이사회는 부산에 새 지점을 여는 것을 검토하고 있다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "예산이 한정되어 있었지만 팀은 제때 프로젝트를 끝냈다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "Novak 씨는 Carlow Logistics에서 10년 넘게 일해 왔다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "영업팀은 올해 꾸준히 목표를 초과 달성해 왔다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "중앙 로비가 보수되는 동안 협조해 주셔서 감사합니다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "첨부된 양식을 작성해 금요일까지 Patel 씨에게 돌려주세요."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "Tanaka 씨는 회계 부서의 신입 사원 교육을 담당하고 있다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Ms. Grant gave a very informative talk about customer loyalty at the conference.",
      "ko": "Grant 씨는 학회에서 고객 충성도에 관해 매우 유익한 강연을 했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The broken elevator in the east wing has not been repaired yet.",
      "ko": "동관의 고장 난 엘리베이터는 아직 수리되지 않았다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Employees whose parking permits have expired must renew them by the end of the month.",
      "ko": "주차 허가증이 만료된 직원들은 이달 말까지 갱신해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "The board is considering opening a new branch office in Busan.",
      "ko": "이사회는 부산에 새 지점을 여는 것을 검토하고 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Even though the budget was limited, the team finished the project on time.",
      "ko": "예산이 한정되어 있었지만 팀은 제때 프로젝트를 끝냈다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Ms. Novak has worked at Carlow Logistics for more than ten years.",
      "ko": "Novak 씨는 Carlow Logistics에서 10년 넘게 일해 왔다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "The sales team has consistently exceeded its targets this year.",
      "ko": "영업팀은 올해 꾸준히 목표를 초과 달성해 왔다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "We appreciate your cooperation while the main lobby is being renovated.",
      "ko": "중앙 로비가 보수되는 동안 협조해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Please complete the attached form and return it to Ms. Patel by Friday.",
      "ko": "첨부된 양식을 작성해 금요일까지 Patel 씨에게 돌려주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Mr. Tanaka is responsible for training new employees in the accounting department.",
      "ko": "Tanaka 씨는 회계 부서의 신입 사원 교육을 담당하고 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
