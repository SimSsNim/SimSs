  "grammar": [
    {
      "id": "g1",
      "title": "명사 뒤에서 꾸미는 현재분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Visitors wishing to attend"
      ],
      "explanation": "방문객이 '참석하기를 바라는' 능동 관계이므로 현재분사 wishing이 명사 Visitors를 뒤에서 꾸민다. 문장의 동사는 should register이므로 빈칸에 동사(wish, wished)는 올 수 없다.",
      "example": {
        "en": "Employees working late can use the side entrance.",
        "ko": "늦게까지 일하는 직원은 옆문을 이용할 수 있다."
      },
      "note": "동사가 이미 있고 명사 뒤 빈칸 + 목적어(to부정사 등)가 있으면 현재분사(-ing)."
    },
    {
      "id": "g2",
      "title": "과거분사로 시작하는 분사구문",
      "tags": [
        "분사구문"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Founded in 1998"
      ],
      "explanation": "주어 Corlin Logistics는 1998년에 '설립된' 대상이므로 수동 의미의 과거분사 Founded를 쓴다. Founding이나 Having founded는 주어가 직접 무언가를 설립했다는 능동 의미라 맞지 않다.",
      "example": {
        "en": "Built in 1920, the hotel still attracts many guests.",
        "ko": "1920년에 지어진 그 호텔은 여전히 많은 손님을 끈다."
      },
      "note": "콤마 앞 빈칸 + in 연도/by 사람 → 과거분사 분사구문(Founded, Located, Built)."
    },
    {
      "id": "g3",
      "title": "가정법 과거",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s6",
      "highlight": [
        "were larger",
        "would hire"
      ],
      "explanation": "현재 사실과 반대되는 상황을 가정할 때 If + 주어 + 과거동사(be는 were), 주어 + would + 동사원형을 쓴다.",
      "example": {
        "en": "If I had more time, I would take the course.",
        "ko": "시간이 더 있다면 그 강좌를 들을 텐데."
      },
      "note": "If절에 were/과거동사가 보이면 주절은 would(could) + 동사원형."
    }
  ],
