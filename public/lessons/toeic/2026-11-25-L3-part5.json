  "grammar": [
    {
      "id": "g1",
      "title": "과거분사 후치 수식",
      "tags": [
        "분사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "compiled by an outside research firm"
      ],
      "explanation": "명사 뒤에서 '~된'이라는 수동의 뜻으로 꾸밀 때는 과거분사(p.p.)를 쓴다. 결과는 업체에 의해 '정리된' 것이므로 compiled. 뒤의 by가 수동의 단서.",
      "example": {
        "en": "The documents signed by the director are in the top drawer.",
        "ko": "이사가 서명한 서류는 맨 위 서랍에 있다."
      },
      "note": "명사 + ___ + by ~ → 과거분사(p.p.)가 정답일 확률이 높다."
    },
    {
      "id": "g2",
      "title": "능동 분사구문 (V-ing)",
      "tags": [
        "분사구문"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Hoping to attract"
      ],
      "explanation": "분사구문은 '접속사 + 주어'를 빼고 동사를 -ing로 바꾼 것. 주절 주어가 그 동작을 직접 하면 -ing, 당하면 p.p.를 쓴다. 비스트로가 '바라는' 것이므로 Hoping.",
      "example": {
        "en": "Wanting to save time, she booked a direct flight.",
        "ko": "시간을 아끼고 싶어서 그녀는 직항편을 예약했다."
      },
      "note": "콤마 앞 빈칸 + 뒤에 목적어(to부정사 등)가 있으면 능동 -ing."
    },
    {
      "id": "g3",
      "title": "가정법 과거완료",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s7",
      "highlight": [
        "had arrived",
        "would have opened"
      ],
      "explanation": "과거에 일어나지 않은 일을 반대로 가정할 때: If + 주어 + had p.p., 주어 + would/could have p.p.",
      "example": {
        "en": "If we had left earlier, we would have caught the train.",
        "ko": "우리가 더 일찍 출발했더라면 기차를 탔을 것이다."
      },
      "note": "주절에 would have p.p.가 보이면 If절 빈칸은 had p.p."
    }
  ],
