  "grammar": [
    {
      "id": "g1",
      "title": "Only + 부사(절) 도치",
      "tags": [
        "도치"
      ],
      "sentenceId": "s1",
      "highlight": [
        "Only after",
        "did the client request"
      ],
      "explanation": "Only가 붙은 부사구·부사절이 문장 맨 앞에 오면 주절은 '조동사 + 주어 + 동사원형' 순서로 바뀐다. 과거 일반동사이므로 did를 쓴다.",
      "example": {
        "en": "Only then did I realize my mistake.",
        "ko": "그제서야 나는 내 실수를 깨달았다."
      },
      "note": "문두 Only/Never/Rarely/Not until → 빈칸에 도치 어순이 들어가는지 확인."
    },
    {
      "id": "g2",
      "title": "복합관계대명사 whoever",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "Whoever submits"
      ],
      "explanation": "whoever는 '~하는 사람은 누구든'이라는 뜻으로 명사절을 이끈다. 절 안에서 주어 역할이면 whoever, 목적어 역할이면 whomever.",
      "example": {
        "en": "Whoever arrives first should unlock the office.",
        "ko": "가장 먼저 도착하는 사람이 사무실 문을 열어야 한다."
      },
      "note": "빈칸 뒤에 바로 동사가 오면 주격 whoever."
    },
    {
      "id": "g3",
      "title": "each of + 복수 명사 + 단수 동사",
      "tags": [
        "일치"
      ],
      "sentenceId": "s9",
      "highlight": [
        "Each of the regional managers is"
      ],
      "explanation": "Each of 뒤의 명사는 복수지만 진짜 주어는 Each라서 단수 동사 is를 쓴다.",
      "example": {
        "en": "Each of the rooms has a private balcony.",
        "ko": "객실마다 전용 발코니가 있다."
      },
      "note": "managers에 속지 말고 Each에 동사를 맞춘다."
    }
  ],
