  "grammar": [
    {
      "id": "g1",
      "title": "Not only 도치",
      "tags": [
        "도치"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Not only will we replace"
      ],
      "explanation": "부정어 Not only가 문장 맨 앞에 오면 의문문처럼 '조동사 + 주어 + 동사원형' 순서로 바뀐다. 뒤에는 보통 but (also)가 이어진다.",
      "example": {
        "en": "Not only does the hotel offer free parking, but it also provides airport shuttles.",
        "ko": "그 호텔은 무료 주차를 제공할 뿐 아니라 공항 셔틀도 운행한다."
      },
      "note": "Not only + 빈칸 + 주어 + 동사원형 → 빈칸은 조동사(will/do/does/did)."
    },
    {
      "id": "g2",
      "title": "가정법 미래 도치 (Should + S + 동사원형)",
      "tags": [
        "가정법",
        "도치"
      ],
      "sentenceId": "s10",
      "highlight": [
        "Should you have any further questions"
      ],
      "explanation": "If you should have ~에서 If를 생략하고 Should를 주어 앞으로 보낸 형태. '혹시 ~하시면'이라는 정중한 조건으로, 편지 맺음말에 자주 쓰인다.",
      "example": {
        "en": "Should the package arrive damaged, please contact us immediately.",
        "ko": "혹시 소포가 파손된 채 도착하면 즉시 연락해 주세요."
      },
      "note": "빈칸 + 주어 + 동사원형 ~, please ... 패턴이면 Should."
    },
    {
      "id": "g3",
      "title": "숫자를 꾸미는 부사 barely",
      "tags": [
        "품사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "barely three weeks"
      ],
      "explanation": "barely, nearly, almost, approximately 같은 부사는 숫자 표현 앞에서 '겨우/거의/약'처럼 양을 꾸민다.",
      "example": {
        "en": "The meeting lasted barely ten minutes.",
        "ko": "회의는 겨우 10분 동안 진행되었다."
      },
      "note": "숫자 앞 빈칸은 형용사가 아니라 부사 자리."
    }
  ],
