  "grammar": [
    {
      "id": "g1",
      "title": "미래 수동태 will be p.p.",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s6",
      "highlight": [
        "will be announced"
      ],
      "explanation": "수상자는 '발표되는' 대상이므로 수동태. 미래 시점(next Monday)이라 will be + 과거분사를 쓴다.",
      "example": {
        "en": "The results will be posted tomorrow.",
        "ko": "결과는 내일 게시될 것이다."
      },
      "note": "빈칸 뒤에 목적어가 없고 주어가 행동을 '당하면' 수동태를 고른다."
    },
    {
      "id": "g2",
      "title": "비교급 + than",
      "tags": [
        "비교"
      ],
      "sentenceId": "s7",
      "highlight": [
        "much lighter than"
      ],
      "explanation": "두 대상을 비교할 때 '형용사-er + than'을 쓴다. much는 비교급을 강조해 '훨씬'이라는 뜻.",
      "example": {
        "en": "This room is much bigger than that one.",
        "ko": "이 방은 저 방보다 훨씬 크다."
      },
      "note": "빈칸 뒤에 than이 보이면 비교급을 고른다. very는 비교급을 꾸미지 못한다."
    },
    {
      "id": "g3",
      "title": "during + 명사 vs while + 절",
      "tags": [
        "전치사",
        "접속사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "during the presentation"
      ],
      "explanation": "during은 전치사라 뒤에 명사(the presentation)가 온다. while은 접속사라 뒤에 주어+동사가 와야 한다.",
      "example": {
        "en": "Please be quiet during the meeting.",
        "ko": "회의 중에는 조용히 해 주세요."
      },
      "note": "빈칸 뒤가 명사 하나면 during, 주어+동사면 while."
    }
  ],
