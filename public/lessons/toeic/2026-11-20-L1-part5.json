  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "새 프린터를 사용하기 전에 안전 수칙을 주의 깊게 읽어 주세요."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "Lee 씨는 보통 매일 아침 7시에 사무실 문을 연다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "새 주차장 공사는 약 3개월이 걸릴 것이다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "발표 중에는 휴대전화를 꺼 주세요."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "새 배달 서비스는 우리 고객들에게 매우 인기가 많다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "사진 대회 수상자는 다음 주 월요일에 발표될 것이다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "새 노트북은 예전 모델보다 훨씬 더 가볍다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "질문이 있으시면 저희 안내 데스크로 전화해 주세요."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "고객들은 언제든지 온라인으로 주문을 추적할 수 있다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "저희 신제품 라인에 관심을 가져 주셔서 감사합니다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Please read the safety instructions carefully before you use the new printer.",
      "ko": "새 프린터를 사용하기 전에 안전 수칙을 주의 깊게 읽어 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Mr. Lee usually opens the office at seven every morning.",
      "ko": "Lee 씨는 보통 매일 아침 7시에 사무실 문을 연다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The construction of the new parking lot will take about three months.",
      "ko": "새 주차장 공사는 약 3개월이 걸릴 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Please turn off your mobile phones during the presentation.",
      "ko": "발표 중에는 휴대전화를 꺼 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The new delivery service is very popular with our customers.",
      "ko": "새 배달 서비스는 우리 고객들에게 매우 인기가 많다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The winners of the photo contest will be announced next Monday.",
      "ko": "사진 대회 수상자는 다음 주 월요일에 발표될 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "The new laptop is much lighter than the old model.",
      "ko": "새 노트북은 예전 모델보다 훨씬 더 가볍다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "If you have any questions, please call our help desk.",
      "ko": "질문이 있으시면 저희 안내 데스크로 전화해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Customers can track their orders online at any time.",
      "ko": "고객들은 언제든지 온라인으로 주문을 추적할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Thank you for your interest in our new product line.",
      "ko": "저희 신제품 라인에 관심을 가져 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
