  "audio": null,
  "wordCount": 104,
  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "그랜트 씨께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5"
      ],
      "ko": "회원 카드에 관해 편지를 보내 주셔서 감사합니다. 지난주에 카드가 작동하지 않게 되어 죄송합니다. 카드를 휴대 전화 옆에 두면 가끔 이런 일이 생깁니다. 저희가 이미 새 카드를 만들어 두었습니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s6",
        "s7",
        "s8",
        "s9",
        "s10"
      ],
      "ko": "언제든지 안내 데스크에서 찾아가실 수 있습니다. 본인 확인을 할 수 있도록 사진이 있는 신분증을 가져와 주세요. 새 카드는 비용이 들지 않습니다. 불편을 드린 데 대한 사과로 회원 기간에 무료 한 달을 추가해 드렸습니다. 곧 뵙기를 바랍니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s11"
      ],
      "ko": "감사합니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s12"
      ],
      "ko": "폴라 레예스, 고객 서비스 매니저"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Mr. Grant,",
      "ko": "그랜트 씨께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for your letter about your membership card.",
      "ko": "회원 카드에 관해 편지를 보내 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "We are sorry that it stopped working last week.",
      "ko": "지난주에 카드가 작동하지 않게 되어 죄송합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "This sometimes happens when a card is kept next to a mobile phone.",
      "ko": "카드를 휴대 전화 옆에 두면 가끔 이런 일이 생깁니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "We have already made a new card for you.",
      "ko": "저희가 이미 새 카드를 만들어 두었습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "You can pick it up at the front desk at any time.",
      "ko": "언제든지 안내 데스크에서 찾아가실 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "Please bring a photo identification card so that we can confirm your identity.",
      "ko": "본인 확인을 할 수 있도록 사진이 있는 신분증을 가져와 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "There is no charge for the new card.",
      "ko": "새 카드는 비용이 들지 않습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p3",
      "en": "We have also added one free month to your membership as an apology for the trouble.",
      "ko": "불편을 드린 데 대한 사과로 회원 기간에 무료 한 달을 추가해 드렸습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p3",
      "en": "We hope to see you soon.",
      "ko": "곧 뵙기를 바랍니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p4",
      "en": "Sincerely,",
      "ko": "감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p5",
      "en": "Paula Reyes, Customer Service Manager",
      "ko": "폴라 레예스, 고객 서비스 매니저",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
