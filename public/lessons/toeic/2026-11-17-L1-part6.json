  "grammar": [
    {
      "id": "g1",
      "title": "stop + -ing (~하는 것을 멈추다)",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "stopped working"
      ],
      "explanation": "stop 뒤에 동명사가 오면 '~하던 것을 멈추다'. stopped working = 작동을 멈췄다(고장 났다).",
      "example": {
        "en": "The phone stopped ringing.",
        "ko": "전화벨이 멈췄다."
      },
      "note": "stop + -ing(하던 일을 멈춤) vs stop + to V(~하려고 멈춤)."
    },
    {
      "id": "g2",
      "title": "so that + 주어 + can (~할 수 있도록)",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "so that we can confirm"
      ],
      "explanation": "so that은 목적을 나타내는 접속사. 뒤에 주어 + can/will + 동사원형이 온다.",
      "example": {
        "en": "Speak loudly so that everyone can hear you.",
        "ko": "모두가 들을 수 있도록 크게 말하세요."
      },
      "note": "can 뒤 빈칸은 언제나 동사원형."
    },
    {
      "id": "g3",
      "title": "명사 자리: 관사 + 명사",
      "tags": [
        "품사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "an apology"
      ],
      "explanation": "an 뒤에는 명사가 온다. as an apology for ~ = ~에 대한 사과로.",
      "example": {
        "en": "He sent flowers as an apology.",
        "ko": "그는 사과의 뜻으로 꽃을 보냈다."
      },
      "note": "a/an/the 바로 뒤 빈칸 → 명사."
    }
  ],
