  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the article mainly about?",
      "choices": [
        {
          "key": "A",
          "text": "A change in the price of bread"
        },
        {
          "key": "B",
          "text": "A bakery's plan to hire workers for a new location"
        },
        {
          "key": "C",
          "text": "A cooking class for local residents"
        },
        {
          "key": "D",
          "text": "The retirement of a business owner"
        }
      ],
      "answer": "B",
      "explanationKo": "제목과 둘째 문단이 '두 번째 매장을 열면서 15명을 채용한다'는 내용. second store → new location, hire fifteen new workers → hire workers로 바꿔 말한 B가 정답.",
      "choiceNotesKo": {
        "D": "주인 Laura Chen의 시작 이야기는 나오지만 은퇴 이야기는 없다.",
        "A": "빵 가격은 언급되지 않는다."
      },
      "skill": "글의 주제",
      "evidenceSentenceIds": [
        "s2",
        "s3"
      ]
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What will new cashiers receive?",
      "choices": [
        {
          "key": "A",
          "text": "A free lunch every day"
        },
        {
          "key": "B",
          "text": "A higher salary than drivers"
        },
        {
          "key": "C",
          "text": "A driver's license"
        },
        {
          "key": "D",
          "text": "Instruction for a short period"
        }
      ],
      "answer": "D",
      "explanationKo": "'all new staff will receive two weeks of training'(모든 신규 직원은 2주간 교육을 받는다). two weeks of training을 Instruction for a short period(짧은 기간의 교육)로 바꿔 말한 D가 정답.",
      "choiceNotesKo": {
        "C": "운전면허는 배달 기사가 '가지고 있어야' 하는 것이다.",
        "B": "급여 이야기는 없다."
      },
      "skill": "세부 사항(패러프레이징)",
      "evidenceSentenceIds": [
        "s8"
      ]
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-not-true",
      "prompt": "What is NOT mentioned about Maple Street Bakery?",
      "choices": [
        {
          "key": "A",
          "text": "It began with a small number of employees."
        },
        {
          "key": "B",
          "text": "It sells hundreds of loaves daily."
        },
        {
          "key": "C",
          "text": "It plans to close its downtown store."
        },
        {
          "key": "D",
          "text": "It accepts job applications online."
        }
      ],
      "answer": "C",
      "explanationKo": "두 번째 매장을 '새로' 여는 것이지 시내 매장을 닫는다는 말은 없다. A는 직원 세 명으로 시작(s5), B는 매일 500개 이상(s6), D는 웹사이트 지원(s10)으로 모두 언급됨.",
      "choiceNotesKo": {
        "B": "more than 500 loaves every day = hundreds of loaves daily.",
        "D": "apply on the bakery's website = 온라인 지원."
      },
