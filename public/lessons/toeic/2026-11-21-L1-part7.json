  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "Why was the e-mail sent?",
      "evidenceSentenceIds": [
        "s3"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To explain a delay in a delivery"
        },
        {
          "key": "B",
          "text": "To confirm that an order was canceled"
        },
        {
          "key": "C",
          "text": "To advertise a new line of office chairs"
        },
        {
          "key": "D",
          "text": "To ask a customer to pay a bill"
        }
      ],
      "answer": "A",
      "explanationKo": "두 번째 문단 첫머리에서 주문 일부가 예정보다 늦게 도착한다고 알린다. arrive later than planned → a delay in a delivery.",
      "choiceNotesKo": {
        "B": "취소는 고객이 원할 때 가능한 선택일 뿐 이미 취소된 것이 아니다.",
        "C": "의자는 이미 주문한 물품이지 광고하는 신제품이 아니다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What has already been sent to Mr. Thompson?",
      "evidenceSentenceIds": [
        "s6"
      ],
      "choices": [
        {
          "key": "A",
          "text": "Some office chairs"
        },
        {
          "key": "B",
          "text": "A full refund"
        },
        {
          "key": "C",
          "text": "Some lamps and paper"
        },
        {
          "key": "D",
          "text": "A printed coupon"
        }
      ],
      "answer": "C",
      "explanationKo": "책상 조명 2개와 종이 한 상자가 오늘 발송되었다고 했다. two desk lamps and a box of paper → some lamps and paper.",
      "choiceNotesKo": {
        "A": "의자는 재고가 없어 나중에 따로 보낸다.",
        "D": "쿠폰은 이메일 아래에 코드로 있고, 인쇄해서 보낸 것이 아니다."
      },
      "skill": "세부 사항(패러프레이징)"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-synonym",
      "prompt": "In the e-mail, the word \"separately\" is closest in meaning to",
      "evidenceSentenceIds": [
        "s8"
      ],
      "choices": [
        {
          "key": "A",
          "text": "quickly"
        },
        {
          "key": "B",
          "text": "individually"
        },
        {
          "key": "C",
          "text": "carefully"
        },
        {
          "key": "D",
          "text": "finally"
        }
      ],
      "answer": "B",
      "explanationKo": "의자는 다른 물품과 '따로' 보낸다는 뜻이므로 individually(개별적으로)가 가장 가깝다.",
      "choiceNotesKo": {
        "A": "'빨리'가 아니라 '따로'라는 뜻이다.",
        "D": "finally는 '마침내'라 뜻이 다르다."
      },
      "skill": "동의어"
    }
  ]
