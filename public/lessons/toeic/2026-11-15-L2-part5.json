  "grammar": [
    {
      "id": "g1",
      "title": "조동사 + 수동태",
      "tags": [
        "수동태",
        "조동사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "must be accompanied by"
      ],
      "explanation": "방문객은 직원이 '동행해 주는' 대상이다. 조동사 뒤 수동태는 must be + p.p.이고, 행위자는 by로 나타낸다.",
      "example": {
        "en": "The form must be signed by a manager.",
        "ko": "그 양식은 관리자가 서명해야 한다."
      },
      "note": "be 뒤 빈칸 + by ~ → 과거분사(p.p.)."
    },
    {
      "id": "g2",
      "title": "관계부사 where",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "The hotel where the seminar took place"
      ],
      "explanation": "장소 명사(The hotel) 뒤에 완전한 문장(the seminar took place)이 오면 관계부사 where를 쓴다. which는 뒤에 빠진 성분이 있어야 한다.",
      "example": {
        "en": "This is the office where I work.",
        "ko": "여기가 내가 일하는 사무실이다."
      },
      "note": "장소 명사 + 빈칸 + 완전한 절 → where."
    },
