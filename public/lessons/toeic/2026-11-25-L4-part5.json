  "grammar": [
    {
      "id": "g1",
      "title": "Only + 부사구/절 도치",
      "tags": [
        "도치"
      ],
      "sentenceId": "s5",
      "highlight": [
        "were employees permitted"
      ],
      "explanation": "Only after/Only when/Only by 같은 'Only + 수식어'가 문장 맨 앞에 오면 주절이 '조동사/be동사 + 주어 + 동사' 순서로 바뀐다.",
      "example": {
        "en": "Only when the manager arrived did the meeting begin.",
        "ko": "매니저가 도착하고 나서야 회의가 시작되었다."
      },
      "note": "문장 앞 Only + 시간 표현 → 빈칸은 도치 어순(be/조동사 + S)."
    },
    {
      "id": "g2",
      "title": "복합관계부사 however (아무리 ~해도)",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "However carefully"
      ],
      "explanation": "however + 형용사/부사 + 주어 + 동사 = no matter how ~. 양보의 부사절을 만들며, 바로 뒤에 형용사나 부사가 붙는 것이 특징이다.",
      "example": {
        "en": "However busy you are, please reply by Friday.",
        "ko": "아무리 바쁘더라도 금요일까지 답해 주세요."
      },
      "note": "빈칸 바로 뒤에 형용사/부사 + 주어 + 동사 → However."
    },
    {
      "id": "g3",
      "title": "Without을 이용한 가정법 과거완료",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Without",
        "could not have taken"
      ],
      "explanation": "Without(= But for) + 명사는 '~이 없었다면'이라는 뜻으로 If절을 대신한다. 과거의 반대를 가정하면 주절은 would/could have p.p.",
      "example": {
        "en": "Without your help, we could not have finished on time.",
        "ko": "당신의 도움이 없었다면 우리는 제시간에 끝내지 못했을 것이다."
      },
      "note": "Without + 명사 + 콤마 뒤 빈칸 → would/could have p.p.를 확인."
    }
  ],
