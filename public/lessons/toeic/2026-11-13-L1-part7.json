  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the purpose of the memo?",
      "evidenceSentenceIds": [
        "s4"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To introduce a new office manager"
        },
        {
          "key": "B",
          "text": "To explain plans for an office move"
        },
        {
          "key": "C",
          "text": "To ask staff to buy new computers"
        },
        {
          "key": "D",
          "text": "To announce a holiday schedule"
        }
      ],
      "answer": "B",
      "explanationKo": "'our company is moving to a larger office'로 시작해 이사 날짜와 할 일을 설명한다. is moving → an office move로 바꿔 말했다.",
      "choiceNotesKo": {
        "A": "Grace Holt는 보내는 사람일 뿐, 새로 소개되는 사람이 아니다.",
        "C": "컴퓨터는 설치(set up)할 뿐 사라는 말은 없다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What are employees asked to do before December 4?",
      "evidenceSentenceIds": [
        "s7"
      ],
      "choices": [
        {
          "key": "A",
          "text": "Visit the new building"
        },
        {
          "key": "B",
          "text": "Order new furniture"
        },
        {
          "key": "C",
          "text": "Put their desk items in boxes"
        },
        {
          "key": "D",
          "text": "Call the moving company"
        }
      ],
      "answer": "C",
      "explanationKo": "'Before then, please pack the items on your desk into the boxes'에서 책상 물건을 상자에 담으라고 했다. pack ~ into the boxes → put ~ in boxes로 바꿔 말했다.",
      "choiceNotesKo": {
        "D": "전화는 질문이 있을 때 Grace Holt에게 하라는 것이다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-inference",
      "prompt": "What is suggested about Monday, December 7?",
