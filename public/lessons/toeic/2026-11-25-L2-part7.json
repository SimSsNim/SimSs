  "grammar": [
    {
      "id": "g1",
      "title": "전치사 + 동명사 / decide + to부정사",
      "tags": [
        "동명사",
        "to부정사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "After comparing",
        "decided to hire"
      ],
      "explanation": "전치사 after 뒤에는 동사를 -ing(동명사)로 쓴다. decide는 to부정사를 목적어로 쓴다.",
      "example": {
        "en": "After reading the report, she decided to call the client.",
        "ko": "보고서를 읽은 후 그녀는 고객에게 전화하기로 했다."
      },
      "note": "전치사 뒤 동사 → -ing. decide·plan·agree → to + 동사원형."
    },
    {
      "id": "g2",
      "title": "앞 절 전체를 받는 , which",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s7",
      "highlight": [
        ", which was"
      ],
      "explanation": "콤마 뒤의 which는 바로 앞 명사가 아니라 앞 문장 전체 내용을 가리킬 수 있다. 이때 동사는 단수(was).",
      "example": {
        "en": "He finished early, which surprised everyone.",
        "ko": "그는 일찍 끝냈는데, 그것이 모두를 놀라게 했다."
      },
      "note": "that은 콤마 뒤(계속적 용법)에 쓸 수 없다."
    },
    {
      "id": "g3",
      "title": "have to의 과거 had to",
      "tags": [
        "조동사"
      ],
      "sentenceId": "s10",
      "highlight": [
        "had to call"
      ],
      "explanation": "had to + 동사원형은 '~해야 했다'(과거의 의무). must는 과거형이 없어서 had to를 쓴다.",
      "example": {
        "en": "We had to wait for an hour.",
        "ko": "우리는 한 시간을 기다려야 했다."
      },
      "note": "had to + 동사원형 = ~해야 했다."
    }
  ],
