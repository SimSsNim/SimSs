  "grammar": [
    {
      "title": "계속적 용법 관계대명사 which",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s7",
      "highlight": [
        ", which replaced"
      ],
      "explanation": "콤마 + which는 앞 명사(사물)에 정보를 덧붙인다. which 다음에 주어가 없고 바로 동사 replaced가 오므로 which가 주어 역할을 한다.",
      "example": {
        "en": "We moved to a new office, which is near the station.",
        "ko": "우리는 새 사무실로 옮겼는데, 그곳은 역 근처다."
      },
      "note": "콤마 뒤에는 that을 쓸 수 없다. 사물이면 which, 사람이면 who.",
      "id": "g1"
    },
    {
      "title": "such as로 예 들기",
      "tags": [
        "전치사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "such as equipment, travel, and training"
      ],
      "explanation": "such as(~와 같은)는 앞에 나온 말의 예를 명사로 나열할 때 쓴다. 뒤에는 명사(구)가 온다.",
      "example": {
        "en": "We sell office supplies such as pens and paper.",
        "ko": "우리는 펜, 종이 같은 사무용품을 판다."
      },
      "note": "such as 뒤 = 명사. so that 뒤 = 주어 + 동사.",
      "id": "g2"
    },
    {
      "title": "조동사 + 부사 + 동사원형",
      "tags": [
        "어순"
      ],
      "sentenceId": "s10",
      "highlight": [
        "will carefully review"
      ],
      "explanation": "부사는 조동사(will)와 동사원형(review) 사이에 들어갈 수 있다. 이때 부사는 동사를 꾸민다.",
      "example": {
        "en": "The team will quickly fix the problem.",
        "ko": "팀이 문제를 빠르게 고칠 것이다."
      },
      "note": "will ___ review 처럼 조동사와 동사 사이 빈칸은 부사 자리.",
      "id": "g3"
    }
  ],
