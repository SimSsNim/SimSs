  "grammar": [
    {
      "id": "g1",
      "title": "시간 접속사 while + 진행형",
      "tags": [
        "접속사",
        "시제"
      ],
      "sentenceId": "s1",
      "highlight": [
        "while I was attending"
      ],
      "explanation": "while은 '~하는 동안'. 같은 시간에 계속되던 일을 말할 때 과거진행(was attending)과 자주 쓴다.",
      "example": {
        "en": "I read a book while I was waiting for the bus.",
        "ko": "버스를 기다리는 동안 책을 읽었다."
      },
      "note": "while 뒤에는 주어 + 동사(절), during 뒤에는 명사"
    },
    {
      "id": "g2",
      "title": "전치사 during + 명사",
      "tags": [
        "전치사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "during my entire stay"
      ],
      "explanation": "during 뒤에는 기간을 나타내는 명사(my entire stay)가 온다.",
      "example": {
        "en": "Please turn off your phone during the movie.",
        "ko": "영화 상영 중에는 휴대폰을 꺼 주세요."
      },
      "note": "빈칸 뒤 명사만 → during, 주어+동사 → while"
    },
    {
      "id": "g3",
      "title": "recommend A to B",
      "tags": [
        "어휘"
      ],
      "sentenceId": "s9",
      "highlight": [
        "recommend the Harborview Hotel to other business travelers"
      ],
      "explanation": "recommend + 추천하는 것 + to + 사람 = B에게 A를 추천하다.",
      "example": {
        "en": "She recommended the book to her friends.",
        "ko": "그녀는 친구들에게 그 책을 추천했다."
      },
      "note": "recommend 뒤 사람에는 to를 붙인다"
    }
  ],
