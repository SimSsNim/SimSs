  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "Why did Mr. Ortiz write the review?",
      "evidenceSentenceIds": [
        "s1",
        "s9"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To complain about a convention center"
        },
        {
          "key": "B",
          "text": "To describe a recent hotel stay"
        },
        {
          "key": "C",
          "text": "To apply for a job at a hotel"
        },
        {
          "key": "D",
          "text": "To advertise a trade show"
        }
      ],
      "answer": "B",
      "explanationKo": "첫 문장에서 지난달 호텔에 3박 묵었다고 하고, 방·직원·조식·문제점을 차례로 평가한 뒤 추천으로 끝난다. stayed ... last month → a recent hotel stay.",
      "choiceNotesKo": {
        "A": "컨벤션 센터는 호텔과 가깝다는 장점으로만 나온다.",
        "D": "무역 박람회는 그가 도시에 간 이유일 뿐 광고하는 대상이 아니다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "Why was Mr. Ortiz in the city?",
      "evidenceSentenceIds": [
        "s1"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To visit family members"
        },
        {
          "key": "B",
          "text": "To repair a fitness center"
        },
        {
          "key": "C",
          "text": "To go on vacation"
        },
        {
          "key": "D",
          "text": "To attend an industry event"
        }
      ],
      "answer": "D",
      "explanationKo": "while I was attending a trade show(무역 박람회에 참석하는 동안)라고 했다. trade show → an industry event로 바꿔 말했다.",
      "choiceNotesKo": {
        "B": "피트니스 센터를 수리한 것은 호텔 쪽이다.",
        "C": "마지막에 business travelers(출장자)에게 추천하므로 휴가가 아니다."
      },
      "skill": "세부 사항(패러프레이징)"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-not-true",
      "prompt": "What is NOT mentioned about the Harborview Hotel?",
