  "grammar": [
    {
      "id": "g1",
      "title": "If 생략 도치: Should + 주어 + 동사원형",
      "tags": [
        "도치",
        "가정법"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Should an item arrive"
      ],
      "explanation": "If an item should arrive ~에서 If를 빼고 Should를 주어 앞으로 보낸 형태. '혹시 ~하면'이라는 뜻이며 주절에는 명령문이 자주 온다.",
      "example": {
        "en": "Should you need assistance, please call the front desk.",
        "ko": "도움이 필요하시면 프런트로 전화해 주세요."
      },
      "note": "문장 첫 빈칸 + 주어 + 동사원형 → Should."
    },
    {
      "id": "g2",
      "title": "동명사의 의미상 주어",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "our receiving"
      ],
      "explanation": "동명사 앞의 소유격(our, his, the company's)은 그 동작을 하는 사람을 나타낸다. our receiving the item = 우리가 상품을 받는 것.",
      "example": {
        "en": "We appreciate your responding so quickly.",
        "ko": "빨리 답해 주셔서 감사합니다."
      },
      "note": "소유격 + -ing → 의미상 주어 + 동명사."
    },
    {
      "id": "g3",
      "title": "make + 목적어 + 비교급 형용사",
      "tags": [
        "비교"
      ],
      "sentenceId": "s10",
      "highlight": [
        "make returning items simpler and faster"
      ],
      "explanation": "make A B(형용사)는 'A를 B하게 만들다'. 목적어 자리의 returning items는 동명사구, 보어는 비교급 형용사 두 개.",
      "example": {
        "en": "The new layout makes the store easier to navigate.",
        "ko": "새 배치 덕분에 매장을 둘러보기가 더 쉬워졌다."
      },
      "note": "make + 목적어 뒤 빈칸 → 부사가 아니라 형용사."
    }
  ],
