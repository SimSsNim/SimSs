  "grammar": [
    {
      "id": "g1",
      "title": "접속사 while vs 전치사 during",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "while the floors are resurfaced"
      ],
      "explanation": "while은 접속사라 뒤에 주어 + 동사가 오고, during은 전치사라 뒤에 명사(구)가 온다. 다음 문장의 During this period와 비교해 보자.",
      "example": {
        "en": "Please wait in the lobby while your room is being cleaned.",
        "ko": "객실이 청소되는 동안 로비에서 기다려 주세요."
      },
      "note": "빈칸 뒤에 '주어 + 동사'가 있으면 while, 명사만 있으면 during."
    },
    {
      "id": "g2",
      "title": "명사를 뒤에서 꾸미는 현재분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "any vehicles remaining in the garage"
      ],
      "explanation": "remaining in the garage가 앞의 vehicles를 꾸민다(= vehicles that remain in the garage). remain은 자동사라 수동형(remained)으로 명사를 꾸미지 않는다.",
      "example": {
        "en": "Customers waiting in line will receive a free drink.",
        "ko": "줄을 서서 기다리는 손님은 무료 음료를 받는다."
      },
      "note": "문장에 동사가 이미 있으면 빈칸은 분사 자리. 자동사는 현재분사(-ing)."
    },
    {
      "id": "g3",
      "title": "소유격 뒤 명사 자리",
      "tags": [
        "품사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "at the owner's expense"
      ],
      "explanation": "소유격(the owner's) 뒤에는 명사가 온다. at one's expense는 '~의 비용으로'라는 고정 표현이다.",
      "example": {
        "en": "The hotel replaced the broken lamp at its own expense.",
        "ko": "호텔은 자체 비용으로 고장 난 램프를 교체했다."
      },
      "note": "소유격 + _ → 명사. expense(명사) / expensive(형용사) 구별."
    }
  ],
