  "grammar": [
    {
      "id": "g1",
      "title": "현재완료 has + p.p. + since",
      "tags": [
        "시제"
      ],
      "sentenceId": "s7",
      "highlight": [
        "has worked",
        "since 2019"
      ],
      "explanation": "과거(2019년)에 시작해 지금까지 계속되는 일은 현재완료 has worked. since + 시작 시점이 단서.",
      "example": {
        "en": "She has lived in Seoul since 2020.",
        "ko": "그녀는 2020년부터 서울에 살고 있다."
      },
      "note": "since + 과거 시점 → 빈칸은 have/has + p.p."
    },
    {
      "id": "g2",
      "title": "접속사 because vs 전치사 because of",
      "tags": [
        "접속사",
        "전치사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "because the weather was too cold"
      ],
      "explanation": "because 뒤에는 주어+동사가 있는 절, because of 뒤에는 명사(구)가 온다.",
      "example": {
        "en": "The game was canceled because of the rain.",
        "ko": "비 때문에 경기가 취소되었다."
      },
      "note": "빈칸 뒤에 동사가 보이면 접속사, 명사만 있으면 전치사."
    },
    {
      "id": "g3",
      "title": "기한의 전치사 by",
      "tags": [
        "전치사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "by Friday, November 27"
      ],
      "explanation": "by + 시점 = '~까지(마감)'. 제출·완료 동사(submit, finish)와 자주 쓰인다.",
      "example": {
        "en": "Please return the form by Monday.",
        "ko": "월요일까지 양식을 돌려주세요."
      },
      "note": "submit/complete + 빈칸 + 날짜 → by"
    }
  ],
