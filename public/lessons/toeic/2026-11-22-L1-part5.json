  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Park 씨는 영업 회의에서 매우 인상적인 발표를 했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "배달 트럭은 어제 오후 늦게 창고에 도착했다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "저희 기술자들은 모든 고객 불만에 빠르게 대응합니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "출장 경비 보고서를 11월 27일 금요일까지 제출해 주세요."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "관리자는 모든 직원에게 새 안전 수칙을 따르라고 요청했다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "그 회사는 지난주 한 지역 병원으로부터 큰 금액을 지급받았다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "Lee 씨는 2019년부터 Bright Star Foods에서 일해 왔다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "날씨가 너무 추워서 야유회는 실내로 옮겨졌다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "모든 방문객은 건물 안에서 이름표를 착용해야 한다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "고객은 구매 후 30일 이내에 전액 환불을 받을 수 있다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Ms. Park gave a very impressive presentation at the sales meeting.",
      "ko": "Park 씨는 영업 회의에서 매우 인상적인 발표를 했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The delivery truck arrived at the warehouse late yesterday afternoon.",
      "ko": "배달 트럭은 어제 오후 늦게 창고에 도착했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Our technicians respond quickly to all customer complaints.",
      "ko": "저희 기술자들은 모든 고객 불만에 빠르게 대응합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Please submit your travel expense report by Friday, November 27.",
      "ko": "출장 경비 보고서를 11월 27일 금요일까지 제출해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The manager asked all employees to follow the new safety rules.",
      "ko": "관리자는 모든 직원에게 새 안전 수칙을 따르라고 요청했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The company received a large payment from a local hospital last week.",
      "ko": "그 회사는 지난주 한 지역 병원으로부터 큰 금액을 지급받았다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Mr. Lee has worked at Bright Star Foods since 2019.",
      "ko": "Lee 씨는 2019년부터 Bright Star Foods에서 일해 왔다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "The picnic was moved indoors because the weather was too cold.",
      "ko": "날씨가 너무 추워서 야유회는 실내로 옮겨졌다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "All visitors must wear their name tags inside the building.",
      "ko": "모든 방문객은 건물 안에서 이름표를 착용해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Customers can receive a full refund within 30 days of purchase.",
      "ko": "고객은 구매 후 30일 이내에 전액 환불을 받을 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
