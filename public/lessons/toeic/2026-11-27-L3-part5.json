  "structures": [
    {
      "id": "st1",
      "sentenceId": "s4",
      "chunks": [
        {
          "text": "Customers",
          "role": "S",
          "ko": "고객들은"
        },
        {
          "text": "interested in joining the loyalty program",
          "role": "M",
          "ko": "보상 프로그램 가입에 관심 있는"
        },
        {
          "text": "can sign up",
          "role": "V",
          "ko": "등록할 수 있다"
        },
        {
          "text": "at any of our branches.",
          "role": "M",
          "ko": "저희 어느 지점에서나"
        }
      ],
      "skeleton": "S + (p.p. 수식어구) + V + M",
      "explanation": "과거분사구 interested in ~이 뒤에서 Customers를 꾸민다. Customers who are interested in ~에서 who are가 빠진 형태."
    },
    {
      "id": "st2",
      "sentenceId": "s7",
      "chunks": [
        {
          "text": "Since",
          "role": "CONJ",
          "ko": "~ 때문에"
        },
        {
          "text": "the conference room",
          "role": "S",
          "ko": "회의실이",
          "sub": true
        },
        {
          "text": "is being repainted,",
          "role": "V",
          "ko": "다시 칠해지는 중이다",
          "sub": true
        },
        {
          "text": "the weekly staff meeting",
          "role": "S",
          "ko": "주간 직원 회의는"
        },
        {
          "text": "will be held",
          "role": "V",
          "ko": "열릴 것이다"
        },
        {
          "text": "in the cafeteria.",
          "role": "M",
          "ko": "구내식당에서"
        }
      ],
      "skeleton": "Since + S + V(진행 수동), S + V(미래 수동) + M",
      "explanation": "Since는 '~ 때문에'라는 이유의 접속사. 종속절은 진행형 수동태(is being p.p.), 주절은 미래 수동태(will be p.p.)이다."
    }
  ],
  "grammar": [
    {
      "id": "g1",
      "title": "분사구문 (능동: -ing)",
      "tags": [
        "분사구문"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Examining the budget report carefully"
      ],
      "explanation": "주절의 주어 Mr. Patel이 보고서를 '검토하는' 능동 관계이므로 현재분사 Examining으로 시작한다. While he was examining ~을 줄인 형태.",
      "example": {
        "en": "Leaving the office, she remembered her umbrella.",
        "ko": "사무실을 나서다가 그녀는 우산이 생각났다."
      },
      "note": "분사구문 빈칸: 뒤에 목적어(the budget report)가 있으면 -ing, 없으면 p.p.를 먼저 의심한다."
    },
    {
      "id": "g2",
      "title": "가정법 과거완료",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s6",
      "highlight": [
        "had arrived",
        "would have sold"
      ],
      "explanation": "If + S + had p.p., S + would have p.p.는 과거 사실과 반대되는 가정(실제로는 늦게 도착해서 못 팔았다)을 나타낸다.",
      "example": {
        "en": "If we had left earlier, we would have caught the train.",
        "ko": "더 일찍 출발했더라면 기차를 탔을 것이다."
      },
      "note": "If절에 had p.p.가 보이면 주절은 would/could/might have p.p."
    },
    {
      "id": "g3",
      "title": "분사의 후치 수식",
      "tags": [
        "분사",
        "관계사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Customers interested in"
      ],
      "explanation": "분사가 다른 말(in joining ~)을 달고 길어지면 명사 뒤에서 꾸민다. interested는 '관심을 갖게 된' 수동 의미의 과거분사.",
      "example": {
        "en": "Employees invited to the dinner should reply by Friday.",
        "ko": "만찬에 초대받은 직원은 금요일까지 답해야 한다."
      },
      "note": "사람이 관심을 가질 때는 interested, 사물이 흥미로울 때는 interesting."
    }
  ],
