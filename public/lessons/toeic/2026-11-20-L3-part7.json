  "grammar": [
    {
      "id": "g1",
      "title": "현재완료 + for 기간",
      "tags": [
        "시제"
      ],
      "sentenceId": "s4",
      "highlight": [
        "For more than fifteen years",
        "have prepared"
      ],
      "explanation": "과거에 시작해 지금까지 이어지는 일은 for + 기간과 함께 현재완료(have p.p.)로 나타낸다.",
      "example": {
        "en": "We have served this town for ten years.",
        "ko": "우리는 10년 동안 이 동네에서 영업해 왔다."
      },
      "note": "for + 기간, since + 시점이 보이면 현재완료를 먼저 떠올린다."
    },
    {
      "id": "g2",
      "title": "명사를 뒤에서 꾸미는 과거분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "herbs grown on local farms"
      ],
      "explanation": "채소와 허브는 농장에서 '길러진' 것이므로 과거분사 grown이 뒤에서 꾸민다.",
      "example": {
        "en": "We sell bread baked every morning.",
        "ko": "우리는 매일 아침 구운 빵을 판다."
      },
      "note": "명사 + p.p. + 전치사구: '~된 명사'."
    },
    {
      "id": "g3",
      "title": "let + 목적어 + 동사원형",
      "tags": [
        "기타"
      ],
      "sentenceId": "s3",
      "highlight": [
        "Let Marigold Kitchen take care of"
      ],
      "explanation": "사역동사 let은 목적어 뒤에 동사원형을 쓴다. so that you can ~은 '~할 수 있도록'이라는 목적을 나타낸다.",
      "example": {
        "en": "Let our staff carry your bags.",
        "ko": "가방은 저희 직원이 들도록 맡기세요."
      },
      "note": "let/make/have + O + 동사원형. to부정사를 넣지 않는다."
    }
  ],
