      "type": "part7-purpose",
      "prompt": "Why did Ms. Lindqvist send the e-mail?",
      "evidenceSentenceIds": [
        "s7",
        "s8"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To confirm that a payment has been received"
        },
        {
          "key": "B",
          "text": "To report that part of an order will be late"
        },
        {
          "key": "C",
          "text": "To promote a new line of kitchen equipment"
        },
        {
          "key": "D",
          "text": "To request information about a restaurant"
        }
      ],
      "answer": "B",
      "explanationKo": "'오븐이 약속한 4월 15일에 도착하지 못한다'(will not arrive on April 15)를 알리려고 쓴 글이다. 주문 일부(오븐)가 늦어진다고 바꿔 말한 B가 정답.",
      "choiceNotesKo": {
        "C": "새 제품 홍보가 아니라 이미 주문한 제품의 지연 안내다."
      },
      "skill": "목적 찾기"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What does Ms. Lindqvist offer to do for Mr. Bellini?",
      "evidenceSentenceIds": [
