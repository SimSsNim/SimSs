  "grammar": [
    {
      "id": "g1",
      "title": "현재완료 수동태 has been p.p.",
      "tags": [
        "시제",
        "수동태"
      ],
      "sentenceId": "s8",
      "highlight": [
        "has been temporarily suspended"
      ],
      "explanation": "생산은 '중단되는' 대상이라 수동태이고, 과거에 중단되어 지금도 멈춰 있다는 뜻이라 현재완료. 부사(temporarily)는 been과 p.p. 사이에 들어간다.",
      "example": {
        "en": "The event has been postponed until further notice.",
        "ko": "행사는 추후 공지가 있을 때까지 연기되었다."
      },
      "note": "has been + 부사 + p.p. 형태에서 빈칸이면 부사 자리."
    },
    {
      "id": "g2",
      "title": "앞 절 전체를 받는 , which",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s9",
      "highlight": [
        ", which means"
      ],
      "explanation": "콤마 뒤 which는 바로 앞 명사가 아니라 앞 문장 내용 전체(4월 24일까지 출고된다는 것)를 가리킬 수 있다. 이때 동사는 단수(means).",
      "example": {
        "en": "The flight was canceled, which caused a lot of confusion.",
        "ko": "항공편이 취소되었고, 그 때문에 큰 혼란이 생겼다."
      },
      "note": "콤마 뒤 관계사 자리에 that은 쓸 수 없다."
    },
    {
      "id": "g3",
      "title": "시간 접속사 Until·as soon as + 현재 시제",
      "tags": [
        "접속사",
        "부사절"
      ],
      "sentenceId": "s13",
      "highlight": [
        "Until your ovens arrive"
      ],
      "explanation": "Until(~할 때까지), as soon as(~하자마자) 같은 시간 접속사 뒤에서는 미래의 일도 현재 시제로 쓴다. arrive, is confirmed가 그 예.",
      "example": {
        "en": "Please wait here until your name is called.",
        "ko": "이름이 불릴 때까지 여기서 기다려 주세요."
      },
      "note": "시간 부사절 안에 will이 있는 보기는 오답."
    }
  ],
