  "grammar": [
    {
      "id": "g1",
      "title": "현재완료 수동태와 미래 수동태",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s3",
      "highlight": [
        "have been booked",
        "will be sent"
      ],
      "explanation": "have been p.p.는 '(이미) ~되었다', will be p.p.는 '(앞으로) ~될 것이다'라는 뜻이다. 주어가 동작을 받는 쪽이면 수동태를 쓰고, 시간 표현(by the end of this week)으로 시제를 정한다.",
      "example": {
        "en": "The invitations have been printed and will be mailed tomorrow.",
        "ko": "초대장이 인쇄되었고 내일 발송될 것이다."
      },
      "note": "사물 주어 + 빈칸 + to 사람 → 수동태. 미래 시간 표현이 있으면 will be p.p."
    },
    {
      "id": "g2",
      "title": "계속적 용법의 관계대명사 which",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        ", which is located"
      ],
      "explanation": "콤마 + which는 앞의 사물(장소 포함)에 정보를 덧붙인다. 뒤에 주어가 빠진 불완전한 절이 오면 which, 완전한 절이 오면 where를 쓴다.",
      "example": {
        "en": "We met at the Lindon Café, which opens early.",
        "ko": "우리는 린던 카페에서 만났는데, 그곳은 일찍 문을 연다."
      },
      "note": "장소 명사 뒤라도 바로 동사가 오면(주어 빠짐) where가 아니라 which."
    },
    {
      "id": "g3",
      "title": "부사 자리 (동사구 수식)",
      "tags": [
        "품사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "let me know immediately"
      ],
      "explanation": "let me know(알려 주다)라는 동사구 뒤에서 '즉시'라고 꾸미는 말은 부사다. 문장 성분이 다 갖춰진 뒤 남는 자리는 부사 자리인 경우가 많다.",
      "example": {
        "en": "Please reply promptly.",
        "ko": "빨리 답장해 주세요."
      },
      "note": "필수 성분이 다 있는 문장의 빈칸 → 부사."
    }
  ],
