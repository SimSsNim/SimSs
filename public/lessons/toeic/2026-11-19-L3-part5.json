  "grammar": [
    {
      "id": "g1",
      "title": "가정법 과거완료",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s6",
      "highlight": [
        "had hired",
        "would have handled"
      ],
      "explanation": "과거에 일어나지 않은 일을 가정할 때 If + had p.p., 주절은 would/could have p.p.를 쓴다. 실제로는 기사를 더 뽑지 않았다는 뜻.",
      "example": {
        "en": "If we had left earlier, we would have caught the train.",
        "ko": "더 일찍 출발했더라면 기차를 탔을 것이다."
      },
      "note": "if절에 had p.p.가 보이면 주절 빈칸은 would have p.p."
    },
    {
      "id": "g2",
      "title": "수동 분사구문",
      "tags": [
        "분사구문",
        "분사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Encouraged by"
      ],
      "explanation": "분사구문의 주어는 주절 주어와 같다. 식당이 '격려받은' 것이므로 과거분사 Encouraged. 뒤에 by가 오면 수동의 강한 단서.",
      "example": {
        "en": "Impressed by her résumé, the manager called her the same day.",
        "ko": "이력서에 감명을 받아 매니저는 당일 그녀에게 전화했다."
      },
      "note": "빈칸 + by + 명사, 콤마 → 과거분사(p.p.)로 시작하는 분사구문."
    },
    {
      "id": "g3",
      "title": "전치사 before + 동명사",
      "tags": [
        "전치사",
        "동명사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "before signing it"
      ],
      "explanation": "before는 전치사로도 쓰여 뒤에 동명사(-ing)가 올 수 있다. 서명하는 일은 아직 일어나지 않았으므로 '~하기 전에'가 자연스럽다.",
      "example": {
        "en": "Turn off the lights before leaving the office.",
        "ko": "사무실을 나가기 전에 불을 꺼 주세요."
      },
      "note": "before/after + -ing는 시간 순서를, during은 명사(기간)를 받는다."
    }
  ],
