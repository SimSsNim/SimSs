  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "새로 온 접수 담당자는 안내 데스크에서 항상 방문객을 따뜻하게 맞이한다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "로페즈 씨는 2주 전에 영업 회의를 위해 호텔 방을 예약했다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "매니저는 새 안전 규칙에 대해 짧게 설명했다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "난방 시스템 수리가 필요해서 사무실은 월요일에 문을 닫는다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "고객들은 온라인 주문 시스템이 매우 편리하다고 말한다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "회의실은 매일 저녁 건물 직원들이 청소한다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "월말까지 경비 보고서를 제출해 주세요."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "파크 스트리트에 있는 그 식당은 다양한 디저트를 제공한다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "첸 씨가 내일 아침 신입 사원 교육을 진행할 것이다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "물건을 반품해야 할 경우를 대비해 영수증을 보관해 주세요."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The new receptionist always greets visitors warmly at the front desk.",
      "ko": "새로 온 접수 담당자는 안내 데스크에서 항상 방문객을 따뜻하게 맞이한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Mr. Lopez booked a hotel room for the sales conference two weeks ago.",
      "ko": "로페즈 씨는 2주 전에 영업 회의를 위해 호텔 방을 예약했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The manager gave a short explanation of the new safety rules.",
      "ko": "매니저는 새 안전 규칙에 대해 짧게 설명했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "The office will be closed on Monday because the heating system needs repairs.",
      "ko": "난방 시스템 수리가 필요해서 사무실은 월요일에 문을 닫는다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Our customers say that the online ordering system is very convenient.",
      "ko": "고객들은 온라인 주문 시스템이 매우 편리하다고 말한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The meeting room is cleaned every evening by the building staff.",
      "ko": "회의실은 매일 저녁 건물 직원들이 청소한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Please submit your expense reports by the end of the month.",
      "ko": "월말까지 경비 보고서를 제출해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "The restaurant on Park Street offers a large selection of desserts.",
      "ko": "파크 스트리트에 있는 그 식당은 다양한 디저트를 제공한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Ms. Chen will lead the training session for new employees tomorrow morning.",
      "ko": "첸 씨가 내일 아침 신입 사원 교육을 진행할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Please keep your receipt in case you need to return the item.",
      "ko": "물건을 반품해야 할 경우를 대비해 영수증을 보관해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
