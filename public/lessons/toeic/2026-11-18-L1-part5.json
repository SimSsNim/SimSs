  "grammar": [
    {
      "id": "g1",
      "title": "부사 자리: 동사 + 목적어 뒤",
      "tags": [
        "품사"
      ],
      "sentenceId": "s1",
      "highlight": [
        "greets visitors warmly"
      ],
      "explanation": "warmly는 동사 greets를 꾸미는 부사. '동사 + 목적어' 뒤에 오는 빈칸은 부사 자리다.",
      "example": {
        "en": "She spoke slowly and clearly.",
        "ko": "그녀는 천천히 또렷하게 말했다."
      },
      "note": "완전한 문장 뒤 빈칸 → -ly 부사."
    },
    {
      "id": "g2",
      "title": "수동태: be + p.p. + by",
      "tags": [
        "수동태"
      ],
      "sentenceId": "s6",
      "highlight": [
        "is cleaned",
        "by the building staff"
      ],
      "explanation": "주어(회의실)가 청소를 '받는' 쪽이므로 be + 과거분사. by 뒤에 행동하는 사람이 온다.",
      "example": {
        "en": "The letters are sent by the office manager.",
        "ko": "편지는 사무실 관리자가 보낸다."
      },
      "note": "빈칸 뒤에 목적어가 없고 by ~가 있으면 수동태."
    },
    {
      "id": "g3",
      "title": "미래 시제: will + 동사원형",
      "tags": [
        "시제"
      ],
      "sentenceId": "s9",
      "highlight": [
        "will lead",
        "tomorrow morning"
      ],
      "explanation": "tomorrow(내일) 같은 미래 표현이 있으면 will + 동사원형을 쓴다.",
      "example": {
        "en": "We will meet the client next week.",
        "ko": "우리는 다음 주에 고객을 만날 것이다."
      },
      "note": "tomorrow, next week, soon → 미래 시제 단서."
    }
  ],
