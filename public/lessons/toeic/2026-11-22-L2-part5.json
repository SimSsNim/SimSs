  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "마케팅팀은 새 스포츠음료를 위한 효과적인 광고 캠페인을 만들었다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "모든 고객 주문은 결제 후 영업일 기준 이틀 안에 처리된다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "지난달 개조된 회의실은 이제 최대 50명까지 수용할 수 있다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "직원들은 특별 허가가 없으면 서버실에 들어갈 수 없다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "새 회계 소프트웨어는 놀라울 만큼 설치하고 쓰기 쉽다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "Tanaka 씨는 연말에 자리에서 물러나기로 결정했다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "방문객은 보안 데스크에서 적절한 신분증을 제시해야 한다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "그 매장의 가격은 연휴 기간 내내 그대로 유지될 것이다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "그 항공사는 항공편이 3시간 넘게 지연된 승객들에게 보상할 것이다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "구매 증빙으로 영수증을 보관해 주세요."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The marketing team created an effective advertising campaign for the new sports drink.",
      "ko": "마케팅팀은 새 스포츠음료를 위한 효과적인 광고 캠페인을 만들었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "All customer orders are processed within two business days of payment.",
      "ko": "모든 고객 주문은 결제 후 영업일 기준 이틀 안에 처리된다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The conference room, which was renovated last month, can now hold up to fifty people.",
      "ko": "지난달 개조된 회의실은 이제 최대 50명까지 수용할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Employees cannot enter the server room unless they have special permission.",
      "ko": "직원들은 특별 허가가 없으면 서버실에 들어갈 수 없다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The new accounting software is surprisingly easy to install and use.",
      "ko": "새 회계 소프트웨어는 놀라울 만큼 설치하고 쓰기 쉽다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Ms. Tanaka has decided to leave her position at the end of the year.",
      "ko": "Tanaka 씨는 연말에 자리에서 물러나기로 결정했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Visitors must show proper identification at the security desk.",
      "ko": "방문객은 보안 데스크에서 적절한 신분증을 제시해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Prices at the store will stay the same throughout the holiday season.",
      "ko": "그 매장의 가격은 연휴 기간 내내 그대로 유지될 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The airline will compensate passengers whose flights are delayed by more than three hours.",
      "ko": "그 항공사는 항공편이 3시간 넘게 지연된 승객들에게 보상할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Please keep your receipt as proof of purchase.",
      "ko": "구매 증빙으로 영수증을 보관해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
