  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "연례 직원 야유회"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5"
      ],
      "ko": "올해 직원 야유회는 6월 7일 토요일 Lakeview 공원에서 열립니다. 모든 직원과 가족을 초대합니다. 회사가 모두를 위해 점심, 음료, 야외 게임을 제공합니다. 아이들을 위한 페이스 페인팅 특별 공간도 마련됩니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s6",
        "s7"
      ],
      "ko": "무료 버스가 하루 종일 본사에서 공원까지 운행합니다. 버스를 이용할 계획이라면 5월 30일까지 담당 매니저에게 알려 주세요."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s8",
        "s9"
      ],
      "ko": "비가 오면 야유회는 회사 구내식당으로 옮겨집니다. 함께 멋진 하루를 보내기를 기대합니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s10"
      ],
      "ko": "인사부"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Annual Staff Picnic",
      "ko": "연례 직원 야유회",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "This year's staff picnic will be held on Saturday, June 7, at Lakeview Park.",
      "ko": "올해 직원 야유회는 6월 7일 토요일 Lakeview 공원에서 열립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "All employees and their families are invited.",
      "ko": "모든 직원과 가족을 초대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "The company will provide lunch, drinks, and outdoor games for everyone.",
      "ko": "회사가 모두를 위해 점심, 음료, 야외 게임을 제공합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "There will also be a special area with face painting for children.",
      "ko": "아이들을 위한 페이스 페인팅 특별 공간도 마련됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "Free buses will run from the main office to the park throughout the day.",
      "ko": "무료 버스가 하루 종일 본사에서 공원까지 운행합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "If you plan to take a bus, please inform your manager by May 30.",
      "ko": "버스를 이용할 계획이라면 5월 30일까지 담당 매니저에게 알려 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p4",
      "en": "In case of rain, the picnic will be moved to the company cafeteria.",
      "ko": "비가 오면 야유회는 회사 구내식당으로 옮겨집니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "We look forward to spending a wonderful day together.",
      "ko": "함께 멋진 하루를 보내기를 기대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p5",
      "en": "Human Resources Department",
      "ko": "인사부",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
