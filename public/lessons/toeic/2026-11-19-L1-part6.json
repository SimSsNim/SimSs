  "grammar": [
    {
      "id": "g1",
      "title": "Until now + 현재완료",
      "tags": [
        "시제"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Until now",
        "has placed"
      ],
      "explanation": "'지금까지 계속 ~해 왔다'는 현재완료(have/has + 과거분사)로 나타낸다. Until now, so far 같은 표현과 자주 함께 쓴다.",
      "example": {
        "en": "So far, we have received ten orders.",
        "ko": "지금까지 우리는 주문 10건을 받았다."
      },
      "note": "Until now / so far / since → 현재완료."
    },
    {
      "id": "g2",
      "title": "명사를 뒤에서 꾸미는 과거분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "Orders received by Wednesday"
      ],
      "explanation": "received by Wednesday가 앞의 명사 Orders를 뒤에서 꾸민다. '수요일까지 받은 주문'이라는 수동의 뜻.",
      "example": {
        "en": "The photos taken at the event are online.",
        "ko": "행사에서 찍은 사진들이 온라인에 있다."
      },
      "note": "명사 + p.p. + 수식어 → 문장의 진짜 동사는 그 뒤에 있다."
    },
    {
      "id": "g3",
      "title": "전치사 within",
