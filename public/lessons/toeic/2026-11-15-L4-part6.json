  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "받는 사람: 프리야 라만"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "보낸 사람: 토마스 에크베리"
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "날짜: 3월 3일"
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "제목: 2월 청구서 정정"
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "라만 씨께,"
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6",
        "s7",
        "s8",
        "s9",
        "s10"
      ],
      "ko": "2월 청구서의 불일치 사항을 알려 주셔서 감사합니다. 계정을 검토해 보니 귀하의 팀에 계약서에 명시된 12개가 아니라 20개의 사용자 라이선스 요금이 청구된 것을 확인했습니다. 이 오류는 자동 갱신이 작년에 귀하의 요금제에 적용된 변경 사항을 덮어쓰면서 발생했습니다. 이후 재발을 막기 위해 귀하의 계정에서 자동 갱신 기능을 해제했습니다. 아울러 340달러가 귀하의 계정에 적립되었으며 3월 명세서에 반영될 것입니다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s11",
        "s12",
        "s13"
      ],
      "ko": "정정된 2월 청구서 사본을 보관용으로 첨부합니다. 이로 인해 혼란을 드렸을 수 있는 점 진심으로 유감스럽게 생각합니다. 다른 이상한 점을 발견하시면 주저하지 말고 저에게 직접 연락해 주십시오."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s14"
      ],
      "ko": "감사합니다,"
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s15"
      ],
      "ko": "토마스 에크베리, 고객 계정 관리자, 벨로란 소프트웨어"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "To: Priya Raman",
      "ko": "받는 사람: 프리야 라만",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "From: Tomas Ekberg",
      "ko": "보낸 사람: 토마스 에크베리",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Date: March 3",
      "ko": "날짜: 3월 3일",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Subject: Correction to Your February Invoice",
      "ko": "제목: 2월 청구서 정정",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Dear Ms. Raman,",
      "ko": "라만 씨께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Thank you for bringing the discrepancy in your February invoice to our attention.",
      "ko": "2월 청구서의 불일치 사항을 알려 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p6",
      "en": "Upon reviewing your account, we found that your team was charged for twenty user licenses rather than the twelve specified in your contract.",
      "ko": "계정을 검토해 보니 귀하의 팀에 계약서에 명시된 12개가 아니라 20개의 사용자 라이선스 요금이 청구된 것을 확인했습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p6",
      "en": "The error occurred when an automatic renewal overwrote the changes made to your plan last year.",
      "ko": "이 오류는 자동 갱신이 작년에 귀하의 요금제에 적용된 변경 사항을 덮어쓰면서 발생했습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p6",
      "en": "We have since disabled automatic renewals on your account to prevent a recurrence.",
      "ko": "이후 재발을 막기 위해 귀하의 계정에서 자동 갱신 기능을 해제했습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p6",
      "en": "In addition, a credit of $340 has been applied to your account and will be reflected on your March statement.",
      "ko": "아울러 340달러가 귀하의 계정에 적립되었으며 3월 명세서에 반영될 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p7",
      "en": "A corrected copy of your February invoice is attached for your records.",
      "ko": "정정된 2월 청구서 사본을 보관용으로 첨부합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p7",
      "en": "We sincerely regret any confusion this may have caused.",
      "ko": "이로 인해 혼란을 드렸을 수 있는 점 진심으로 유감스럽게 생각합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s13",
      "paragraphId": "p7",
      "en": "If you notice any other irregularities, please do not hesitate to contact me directly.",
      "ko": "다른 이상한 점을 발견하시면 주저하지 말고 저에게 직접 연락해 주십시오.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s14",
      "paragraphId": "p8",
      "en": "Best regards,",
      "ko": "감사합니다,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s15",
      "paragraphId": "p9",
      "en": "Tomas Ekberg, Customer Accounts Manager, Veloran Software",
      "ko": "토마스 에크베리, 고객 계정 관리자, 벨로란 소프트웨어",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
