  "grammar": [
    {
      "id": "g1",
      "title": "명사를 뒤에서 꾸미는 과거분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "the twelve specified in your contract"
      ],
      "explanation": "specified in your contract가 the twelve (licenses)를 꾸민다. 라이선스 수는 계약서에 '명시되는' 대상이라 과거분사를 쓴다. 뒤에 목적어가 없다는 점도 단서.",
      "example": {
        "en": "Please follow the steps described in the manual.",
        "ko": "설명서에 나와 있는 단계를 따라 주세요."
      },
      "note": "명사 + _ + in/by ~ (목적어 없음) → 과거분사."
    },
    {
      "id": "g2",
      "title": "조동사 + have p.p. (과거 추측)",
      "tags": [
        "조동사"
      ],
      "sentenceId": "s12",
      "highlight": [
        "may have caused"
      ],
      "explanation": "may have p.p.는 '~했을지도 모른다'는 과거에 대한 추측이다. 사과문에서 '끼쳤을 수도 있는 혼란'처럼 정중하게 쓴다.",
      "example": {
        "en": "The package may have been delivered to the wrong address.",
        "ko": "소포가 잘못된 주소로 배달되었을 수도 있다."
      },
      "note": "may/might/could have p.p. = 과거 추측, should have p.p. = 과거 후회."
    },
    {
      "id": "g3",
      "title": "do not hesitate to V",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s13",
      "highlight": [
        "do not hesitate to contact"
      ],
      "explanation": "hesitate는 뒤에 to부정사를 쓴다. please do not hesitate to contact me는 '편하게 연락하라'는 비즈니스 이메일의 단골 맺음 표현이다.",
      "example": {
        "en": "Please do not hesitate to ask if you need anything.",
        "ko": "필요한 것이 있으면 언제든 말씀해 주세요."
      },
      "note": "refrain은 from -ing, hesitate는 to V."
    }
  ],
