  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the purpose of the review?",
      "choices": [
        {
          "key": "A",
          "text": "To complain about a canceled reservation"
        },
        {
          "key": "B",
          "text": "To promote a restaurant that recently opened"
        },
        {
          "key": "C",
          "text": "To evaluate a hotel used during a business trip"
        },
        {
          "key": "D",
          "text": "To describe a conference the writer organized"
        }
      ],
      "answer": "C",
      "evidenceSentenceIds": [
        "s1",
        "s12"
      ],
      "explanationKo": "첫 문장에서 영업 회의 참석 중 호텔에 묵었다고 하고, 객실·식당·체크인을 차례로 평가한 뒤 추천으로 끝난다. 출장 중 묵은 호텔을 평가하는 글.",
      "choiceNotesKo": {
        "A": "예약이 취소된 것이 아니라 방 준비가 늦어진 것이다.",
        "D": "회의에는 참석했을 뿐 직접 준비했다는 말은 없다."
      },
      "skill": "목적 찾기"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What happened when the writer arrived at the hotel?",
      "choices": [
        {
          "key": "A",
          "text": "The writer was given a room on a different floor."
        },
        {
          "key": "B",
          "text": "The writer waited because the room was not yet available."
        },
        {
          "key": "C",
          "text": "The writer was charged for an extra night."
        },
        {
          "key": "D",
          "text": "The writer received a discount on the room rate."
        }
      ],
      "answer": "B",
      "evidenceSentenceIds": [
        "s10",
        "s11"
      ],
      "explanationKo": "'my room was not ready, and I had to wait nearly an hour'를 '방을 아직 쓸 수 없어서 기다렸다'로 바꿔 말한 B가 정답.",
      "choiceNotesKo": {
        "D": "받은 것은 객실 요금 할인이 아니라 무료 저녁 식사 쿠폰(voucher)이다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-synonym",
      "prompt": "In paragraph 3, the word \"justified\" is closest in meaning to",
      "choices": [
        {
          "key": "A",
          "text": "excused"
        },
        {
          "key": "B",
          "text": "adjusted"
        },
        {
          "key": "C",
          "text": "announced"
        },
        {
          "key": "D",
          "text": "warranted"
        }
      ],
      "answer": "D",
      "evidenceSentenceIds": [
        "s8"
      ],
      "explanationKo": "'품질이 가격을 justified했다'는 비싼 가격만큼 가치가 있었다는 뜻. '정당하게 만들다, ~할 만하게 하다'인 warranted가 가장 가깝다.",
      "choiceNotesKo": {
        "A": "excuse는 '(잘못을) 용서하다, 변명하다'라서 가격과 어울리지 않는다.",
        "B": "adjust는 '조정하다'로 가격을 바꿨다는 뜻이 된다."
      },
      "skill": "동의어"
    }
