  "grammar": [
    {
      "id": "g1",
      "title": "let + 목적어 + 동사원형",
      "tags": [
        "to부정사",
        "어순"
      ],
      "sentenceId": "s4",
      "highlight": [
        "lets you choose"
      ],
      "explanation": "사역동사 let은 목적어 뒤에 to 없는 동사원형을 쓴다. '~가 …하게 해 주다'.",
      "example": {
        "en": "Please let me know your answer.",
        "ko": "답을 저에게 알려 주세요."
      },
      "note": "let/make/have + 목적어 + 동사원형. to choose를 고르면 오답."
    },
    {
      "id": "g2",
      "title": "결과의 접속사 so",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "so it fits"
      ],
      "explanation": "so는 앞 내용(작고 가볍다)의 결과(어떤 책상에도 맞는다)를 이어 준다. '그래서'.",
      "example": {
        "en": "It was raining, so we stayed inside.",
        "ko": "비가 와서 우리는 안에 있었다."
      },
      "note": "because는 원인 앞, so는 결과 앞에 온다."
    },
    {
      "id": "g3",
      "title": "조건절의 현재 시제",
      "tags": [
        "시제",
        "부사절"
      ],
      "sentenceId": "s9",
      "highlight": [
        "If you order"
      ],
      "explanation": "if·when이 이끄는 조건·시간 부사절에서는 미래 일이라도 현재 시제를 쓴다. 주절은 will pay.",
      "example": {
        "en": "If it rains tomorrow, we will stay home.",
        "ko": "내일 비가 오면 우리는 집에 있을 것이다."
      },
      "note": "If you will order(×) → If you order(○)."
    }
  ],
