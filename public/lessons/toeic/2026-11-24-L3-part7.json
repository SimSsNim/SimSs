  "grammar": [
    {
      "id": "g1",
      "title": "결과의 분사구문 (, V-ing)",
      "tags": [
        "분사구문"
      ],
      "sentenceId": "s6",
      "highlight": [
        "making it easy for employees to commute"
      ],
      "explanation": "문장 뒤에 콤마 + V-ing가 오면 앞 내용 때문에 생기는 결과를 덧붙인다(= and it makes ~). make it + 형용사 + to V는 'to V하는 것을 ~하게 만들다'.",
      "example": {
        "en": "The store moved closer to the station, making it easier for customers to visit.",
        "ko": "그 매장은 역 가까이로 옮겨서 고객이 방문하기 더 쉬워졌다."
      },
      "note": "Part 7에서 분사구문 뒤 내용이 '장점'의 근거로 자주 출제된다."
    },
    {
      "id": "g2",
      "title": "주격 관계대명사 that",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "Businesses that sign"
      ],
      "explanation": "선행사(Businesses) 뒤에 that + 동사가 오면 '~하는 업체'로 명사를 꾸민다. 관계대명사절 안의 동사는 선행사의 수에 맞춘다(복수 → sign).",
      "example": {
        "en": "Customers that order before noon receive their items the same day.",
        "ko": "정오 전에 주문하는 고객은 당일에 물건을 받는다."
      },
      "note": "주어가 길 때 진짜 동사(will receive)를 찾으면 문장 구조가 보인다."
    }
  ],
