  "grammar": [
    {
      "id": "g1",
      "title": "Not until 도치",
      "tags": [
        "도치",
        "일치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Not until",
        "were the tenants allowed"
      ],
      "explanation": "Not until ~ 같은 부정 표현이 문장 맨 앞에 나오면 주절은 의문문 어순(be동사/조동사 + 주어)이 된다. 수동태 were allowed에서 were가 주어 앞으로 나갔고, 주어 tenants가 복수라 was가 아니라 were.",
      "example": {
        "en": "Not until he called did I learn the news.",
        "ko": "그가 전화하고 나서야 나는 그 소식을 알았다."
      },
      "note": "Not until ... 뒤 빈칸 → 조동사/be동사 + 주어. 수 일치도 확인."
    },
    {
      "id": "g2",
      "title": "No matter how + 형용사/부사",
      "tags": [
        "관계사",
        "부사절"
      ],
      "sentenceId": "s5",
      "highlight": [
        "No matter how difficult"
      ],
      "explanation": "No matter how(= however)는 '아무리 ~하더라도'라는 양보의 뜻으로, 바로 뒤에 형용사나 부사를 붙인 뒤 주어 + 동사를 쓴다. Whatever, Whenever는 형용사를 바로 뒤에 둘 수 없다.",
      "example": {
        "en": "No matter how busy you are, take a break.",
        "ko": "아무리 바빠도 휴식을 취하세요."
      },
      "note": "빈칸 + 형용사 + S + V → No matter how / However."
    },
    {
      "id": "g3",
      "title": "Without + 명사 = 가정법",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Without",
        "would have been postponed"
      ],
      "explanation": "Without + 명사가 if절 역할을 해서 '~이 없었다면'의 뜻이 된다. 주절이 would have p.p.이므로 과거 사실의 반대(가정법 과거완료)다. Without = If it had not been for.",
      "example": {
        "en": "Without your help, we would have failed.",
        "ko": "네 도움이 없었다면 우리는 실패했을 것이다."
      },
      "note": "주절에 would have p.p.인데 if가 없으면 Without / But for를 찾는다."
    }
  ],
