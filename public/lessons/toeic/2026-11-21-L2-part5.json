  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Hwang 씨는 새 마케팅 전략에 관해 이사회에 설득력 있는 발표를 했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "Ortiz 씨가 지난주에 주문한 노트북이 아직 도착하지 않았다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "폭설 때문에 직원 회의가 목요일로 연기되었다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "매니저는 디자인팀이 프로젝트에 헌신한 것을 칭찬했다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "Sato 씨는 회사 야유회를 6월의 더 늦은 날짜로 옮기자고 제안했다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "모든 방문객은 도착하는 즉시 보안 데스크에서 출입 기록을 해야 한다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "새 소프트웨어 덕분에 직원들은 큰 파일을 더 효율적으로 공유할 수 있다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "고객은 원래 영수증을 보관하고 있기만 하면 30일 안에 어떤 물건이든 반품할 수 있다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "그 호텔의 주 회의장은 최대 300명의 손님을 수용할 수 있다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "우리의 새 배달 서비스는 지역 곳곳의 작은 마을에서 매우 성공적이었다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Ms. Hwang gave a persuasive presentation to the board on the new marketing strategy.",
      "ko": "Hwang 씨는 새 마케팅 전략에 관해 이사회에 설득력 있는 발표를 했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The laptop that Mr. Ortiz ordered last week has not arrived yet.",
      "ko": "Ortiz 씨가 지난주에 주문한 노트북이 아직 도착하지 않았다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The staff meeting was postponed until Thursday because of the heavy snow.",
      "ko": "폭설 때문에 직원 회의가 목요일로 연기되었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "The manager praised the design team for its dedication to the project.",
      "ko": "매니저는 디자인팀이 프로젝트에 헌신한 것을 칭찬했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Mr. Sato suggested moving the company picnic to a later date in June.",
      "ko": "Sato 씨는 회사 야유회를 6월의 더 늦은 날짜로 옮기자고 제안했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "All visitors are required to sign in at the security desk upon arrival.",
      "ko": "모든 방문객은 도착하는 즉시 보안 데스크에서 출입 기록을 해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "The new software allows employees to share large files more efficiently.",
      "ko": "새 소프트웨어 덕분에 직원들은 큰 파일을 더 효율적으로 공유할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Customers may return any item within thirty days as long as they keep the original receipt.",
      "ko": "고객은 원래 영수증을 보관하고 있기만 하면 30일 안에 어떤 물건이든 반품할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The hotel's main conference hall can accommodate up to three hundred guests.",
      "ko": "그 호텔의 주 회의장은 최대 300명의 손님을 수용할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Our new delivery service has been very successful in small towns across the region.",
      "ko": "우리의 새 배달 서비스는 지역 곳곳의 작은 마을에서 매우 성공적이었다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
