  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is being advertised?",
      "evidenceSentenceIds": [
        "s1",
        "s3"
      ],
      "choices": [
        {
          "key": "A",
          "text": "A repair service for laptops"
        },
        {
          "key": "B",
          "text": "A new device for showing presentations"
        },
        {
          "key": "C",
          "text": "A class on public speaking"
        },
        {
          "key": "D",
          "text": "An office furniture store"
        }
      ],
      "answer": "B",
      "explanationKo": "제목과 둘째 문장에서 새 소형 프로젝터를 소개한다. projector → a device for showing presentations로 바꿔 말했다.",
      "choiceNotesKo": {
        "C": "presentations라는 말이 나오지만 발표 수업을 광고하는 것은 아니다.",
        "A": "노트북은 연결 기기로만 나온다."
      },
      "skill": "광고 대상(주제)"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "How can customers get a lower price?",
      "evidenceSentenceIds": [
        "s9"
      ],
      "choices": [
        {
          "key": "A",
          "text": "By buying two projectors"
        },
        {
          "key": "B",
          "text": "By bringing an old projector to a store"
        },
        {
          "key": "C",
          "text": "By placing an order before a certain date"
        },
        {
          "key": "D",
          "text": "By joining a membership program"
        }
      ],
      "answer": "C",
      "explanationKo": "12월 15일 전에 주문하면 20퍼센트 할인을 받는다. order before December 15 → placing an order before a certain date.",
      "choiceNotesKo": {
        "B": "옛 제품을 가져오라는 말은 없다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-synonym",
      "prompt": "In the advertisement, the word \"clear\" in the sentence about the images is closest in meaning to",
      "evidenceSentenceIds": [
        "s4"
      ],
      "choices": [
        {
          "key": "A",
          "text": "empty"
        },
        {
          "key": "B",
          "text": "obvious"
        },
        {
          "key": "C",
          "text": "free"
        },
        {
          "key": "D",
          "text": "sharp"
        }
      ],
      "answer": "D",
      "explanationKo": "bright, clear images = 밝고 '선명한' 화면. 화면이 또렷하다는 뜻이므로 sharp.",
      "choiceNotesKo": {
        "B": "obvious(분명한, 뻔한)도 clear의 뜻이지만 화면을 꾸밀 때는 맞지 않는다.",
        "A": "empty(비어 있는)는 '길이 뚫린' 뜻의 clear에 가깝다."
      },
      "skill": "동의어"
