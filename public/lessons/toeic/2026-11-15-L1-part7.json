  "grammar": [
    {
      "id": "g1",
      "title": "형용사 + enough to V",
      "tags": [
        "to부정사",
        "어순"
      ],
      "sentenceId": "s3",
      "highlight": [
        "small enough to fit"
      ],
      "explanation": "'~할 만큼 충분히 …한'은 형용사 뒤에 enough를 두고 to + 동사원형을 쓴다. enough small(×)이 아니라 small enough(○).",
      "example": {
        "en": "The room is big enough to hold fifty people.",
        "ko": "그 방은 50명을 수용할 만큼 크다."
      },
      "note": "형용사·부사 + enough 어순을 묻는 문제가 자주 나온다."
    },
    {
      "id": "g2",
      "title": "주격 관계대명사 who",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "Customers who order"
      ],
      "explanation": "who는 앞의 사람 명사(Customers)를 꾸미는 절을 이끈다. who 뒤에 바로 동사(order)가 온다.",
      "example": {
        "en": "People who live nearby can walk to the park.",
        "ko": "근처에 사는 사람들은 공원까지 걸어갈 수 있다."
      },
      "note": "사람 + who + 동사 / 사물 + which + 동사."
    }
  ],
