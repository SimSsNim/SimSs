  "grammar": [
    {
      "id": "g1",
      "title": "미래 수동태 will be p.p.",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s6",
      "highlight": [
        "will be delivered"
      ],
      "explanation": "의자는 스스로 배달하지 않고 '배달되는' 대상이다. 그래서 수동태(be + 과거분사)를 쓰고, tomorrow가 있으니 미래형 will be delivered가 된다.",
      "example": {
        "en": "The report will be sent to you tomorrow.",
        "ko": "보고서는 내일 당신에게 보내질 것이다."
      },
      "note": "주어가 사물이고 뒤에 목적어가 없으면 수동태부터 의심하자."
    },
    {
      "id": "g2",
      "title": "want + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "wants to hold"
      ],
      "explanation": "want(원하다)는 뒤에 to + 동사원형을 목적어로 쓴다. want holding(×), want hold(×).",
      "example": {
        "en": "She wants to visit the factory.",
        "ko": "그녀는 공장을 방문하고 싶어 한다."
      },
      "note": "want, plan, decide, hope, need 뒤에는 to부정사가 온다."
    },
    {
      "id": "g3",
      "title": "because + 문장 vs because of + 명사",
      "tags": [
        "접속사",
        "전치사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "because the heating system stopped working"
      ],
      "explanation": "because는 접속사라서 뒤에 '주어 + 동사'가 온다. because of는 전치사라서 뒤에 명사만 온다(because of the cold weather).",
      "example": {
        "en": "We stayed inside because it was raining.",
        "ko": "비가 와서 우리는 안에 있었다."
      },
      "note": "빈칸 뒤에 동사가 보이면 접속사, 명사만 있으면 전치사."
    }
  ],
