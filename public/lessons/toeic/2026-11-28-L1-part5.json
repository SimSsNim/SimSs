  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Rosewood 식당의 새 메뉴는 직장인들에게 매우 인기가 많다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "Park 씨는 월요일에 영업팀에게 짧은 발표를 했다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "기술자가 2층의 고장 난 프린터를 빠르게 수리했다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "우리는 새 웹사이트에 대해 고객들로부터 도움이 되는 의견을 많이 받았다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "Lee 씨는 서울로 옮기기 전에 도쿄 지점에서 3년 동안 일했다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "새 의자들은 내일 아침 회의실로 배달될 것이다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "매니저는 이번 주 주간 회의를 목요일에 열고 싶어 한다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "난방 장치가 작동을 멈춰서 가게가 일찍 문을 닫았다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "직원들은 본관 건물 뒤에 차를 주차할 수 있다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "이 양식을 작성해서 안내 데스크에 다시 제출해 주세요."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The new menu at Rosewood Diner is very popular with office workers.",
      "ko": "Rosewood 식당의 새 메뉴는 직장인들에게 매우 인기가 많다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Ms. Park gave a short presentation to the sales team on Monday.",
      "ko": "Park 씨는 월요일에 영업팀에게 짧은 발표를 했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The technician quickly repaired the broken printer on the second floor.",
      "ko": "기술자가 2층의 고장 난 프린터를 빠르게 수리했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "We received many helpful comments from customers about the new website.",
      "ko": "우리는 새 웹사이트에 대해 고객들로부터 도움이 되는 의견을 많이 받았다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Mr. Lee worked at the Tokyo branch for three years before he moved to Seoul.",
      "ko": "Lee 씨는 서울로 옮기기 전에 도쿄 지점에서 3년 동안 일했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The new chairs will be delivered to the meeting room tomorrow morning.",
      "ko": "새 의자들은 내일 아침 회의실로 배달될 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "The manager wants to hold the weekly meeting on Thursday this week.",
      "ko": "매니저는 이번 주 주간 회의를 목요일에 열고 싶어 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "The store closed early because the heating system stopped working.",
      "ko": "난방 장치가 작동을 멈춰서 가게가 일찍 문을 닫았다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Staff members can park their cars behind the main building.",
      "ko": "직원들은 본관 건물 뒤에 차를 주차할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Please fill out this form and return it to the front desk.",
      "ko": "이 양식을 작성해서 안내 데스크에 다시 제출해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
