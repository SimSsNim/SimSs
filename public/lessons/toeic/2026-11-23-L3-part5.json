  "grammar": [
    {
      "id": "g1",
      "title": "완료 분사구문 Having p.p.",
      "tags": [
        "분사구문"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Having reviewed"
      ],
      "explanation": "분사구문에서 주절보다 먼저 일어난 일은 Having p.p.로 쓴다. 주어가 직접 한 일(능동)이면 Having p.p., 당한 일(수동)이면 Having been p.p.다.",
      "example": {
        "en": "Having finished the report, Mr. Diaz left the office early.",
        "ko": "보고서를 끝낸 뒤 디아스 씨는 일찍 퇴근했다."
      },
      "note": "콤마 앞 빈칸 + 뒤에 목적어가 있으면 능동 분사(-ing / Having p.p.)."
    },
    {
      "id": "g2",
      "title": "가정법 과거",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s7",
      "highlight": [
        "If the conference room were larger",
        "would hold"
      ],
      "explanation": "현재 사실과 반대되는 상황을 가정할 때 If + 과거형(be동사는 were), 주절은 would/could + 동사원형을 쓴다.",
      "example": {
        "en": "If we had more staff, we could open on weekends.",
        "ko": "직원이 더 있다면 주말에도 문을 열 수 있을 텐데."
      },
      "note": "If절에 were/과거형이 보이면 주절 빈칸은 would + 동사원형."
    },
    {
      "id": "g3",
      "title": "과거분사의 후치 수식",
      "tags": [
        "분사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "packages received after three in the afternoon"
      ],
      "explanation": "분사가 뒤에 다른 말(after three ...)을 달고 명사를 꾸밀 때는 명사 뒤에 온다. 명사가 동작을 받는 쪽이면 과거분사다.",
      "example": {
        "en": "Orders placed before noon arrive the same day.",
        "ko": "정오 전에 접수된 주문은 당일 도착한다."
      },
      "note": "문장에 동사가 이미 있으면 빈칸은 분사. 받는 쪽이면 p.p."
    }
  ],
