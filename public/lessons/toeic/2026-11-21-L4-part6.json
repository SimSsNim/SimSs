  "grammar": [
    {
      "id": "g1",
      "title": "관계부사 where (계속적 용법)",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s3",
      "highlight": [
        ", where a buffet will be available"
      ],
      "explanation": "앞에 장소 명사(the Garden Lounge)가 있고 뒤에 주어 + 동사 + 보어가 다 갖춰진 완전한 절이 오면 관계부사 where를 쓴다. which는 뒤에 주어나 목적어가 빠진 불완전한 절을 이끈다.",
      "example": {
        "en": "We visited Kyoto, where we stayed for a week.",
        "ko": "우리는 교토에 갔고, 그곳에서 일주일 머물렀다."
      },
      "note": "장소 명사 + 빈칸 + 완전한 절 → where. 불완전한 절 → which."
    },
    {
      "id": "g2",
      "title": "과거분사 후치 수식",
      "tags": [
        "분사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "a seasonal menu developed by our new head chef"
      ],
      "explanation": "메뉴는 셰프에 의해 '개발된' 것이므로 과거분사 developed가 명사 menu를 뒤에서 꾸민다. 뒤에 by + 행위자가 오는 것이 수동의 단서다.",
      "example": {
        "en": "This is a report written by our team.",
        "ko": "이것은 우리 팀이 쓴 보고서다."
      },
      "note": "명사 + 빈칸 + by ~ → 과거분사."
    },
    {
      "id": "g3",
      "title": "현재분사 후치 수식 + once절",
      "tags": [
        "분사",
        "부사절"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Guests staying three or more nights",
        "once the restaurant reopens"
      ],
      "explanation": "staying ~은 Guests를 꾸미는 현재분사구(고객이 '머무는' 능동). once는 '~하면, ~하자마자'의 접속사이고, 시간 부사절이라 미래 대신 현재 시제 reopens를 쓴다.",
      "example": {
        "en": "Once you arrive, please call me.",
        "ko": "도착하면 전화 주세요."
      },
      "note": "시간·조건 부사절(once, when, if)에서는 will 대신 현재 시제."
    }
  ],
