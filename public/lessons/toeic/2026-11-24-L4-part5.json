  "grammar": [
    {
      "id": "g1",
      "title": "부정 부사 도치",
      "tags": [
        "도치"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Rarely has a newly launched product attracted"
      ],
      "explanation": "Rarely, Seldom, Never, Hardly 같은 부정 부사가 문장 앞에 나오면 의문문 어순(조동사 + 주어 + 동사)으로 바뀐다. 조동사는 주어의 수와 시제에 맞춘다.",
      "example": {
        "en": "Seldom have our sales been this strong in December.",
        "ko": "12월에 우리 매출이 이렇게 좋았던 적은 드물다."
      },
      "note": "도치 문장에서는 뒤에 오는 주어(단수/복수)와 동사 형태(p.p./원형)를 보고 조동사를 고른다."
    },
    {
      "id": "g2",
      "title": "복합관계대명사 whoever",
      "tags": [
        "관계사",
        "명사절"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Whoever submits"
      ],
      "explanation": "whoever는 '~하는 사람은 누구든(anyone who)'이라는 뜻으로, 스스로 명사절을 이끌어 문장의 주어나 목적어가 된다. 절 안에서 주어 역할이면 whoever, 목적어 역할이면 whomever.",
      "example": {
        "en": "Whoever arrives first should unlock the office.",
        "ko": "가장 먼저 도착하는 사람이 누구든 사무실 문을 열어야 한다."
      },
      "note": "빈칸 바로 뒤에 동사(submits)가 오면 주격 whoever."
    },
    {
      "id": "g3",
      "title": "가정법 도치 (Were + S + to V)",
      "tags": [
        "가정법",
        "도치"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Were the merger to proceed"
      ],
      "explanation": "if절의 were, had, should는 if를 생략하고 주어 앞으로 보낼 수 있다. Were + S + to V는 '만약 ~한다면'이라는 미래에 대한 가정.",
      "example": {
        "en": "Were the price to rise again, we would look for another supplier.",
        "ko": "가격이 또 오른다면 우리는 다른 공급업체를 찾을 것이다."
      },
      "note": "문장 맨 앞 빈칸 + 주어 + to V + 주절의 would → Were."
    }
  ],
