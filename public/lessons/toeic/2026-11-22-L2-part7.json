  "grammar": [
    {
      "id": "g1",
      "title": "조동사 + 수동태 must be + p.p.",
      "tags": [
        "수동태",
        "조동사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "must be submitted"
      ],
      "explanation": "청구서는 '제출되는' 것이므로 수동태. 조동사 뒤라서 be + p.p. 형태(must be submitted).",
      "example": {
        "en": "All forms must be signed by the manager.",
        "ko": "모든 양식은 관리자의 서명을 받아야 한다."
      },
      "note": "조동사 + 빈칸 + by/전치사구 → be + p.p."
    },
    {
      "id": "g2",
      "title": "allow + 목적어 + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "allow us to process"
      ],
      "explanation": "allow, enable, encourage, ask 등은 '목적어 + to V' 구조를 쓴다.",
      "example": {
        "en": "The new app allows users to pay by phone.",
        "ko": "새 앱은 사용자가 휴대폰으로 결제할 수 있게 한다."
      },
      "note": "allow/enable + 목적어 + 빈칸 → to V"
    },
    {
      "id": "g3",
      "title": "주격 관계대명사 who",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s13",
      "highlight": [
        "who cannot attend either session"
      ],
      "explanation": "사람 명사(Staff) 뒤에서 who + 동사가 '~하는'이라는 뜻으로 앞 명사를 꾸민다.",
      "example": {
        "en": "Customers who order online get free shipping.",
        "ko": "온라인으로 주문하는 고객은 무료 배송을 받는다."
      },
      "note": "사람 명사 + 빈칸 + 동사 → who"
    }
  ],
