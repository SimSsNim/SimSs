  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "수신: 영업부 전 직원"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "발신: 재무부 Linda Cho"
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "날짜: 11월 23일"
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "제목: 출장 경비 청구 방식 변경"
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5",
        "s6",
        "s7"
      ],
      "ko": "12월 1일부터 모든 출장 경비 청구는 새 온라인 시스템인 ExpensePro를 통해 제출해야 합니다. 그날 이후로는 종이 양식을 더 이상 받지 않습니다. 새 시스템으로 청구를 더 빨리 처리할 수 있어, 대부분의 직원은 2주가 아니라 영업일 기준 5일 안에 돈을 받게 될 것입니다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s8",
        "s9",
        "s10"
      ],
      "ko": "청구하려면 사원 번호로 로그인한 뒤 영수증마다 사진을 올리기만 하면 됩니다. 식사 비용 청구에는 함께한 고객의 이름도 적어야 합니다. 500달러가 넘는 단일 비용은 제출하기 전에 부서장의 승인을 받아야 한다는 점에 유의해 주세요."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s11",
        "s12",
        "s13"
      ],
      "ko": "재무팀은 ExpensePro 사용법에 관한 짧은 교육을 두 번 진행합니다. 첫 번째는 11월 26일 310호에서, 두 번째는 11월 30일 온라인으로 열립니다. 두 교육 모두 참석하지 못하는 직원은 사내 인트라넷에서 녹화 영상을 볼 수 있습니다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s14"
      ],
      "ko": "궁금한 점이 있으면 내선 4127번으로 저에게 연락해 주세요."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "To: All Sales Staff",
      "ko": "수신: 영업부 전 직원",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "From: Linda Cho, Finance Department",
      "ko": "발신: 재무부 Linda Cho",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Date: November 23",
      "ko": "날짜: 11월 23일",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Subject: Changes to Travel Expense Claims",
      "ko": "제목: 출장 경비 청구 방식 변경",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Starting on December 1, all travel expense claims must be submitted through our new online system, ExpensePro.",
      "ko": "12월 1일부터 모든 출장 경비 청구는 새 온라인 시스템인 ExpensePro를 통해 제출해야 합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p5",
      "en": "Paper forms will no longer be accepted after that date.",
      "ko": "그날 이후로는 종이 양식을 더 이상 받지 않습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p5",
      "en": "The new system will allow us to process claims faster, and most employees should receive their money within five business days instead of two weeks.",
      "ko": "새 시스템으로 청구를 더 빨리 처리할 수 있어, 대부분의 직원은 2주가 아니라 영업일 기준 5일 안에 돈을 받게 될 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p6",
      "en": "To submit a claim, simply log in with your employee number and upload a photo of each receipt.",
      "ko": "청구하려면 사원 번호로 로그인한 뒤 영수증마다 사진을 올리기만 하면 됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p6",
      "en": "Claims for meals must also include the names of any clients who attended.",
      "ko": "식사 비용 청구에는 함께한 고객의 이름도 적어야 합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p6",
      "en": "Please note that any single expense over $500 must be approved by your department manager before you submit it.",
      "ko": "500달러가 넘는 단일 비용은 제출하기 전에 부서장의 승인을 받아야 한다는 점에 유의해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p7",
      "en": "The finance team will hold two short training sessions on how to use ExpensePro.",
      "ko": "재무팀은 ExpensePro 사용법에 관한 짧은 교육을 두 번 진행합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p7",
      "en": "The first will take place on November 26 in Room 310, and the second will be held online on November 30.",
      "ko": "첫 번째는 11월 26일 310호에서, 두 번째는 11월 30일 온라인으로 열립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s13",
      "paragraphId": "p7",
      "en": "Staff who cannot attend either session can watch a recorded video on the company intranet.",
      "ko": "두 교육 모두 참석하지 못하는 직원은 사내 인트라넷에서 녹화 영상을 볼 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s14",
      "paragraphId": "p8",
      "en": "If you have any questions, please contact me at extension 4127.",
      "ko": "궁금한 점이 있으면 내선 4127번으로 저에게 연락해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
