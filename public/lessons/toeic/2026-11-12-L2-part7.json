  "grammar": [
    {
      "id": "g1",
      "title": "계속적 용법 관계대명사 , which",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "The Lindell Harbor Hotel, which opened"
      ],
      "explanation": "콤마 뒤 which는 앞의 명사에 정보를 덧붙인다. 이 경우 that으로 바꿔 쓸 수 없다.",
      "example": {
        "en": "My car, which is ten years old, still runs well.",
        "ko": "내 차는 10년 됐는데도 여전히 잘 달린다."
      },
      "note": "콤마 + 빈칸 + 동사 구조라면 that이 아니라 which/who를 고른다."
    },
    {
      "id": "g2",
      "title": "목적을 나타내는 To V",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s10",
      "highlight": [
        "To book the Weekday Business Package"
      ],
      "explanation": "문장 맨 앞의 To V는 '~하기 위해'라는 목적을 나타낸다. 뒤에 명령문(visit, call)이 이어진다.",
      "example": {
        "en": "To apply, fill out this form.",
        "ko": "지원하려면 이 양식을 작성하세요."
      },
      "note": "광고·공지 끝부분의 'To + 동사원형, 명령문'은 신청·예약 방법을 알려 주는 단서."
    },
    {
      "id": "g3",
      "title": "recommend + 동명사",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s11",
      "highlight": [
        "recommend reserving"
      ],
      "explanation": "recommend, suggest, consider, avoid, finish는 목적어로 동명사(V-ing)를 쓴다. recommend to reserve는 틀린 표현이다.",
      "example": {
        "en": "I suggest leaving early.",
        "ko": "일찍 출발하기를 제안한다."
      },
      "note": "recommend/suggest + V-ing는 to부정사와 헷갈리게 내는 단골 함정."
    }
  ],
