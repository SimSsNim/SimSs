    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is being advertised?",
      "evidenceSentenceIds": [
        "s3",
        "s5"
      ],
      "choices": [
        {
          "key": "A",
          "text": "A discounted offer for business travelers"
        },
        {
          "key": "B",
          "text": "The opening of a new hotel"
        },
        {
          "key": "C",
          "text": "A seafood cooking class"
        },
        {
          "key": "D",
          "text": "A conference on finance"
        }
      ],
      "answer": "A",
      "explanationKo": "'special Weekday Business Package'와 '20 percent discount'에서 출장객을 위한 할인 상품 광고임을 알 수 있다. discount → discounted offer로 바꿔 말했다.",
      "choiceNotesKo": {
        "B": "호텔은 지난봄에 이미 문을 열었다. 개업 광고가 아니다.",
        "D": "financial district는 호텔 위치일 뿐, 금융 회의 이야기가 아니다."
      },
      "skill": "광고 대상(주제)"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What can package guests receive at Skyline Grill?",
