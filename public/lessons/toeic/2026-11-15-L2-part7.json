  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "Why did Ms. Shah send the e-mail?",
      "evidenceSentenceIds": [
        "s6"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To give details about travel plans"
        },
        {
          "key": "B",
          "text": "To invite Mr. Mercer to speak at an expo"
        },
        {
          "key": "C",
          "text": "To ask for help designing a booth"
        },
        {
          "key": "D",
          "text": "To report a problem with a flight"
        }
      ],
      "answer": "A",
      "explanationKo": "첫 문장에서 출장 준비를 마쳤다고 하고, 이어서 비행기·호텔·일정을 알려 준다. arrangements for your trip → details about travel plans.",
      "choiceNotesKo": {
        "B": "박람회에 가는 것은 맞지만 발표를 부탁하는 내용은 없다.",
        "D": "비행 일정을 알려 줄 뿐, 문제가 있다는 말은 없다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What is Mr. Mercer asked to bring?",
      "evidenceSentenceIds": [
        "s12"
      ],
      "choices": [
        {
          "key": "A",
          "text": "Product samples"
        },
        {
          "key": "B",
          "text": "A printed hotel confirmation"
        },
        {
          "key": "C",
          "text": "A large number of business cards"
        },
        {
          "key": "D",
          "text": "Receipts from last year's trip"
        }
      ],
      "answer": "C",
      "explanationKo": "Please bring plenty of business cards → '명함을 많이' 가져오라고 했다. plenty of → a large number of.",
      "choiceNotesKo": {
        "A": "견본은 림 씨가 이미 보냈으니 들고 갈 필요가 없다.",
        "B": "확인서는 이메일에 첨부되어 있다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-inference",
      "prompt": "What is suggested about the company at last year's event?",
      "evidenceSentenceIds": [
        "s12"
      ],
      "choices": [
        {
          "key": "A",
          "text": "It did not have a booth."
        },
        {
          "key": "B",
          "text": "It sent its samples by plane."
        },
        {
          "key": "C",
          "text": "Its booth was located in Hall C."
        },
        {
          "key": "D",
          "text": "Its supply of business cards was used up early."
        }
      ],
      "answer": "D",
      "explanationKo": "작년에는 둘째 날 명함이 다 떨어졌다(ran out of them on the second day) → 명함이 일찍 바닥났다는 것을 알 수 있다.",
