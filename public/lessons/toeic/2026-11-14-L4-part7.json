  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the article mainly about?",
      "evidenceSentenceIds": [
        "s2"
      ],
      "choices": [
        {
          "key": "A",
          "text": "The retirement of a well-known local chef"
        },
        {
          "key": "B",
          "text": "A dispute between two hotel companies"
        },
        {
          "key": "C",
          "text": "The new use planned for a closed hotel"
        },
        {
          "key": "D",
          "text": "The results of a survey of local residents"
        }
      ],
      "answer": "C",
      "explanationKo": "첫 문장에서 2년 전 문을 닫은 호텔이 '부티크 호텔 겸 요리사 교육 센터'로 다시 문을 연다고 밝히고, 나머지는 그 세부 내용이다. reopen as ~ → new use planned로 바꿔 말한 C가 정답.",
      "choiceNotesKo": {
        "B": "웩스퍼드가 건물을 산 것이지 두 회사 간 분쟁 이야기는 없다.",
        "D": "주민 걱정은 나오지만 설문 조사 결과는 아니다."
      },
      "skill": "주제 찾기"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What did Wexford Hospitality Group agree to do?",
      "evidenceSentenceIds": [
        "s11"
      ],
      "choices": [
        {
          "key": "A",
          "text": "Restrict the times when goods are brought to the hotel"
        },
        {
          "key": "B",
          "text": "Reduce the number of guest rooms in the building"
        },
        {
          "key": "C",
          "text": "Hire neighborhood residents as instructors"
        },
        {
          "key": "D",
          "text": "Replace the stone exterior of the building"
        }
      ],
      "answer": "A",
      "explanationKo": "'배송을 평일 오전으로 제한한다'(limit deliveries to weekday mornings)를 '물품이 들어오는 시간을 제한한다'로 바꿔 말한 A가 정답.",
      "choiceNotesKo": {
        "D": "외관은 교체가 아니라 보존(preserve)하기로 했다.",
        "B": "객실 수를 줄인다는 내용은 없다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-synonym",
      "prompt": "In the article, the word \"pledged\" is closest in meaning to",
      "evidenceSentenceIds": [
        "s12"
      ],
      "choices": [
        {
          "key": "A",
          "text": "requested"
        },
        {
          "key": "B",
          "text": "considered"
        },
        {
          "key": "C",
          "text": "refused"
        },
        {
          "key": "D",
          "text": "promised"
        }
      ],
      "answer": "D",
      "explanationKo": "주민의 걱정에 대한 대응으로 회사가 외관을 '보존하겠다고 약속했다'는 뜻 → promised.",
      "choiceNotesKo": {
        "B": "considered(고려했다)는 아직 결정하지 않았다는 뜻이라 약속의 의미가 없다."
      },
      "skill": "동의어"
    }
  ]
