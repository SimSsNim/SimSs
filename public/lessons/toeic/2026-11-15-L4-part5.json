  "grammar": [
    {
      "id": "g1",
      "title": "전치사 + 관계대명사 (the N of which)",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "the details of which"
      ],
      "explanation": "콤마 뒤에 '명사 + of which'가 오면 앞 명사(사물)를 가리키며 절을 이어 준다. 대명사 them/it을 쓰면 접속사가 없어 두 절이 이어지지 않는다.",
      "example": {
        "en": "We received ten applications, most of which were excellent.",
        "ko": "지원서 10장을 받았는데, 그중 대부분이 훌륭했다."
      },
      "note": "콤마 + 수량/명사 + of + _ + 동사 → which(사물) / whom(사람)."
    },
    {
      "id": "g2",
      "title": "복합관계대명사 whoever",
      "tags": [
        "관계사",
        "명사절"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Whoever submits"
      ],
      "explanation": "whoever = anyone who. 명사절을 이끌며 절 안에서 주어 역할을 한다. 목적어 자리면 whomever를 쓴다.",
      "example": {
        "en": "Whoever arrives first should unlock the office.",
        "ko": "가장 먼저 도착하는 사람이 사무실 문을 열어야 한다."
      },
      "note": "빈칸 뒤에 바로 동사가 오고 문장 동사가 또 있으면 Whoever."
    },
    {
      "id": "g3",
      "title": "Not only 도치",
      "tags": [
        "도치"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Not only does the new software reduce"
      ],
      "explanation": "Not only가 문장 맨 앞에 오면 의문문 어순(조동사 + 주어 + 동사원형)으로 도치된다. 일반동사 현재 3인칭 단수는 does를 쓴다.",
      "example": {
        "en": "Not only did the hotel upgrade our room, but it also offered free breakfast.",
        "ko": "호텔은 객실을 업그레이드해 주었을 뿐 아니라 무료 조식도 제공했다."
      },
      "note": "Not only _ + 주어 + 동사원형 → do/does/did 중 수·시제에 맞는 것."
    }
  ],
