  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Lee 씨는 신입 사원들을 위한 매우 유용한 안내서를 썼다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "우리 회사는 내년에 부산에 새 지점을 열 것이다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "Park 씨는 아침 회의 전에 정기적으로 이메일을 확인한다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "모든 방문객은 건물 안에 있는 동안 신분증 배지를 착용해야 한다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "이사는 금요일에 예산에 대한 최종 결정을 내릴 것이다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "고장 난 프린터는 어제 기술자가 수리했다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "교육이 끝날 때까지 방을 나가지 마세요."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "회의실의 새 의자들은 아주 편안하다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "저희 고객 지원 창구는 평일 9시부터 6시까지 이용할 수 있습니다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "신입 사원은 각자 첫날에 노트북을 받는다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Ms. Lee wrote a very helpful guide for new employees.",
      "ko": "Lee 씨는 신입 사원들을 위한 매우 유용한 안내서를 썼다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Our company will open a new branch in Busan next year.",
      "ko": "우리 회사는 내년에 부산에 새 지점을 열 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Mr. Park regularly checks his e-mail before the morning meeting.",
      "ko": "Park 씨는 아침 회의 전에 정기적으로 이메일을 확인한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "All visitors must wear an ID badge while they are in the building.",
      "ko": "모든 방문객은 건물 안에 있는 동안 신분증 배지를 착용해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The director will make a final decision about the budget on Friday.",
      "ko": "이사는 금요일에 예산에 대한 최종 결정을 내릴 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The broken printer was repaired by a technician yesterday.",
      "ko": "고장 난 프린터는 어제 기술자가 수리했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Please do not leave the room until the training session ends.",
      "ko": "교육이 끝날 때까지 방을 나가지 마세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "The new chairs in the meeting room are very comfortable.",
      "ko": "회의실의 새 의자들은 아주 편안하다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Our help desk is available from nine to six on weekdays.",
      "ko": "저희 고객 지원 창구는 평일 9시부터 6시까지 이용할 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Each new employee gets a laptop on the first day.",
      "ko": "신입 사원은 각자 첫날에 노트북을 받는다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
