  "grammar": [
    {
      "id": "g1",
      "title": "미래 시제 will + 동사원형",
      "tags": [
        "시제"
      ],
      "sentenceId": "s2",
      "highlight": [
        "will open",
        "next year"
      ],
      "explanation": "next year(내년)처럼 미래를 나타내는 말이 있으면 will + 동사원형을 쓴다.",
      "example": {
        "en": "We will move to a new office next month.",
        "ko": "우리는 다음 달에 새 사무실로 이사할 것이다."
      },
      "note": "next year / next month / tomorrow → will + 동사원형"
    },
    {
      "id": "g2",
      "title": "과거 수동태 was + p.p.",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s6",
      "highlight": [
        "was repaired by"
      ],
      "explanation": "프린터는 스스로 고치는 것이 아니라 '수리되는' 것이므로 수동태. yesterday가 있어 과거형 was repaired. 행동한 사람은 by로 나타낸다.",
      "example": {
        "en": "The package was delivered by a courier this morning.",
        "ko": "그 소포는 오늘 아침 택배 기사가 배달했다."
      },
      "note": "사물 주어 + 빈칸 + by → be + p.p."
    },
    {
      "id": "g3",
      "title": "each + 단수 명사 + 단수 동사",
      "tags": [
        "일치"
      ],
      "sentenceId": "s10",
      "highlight": [
        "Each new employee gets"
      ],
      "explanation": "each(각각의) 뒤에는 단수 명사가 오고, 동사도 단수형(-s)을 쓴다.",
      "example": {
        "en": "Each room has a small desk.",
        "ko": "방마다 작은 책상이 하나 있다."
      },
      "note": "Each/Every + 단수 명사 → 동사에 -s"
    }
  ],
