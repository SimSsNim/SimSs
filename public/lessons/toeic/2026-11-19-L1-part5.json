  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "새 급여 소프트웨어는 모든 직원의 급여를 정확하게 계산한다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "김 씨는 어제 오후 월간 매출 보고서를 상사에게 보냈다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "작은 회의실은 우리 건물 3층에 있다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "새 로고 디자인에 대한 제안을 금요일까지 가르시아 씨에게 보내 주세요."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "모든 방문객은 공장에 들어가기 전에 안내 데스크에서 등록해야 한다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "그랜드뷰 호텔 직원들은 우리 손님 모두에게 매우 친절하게 도움을 주었다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "새 노트북 각각에는 2년 품질 보증이 딸려 있다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "밤에 사무실을 나갈 때는 불을 꺼 주세요."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "이사회는 다음 주에 예산에 대해 최종 결정을 내릴 것이다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "이 씨는 비서에게 계약서를 복사해 달라고 부탁했다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The new payroll software calculates the pay of every employee accurately.",
      "ko": "새 급여 소프트웨어는 모든 직원의 급여를 정확하게 계산한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Mr. Kim sent the monthly sales report to his manager yesterday afternoon.",
      "ko": "김 씨는 어제 오후 월간 매출 보고서를 상사에게 보냈다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The small meeting room is located on the third floor of our building.",
      "ko": "작은 회의실은 우리 건물 3층에 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Please send your suggestions for the new logo design to Ms. Garcia by Friday.",
      "ko": "새 로고 디자인에 대한 제안을 금요일까지 가르시아 씨에게 보내 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "All visitors must register at the front desk before entering the factory.",
      "ko": "모든 방문객은 공장에 들어가기 전에 안내 데스크에서 등록해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The staff at the Grandview Hotel were very helpful to all of our guests.",
      "ko": "그랜드뷰 호텔 직원들은 우리 손님 모두에게 매우 친절하게 도움을 주었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Each of the new laptops comes with a two-year warranty.",
      "ko": "새 노트북 각각에는 2년 품질 보증이 딸려 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Please turn off the lights when you leave the office at night.",
      "ko": "밤에 사무실을 나갈 때는 불을 꺼 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The board will make a final decision about the budget next week.",
      "ko": "이사회는 다음 주에 예산에 대해 최종 결정을 내릴 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Ms. Lee asked her assistant to make copies of the contract.",
      "ko": "이 씨는 비서에게 계약서를 복사해 달라고 부탁했다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
