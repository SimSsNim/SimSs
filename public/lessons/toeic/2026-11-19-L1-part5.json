  "grammar": [
    {
      "id": "g1",
      "title": "Each of + 복수 명사 + 단수 동사",
      "tags": [
        "일치"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Each of the new laptops comes"
      ],
      "explanation": "each of 뒤에는 복수 명사(laptops)가 오지만 주어는 each(각각 하나)라서 동사는 단수형(comes)을 쓴다.",
      "example": {
        "en": "Each of the rooms has a window.",
        "ko": "방마다 창문이 하나씩 있다."
      },
      "note": "Each of 주어 → 동사에 -s 붙은 단수형 고르기."
    },
    {
      "id": "g2",
      "title": "과거 시간 표현 + 과거 시제",
      "tags": [
        "시제"
      ],
      "sentenceId": "s2",
      "highlight": [
        "sent",
        "yesterday afternoon"
      ],
      "explanation": "yesterday, last week, ago 같은 과거 표현이 있으면 동사는 과거형을 쓴다. send의 과거형은 sent.",
      "example": {
        "en": "We met the client last Monday.",
        "ko": "우리는 지난 월요일에 고객을 만났다."
      },
      "note": "문장 끝 시간 표현부터 보고 시제를 정한다."
    },
    {
      "id": "g3",
      "title": "before + 동명사",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "before entering"
      ],
      "explanation": "before는 전치사로도 쓰여 뒤에 -ing가 올 수 있다. before entering = 들어가기 전에.",
      "example": {
        "en": "Please read the guide before using the machine.",
        "ko": "기계를 사용하기 전에 안내서를 읽어 주세요."
      },
      "note": "before/after + -ing 형태가 자주 나온다."
    }
  ],
