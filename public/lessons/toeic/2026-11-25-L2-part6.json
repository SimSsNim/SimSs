  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Alvarez 씨께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4"
      ],
      "ko": "최근 Brightleaf 사무용품에 주문해 주셔서 감사합니다. 안타깝게도 주문하신 인체공학 의자는 일시적으로 품절되었습니다. 다음 주 수요일에 공급업체로부터 의자를 더 받을 예정입니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s5",
        "s6"
      ],
      "ko": "그동안 종이와 프린터 잉크를 포함한 나머지 물품은 오늘 아침 발송되었습니다. 영업일 기준 이틀 안에 도착할 것입니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s7",
        "s8",
        "s9"
      ],
      "ko": "의자와 관련해 두 가지 방법을 제안드리고자 합니다. 입고되는 대로 바로 보내 드리거나, 주문을 취소하고 전액 환불을 받으실 수 있습니다. 이 이메일에 답장하여 원하시는 방법을 알려 주세요."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s10"
      ],
      "ko": "지연에 대해 사과드리며 기다려 주셔서 감사합니다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s11"
      ],
      "ko": "감사합니다,"
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s12"
      ],
      "ko": "Daniel Cho, 고객 서비스팀"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Ms. Alvarez,",
      "ko": "Alvarez 씨께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for your recent order from Brightleaf Office Supplies.",
      "ko": "최근 Brightleaf 사무용품에 주문해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "Unfortunately, the ergonomic chair that you ordered is temporarily out of stock.",
      "ko": "안타깝게도 주문하신 인체공학 의자는 일시적으로 품절되었습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "We expect to receive more chairs from our supplier next Wednesday.",
      "ko": "다음 주 수요일에 공급업체로부터 의자를 더 받을 예정입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p3",
      "en": "In the meantime, the rest of your items, which include paper and printer ink, were sent to you this morning.",
      "ko": "그동안 종이와 프린터 잉크를 포함한 나머지 물품은 오늘 아침 발송되었습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "They should arrive within two business days.",
      "ko": "영업일 기준 이틀 안에 도착할 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p4",
      "en": "We would like to offer you two options regarding the chair.",
      "ko": "의자와 관련해 두 가지 방법을 제안드리고자 합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p4",
      "en": "We can ship it as soon as it arrives, or you can cancel it and receive a full refund.",
      "ko": "입고되는 대로 바로 보내 드리거나, 주문을 취소하고 전액 환불을 받으실 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "Please let us know which option you prefer by replying to this e-mail.",
      "ko": "이 이메일에 답장하여 원하시는 방법을 알려 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p5",
      "en": "We apologize for the delay and thank you for your patience.",
      "ko": "지연에 대해 사과드리며 기다려 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p6",
      "en": "Best regards,",
      "ko": "감사합니다,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p7",
      "en": "Daniel Cho, Customer Service Team",
      "ko": "Daniel Cho, 고객 서비스팀",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
