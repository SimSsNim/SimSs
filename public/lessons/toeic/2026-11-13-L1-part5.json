  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "물건을 반품해야 할 경우를 대비해 영수증을 잘 보관해 주세요."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "이 씨는 내일 영업 회의에서 짧은 발표를 할 것이다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "김 씨는 회사 예산에 관한 중요한 결정을 내렸다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "호텔 식당은 아침 7시부터 밤 10시까지 문을 연다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "우리 새 사무실 의자는 긴 회의에 아주 편하다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "모든 방문객은 들어가기 전에 접수처에서 방문 기록을 해야 한다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "그 가게는 이번 주에 모든 겨울 코트를 20퍼센트 할인할 것이다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "새 메뉴는 파리 출신의 유명한 요리사가 만들었다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "그 프린터는 오래됐지만 여전히 아주 잘 작동한다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "주차 허가증을 신청하려면 이 양식을 작성해 주세요."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Please keep your receipt carefully in case you need to return the item.",
      "ko": "물건을 반품해야 할 경우를 대비해 영수증을 잘 보관해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Mr. Lee will give a short presentation at the sales meeting tomorrow.",
      "ko": "이 씨는 내일 영업 회의에서 짧은 발표를 할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Ms. Kim made an important decision about the company budget.",
      "ko": "김 씨는 회사 예산에 관한 중요한 결정을 내렸다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "The hotel restaurant is open from 7 in the morning until 10 at night.",
      "ko": "호텔 식당은 아침 7시부터 밤 10시까지 문을 연다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Our new office chairs are very comfortable for long meetings.",
      "ko": "우리 새 사무실 의자는 긴 회의에 아주 편하다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "All visitors must sign in at the reception desk before entering.",
      "ko": "모든 방문객은 들어가기 전에 접수처에서 방문 기록을 해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "The store will offer a 20 percent discount on all winter coats this week.",
      "ko": "그 가게는 이번 주에 모든 겨울 코트를 20퍼센트 할인할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "The new menu was designed by a famous chef from Paris.",
      "ko": "새 메뉴는 파리 출신의 유명한 요리사가 만들었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The printer is old, but it still works very well.",
      "ko": "그 프린터는 오래됐지만 여전히 아주 잘 작동한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Please fill out this form to apply for a parking permit.",
      "ko": "주차 허가증을 신청하려면 이 양식을 작성해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
