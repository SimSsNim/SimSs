  "grammar": [
    {
      "id": "g1",
      "title": "과거분사의 후치 수식",
      "tags": [
        "분사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "created by head chef Marisol Vance",
        "made with ingredients"
      ],
      "explanation": "메뉴는 '만들어진' 대상, 샐러드·수프도 '만들어진' 대상이므로 과거분사(created, made)가 뒤에서 명사를 꾸민다.",
      "example": {
        "en": "The chairs ordered last week have finally arrived.",
        "ko": "지난주에 주문한 의자가 드디어 도착했다."
      },
      "note": "명사 뒤 빈칸 + by/with 등 → 수동 의미 과거분사."
    },
    {
      "id": "g2",
      "title": "계속적 용법의 which",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        ", which is guaranteed"
      ],
      "explanation": "콤마 뒤 which는 앞 명사에 정보를 덧붙인다. that은 콤마 뒤에 쓸 수 없다.",
      "example": {
        "en": "We moved to Dalton Tower, which is close to the station.",
        "ko": "우리는 역과 가까운 돌턴 타워로 이사했다."
      },
      "note": "콤마 + 관계대명사 → which/who 가능, that 불가."
    },
    {
      "id": "g3",
      "title": "현재완료 수동태 (계속)",
      "tags": [
        "시제",
        "수동태"
      ],
      "sentenceId": "s2",
      "highlight": [
        "has been known"
      ],
      "explanation": "Since + 과거 시점과 함께 has been known은 '그때부터 지금까지 ~로 알려져 왔다'는 계속의 뜻이다.",
      "example": {
        "en": "The shop has been closed since Monday.",
        "ko": "그 가게는 월요일부터 문을 닫은 상태다."
      },
      "note": "since + 과거 시점 → 주절은 현재완료."
    }
  ],
