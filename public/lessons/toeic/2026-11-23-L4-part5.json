  "grammar": [
    {
      "id": "g1",
      "title": "부정어 Not only 도치",
      "tags": [
        "도치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Not only did the firm exceed"
      ],
      "explanation": "Not only, Never, Rarely, Only then 같은 부정·제한 표현이 문장 맨 앞에 오면 조동사 + 주어 + 동사 순서로 바뀐다. 일반동사 문장은 do/does/did를 꺼내 쓴다.",
      "example": {
        "en": "Not only does the hotel offer free parking, but it also provides airport transfers.",
        "ko": "그 호텔은 무료 주차를 제공할 뿐 아니라 공항 픽업도 해 준다."
      },
      "note": "Not only ___ the + 명사 + 동사원형 → 빈칸은 do/does/did. 시제는 뒤 절로 판단."
    },
    {
      "id": "g2",
      "title": "가정법 도치 Had + S + p.p.",
      "tags": [
        "가정법",
        "도치"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Had the contractor submitted"
      ],
      "explanation": "가정법 과거완료의 If S had p.p.는 If를 빼고 Had S p.p.로 쓸 수 있다. 주절은 would have p.p.(과거 결과) 또는 would + 동사원형(현재 결과, 혼합 가정법)이다.",
      "example": {
        "en": "Had we left earlier, we would have caught the train.",
        "ko": "더 일찍 나섰더라면 기차를 탔을 텐데."
      },
      "note": "문장 첫 빈칸 + 주어 + p.p. + 콤마 → Had."
    },
    {
      "id": "g3",
      "title": "복합관계형용사 whatever + 명사",
      "tags": [
        "관계사",
        "명사절"
      ],
      "sentenceId": "s5",
      "highlight": [
        "whatever support the team needs"
      ],
      "explanation": "whatever + 명사 + S + V는 \"S가 V하는 어떤 명사든\"이라는 명사절이다. any + 명사 + that S V로 바꿔 쓸 수 있다.",
      "example": {
        "en": "You may choose whatever seat you like.",
        "ko": "원하는 좌석은 어느 것이든 고르셔도 됩니다."
      },
      "note": "빈칸 바로 뒤에 명사 + 불완전한 절 → whatever/whichever."
    }
  ],
