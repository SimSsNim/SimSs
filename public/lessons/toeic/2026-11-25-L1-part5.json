  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "새로 온 매니저가 그 프로젝트에 대해 아주 명확하게 설명해 주었다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "Kim 씨는 보통 매일 아침 기차를 타고 출근한다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "금요일까지 인사부로 지원서를 보내 주세요."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "고객은 구매 후 30일 이내에 물품을 반품할 수 있다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "Patel 씨는 판매 보고서의 숫자들을 꼼꼼하게 확인했다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "사무실 창문은 매달 전문 업체가 청소한다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "회의실을 나갈 때는 불을 꺼 주세요."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "Lopez 씨가 내일 신입 사원 교육을 진행할 것이다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "이 노트북은 가볍고 가격이 적당해서 인기가 많다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "회사는 올해 영업 사원을 세 명 더 채용하기로 결정했다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Our new manager gave a very clear explanation of the project.",
      "ko": "새로 온 매니저가 그 프로젝트에 대해 아주 명확하게 설명해 주었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Ms. Kim usually takes the train to work every morning.",
      "ko": "Kim 씨는 보통 매일 아침 기차를 타고 출근한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Please send your application to the human resources department by Friday.",
      "ko": "금요일까지 인사부로 지원서를 보내 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Customers can return items within thirty days of purchase.",
      "ko": "고객은 구매 후 30일 이내에 물품을 반품할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Mr. Patel carefully checked the numbers in the sales report.",
      "ko": "Patel 씨는 판매 보고서의 숫자들을 꼼꼼하게 확인했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The office windows are cleaned by a professional company every month.",
      "ko": "사무실 창문은 매달 전문 업체가 청소한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Please turn off the lights when you leave the meeting room.",
      "ko": "회의실을 나갈 때는 불을 꺼 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Ms. Lopez will lead the training session for new employees tomorrow.",
      "ko": "Lopez 씨가 내일 신입 사원 교육을 진행할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "This laptop is popular because it is light and affordable.",
      "ko": "이 노트북은 가볍고 가격이 적당해서 인기가 많다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "The company decided to hire three more sales representatives this year.",
      "ko": "회사는 올해 영업 사원을 세 명 더 채용하기로 결정했다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
