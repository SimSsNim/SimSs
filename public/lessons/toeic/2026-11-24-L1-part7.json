  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "Why did Ms. Whitfield write to Ms. Alvarez?",
      "choices": [
        {
          "key": "A",
          "text": "To invite her to an interview"
        },
        {
          "key": "B",
          "text": "To schedule a fitness class"
        },
        {
          "key": "C",
          "text": "To offer her a job"
        },
        {
          "key": "D",
          "text": "To ask for a recommendation"
        }
      ],
      "answer": "C",
      "evidenceSentenceIds": [
        "s2"
      ],
      "explanationKo": "두 번째 문단 첫 문장 'I am pleased to offer you the position'이 단서. 일자리를 제안하는 편지다. position → job으로 바꿔 말했다.",
      "choiceNotesKo": {
        "A": "면접은 '지난 화요일'에 이미 끝났다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What will Ms. Alvarez do during her first week?",
      "choices": [
        {
          "key": "A",
          "text": "Learn how to use some software"
        },
        {
          "key": "B",
          "text": "Lead some fitness classes"
        },
        {
          "key": "C",
          "text": "Clean the swimming pool"
        },
        {
          "key": "D",
          "text": "Interview new members"
        }
      ],
      "answer": "A",
      "evidenceSentenceIds": [
        "s7"
      ],
      "explanationKo": "'During your first week, ... will teach you how to use our computer system'이 단서. 컴퓨터 시스템 사용법을 배운다 → 소프트웨어 사용법을 배운다(패러프레이징).",
      "choiceNotesKo": {
        "B": "그녀의 업무는 수업을 '예약'하는 것이지 진행하는 것이 아니다."
      },
      "skill": "세부 사항(패러프레이징)"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-not-true",
      "prompt": "What is NOT mentioned about the position?",
      "choices": [
        {
          "key": "A",
          "text": "It includes answering the phone."
        },
        {
          "key": "B",
          "text": "It allows free use of the facilities."
        },
        {
          "key": "C",
          "text": "It begins in June."
        },
        {
          "key": "D",
          "text": "It requires weekend work."
        }
      ],
      "answer": "D",
      "evidenceSentenceIds": [
        "s4",
        "s5",
        "s6",
        "s8"
      ],
      "explanationKo": "근무일은 'from Monday to Friday(월~금)'라서 주말 근무는 언급되지 않았다. 전화 응대(s6), 시설 무료 이용(s8), 6월 시작(s4)은 모두 나온다.",
      "choiceNotesKo": {
        "B": "'use the gym and swimming pool for free'를 바꿔 말한 것으로 본문에 있다."
      },
      "skill": "사실이 아닌 것(NOT)"
    }
  ]
