  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Alvarez 씨께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3"
      ],
      "ko": "Pinecrest 피트니스 센터의 프런트 데스크 보조 자리를 제안하게 되어 기쁩니다. 지난 화요일 만나서 즐거웠고, 당신의 친절한 성격이 우리 팀에 잘 맞을 것이라고 믿습니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s4",
        "s5",
        "s6",
        "s7",
        "s8"
      ],
      "ko": "첫 출근일은 6월 2일 월요일입니다. 월요일부터 금요일까지 주 5일 근무하게 됩니다. 주요 업무는 회원 맞이, 전화 응대, 운동 수업 예약입니다. 첫 주 동안 매니저인 Doyle 씨가 저희 컴퓨터 시스템 사용법을 가르쳐 드릴 것입니다. 직원으로서 헬스장과 수영장도 무료로 이용할 수 있습니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s9",
        "s10",
        "s11"
      ],
      "ko": "동봉한 계약서에 서명하여 5월 20일까지 제게 돌려보내 주세요. 궁금한 점이 있으면 555-0148로 편하게 전화 주세요. 함께 일하게 되기를 기대합니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s12"
      ],
      "ko": "진심을 담아,"
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s13"
      ],
      "ko": "Karen Whitfield, Pinecrest 피트니스 센터 관리자"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Ms. Alvarez,",
      "ko": "Alvarez 씨께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "I am pleased to offer you the position of front desk assistant at Pinecrest Fitness Center.",
      "ko": "Pinecrest 피트니스 센터의 프런트 데스크 보조 자리를 제안하게 되어 기쁩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "We enjoyed meeting you last Tuesday, and we believe your friendly personality will be a great fit for our team.",
      "ko": "지난 화요일 만나서 즐거웠고, 당신의 친절한 성격이 우리 팀에 잘 맞을 것이라고 믿습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p3",
      "en": "Your first day of work will be Monday, June 2.",
      "ko": "첫 출근일은 6월 2일 월요일입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p3",
      "en": "You will work five days a week, from Monday to Friday.",
      "ko": "월요일부터 금요일까지 주 5일 근무하게 됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "Your main duties will include greeting members, answering phone calls, and booking fitness classes.",
      "ko": "주요 업무는 회원 맞이, 전화 응대, 운동 수업 예약입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "During your first week, our manager, Mr. Doyle, will teach you how to use our computer system.",
      "ko": "첫 주 동안 매니저인 Doyle 씨가 저희 컴퓨터 시스템 사용법을 가르쳐 드릴 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "As a staff member, you can also use the gym and swimming pool for free.",
      "ko": "직원으로서 헬스장과 수영장도 무료로 이용할 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "Please sign the enclosed contract and return it to me by May 20.",
      "ko": "동봉한 계약서에 서명하여 5월 20일까지 제게 돌려보내 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "If you have any questions, feel free to call me at 555-0148.",
      "ko": "궁금한 점이 있으면 555-0148로 편하게 전화 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p4",
      "en": "We look forward to working with you.",
      "ko": "함께 일하게 되기를 기대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p5",
      "en": "Sincerely,",
      "ko": "진심을 담아,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s13",
      "paragraphId": "p6",
      "en": "Karen Whitfield, Manager, Pinecrest Fitness Center",
      "ko": "Karen Whitfield, Pinecrest 피트니스 센터 관리자",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
