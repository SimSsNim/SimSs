  "grammar": [
    {
      "id": "g1",
      "title": "from A until B",
      "tags": [
        "전치사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "from eleven in the morning until six in the evening"
      ],
      "explanation": "from A until B = A부터 B까지. 시간의 시작과 끝을 함께 말할 때 쓴다.",
      "example": {
        "en": "The store is open from ten until nine.",
        "ko": "그 가게는 10시부터 9시까지 연다."
      },
      "note": "from이 보이면 짝이 되는 until/to를 고른다."
    },
    {
      "id": "g2",
      "title": "미래 수동태 will be kept",
      "tags": [
        "수동태"
      ],
      "sentenceId": "s6",
      "highlight": [
        "will also be kept"
      ],
      "explanation": "분실물(Lost items)은 스스로 보관하는 것이 아니라 '보관되는' 것이라 will be + 과거분사.",
      "example": {
        "en": "Your bags will be kept in a safe place.",
        "ko": "가방은 안전한 곳에 보관될 것이다."
      },
      "note": "사물 주어 + 빈칸 + 전치사구 → 수동태 자리일 가능성이 높다."
    },
    {
      "id": "g3",
      "title": "사람을 꾸미는 관계대명사 who",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "Shoppers who need help"
      ],
      "explanation": "who는 사람 명사 뒤에서 '~하는 (사람)'이라는 뜻으로 꾸며 준다. who 뒤에는 동사가 바로 온다.",
      "example": {
        "en": "Employees who work late can take a taxi.",
        "ko": "늦게까지 일하는 직원은 택시를 탈 수 있다."
      },
      "note": "사람 명사 + 빈칸 + 동사 → who."
    }
  ],
