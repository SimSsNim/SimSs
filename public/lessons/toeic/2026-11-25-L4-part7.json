  "grammar": [
    {
      "id": "g1",
      "title": "관계대명사 which 계속적 용법",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s10",
      "highlight": [
        "which featured"
      ],
      "explanation": "콤마 + which는 앞의 명사(사물)에 대한 정보를 덧붙인다. that은 콤마 뒤에 쓸 수 없다.",
      "example": {
        "en": "The new office, which opened in May, has a rooftop garden.",
        "ko": "5월에 문을 연 새 사무실에는 옥상 정원이 있다."
      },
      "note": "콤마 뒤 관계대명사 자리에 that은 오답."
    },
    {
      "id": "g2",
      "title": "be supposed to + 수동 (to be p.p.)",
      "tags": [
        "to부정사",
        "수동태"
      ],
      "sentenceId": "s13",
      "highlight": [
        "were supposed to be set out"
      ],
      "explanation": "be supposed to V는 '~하기로 되어 있다(예정·의무)'. 주어가 동작을 받으면 to be p.p.를 쓴다. 과거형 were supposed to는 '그랬어야 했는데 안 됐다'는 뉘앙스가 있다.",
      "example": {
        "en": "The report was supposed to be finished yesterday.",
        "ko": "보고서는 어제 끝났어야 했다."
      },
      "note": "be supposed to / be scheduled to / be expected to는 Part 7 일정 관련 문장에 자주 나온다."
    },
    {
      "id": "g3",
      "title": "과거완료 (had p.p.)",
      "tags": [
        "시제"
      ],
      "sentenceId": "s11",
      "highlight": [
        "had rarely been served"
      ],
      "explanation": "과거의 한 시점(told me)보다 더 이전의 경험을 말할 때 had + p.p.를 쓴다. rarely(거의 ~ 않다)는 had와 p.p. 사이에 온다.",
      "example": {
        "en": "She said she had never visited Seoul before.",
        "ko": "그녀는 전에 서울에 가 본 적이 없다고 말했다."
      },
      "note": "과거 동사 + that절 안의 더 이전 일 → had p.p."
    }
  ],
