  "grammar": [
    {
      "id": "g1",
      "title": "주격 관계대명사 who",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "Applicants who have"
      ],
      "explanation": "사람 명사(Applicants) 뒤에서 동사(have)를 바로 이끄는 관계대명사는 who. 관계절 안의 동사는 선행사에 수를 맞춘다.",
      "example": {
        "en": "Customers who order online get free shipping.",
        "ko": "온라인으로 주문하는 고객은 무료 배송을 받는다."
      },
      "note": "사람 명사 + ___ + 동사 → who (that도 가능)"
    },
    {
      "id": "g2",
      "title": "조동사 + 수동태 (must be p.p.)",
      "tags": [
        "수동태",
        "조동사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "must be displayed"
      ],
      "explanation": "허가증은 스스로 보이게 하는 것이 아니라 '놓여 보여지는' 대상이라 수동태. 조동사 뒤에는 be + p.p.",
      "example": {
        "en": "All forms must be signed by a manager.",
        "ko": "모든 서류는 관리자가 서명해야 한다."
      },
      "note": "must/can/should + ___ + 목적어 없음 → be + p.p."
    },
    {
      "id": "g3",
      "title": "현재완료 + since",
      "tags": [
        "시제",
        "접속사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "have increased",
        "since"
      ],
      "explanation": "since(~ 이후로) 뒤에는 과거 시점, 주절에는 현재완료(have + p.p.)를 쓴다.",
      "example": {
        "en": "He has worked here since 2020.",
        "ko": "그는 2020년부터 여기서 일해 왔다."
      },
      "note": "since + 과거 → 주절은 have/has p.p."
    }
  ],
