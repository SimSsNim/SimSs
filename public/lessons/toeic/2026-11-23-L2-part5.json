  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "5층의 새로 단장한 회의실은 최대 20명까지의 회의에 알맞다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "최소 3년의 경력이 있는 지원자는 2차 면접에 초대될 것이다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "Tanaka 씨는 연구팀에 기여한 공로를 인정받아 상을 받았다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "폭설에도 불구하고 화물은 제시간에 창고에 도착했다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "주차 허가증은 항상 계기판 위에 보이게 두어야 한다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "가격이 인하된 이후로 새 스마트폰의 판매량이 크게 늘었다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "출장에서 돌아오는 대로 출장 경비를 제출해 주세요."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "마케팅팀은 고객 만족도에 관한 종합적인 보고서를 준비했다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "그 호텔은 2박 넘게 머무는 모든 투숙객에게 무료 조식을 제공한다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "워크숍에 참석하고 싶은 직원은 회사 웹사이트에서 등록해야 한다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The renovated conference room on the fifth floor is suitable for meetings of up to twenty people.",
      "ko": "5층의 새로 단장한 회의실은 최대 20명까지의 회의에 알맞다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Applicants who have at least three years of experience will be invited to a second interview.",
      "ko": "최소 3년의 경력이 있는 지원자는 2차 면접에 초대될 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Ms. Tanaka received an award in recognition of her contributions to the research team.",
      "ko": "Tanaka 씨는 연구팀에 기여한 공로를 인정받아 상을 받았다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Despite the heavy snow, the shipment arrived at the warehouse on time.",
      "ko": "폭설에도 불구하고 화물은 제시간에 창고에 도착했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Parking permits must be displayed on the dashboard at all times.",
      "ko": "주차 허가증은 항상 계기판 위에 보이게 두어야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Sales of the new smartphone have increased significantly since the price was lowered.",
      "ko": "가격이 인하된 이후로 새 스마트폰의 판매량이 크게 늘었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Please submit your travel expenses as soon as you return from your business trip.",
      "ko": "출장에서 돌아오는 대로 출장 경비를 제출해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "The marketing team prepared a comprehensive report on customer satisfaction.",
      "ko": "마케팅팀은 고객 만족도에 관한 종합적인 보고서를 준비했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The hotel offers free breakfast to all guests staying more than two nights.",
      "ko": "그 호텔은 2박 넘게 머무는 모든 투숙객에게 무료 조식을 제공한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Employees who wish to attend the workshop should register on the company Web site.",
      "ko": "워크숍에 참석하고 싶은 직원은 회사 웹사이트에서 등록해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
