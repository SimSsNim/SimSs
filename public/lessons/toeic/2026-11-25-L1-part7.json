  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the purpose of the advertisement?",
      "choices": [
        {
          "key": "A",
          "text": "To announce new business hours"
        },
        {
          "key": "B",
          "text": "To hire kitchen staff"
        },
        {
          "key": "C",
          "text": "To introduce a recently opened cafe"
        },
        {
          "key": "D",
          "text": "To explain how to bake bread"
        }
      ],
      "answer": "C",
      "explanationKo": "첫 문장 'opened its doors ... last Saturday(지난 토요일에 문을 열었다)'가 단서. 문을 열었다 → recently opened(최근에 문을 연)로 바꿔 말한 C가 정답.",
      "choiceNotesKo": {
        "A": "영업시간이 나오지만 '바뀌었다'는 말은 없다.",
        "D": "빵을 직접 굽는다는 말만 있고 굽는 법을 설명하지는 않는다."
      },
      "skill": "광고의 목적",
      "evidenceSentenceIds": [
        "s2"
      ]
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What will customers who buy a sandwich get this month?",
      "choices": [
