  "grammar": [
    {
      "id": "g1",
      "title": "미래 수동태 will be held",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s4",
      "highlight": [
        "will be held"
      ],
      "explanation": "회의(meeting)는 스스로 여는 것이 아니라 '열리는' 것이라 수동태. next Thursday가 미래라서 will be + 과거분사.",
      "example": {
        "en": "The award ceremony will be held at the city hall.",
        "ko": "시상식은 시청에서 열릴 것이다."
      },
      "note": "meeting, event, conference + 빈칸 → be held가 단골 정답."
    },
    {
      "id": "g2",
      "title": "전치사 + 동명사",
      "tags": [
        "동명사",
        "전치사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "responsible for preparing"
      ],
      "explanation": "전치사(for) 뒤에 동사를 쓰려면 동명사(-ing)로 바꾼다. be responsible for -ing = ~을 맡다.",
      "example": {
        "en": "Thank you for helping me.",
        "ko": "도와줘서 고맙습니다."
      },
      "note": "for, by, before, without 뒤 빈칸 → -ing."
    },
    {
      "id": "g3",
      "title": "시간 부사절의 현재 시제",
      "tags": [
        "부사절",
        "시제"
      ],
      "sentenceId": "s8",
      "highlight": [
        "as soon as she receives"
      ],
      "explanation": "as soon as, when, before, after, until 같은 시간 부사절에서는 미래 일도 현재형으로 쓴다.",
      "example": {
        "en": "I will email you when I arrive at the office.",
        "ko": "사무실에 도착하면 이메일 보낼게요."
      },
      "note": "주절은 will, 시간 부사절은 현재형 — 짝으로 기억."
    }
  ],
