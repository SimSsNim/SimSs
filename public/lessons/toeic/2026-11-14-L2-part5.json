  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "마케팅팀은 캠페인을 시작하기 전에 고객 의견을 철저히 분석했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "영업직 지원자는 소매업 경력이 상당히 있어야 한다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "새 소프트웨어 덕분에 회계사들은 전보다 더 정확하게 송장을 처리할 수 있다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "연례 예산 회의는 다음 주 목요일 대강당에서 열린다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "교육에 참석하고 싶은 직원은 금요일까지 온라인으로 등록해야 한다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "첸 씨는 분기 매출 보고서 작성을 맡고 있다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "폭우에도 불구하고 야외 제품 시연회는 계획대로 진행되었다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "루이즈 씨는 수정된 가격표를 받는 대로 공급업체에 전화할 것이다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "새 지점장은 고객 만족도를 높이기 위해 몇 가지 변화를 실행했다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "법무팀에 보내기 전에 모든 서류가 빠짐없이 갖춰졌는지 꼭 확인해 주세요."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The marketing team conducted a thorough analysis of customer comments before launching the campaign.",
      "ko": "마케팅팀은 캠페인을 시작하기 전에 고객 의견을 철저히 분석했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Applicants for the sales position should have considerable experience in retail.",
      "ko": "영업직 지원자는 소매업 경력이 상당히 있어야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The new software allows accountants to process invoices more accurately than before.",
      "ko": "새 소프트웨어 덕분에 회계사들은 전보다 더 정확하게 송장을 처리할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "The annual budget meeting will be held in the main auditorium next Thursday.",
      "ko": "연례 예산 회의는 다음 주 목요일 대강당에서 열린다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Employees who wish to attend the training session must register online by Friday.",
      "ko": "교육에 참석하고 싶은 직원은 금요일까지 온라인으로 등록해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Ms. Chen is responsible for preparing the quarterly sales report.",
      "ko": "첸 씨는 분기 매출 보고서 작성을 맡고 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Despite the heavy rain, the outdoor product demonstration went ahead as planned.",
      "ko": "폭우에도 불구하고 야외 제품 시연회는 계획대로 진행되었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Ms. Ruiz will call the supplier as soon as she receives the revised price list.",
      "ko": "루이즈 씨는 수정된 가격표를 받는 대로 공급업체에 전화할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The new branch manager has implemented several changes to improve customer satisfaction.",
      "ko": "새 지점장은 고객 만족도를 높이기 위해 몇 가지 변화를 실행했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Please make sure that all documents are complete before you send them to the legal team.",
      "ko": "법무팀에 보내기 전에 모든 서류가 빠짐없이 갖춰졌는지 꼭 확인해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
