 "wordCount": 158,
 "paragraphs": [
  {
   "id": "p1",
   "sentenceIds": [
    "s1"
   ],
   "ko": "수신: 고객 지원 전 직원"
  },
  {
   "id": "p2",
   "sentenceIds": [
    "s2"
   ],
   "ko": "발신: 다나 휫필드, 고객 경험 관리자"
  },
  {
   "id": "p3",
   "sentenceIds": [
    "s3"
   ],
   "ko": "제목: 회신 전화 정책 변경"
  },
  {
   "id": "p4",
   "sentenceIds": [
    "s4",
    "s5",
    "s6"
   ],
   "ko": "4월 1일부터 즉시 해결할 수 없는 고객 전화를 처리하는 새 정책을 도입합니다. 현재 방식에서는 문제가 조사된 뒤 고객이 다시 전화하도록 요청받는 경우가 많습니다. 많은 고객이 이것이 답답하다고 말해 왔습니다."
  },
  {
   "id": "p5",
   "sentenceIds": [
    "s7",
    "s8",
    "s9"
   ],
   "ko": "앞으로는 처음 전화를 받은 상담원이 영업일 기준 하루 안에 고객에게 연락할 책임을 집니다. 이는 문제가 아직 완전히 해결되지 않았더라도 마찬가지입니다. 그런 경우에는 어떤 조치가 진행 중인지, 그리고 고객이 언제 새 소식을 받을 수 있는지만 설명하면 됩니다."
  },
  {
   "id": "p6",
   "sentenceIds": [
    "s10",
    "s11",
    "s12",
    "s13"
   ],
   "ko": "관리자가 응답 시간을 확인할 수 있도록 모든 회신 전화는 지원 데이터베이스에 기록해야 합니다. 바뀐 절차에 대한 짧은 교육이 다음 주 화요일에 열립니다. 그때까지는 기존 지침을 계속 따라 주십시오. 협조해 주셔서 감사합니다."
  }
 ],
 "sentences": [
  {
   "id": "s1",
   "paragraphId": "p1",
   "en": "To: All Customer Support Staff",
   "ko": "수신: 고객 지원 전 직원",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s2",
   "paragraphId": "p2",
   "en": "From: Dana Whitfield, Customer Experience Manager",
   "ko": "발신: 다나 휫필드, 고객 경험 관리자",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s3",
   "paragraphId": "p3",
   "en": "Subject: Changes to Our Callback Policy",
   "ko": "제목: 회신 전화 정책 변경",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s4",
   "paragraphId": "p4",
   "en": "Starting on April 1, we will introduce a new policy for handling customer calls that cannot be resolved immediately.",
   "ko": "4월 1일부터 즉시 해결할 수 없는 고객 전화를 처리하는 새 정책을 도입합니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s5",
   "paragraphId": "p4",
   "en": "Under the current system, callers are often asked to phone us again once a problem has been investigated.",
   "ko": "현재 방식에서는 문제가 조사된 뒤 고객이 다시 전화하도록 요청받는 경우가 많습니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s6",
   "paragraphId": "p4",
   "en": "Many customers have told us that they find this frustrating.",
   "ko": "많은 고객이 이것이 답답하다고 말해 왔습니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s7",
   "paragraphId": "p5",
   "en": "From now on, the representative who first takes a call will be responsible for contacting the customer within one business day.",
   "ko": "앞으로는 처음 전화를 받은 상담원이 영업일 기준 하루 안에 고객에게 연락할 책임을 집니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s8",
   "paragraphId": "p5",
   "en": "This applies even if the issue has not yet been fully resolved.",
   "ko": "이는 문제가 아직 완전히 해결되지 않았더라도 마찬가지입니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s9",
   "paragraphId": "p5",
   "en": "In such cases, simply explain what steps are being taken and when the customer can expect an update.",
   "ko": "그런 경우에는 어떤 조치가 진행 중인지, 그리고 고객이 언제 새 소식을 받을 수 있는지만 설명하면 됩니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s10",
   "paragraphId": "p6",
   "en": "All callbacks must be recorded in the support database so that managers can monitor response times.",
   "ko": "관리자가 응답 시간을 확인할 수 있도록 모든 회신 전화는 지원 데이터베이스에 기록해야 합니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s11",
   "paragraphId": "p6",
   "en": "A short training session on the updated procedure will be held next Tuesday.",
   "ko": "바뀐 절차에 대한 짧은 교육이 다음 주 화요일에 열립니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s12",
   "paragraphId": "p6",
   "en": "Until then, please continue to follow the existing guidelines.",
   "ko": "그때까지는 기존 지침을 계속 따라 주십시오.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s13",
   "paragraphId": "p6",
   "en": "Thank you for your cooperation.",
   "ko": "협조해 주셔서 감사합니다.",
   "audioStartSec": null,
   "audioEndSec": null
  }
 ],
