  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "수신: 모든 부서장"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "발신: 레나타 솔버그, 재무 이사"
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "날짜: 11월 25일"
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "제목: 새 경비 보고 절차"
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5",
        "s6",
        "s7",
        "s8"
      ],
      "ko": "12월 1일부터 모든 경비 보고서는 새 온라인 회계 플랫폼인 클리어레저를 통해 제출해야 합니다. 이 시스템은 현재 직원들이 손으로 작성하는 종이 양식을 대신하게 됩니다. 영수증을 휴대전화로 촬영해 바로 올릴 수 있으므로 더 이상 보고서를 저희 사무실로 가져오실 필요가 없습니다. 현재 절차에서는 2주가 걸리는 데 비해, 환급금은 영업일 기준 5일 이내에 지급될 것으로 예상합니다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s9",
        "s10",
        "s11",
        "s12"
      ],
      "ko": "직원들이 사용을 시작하도록 돕기 위해 저희 팀이 다음 주 내내 210호에서 30분짜리 교육을 진행합니다. 각 교육은 15명으로 인원이 제한되므로 일찍 등록하시길 권합니다. 시스템이 가동되기 전에 부서원 모두가 새 절차를 숙지하도록 해 주십시오. 그동안 재무부는 11월 30일까지 종이 양식을 계속 받습니다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s13"
      ],
      "ko": "협조해 주셔서 감사합니다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "To: All Department Heads",
      "ko": "수신: 모든 부서장",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "From: Renata Solberg, Finance Director",
      "ko": "발신: 레나타 솔버그, 재무 이사",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Date: November 25",
      "ko": "날짜: 11월 25일",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Subject: New Expense Reporting Procedure",
      "ko": "제목: 새 경비 보고 절차",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Beginning on December 1, all expense reports must be submitted through Clearledger, our new online accounting platform.",
      "ko": "12월 1일부터 모든 경비 보고서는 새 온라인 회계 플랫폼인 클리어레저를 통해 제출해야 합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p5",
      "en": "The system will replace the paper forms that employees currently fill out by hand.",
      "ko": "이 시스템은 현재 직원들이 손으로 작성하는 종이 양식을 대신하게 됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p5",
      "en": "Because receipts can be photographed and uploaded directly from a phone, reports will no longer need to be delivered to our office.",
      "ko": "영수증을 휴대전화로 촬영해 바로 올릴 수 있으므로 더 이상 보고서를 저희 사무실로 가져오실 필요가 없습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p5",
      "en": "We expect reimbursements to be issued within five business days, compared with two weeks under the current process.",
      "ko": "현재 절차에서는 2주가 걸리는 데 비해, 환급금은 영업일 기준 5일 이내에 지급될 것으로 예상합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p6",
      "en": "To help staff get started, our team will hold thirty-minute training sessions in Room 210 throughout next week.",
      "ko": "직원들이 사용을 시작하도록 돕기 위해 저희 팀이 다음 주 내내 210호에서 30분짜리 교육을 진행합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p6",
      "en": "Each session is limited to fifteen people, so we recommend registering early.",
      "ko": "각 교육은 15명으로 인원이 제한되므로 일찍 등록하시길 권합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p6",
      "en": "Please make sure that everyone in your department is familiar with the new procedure before the system goes live.",
      "ko": "시스템이 가동되기 전에 부서원 모두가 새 절차를 숙지하도록 해 주십시오.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p6",
      "en": "Meanwhile, the finance department will continue to accept paper forms until November 30.",
      "ko": "그동안 재무부는 11월 30일까지 종이 양식을 계속 받습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s13",
      "paragraphId": "p7",
      "en": "Thank you for your cooperation.",
      "ko": "협조해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
