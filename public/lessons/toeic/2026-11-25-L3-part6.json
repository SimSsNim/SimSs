  "grammar": [
    {
      "id": "g1",
      "title": "조동사 + 수동태 (must be p.p.)",
      "tags": [
        "수동태",
        "조동사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "must be submitted"
      ],
      "explanation": "주어가 동작을 '받는' 쪽이면 조동사 뒤에 be + 과거분사를 쓴다. 보고서는 '제출되는' 것이므로 must be submitted.",
      "example": {
        "en": "All forms must be signed by a manager.",
        "ko": "모든 양식은 관리자의 서명을 받아야 한다."
      },
      "note": "must/can/will + be + ___ → 빈칸은 과거분사가 가장 흔하다."
    },
    {
      "id": "g2",
      "title": "expect + 목적어 + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "expect reimbursements to be issued"
      ],
      "explanation": "expect, ask, allow, encourage 같은 동사는 '목적어 + to부정사' 형태를 취한다. 목적어가 동작을 받으면 to be p.p.",
      "example": {
        "en": "We expect the package to arrive tomorrow.",
        "ko": "우리는 소포가 내일 도착할 것으로 예상한다."
      },
      "note": "expect/allow/require + O + to V 형태를 묻는 문제가 자주 나온다."
    },
    {
      "id": "g3",
      "title": "이유의 부사절 (Because)",
      "tags": [
        "부사절",
        "접속사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Because"
      ],
      "explanation": "Because 뒤에는 주어 + 동사가 오는 절이 온다. 뒤에 명사구만 오면 because of를 쓴다.",
      "example": {
        "en": "Because the road was closed, we took a different route.",
        "ko": "길이 막혀서 우리는 다른 길로 갔다."
      },
      "note": "Because + 절 / Because of + 명사 구분."
    }
  ],
