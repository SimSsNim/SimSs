  "grammar": [
    {
      "id": "g1",
      "title": "So + 형용사 + be + 주어 + that (도치)",
      "tags": [
        "도치"
      ],
      "sentenceId": "s5",
      "highlight": [
        "So popular was the new tablet that"
      ],
      "explanation": "강조를 위해 so + 형용사를 문장 맨 앞에 두면 뒤는 의문문 어순(be동사 + 주어)이 된다. 동사의 수는 뒤에 오는 주어에 맞춘다.",
      "example": {
        "en": "So crowded was the station that we missed the train.",
        "ko": "역이 너무 붐벼서 우리는 기차를 놓쳤다."
      },
      "note": "문장이 So + 형용사로 시작하면 빈칸은 주어 앞의 be동사 — 뒤 주어의 수·시제를 확인하자."
    },
    {
      "id": "g2",
      "title": "복합관계형용사 whichever",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Whichever of the two venues"
      ],
      "explanation": "whichever는 '어느 ~이든'이라는 뜻으로, 정해진 선택지 사이에서 고를 때 쓴다. 문장 앞에서 양보의 부사절을 만든다.",
      "example": {
        "en": "Whichever option you choose, the price is the same.",
        "ko": "어느 옵션을 고르든 가격은 같다."
      },
      "note": "of the two / of these 같은 범위 표현이 있으면 whatever가 아니라 whichever."
    },
    {
      "id": "g3",
      "title": "당위의 that절: (should) + 동사원형",
      "tags": [
        "가정법",
        "조동사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "It is essential that every visitor wear"
      ],
      "explanation": "essential, important, necessary 같은 형용사나 require, recommend, insist 같은 동사 뒤 that절은 '~해야 한다'는 당위를 나타내므로 동사원형을 쓴다.",
      "example": {
        "en": "The manager requested that each report be submitted by noon.",
        "ko": "관리자는 각 보고서를 정오까지 제출하라고 요청했다."
      },
      "note": "주어가 3인칭 단수라도 -s를 붙이지 않는다 — 토익 고난도 단골 함정."
    }
  ],
