  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the article mainly about?",
      "choices": [
        {
          "key": "A",
          "text": "The closing of a local printing business"
        },
        {
          "key": "B",
          "text": "A company's plan to create jobs in a new location"
        },
        {
          "key": "C",
          "text": "A new line of camping equipment"
        },
        {
          "key": "D",
          "text": "The results of a staff training program"
        }
      ],
      "answer": "B",
      "explanationKo": "펜윅이 데일스퍼드에 고객 서비스 센터를 열고(s2) 약 120명을 채용할 계획이라는(s4) 내용이 기사의 중심이다. '새 지역에 일자리를 만드는 회사의 계획'으로 바꿔 말한 B가 정답.",
      "choiceNotesKo": {
        "A": "캐로 인쇄소 건물은 센터가 들어설 장소로 잠깐 언급될 뿐, 폐업 자체가 주제는 아니다.",
        "D": "교육 과정은 신입 직원이 앞으로 받을 것으로, 결과를 다루지 않는다."
      },
      "evidenceSentenceIds": [
        "s2",
        "s4"
      ],
      "skill": "주제 찾기"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "According to the article, why was Dalesford selected?",
      "choices": [
        {
          "key": "A",
          "text": "The company's founder grew up there."
        },
        {
          "key": "B",
          "text": "Its rental costs are lower than those in Portland."
        },
        {
          "key": "C",
          "text": "It is close to the company's main factory."
        },
        {
          "key": "D",
          "text": "Many people there have recently finished university."
        }
      ],
      "answer": "D",
      "explanationKo": "s10에서 편리한 위치와 '많은 수의 최근 대학 졸업생(large number of recent college graduates)' 때문에 선정되었다고 한다. 이를 '최근 대학을 마친 사람이 많다'로 바꿔 말한 D가 정답.",
      "choiceNotesKo": {
        "C": "'편리한 위치'라고만 했지 공장과 가깝다는 말은 없다.",
        "B": "임대료 비교는 기사에 나오지 않는다."
      },
      "evidenceSentenceIds": [
        "s10"
      ],
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-synonym",
      "prompt": "In the article, the word \"handle\" is closest in meaning to",
      "choices": [
        {
          "key": "A",
          "text": "touch"
        },
        {
          "key": "B",
          "text": "carry"
        },
        {
          "key": "C",
          "text": "deal with"
        },
        {
          "key": "D",
          "text": "control"
        }
      ],
      "answer": "C",
      "explanationKo": "handle online chat requests는 '온라인 채팅 문의를 처리하다'라는 뜻이다. 요청·문의를 '처리하다, 응대하다'라는 의미이므로 deal with가 가장 가깝다.",
      "choiceNotesKo": {
        "A": "touch는 '손으로 만지다'라는 handle의 다른 뜻이다.",
        "D": "control은 '통제하다, 지배하다'라서 문의를 처리한다는 뜻과 다르다."
      },
      "evidenceSentenceIds": [
        "s4"
      ],
      "skill": "동의어"
    }
