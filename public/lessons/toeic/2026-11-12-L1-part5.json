  "grammar": [
    {
      "id": "g1",
      "title": "품사 자리: be동사 뒤 형용사, 동사 뒤 부사",
      "tags": [
        "품사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "is responsible"
      ],
      "explanation": "Part 5에서 가장 많이 나오는 유형. be동사 뒤 보어 자리는 형용사, 동사를 꾸미는 자리는 부사(-ly)다.",
      "example": {
        "en": "The test was difficult.",
        "ko": "시험이 어려웠다."
      },
      "note": "보기 4개가 같은 어근(respons-)이면 품사 문제다. 빈칸 앞뒤만 보고 빨리 푼다."
    },
    {
      "id": "g2",
      "title": "현재완료 + since / for",
      "tags": [
        "시제",
        "전치사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "has worked",
        "since 2019"
      ],
      "explanation": "과거부터 지금까지 계속된 일은 have/has + p.p.. since 뒤에는 시작 시점, for 뒤에는 기간.",
      "example": {
        "en": "I have lived here for three years.",
        "ko": "나는 여기 3년째 살고 있다."
      },
      "note": "since가 보이면 현재완료, 현재완료가 보이면 since/for를 찾는다."
    },
    {
      "id": "g3",
      "title": "주격 관계대명사 who",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "guests who stay"
      ],
      "explanation": "사람 선행사 + who + 동사. 뒤에 주어가 빠져 있으면 주격 관계대명사 자리다.",
      "example": {
        "en": "I know a man who speaks French.",
        "ko": "나는 프랑스어를 하는 남자를 안다."
      },
      "note": "사물이면 which, 소유면 whose."
    }
  ],
