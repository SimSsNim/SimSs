  "wordCount": 135,
  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Novak 님께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4"
      ],
      "ko": "커피 메이커에 관해 Brenton Appliances에 연락해 주셔서 감사합니다. 저희 기록에 따르면 고객님은 8개월 전에 기계를 구입하셨으므로 아직 1년 보증이 적용됩니다. 이는 수리 비용을 내지 않으셔도 된다는 뜻입니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s5",
        "s6",
        "s7",
        "s8"
      ],
      "ko": "가능하면 기계를 원래 상자에 포장해서 저희 서비스 센터로 보내 주세요. 이 편지에 요금이 미리 지불된 배송 라벨이 들어 있습니다. 기술자들이 기계를 받으면 영업일 기준 5일 안에 점검할 것입니다. 수리된 제품은 보통 2주 정도 뒤에 고객에게 돌려보내집니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s9",
        "s10"
      ],
      "ko": "기계를 고칠 수 없으면 같은 기능을 가진 새 제품으로 교환해 드리겠습니다. 이로 인해 겪으신 불편에 사과드리며, 기다려 주셔서 감사합니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s11"
      ],
      "ko": "드림,"
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s12"
      ],
      "ko": "Irene Walsh, 고객 지원 매니저"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Mr. Novak,",
      "ko": "Novak 님께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for contacting Brenton Appliances about your coffee maker.",
      "ko": "커피 메이커에 관해 Brenton Appliances에 연락해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "According to our records, you purchased the machine eight months ago, so it is still covered by our one-year warranty.",
      "ko": "저희 기록에 따르면 고객님은 8개월 전에 기계를 구입하셨으므로 아직 1년 보증이 적용됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "This means that you will not have to pay for the repair.",
      "ko": "이는 수리 비용을 내지 않으셔도 된다는 뜻입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p3",
      "en": "Please pack the machine in its original box, if possible, and send it to our service center.",
      "ko": "가능하면 기계를 원래 상자에 포장해서 저희 서비스 센터로 보내 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "A prepaid shipping label is included with this letter.",
      "ko": "이 편지에 요금이 미리 지불된 배송 라벨이 들어 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "Once our technicians receive the machine, they will inspect it within five business days.",
      "ko": "기술자들이 기계를 받으면 영업일 기준 5일 안에 점검할 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "Repaired items are usually returned to customers in about two weeks.",
      "ko": "수리된 제품은 보통 2주 정도 뒤에 고객에게 돌려보내집니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "If the machine cannot be fixed, we will replace it with a new one that has the same features.",
      "ko": "기계를 고칠 수 없으면 같은 기능을 가진 새 제품으로 교환해 드리겠습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "We are sorry for any trouble this has caused, and we appreciate your patience.",
      "ko": "이로 인해 겪으신 불편에 사과드리며, 기다려 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p5",
      "en": "Sincerely,",
      "ko": "드림,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p6",
      "en": "Irene Walsh, Customer Support Manager",
      "ko": "Irene Walsh, 고객 지원 매니저",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
