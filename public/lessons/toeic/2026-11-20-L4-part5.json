  "grammar": [
    {
      "id": "g1",
      "title": "보어 도치 (So + 형용사 + 동사 + 주어)",
      "tags": [
        "도치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "So popular was the negotiation workshop"
      ],
      "explanation": "so ~ that 구문에서 'So + 형용사'를 문장 맨 앞에 두면 동사가 주어 앞으로 나온다. 주어 the negotiation workshop이 단수이므로 was를 쓴다.",
      "example": {
        "en": "So crowded was the station that we took a taxi.",
        "ko": "역이 너무 붐벼서 우리는 택시를 탔다."
      },
      "note": "문장이 So/Only/Never 등으로 시작하면 도치를 의심하고, 뒤에 오는 주어에 수를 맞춘다."
    },
    {
      "id": "g2",
      "title": "복합관계대명사 whoever",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Whoever wishes"
      ],
      "explanation": "Whoever는 '~하는 사람은 누구든'이라는 뜻으로 명사절을 이끌고, 절 안에서 주어 역할을 한다. 뒤에 동사 wishes가 바로 오므로 주격인 Whoever가 맞다.",
      "example": {
        "en": "Whoever finishes first can leave early.",
        "ko": "먼저 끝내는 사람은 누구든 일찍 가도 된다."
      },
      "note": "빈칸 뒤에 동사가 바로 오고 주절 동사도 따로 있으면 Whoever. 목적어가 빠진 자리는 whomever."
    },
    {
      "id": "g3",
      "title": "당위의 that절 (동사원형)",
      "tags": [
        "조동사",
        "생략"
      ],
      "sentenceId": "s6",
      "highlight": [
        "It is essential that every visitor wear"
      ],
      "explanation": "essential, necessary, important 같은 형용사 뒤 that절에서는 (should) + 동사원형을 쓴다. should가 생략되어 주어가 단수라도 wear를 쓴다.",
      "example": {
        "en": "It is important that each member attend the meeting.",
        "ko": "모든 회원이 회의에 참석하는 것이 중요하다."
      },
      "note": "essential/imperative/recommend/request + that S ___ → 동사원형."
    }
  ],
