  "grammar": [
    {
      "id": "g1",
      "title": "If 생략 가정법 도치 (Should + S + V)",
      "tags": [
        "도치",
        "가정법"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Should you have trouble"
      ],
      "explanation": "If you should have trouble ~에서 If를 빼면 Should가 주어 앞으로 나간다. '혹시 ~한다면'이라는 뜻으로 안내문 끝부분에 자주 나온다.",
      "example": {
        "en": "Should you need assistance, please call the front desk.",
        "ko": "도움이 필요하시면 안내 데스크로 전화해 주세요."
      },
      "note": "문장 맨 앞 빈칸 + 뒤에 주어 + 동사원형 → Should."
    },
    {
      "id": "g2",
      "title": "복합관계대명사 whichever",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "whichever is more convenient"
      ],
      "explanation": "whichever = any one that(어느 것이든 ~한 것). 정해진 선택지(대면/온라인) 중 하나를 고를 때 쓰며 뒤 절의 주어가 빠져 있다.",
      "example": {
        "en": "You can pay by card or in cash, whichever you prefer.",
        "ko": "카드나 현금 중 원하시는 쪽으로 결제하면 됩니다."
      },
      "note": "선택지가 앞에 나와 있으면 whatever보다 whichever."
    },
    {
      "id": "g3",
      "title": "inform + 사람 + of + 내용 (수동태)",
      "tags": [
        "수동태",
        "어휘"
      ],
      "sentenceId": "s12",
      "highlight": [
        "informed of"
      ],
      "explanation": "inform은 '사람'을 목적어로 받아 inform A of B(A에게 B를 알리다)로 쓴다. 수동태로 바꾸면 A be informed of B.",
      "example": {
        "en": "All staff were informed of the new policy.",
        "ko": "전 직원이 새 정책을 안내받았다."
      },
      "note": "announce, explain, describe는 사람을 바로 목적어로 받지 않는다."
    }
  ],
