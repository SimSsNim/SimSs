  "grammar": [
    {
      "id": "g1",
      "title": "현재완료 수동태 has been p.p.",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s2",
      "highlight": [
        "has been reviewed by"
      ],
      "explanation": "보고서는 '검토되는' 대상이고, 검토가 이미 끝났다는 의미라 현재완료 수동태 has been + p.p.를 쓴다.",
      "example": {
        "en": "The contract has been signed by both companies.",
        "ko": "계약서는 두 회사 모두 서명을 마쳤다."
      },
      "note": "has been 뒤 빈칸 + by → 과거분사."
    },
    {
      "id": "g2",
      "title": "소유격 관계대명사 whose",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "whose applications"
      ],
      "explanation": "whose는 '그 사람의'라는 소유 관계를 나타내며 뒤에 관사 없는 명사가 바로 온다. Candidates의 applications.",
      "example": {
        "en": "We hired a designer whose work won several awards.",
        "ko": "우리는 작품이 여러 상을 받은 디자이너를 채용했다."
      },
      "note": "관계사 뒤에 명사 + 동사가 오면 whose."
    },
    {
      "id": "g3",
      "title": "suggest + 동명사",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "suggested postponing"
      ],
      "explanation": "suggest(제안하다)는 to부정사가 아니라 동명사(-ing)를 목적어로 쓴다.",
      "example": {
        "en": "He suggested meeting in the lobby.",
        "ko": "그는 로비에서 만나자고 제안했다."
      },
      "note": "suggest, consider, avoid, recommend + -ing."
    }
  ],
