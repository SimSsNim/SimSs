  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "이사회는 비용에 대한 긴 논의 끝에 그 제안을 승인했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "연간 매출 보고서는 재무팀의 검토를 마쳤다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "지원서가 선정된 지원자들은 면접을 위해 연락을 받게 된다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "그 호텔은 공항에서 멀지만 투숙객에게 무료 셔틀 서비스를 제공한다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "업데이트된 소프트웨어는 신입 직원이 배우기에 놀라울 정도로 쉽다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "노박 씨는 디자인이 확정될 때까지 제품 출시를 미루자고 제안했다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "저희 고객 서비스 상담원들은 모든 제품에 대해 잘 알고 있습니다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "보안 직원이 신분증을 확인할 수 있도록 15분 일찍 도착해 주세요."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "새 지점장은 해외 영업 분야에서 폭넓은 경험을 가지고 있다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "그 박물관은 여름 휴가철 동안 개관 시간을 연장할 것이다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The board of directors approved the proposal after a long discussion of its costs.",
      "ko": "이사회는 비용에 대한 긴 논의 끝에 그 제안을 승인했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The annual sales report has been reviewed by the finance team.",
      "ko": "연간 매출 보고서는 재무팀의 검토를 마쳤다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Candidates whose applications are selected will be contacted for an interview.",
      "ko": "지원서가 선정된 지원자들은 면접을 위해 연락을 받게 된다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Although the hotel is far from the airport, it offers a free shuttle service to guests.",
      "ko": "그 호텔은 공항에서 멀지만 투숙객에게 무료 셔틀 서비스를 제공한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The updated software is remarkably easy for new employees to learn.",
      "ko": "업데이트된 소프트웨어는 신입 직원이 배우기에 놀라울 정도로 쉽다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Ms. Novak suggested postponing the product launch until the design is finalized.",
      "ko": "노박 씨는 디자인이 확정될 때까지 제품 출시를 미루자고 제안했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Our customer service representatives are knowledgeable about all of our products.",
      "ko": "저희 고객 서비스 상담원들은 모든 제품에 대해 잘 알고 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Please arrive fifteen minutes early so that the security staff can check your identification.",
      "ko": "보안 직원이 신분증을 확인할 수 있도록 15분 일찍 도착해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The new branch manager has extensive experience in international sales.",
      "ko": "새 지점장은 해외 영업 분야에서 폭넓은 경험을 가지고 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "The museum will extend its opening hours during the summer holiday season.",
      "ko": "그 박물관은 여름 휴가철 동안 개관 시간을 연장할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
