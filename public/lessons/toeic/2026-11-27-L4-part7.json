  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the article mainly about?",
      "choices": [
        {
          "key": "A",
          "text": "A company's plan to move its main office to a renovated site"
        },
        {
          "key": "B",
          "text": "The closing of a long-established textile factory"
        },
        {
          "key": "C",
          "text": "A new public transportation route for city residents"
        },
        {
          "key": "D",
          "text": "The construction of a new city government building"
        }
      ],
      "answer": "A",
      "explanationKo": "s2에서 파머 바이오텍이 본사(headquarters)를 옛 섬유 단지로 이전한다고 발표했고, 이후 보수 계획과 반응이 이어진다. headquarters를 main office로, relocate를 move로 바꿔 말한 A가 정답.",
      "choiceNotesKo": {
        "B": "섬유 단지는 2015년에 이미 문을 닫았으며 기사의 중심 내용이 아니다.",
        "C": "셔틀버스는 회사가 직원을 위해 마련한 것으로, 시민을 위한 대중교통 노선이 아니다."
      },
      "evidenceSentenceIds": [
        "s2"
      ],
      "skill": "주제 찾기"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "According to the article, what problem is the move intended to solve?",
      "choices": [
        {
          "key": "A",
          "text": "Rent in the downtown area has become too high."
        },
        {
          "key": "B",
          "text": "The current buildings do not have enough parking."
        },
        {
          "key": "C",
          "text": "Employees in different locations have had difficulty working together."
        },
        {
          "key": "D",
          "text": "The company's laboratory equipment is out of date."
        }
      ],
      "answer": "C",
      "explanationKo": "s3에서 직원들을 처음으로 한 건물에 모은다고 했고, s4에서 세 건물에 흩어진 배치가 연구팀과 생산팀의 협업(collaboration)을 더디게 했다고 한다. 이를 '다른 장소의 직원들이 함께 일하기 어려웠다'로 바꿔 말한 C가 정답.",
      "choiceNotesKo": {
        "A": "임대료가 비싸다는 말은 기사에 없다.",
        "D": "실험동을 새로 짓는다고 했을 뿐, 장비가 낡았다는 언급은 없다."
      },
      "evidenceSentenceIds": [
        "s3",
        "s4"
      ],
      "skill": "세부 정보 + 패러프레이징"
    },
