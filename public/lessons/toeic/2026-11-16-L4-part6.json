 "paragraphs": [
  {
   "id": "p1",
   "sentenceIds": [
    "s1"
   ],
   "ko": "할보르센 그룹 멘토링 프로그램을 소개합니다"
  },
  {
   "id": "p2",
   "sentenceIds": [
    "s2",
    "s3",
    "s4"
   ],
   "ko": "할보르센 그룹은 최근 2년 안에 입사한 직원을 위한 멘토링 프로그램을 시작하게 되어 기쁩니다. 참가자는 다른 부서의 선배 동료와 짝을 이루며, 그렇게 함으로써 조직이 어떻게 운영되는지 더 넓은 시각을 얻게 됩니다. 멘토와 멘티는 9월부터 2월까지 진행되는 프로그램 기간 동안 최소 한 달에 한 번 만납니다."
  },
  {
   "id": "p3",
   "sentenceIds": [
    "s5",
    "s6",
    "s7"
   ],
   "ko": "멘토는 리더십 역량과 지식을 나누려는 의지를 기준으로 선발됩니다. 이들은 모두 자원해서 참여했으며 짧은 코칭 워크숍을 마쳤습니다. 그 결과 경력 개발에 관한 실질적인 조언을 줄 준비가 잘 되어 있습니다."
  },
  {
   "id": "p4",
   "sentenceIds": [
    "s8",
    "s9",
    "s10"
   ],
   "ko": "참여를 원하는 직원은 자신의 직업적 목표를 간략히 설명하는 짧은 글을 제출해야 합니다. 신청서는 8월 15일까지 접수되어야 하며, 짝 배정은 9월 초에 발표됩니다. 자세한 내용은 인사부의 잉그리드 솔베르그에게 문의해 주십시오."
  }
 ],
 "sentences": [
  {
   "id": "s1",
   "paragraphId": "p1",
   "en": "Announcing the Halvorsen Group Mentorship Program",
   "ko": "할보르센 그룹 멘토링 프로그램을 소개합니다",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s2",
   "paragraphId": "p2",
   "en": "Halvorsen Group is pleased to announce the launch of a mentorship program for employees who have joined the company within the past two years.",
   "ko": "할보르센 그룹은 최근 2년 안에 입사한 직원을 위한 멘토링 프로그램을 시작하게 되어 기쁩니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s3",
   "paragraphId": "p2",
   "en": "Participants will be paired with senior colleagues from other departments, thereby gaining a broader perspective on how the organization operates.",
   "ko": "참가자는 다른 부서의 선배 동료와 짝을 이루며, 그렇게 함으로써 조직이 어떻게 운영되는지 더 넓은 시각을 얻게 됩니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s4",
   "paragraphId": "p2",
   "en": "Mentors and mentees will meet at least once a month for the duration of the program, which runs from September through February.",
   "ko": "멘토와 멘티는 9월부터 2월까지 진행되는 프로그램 기간 동안 최소 한 달에 한 번 만납니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s5",
   "paragraphId": "p3",
   "en": "Mentors are selected on the basis of their leadership skills and their willingness to share knowledge.",
   "ko": "멘토는 리더십 역량과 지식을 나누려는 의지를 기준으로 선발됩니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s6",
   "paragraphId": "p3",
   "en": "Each of them has volunteered to take part and has completed a brief coaching workshop.",
   "ko": "이들은 모두 자원해서 참여했으며 짧은 코칭 워크숍을 마쳤습니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s7",
   "paragraphId": "p3",
   "en": "As a result, they are well prepared to offer practical guidance on career development.",
   "ko": "그 결과 경력 개발에 관한 실질적인 조언을 줄 준비가 잘 되어 있습니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s8",
   "paragraphId": "p4",
   "en": "Employees who wish to participate must submit a brief statement outlining their professional goals.",
   "ko": "참여를 원하는 직원은 자신의 직업적 목표를 간략히 설명하는 짧은 글을 제출해야 합니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s9",
   "paragraphId": "p4",
   "en": "Applications must be received by August 15, and pairings will be announced in early September.",
   "ko": "신청서는 8월 15일까지 접수되어야 하며, 짝 배정은 9월 초에 발표됩니다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s10",
   "paragraphId": "p4",
   "en": "For further details, please contact Ingrid Solberg in the human resources department.",
   "ko": "자세한 내용은 인사부의 잉그리드 솔베르그에게 문의해 주십시오.",
   "audioStartSec": null,
   "audioEndSec": null
  }
 ],
