  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the article mainly about?",
      "choices": [
        {
          "key": "A",
          "text": "A merger between two shipping firms"
        },
        {
          "key": "B",
          "text": "A company's plan to begin operating a new facility"
        },
        {
          "key": "C",
          "text": "A change in a city's delivery regulations"
        },
        {
          "key": "D",
          "text": "The results of a survey of online shoppers"
        }
      ],
      "answer": "B",
      "evidenceSentenceIds": [
        "s2"
      ],
      "explanationKo": "첫 문장에서 던모어 화물이 내년 봄 새 물류센터를 연다고 발표했다고 한다. 이를 '새 시설 운영을 시작할 계획'으로 바꿔 말한 B가 정답이다.",
      "choiceNotesKo": {
        "A": "합병 이야기는 없다.",
        "C": "시의 배송 규정 변경은 언급되지 않는다."
      },
      "skill": "주제 찾기"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "According to the article, what will Halvern Technical College help Dunmore Freight do?",
      "choices": [
        {
          "key": "A",
          "text": "Design automated sorting equipment"
        },
        {
          "key": "B",
          "text": "Select a location for the new center"
        },
        {
          "key": "C",
          "text": "Recruit drivers from other regions"
        },
        {
          "key": "D",
          "text": "Provide instruction to inexperienced applicants"
        }
      ],
      "answer": "D",
      "evidenceSentenceIds": [
        "s11"
      ],
      "explanationKo": "할번 기술대학과 제휴해 '경력이 없는 지원자를 위한 교육 과정'을 제공한다고 했다. candidates without prior experience를 inexperienced applicants로 바꿔 말한 D가 정답이다.",
      "choiceNotesKo": {
        "A": "장비 설계는 대학의 역할로 나오지 않는다.",
        "C": "오히려 케슬러 폴스 주민을 우선 채용한다고 했다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-synonym",
      "prompt": "In the article, the word \"placed\" is closest in meaning to",
      "choices": [
        {
          "key": "A",
          "text": "located"
        },
        {
          "key": "B",
          "text": "positioned"
        },
        {
          "key": "C",
          "text": "submitted"
        },
        {
          "key": "D",
          "text": "ranked"
        }
      ],
      "answer": "C",
      "evidenceSentenceIds": [
        "s7"
      ],
      "explanationKo": "orders placed before noon은 '정오 전에 접수된(넣은) 주문'이다. 주문을 '하다, 넣다'라는 뜻이므로 submitted가 가장 가깝다.",
      "choiceNotesKo": {
        "A": "located는 '(장소에) 위치한'이라는 뜻이다.",
        "B": "positioned는 물건을 어떤 위치에 '놓다'라는 뜻으로, 주문에는 쓰지 않는다.",
        "D": "ranked는 '순위가 매겨진'이라는 뜻이다."
      },
      "skill": "동의어"
    }
  ]
