  "grammar": [
    {
      "title": "현재 수동태 are + p.p.",
      "tags": [
        "수동태"
      ],
      "sentenceId": "s6",
      "highlight": [
        "are delivered"
      ],
      "explanation": "주문(orders)은 스스로 배달하는 것이 아니라 '배달되는' 것이다. 그래서 be동사 + 과거분사(p.p.) 수동태를 쓴다. 주어가 복수(All orders)라서 are.",
      "example": {
        "en": "The packages are shipped every morning.",
        "ko": "소포는 매일 아침 발송된다."
      },
      "note": "주어가 사물이고 빈칸 뒤에 목적어가 없으면 수동태를 먼저 의심하자.",
      "id": "g1"
    },
    {
      "title": "plan + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "plans to create"
      ],
      "explanation": "plan(계획하다)은 뒤에 to + 동사원형을 쓰는 동사다. 앞으로 할 일을 나타낸다.",
      "example": {
        "en": "We plan to open a new store in May.",
        "ko": "우리는 5월에 새 매장을 열 계획이다."
      },
      "note": "plan, want, decide, hope, expect 뒤에는 to부정사.",
      "id": "g2"
    },
    {
      "title": "과거 시제와 시간 표현",
      "tags": [
        "시제"
      ],
      "sentenceId": "s5",
      "highlight": [
        "traveled",
        "last month"
      ],
      "explanation": "last month(지난달)는 이미 끝난 과거다. 그래서 동사는 과거형 traveled를 쓴다.",
      "example": {
        "en": "I visited the factory last week.",
        "ko": "나는 지난주에 공장을 방문했다."
      },
      "note": "yesterday, last ~, ~ ago가 보이면 과거 시제.",
      "id": "g3"
    }
  ],
