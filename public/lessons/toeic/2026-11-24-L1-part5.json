  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "고객들은 새 온라인 주문 시스템이 사용하기 쉽다고 말한다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "그 가게는 영수증을 가져오는 고객에게 전액 환불해 줄 것이다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "신입 직원들은 지난주에 안전 교육을 성공적으로 마쳤다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "Grandview 호텔은 매일 아침 다양한 아침 식사 메뉴를 제공한다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "Patel 씨는 지난달 출장으로 싱가포르에 갔다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "50달러가 넘는 모든 주문은 무료로 배송된다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "마케팅 팀은 다음 달에 새 광고를 만들 계획이다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "회의실을 나가기 전에 불을 꺼 주세요."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "Lakeside 미술관은 일요일마다 관람객에게 문을 닫는다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "손님들은 식당 웹사이트를 통해 온라인으로 자리를 예약할 수 있다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Our customers say that the new online ordering system is simple to use.",
      "ko": "고객들은 새 온라인 주문 시스템이 사용하기 쉽다고 말한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The store will give a full refund to customers who bring their receipt.",
      "ko": "그 가게는 영수증을 가져오는 고객에게 전액 환불해 줄 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The new staff members successfully completed their safety training last week.",
      "ko": "신입 직원들은 지난주에 안전 교육을 성공적으로 마쳤다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "The Grandview Hotel offers a wide selection of breakfast items every morning.",
      "ko": "Grandview 호텔은 매일 아침 다양한 아침 식사 메뉴를 제공한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Mr. Patel traveled to Singapore for a business trip last month.",
      "ko": "Patel 씨는 지난달 출장으로 싱가포르에 갔다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "All orders over fifty dollars are delivered free of charge.",
      "ko": "50달러가 넘는 모든 주문은 무료로 배송된다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "The marketing team plans to create a new advertisement next month.",
      "ko": "마케팅 팀은 다음 달에 새 광고를 만들 계획이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Please turn off the lights before you leave the meeting room.",
      "ko": "회의실을 나가기 전에 불을 꺼 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The Lakeside Art Museum is closed to visitors on Sundays.",
      "ko": "Lakeside 미술관은 일요일마다 관람객에게 문을 닫는다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Guests can book a table online through the restaurant's website.",
      "ko": "손님들은 식당 웹사이트를 통해 온라인으로 자리를 예약할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
