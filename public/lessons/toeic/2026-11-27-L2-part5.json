  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "마케팅팀은 웹사이트를 새로 디자인하기 전에 고객 의견을 철저히 분석했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "새 일정 관리 소프트웨어는 근무 교대를 짜는 데 드는 시간을 크게 줄였다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "그 직책의 지원자는 회계 소프트웨어에 대해 폭넓은 지식이 있어야 한다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "모든 방문객은 공장에 들어가기 전에 접수처에서 방문 등록을 해야 한다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "연례 시상식은 지난 금요일 Grand Harbor 호텔에서 열렸다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "리더십 워크숍에 참석하고 싶은 직원은 월요일까지 등록해야 한다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "Ramirez 씨는 수정된 조건을 검토한 뒤 계약서에 서명하기로 했다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "프로젝트 마감일이 앞당겨졌기 때문에 디자인팀은 주말 내내 일했다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "출장 경비를 환급받을 수 있도록 영수증을 모두 보관해 주세요."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "구매품에 만족하지 않는 고객은 30일 이내에 반품할 수 있다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The marketing team conducted a thorough analysis of customer feedback before redesigning the website.",
      "ko": "마케팅팀은 웹사이트를 새로 디자인하기 전에 고객 의견을 철저히 분석했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The new scheduling software has significantly reduced the time needed to plan work shifts.",
      "ko": "새 일정 관리 소프트웨어는 근무 교대를 짜는 데 드는 시간을 크게 줄였다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Applicants for the position must have extensive knowledge of accounting software.",
      "ko": "그 직책의 지원자는 회계 소프트웨어에 대해 폭넓은 지식이 있어야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "All visitors must check in at the reception desk before entering the factory.",
      "ko": "모든 방문객은 공장에 들어가기 전에 접수처에서 방문 등록을 해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The annual awards ceremony was held at the Grand Harbor Hotel last Friday.",
      "ko": "연례 시상식은 지난 금요일 Grand Harbor 호텔에서 열렸다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Employees who wish to attend the leadership workshop should register by Monday.",
      "ko": "리더십 워크숍에 참석하고 싶은 직원은 월요일까지 등록해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Ms. Ramirez decided to sign the contract after reviewing the revised terms.",
      "ko": "Ramirez 씨는 수정된 조건을 검토한 뒤 계약서에 서명하기로 했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Since the project deadline was moved up, the design team worked through the weekend.",
      "ko": "프로젝트 마감일이 앞당겨졌기 때문에 디자인팀은 주말 내내 일했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Please keep all of your receipts so that you can be reimbursed for travel expenses.",
      "ko": "출장 경비를 환급받을 수 있도록 영수증을 모두 보관해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Customers who are not satisfied with their purchase may return it within thirty days.",
      "ko": "구매품에 만족하지 않는 고객은 30일 이내에 반품할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
