  "grammar": [
    {
      "id": "g1",
      "title": "주격 관계대명사 who",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Employees who wish"
      ],
      "explanation": "선행사가 사람이고 관계사 뒤에 바로 동사가 오면 주격 관계대명사 who(또는 that)를 쓴다. 사물이면 which.",
      "example": {
        "en": "The man who called you is my manager.",
        "ko": "너에게 전화한 남자는 내 매니저다."
      },
      "note": "관계사 뒤 동사의 수는 선행사에 맞춘다: Employees who wish(복수)."
    },
    {
      "id": "g2",
      "title": "동사 + to부정사 목적어",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "decided to sign"
      ],
      "explanation": "decide, plan, hope, want, agree, offer 등은 목적어로 to부정사를 쓴다. 반면 consider, avoid, finish 등은 동명사를 쓴다.",
      "example": {
        "en": "They agreed to share the costs.",
        "ko": "그들은 비용을 나누기로 합의했다."
      },
      "note": "after reviewing처럼 전치사 뒤에는 동명사가 온다는 점도 함께 확인."
    },
    {
      "id": "g3",
      "title": "과거 수동태 was + p.p.",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s5",
      "highlight": [
        "was held"
      ],
      "explanation": "주어가 행위를 받는 경우 be + 과거분사. 과거 시점(last Friday)이면 was/were + p.p.",
      "example": {
        "en": "The report was sent yesterday.",
        "ko": "보고서는 어제 발송되었다."
      },
      "note": "빈칸 뒤에 목적어가 없고 주어가 사물·행사면 수동태가 정답일 확률이 높다."
    }
  ],
