  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "박 선생님께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4"
      ],
      "ko": "12월 3일 스마트 오피스 워크숍에 등록해 주셔서 감사합니다. 워크숍은 카터 빌딩 204호에서 열립니다. 오전 9시 30분에 시작하니, 이름표를 받으실 수 있도록 9시 15분까지 와 주세요."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s5",
        "s6",
        "s7"
      ],
      "ko": "모든 참가자에게 점심이 제공됩니다. 특별히 필요한 식단이 있으시면 11월 28일까지 알려 주세요. 이 이메일에 회신만 하시면 됩니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s8",
        "s9"
      ],
      "ko": "건물 근처 주차 공간이 한정되어 있다는 점을 참고해 주세요. 역에서 걸어서 5분밖에 안 걸리니 지하철 이용을 권해 드립니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s10"
      ],
      "ko": "워크숍에서 뵙기를 기대합니다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s11"
      ],
      "ko": "감사합니다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s12"
      ],
      "ko": "행사 담당자 대니얼 리 드림"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Ms. Park,",
      "ko": "박 선생님께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for registering for the Smart Office Workshop on December 3.",
      "ko": "12월 3일 스마트 오피스 워크숍에 등록해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "The workshop will be held in Room 204 of the Carter Building.",
      "ko": "워크숍은 카터 빌딩 204호에서 열립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "It starts at 9:30 in the morning, so please arrive by 9:15 to pick up your name tag.",
      "ko": "오전 9시 30분에 시작하니, 이름표를 받으실 수 있도록 9시 15분까지 와 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p3",
      "en": "Lunch will be provided for all participants.",
      "ko": "모든 참가자에게 점심이 제공됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "If you have any special dietary needs, please let us know by November 28.",
      "ko": "특별히 필요한 식단이 있으시면 11월 28일까지 알려 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "You can simply reply to this e-mail.",
      "ko": "이 이메일에 회신만 하시면 됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p4",
      "en": "Please note that parking spaces near the building are limited.",
      "ko": "건물 근처 주차 공간이 한정되어 있다는 점을 참고해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "We recommend taking the subway, as the station is only a five-minute walk away.",
      "ko": "역에서 걸어서 5분밖에 안 걸리니 지하철 이용을 권해 드립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p5",
      "en": "We look forward to seeing you at the workshop.",
      "ko": "워크숍에서 뵙기를 기대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p6",
      "en": "Sincerely,",
      "ko": "감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p7",
      "en": "Daniel Lee, Event Coordinator",
      "ko": "행사 담당자 대니얼 리 드림",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
