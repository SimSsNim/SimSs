  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Greenfield 치과가 이전합니다"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5"
      ],
      "ko": "Greenfield 치과는 3월 3일 월요일에 새 장소로 이전합니다. 새 사무실은 Maple 가 418번지로, 중앙 도서관 길 건너편에 있습니다. 새 건물이 더 넓어서 진료실이 두 개 늘고 대기실도 더 커집니다. 또한 환자용 무료 주차장도 있습니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s6",
        "s7",
        "s8"
      ],
      "ko": "현재 사무실은 2월 28일 금요일에 문을 닫습니다. 3월 1일 토요일에는 장비를 옮기기 때문에 환자를 진료하지 않습니다. 그날 예약이 있으신 분께는 저희 직원이 전화를 드려 새 시간을 정해 드립니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s9",
        "s10"
      ],
      "ko": "전화번호와 이메일 주소는 그대로입니다. Hannah Cole 박사와 저희 팀 모두 새 사무실에서 여러분을 맞이하기를 기대합니다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Greenfield Dental Clinic Is Moving",
      "ko": "Greenfield 치과가 이전합니다",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Greenfield Dental Clinic will move to a new location on Monday, March 3.",
      "ko": "Greenfield 치과는 3월 3일 월요일에 새 장소로 이전합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "Our new office is at 418 Maple Avenue, across the street from Central Library.",
      "ko": "새 사무실은 Maple 가 418번지로, 중앙 도서관 길 건너편에 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "The new building is larger, so we will have two more treatment rooms and a bigger waiting area.",
      "ko": "새 건물이 더 넓어서 진료실이 두 개 늘고 대기실도 더 커집니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "It also has a free parking lot for patients.",
      "ko": "또한 환자용 무료 주차장도 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "Our current office will close on Friday, February 28.",
      "ko": "현재 사무실은 2월 28일 금요일에 문을 닫습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "The clinic will not see any patients on Saturday, March 1, because we will be moving our equipment.",
      "ko": "3월 1일 토요일에는 장비를 옮기기 때문에 환자를 진료하지 않습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "If you have an appointment on that day, our staff will call you to choose a new time.",
      "ko": "그날 예약이 있으신 분께는 저희 직원이 전화를 드려 새 시간을 정해 드립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "Our phone number and e-mail address will stay the same.",
      "ko": "전화번호와 이메일 주소는 그대로입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "Dr. Hannah Cole and the rest of our team look forward to welcoming you to our new office.",
      "ko": "Hannah Cole 박사와 저희 팀 모두 새 사무실에서 여러분을 맞이하기를 기대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
