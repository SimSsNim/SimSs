  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "Why did Ms. Cho send the first message?",
      "evidenceSentenceIds": [
        "s1",
        "s2"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To ask Mr. Walsh to buy her a ticket"
        },
        {
          "key": "B",
          "text": "To let Mr. Walsh know about a travel delay"
        },
        {
          "key": "C",
          "text": "To cancel a meeting with a client"
        },
        {
          "key": "D",
          "text": "To invite Mr. Walsh to a demonstration"
        }
      ],
      "answer": "B",
      "explanationKo": "첫 메시지에서 기차가 40분 늦어지고(running about forty minutes late) 회의에 제시간에 못 갈 것 같다고 한다. → a travel delay.",
      "choiceNotesKo": {
        "C": "회의를 취소하지 않고 시작 시간을 늦춘다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What does Ms. Cho have with her?",
      "evidenceSentenceIds": [
        "s8"
      ],
      "choices": [
        {
          "key": "A",
          "text": "A signed contract"
        },
        {
          "key": "B",
          "text": "Some printed menus"
        },
        {
          "key": "C",
          "text": "Items to show the client"
        },
        {
          "key": "D",
          "text": "A new laptop computer"
        }
      ],
      "answer": "C",
      "explanationKo": "I have the sample products with me → 고객에게 보여 줄 샘플 제품. sample products를 Items to show the client로 바꿔 말했다.",
      "choiceNotesKo": {
        "D": "노트북에 대한 말은 없다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-inference",
      "prompt": "At 9:11, what does Mr. Walsh most likely mean when he writes, \"Good idea\"?",
      "evidenceSentenceIds": [
        "s12",
        "s13"
      ],
      "choices": [
        {
          "key": "A",
          "text": "He agrees with Ms. Cho's plan to take a taxi."
        },
        {
          "key": "B",
          "text": "He thinks the meeting should end earlier."
        },
        {
          "key": "C",
          "text": "He wants to meet Ms. Cho at the station."
        },
        {
          "key": "D",
          "text": "He likes the sample products."
        }
      ],
      "answer": "A",
      "explanationKo": "바로 앞에서 하나 조가 '시간을 아끼려고 역에서 택시를 타겠다'고 했고, 그에 대한 대답이 Good idea다. → 택시 계획에 동의.",
      "choiceNotesKo": {
        "C": "벤은 역이 아니라 로비에서 기다리겠다고 한다."
      },
      "skill": "의도 파악(추론)"
    }
  ]
