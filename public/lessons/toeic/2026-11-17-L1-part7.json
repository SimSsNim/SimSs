  "grammar": [
    {
      "id": "g1",
      "title": "ask + 사람 + to V (~에게 …해 달라고 부탁하다)",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "ask them to start"
      ],
      "explanation": "ask 뒤에 사람(목적어)과 to부정사가 오면 '그 사람에게 ~해 달라고 부탁하다'.",
      "example": {
        "en": "I asked him to call me back.",
        "ko": "나는 그에게 다시 전화해 달라고 부탁했다."
      },
      "note": "ask/tell/want + 목적어 + to V 형태가 자주 나온다."
    },
    {
      "id": "g2",
      "title": "if = ~인지 (명사절)",
      "tags": [
        "명사절"
      ],
      "sentenceId": "s7",
      "highlight": [
        "ask if eleven-fifteen is possible"
      ],
      "explanation": "ask 뒤의 if는 '만약'이 아니라 '~인지'라는 뜻으로 목적어 역할을 한다. whether로 바꿔 쓸 수 있다.",
      "example": {
        "en": "Can you check if the store is open?",
        "ko": "가게가 열었는지 확인해 줄래요?"
      },
      "note": "ask/know/check + if절 → '~인지'."
    },
    {
      "id": "g3",
      "title": "to부정사의 목적 (~하려고)",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s12",
      "highlight": [
        "to save time"
      ],
      "explanation": "문장 끝 to save time은 '시간을 아끼기 위해'라는 목적을 나타낸다.",
      "example": {
        "en": "She left early to catch the bus.",
        "ko": "그녀는 버스를 타려고 일찍 나갔다."
      },
      "note": "완전한 문장 + to V → '~하기 위해'."
    }
  ],
