  "grammar": [
    {
      "id": "g1",
      "title": "미래 시제와 시간 단서",
      "tags": [
        "시제"
      ],
      "sentenceId": "s5",
      "highlight": [
        "will open",
        "next spring"
      ],
      "explanation": "next spring, next week, tomorrow처럼 미래를 가리키는 말이 있으면 will + 동사원형을 쓴다.",
      "example": {
        "en": "We will move to a new office next month.",
        "ko": "우리는 다음 달에 새 사무실로 이사할 것이다."
      },
      "note": "토익 시제 문제는 문장 속 시간 표현(last, next, since 등)을 먼저 찾으면 빨리 풀린다."
    },
    {
      "id": "g2",
      "title": "전치사 during vs 접속사 while",
      "tags": [
        "전치사",
        "접속사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "while the main garage is being repaired"
      ],
      "explanation": "뜻은 둘 다 '~ 동안'이지만 during 뒤에는 명사(during the repair), while 뒤에는 주어+동사(while the garage is being repaired)가 온다.",
      "example": {
        "en": "Please be quiet during the meeting.",
        "ko": "회의 중에는 조용히 해 주세요."
      },
      "note": "빈칸 뒤에 동사가 있는지 확인 → 있으면 접속사, 없으면 전치사."
    },
    {
      "id": "g3",
      "title": "소유격 + 명사",
      "tags": [
        "대명사",
        "품사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "their weekly reports"
      ],
      "explanation": "명사 앞에서 '~의'를 나타낼 때는 소유격(my, your, his, her, its, our, their)을 쓴다. 소유격 뒤에는 반드시 명사가 온다.",
      "example": {
        "en": "The staff shared their ideas.",
        "ko": "직원들은 자신들의 아이디어를 나누었다."
      },
      "note": "소유격 뒤 빈칸 = 명사 자리(4번 문제 your participation)도 함께 기억."
    }
  ],
