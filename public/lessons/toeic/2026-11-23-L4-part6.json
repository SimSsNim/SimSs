  "grammar": [
    {
      "id": "g1",
      "title": "소유격 관계대명사 whose",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "whose color schemes"
      ],
      "explanation": "whose + 명사는 \"선행사의 ~\"라는 뜻으로, 뒤에 완전한 절이 온다. 사람과 사물 모두에 쓸 수 있다.",
      "example": {
        "en": "We hired a designer whose work has won several awards.",
        "ko": "우리는 작품이 여러 상을 받은 디자이너를 고용했다."
      },
      "note": "관계사 자리 뒤에 관사 없는 명사 + 완전한 절 → whose."
    },
    {
      "id": "g2",
      "title": "비교급 강조 부사",
      "tags": [
        "비교",
        "품사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "considerably earlier"
      ],
      "explanation": "비교급 앞에는 much, far, even, still, considerably, significantly 같은 부사를 써서 \"훨씬\"이라는 뜻을 더한다. very는 비교급을 꾸미지 못한다.",
      "example": {
        "en": "Sales this year are significantly higher than last year.",
        "ko": "올해 매출은 작년보다 훨씬 높다."
      },
      "note": "비교급(-er/more) 바로 앞 빈칸 → 부사 considerably/significantly."
    },
    {
      "id": "g3",
      "title": "시간·조건 부사절의 현재 시제",
      "tags": [
        "시제",
        "부사절"
      ],
      "sentenceId": "s9",
      "highlight": [
        "Once you approve these changes, we will begin"
      ],
      "explanation": "once, when, as soon as, if 같은 시간·조건 접속사 절은 미래 일이라도 현재 시제로 쓴다. 주절은 will로 미래를 나타낸다.",
      "example": {
        "en": "As soon as the order arrives, we will call you.",
        "ko": "주문품이 도착하는 대로 전화드리겠습니다."
      },
      "note": "Once/When 절 안에 will이 있는 보기는 오답."
    }
  ],
