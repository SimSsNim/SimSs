  "grammar": [
    {
      "id": "g1",
      "title": "Only + 부사절 도치",
      "tags": [
        "도치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Only after",
        "did the factory resume"
      ],
      "explanation": "Only after/Only when 같은 표현이 문장 앞에 오면 주절은 의문문 어순(조동사 + 주어 + 동사원형)이 된다. 일반동사 과거면 did를 쓴다.",
      "example": {
        "en": "Only when the contract is signed will we begin production.",
        "ko": "계약서가 서명되어야만 생산을 시작할 것이다."
      },
      "note": "Only ~ 절 뒤 빈칸 + 주어 + 동사원형 → do/does/did."
    },
    {
      "id": "g2",
      "title": "가정법 미래 도치 Were S to V",
      "tags": [
        "가정법",
        "도치"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Were the shipment to arrive"
      ],
      "explanation": "If S were to V(혹시 ~한다면)에서 if를 빼면 Were가 주어 앞으로 나온다. Should S V(동사원형)도 비슷한 뜻이지만 뒤에 to가 붙지 않는다.",
      "example": {
        "en": "Were the price to rise, sales would fall.",
        "ko": "만일 가격이 오른다면 판매가 줄 것이다."
      },
      "note": "빈칸 + 주어 + to부정사 → Were. 빈칸 + 주어 + 동사원형 → Should."
    },
    {
      "id": "g3",
      "title": "복합관계부사 However + 형용사/부사",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "However carefully"
      ],
      "explanation": "However + 부사/형용사 + S + V = 아무리 ~하게 …하더라도(= No matter how). 뒤에 부사 carefully가 바로 붙는다.",
      "example": {
        "en": "However busy you are, please reply by Friday.",
        "ko": "아무리 바쁘더라도 금요일까지 회신해 주세요."
      },
      "note": "빈칸 바로 뒤에 형용사·부사가 오면 However, 명사가 오면 Whatever/Whichever."
    }
  ],
