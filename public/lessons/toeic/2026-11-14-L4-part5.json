  "grammar": [
    {
      "id": "g1",
      "title": "부정 부사 도치: Rarely + 조동사 + 주어",
      "tags": [
        "도치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Rarely has the firm received"
      ],
      "explanation": "Rarely, Seldom, Never, Hardly 같은 부정 부사가 문장 맨 앞에 오면 의문문처럼 조동사가 주어 앞으로 간다.",
      "example": {
        "en": "Seldom does the manager leave the office before seven.",
        "ko": "그 매니저는 7시 전에 퇴근하는 일이 거의 없다."
      },
      "note": "Rarely/Seldom 뒤 빈칸 → 조동사 + 주어 + 동사 어순 보기를 고른다."
    },
    {
      "id": "g2",
      "title": "가정법 과거완료 도치: Had + 주어 + p.p.",
      "tags": [
        "가정법",
        "도치"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Had the shipment been inspected",
        "would have been found"
      ],
      "explanation": "If를 빼고 Had를 주어 앞으로 보내면 '(과거에) ~했더라면'이라는 뜻이 된다. 주절은 would/could have p.p.",
      "example": {
        "en": "Had we left earlier, we would have caught the train.",
        "ko": "더 일찍 출발했더라면 기차를 탔을 것이다."
      },
      "note": "주절에 would have p.p.가 보이면 조건절 빈칸은 Had."
    },
    {
      "id": "g3",
      "title": "복합관계부사 whenever",
      "tags": [
        "관계사",
        "부사절"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Whenever the printer on the third floor runs out of toner"
      ],
      "explanation": "whenever = any time that(~할 때마다). 뒤에 완전한 절이 오고, 문장 전체를 꾸미는 부사절을 만든다.",
      "example": {
        "en": "Whenever you have a question, feel free to ask.",
        "ko": "궁금한 게 있을 때마다 편하게 물어보세요."
      },
      "note": "빈칸 뒤 절이 완전하고 '때'의 의미 → whenever. 불완전하면 whatever/whoever."
    }
  ],
