  "grammar": [
    {
      "id": "g1",
      "title": "with + 명사 + 분사 (부대상황)",
      "tags": [
        "분사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "with each session lasting about one hour"
      ],
      "explanation": "with 뒤 명사와 분사의 관계가 능동이면 현재분사, 수동이면 과거분사를 쓴다. 만남이 1시간 '지속되는' 것이므로 lasting.",
      "example": {
        "en": "She listened with her eyes closed.",
        "ko": "그녀는 눈을 감은 채 들었다."
      },
      "note": "with + N + 빈칸: N이 스스로 하면 -ing, 당하면 p.p."
    },
    {
      "id": "g2",
      "title": "those + 수식어 = ~하는 사람들",
      "tags": [
        "대명사",
        "생략"
      ],
      "sentenceId": "s9",
      "highlight": [
        "Those interested in applying"
      ],
      "explanation": "Those는 '사람들'을 뜻하는 대명사로, 뒤에 분사·형용사·관계절이 붙어 '~한 사람들'이 된다. 원래 Those who are interested에서 who are가 생략되었다.",
      "example": {
        "en": "Those attending the seminar will receive a certificate.",
        "ko": "세미나 참석자는 수료증을 받는다."
      },
      "note": "these/they는 뒤에서 수식어를 받아 '~한 사람들'로 쓰지 않는다."
    },
    {
      "id": "g3",
      "title": "비교 관용 표현 no later than",
      "tags": [
        "비교",
        "전치사"
      ],
      "sentenceId": "s10",
      "highlight": [
        "no later than March 14"
      ],
      "explanation": "no later than + 시점은 '늦어도 ~까지'로 마감 기한을 나타낸다. 비교급 later를 써야 than과 짝이 맞는다.",
      "example": {
        "en": "Payment is due no later than June 1.",
        "ko": "결제는 늦어도 6월 1일까지다."
      },
      "note": "than이 보이면 비교급. no later than = by."
    }
  ],
