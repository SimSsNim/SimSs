  "grammar": [
    {
      "id": "g1",
      "title": "주격 관계대명사 who",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "who has worked"
      ],
      "explanation": "앞 명사(trainer)가 사람이고 관계사 뒤에 주어 없이 동사(has worked)가 바로 오면 주격 관계대명사 who를 쓴다.",
      "example": {
        "en": "We hired a designer who speaks three languages.",
        "ko": "우리는 3개 국어를 하는 디자이너를 고용했다."
      },
      "note": "사람 선행사 + 빈칸 + 동사 → who. 뒤에 주어가 있으면 whom, 명사가 바로 오면 whose."
    },
    {
      "id": "g2",
      "title": "미래 수동태 will be p.p.",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s8",
      "highlight": [
        "will be provided"
      ],
      "explanation": "점심은 '제공되는' 대상이므로 수동태. 미래 수동태는 will be + 과거분사.",
      "example": {
        "en": "The results will be announced next week.",
        "ko": "결과는 다음 주에 발표된다."
      },
      "note": "will be 뒤 빈칸 + 목적어 없음 → 과거분사."
    }
  ],
