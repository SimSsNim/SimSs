  "grammar": [
    {
      "title": "부정 부사 도치 (Rarely + 조동사 + S)",
      "tags": [
        "도치"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Rarely has a new product generated"
      ],
      "explanation": "Rarely, Seldom, Never 같은 부정 부사가 문장 맨 앞에 오면 의문문처럼 조동사가 주어 앞으로 나간다. 현재완료라면 has/have + 주어 + p.p., 주어가 단수(a new product)라 has.",
      "example": {
        "en": "Seldom have we seen such strong sales in December.",
        "ko": "12월에 이렇게 강한 매출은 좀처럼 본 적이 없다."
      },
      "note": "도치 뒤 동사 형태(p.p./동사원형)와 주어의 수를 함께 확인하자.",
      "id": "g1"
    },
    {
      "title": "If 생략 가정법 과거완료 도치",
      "tags": [
        "가정법",
        "도치"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Had the shipment been inspected"
      ],
      "explanation": "If + S + had p.p.에서 If를 빼면 Had + S + p.p. 순서가 된다. 주절은 would/could have p.p.로 과거에 일어나지 않은 일을 말한다.",
      "example": {
        "en": "Had we known about the delay, we would have called the client.",
        "ko": "지연을 알았더라면 고객에게 전화했을 것이다."
      },
      "note": "콤마 뒤 주절에 would have p.p.가 보이면 문장 앞 빈칸은 Had.",
      "id": "g2"
    },
    {
      "title": "복합관계부사 whenever",
      "tags": [
        "관계사",
        "부사절"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Whenever the main server goes offline"
      ],
      "explanation": "whenever = at any time when(~할 때마다, 언제 ~하든). 뒤에 완전한 절이 오고 부사절을 이끈다. 조건·시간이 반복되는 시스템 설명에 자주 나온다.",
      "example": {
        "en": "Whenever a customer calls, the system records the conversation.",
        "ko": "고객이 전화할 때마다 시스템이 통화를 녹음한다."
      },
      "note": "whatever/whoever는 뒤 절에 빠진 성분(주어·목적어)이 있어야 한다.",
      "id": "g3"
    }
  ],
