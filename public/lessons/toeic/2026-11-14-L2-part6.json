  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "전체 입주자 공지"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5"
      ],
      "ko": "웨스트브룩 타워 주차장은 다음 달 바닥 재포장 공사를 합니다. 작업자들은 주차선도 다시 칠하고 더 밝은 조명도 설치할 예정입니다. 공사는 5월 9~10일, 5월 16~17일 두 번의 주말에 걸쳐 진행됩니다. 그 기간에는 주차장이 완전히 폐쇄됩니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s6",
        "s7",
        "s8"
      ],
      "ko": "입주자분들은 대신 길 건너편 하버 스트리트 주차장을 이용하실 수 있습니다. 건물 출입증을 보여 주시기만 하면 그곳 주차는 무료입니다. 출입증이 없는 입주자는 로비 보안 데스크에서 받으실 수 있습니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s9",
        "s10",
        "s11"
      ],
      "ko": "이로 인해 불편을 끼쳐 드리게 되어 죄송합니다. 건물 관리 사무소는 공사가 진행되는 동안 이메일로 소식을 보내 드릴 예정입니다. 양해해 주셔서 감사합니다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Notice to All Tenants",
      "ko": "전체 입주자 공지",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The parking garage at Westbrook Tower will be resurfaced next month.",
      "ko": "웨스트브룩 타워 주차장은 다음 달 바닥 재포장 공사를 합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "Workers will also repaint the parking lines and install brighter lights.",
      "ko": "작업자들은 주차선도 다시 칠하고 더 밝은 조명도 설치할 예정입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "The work will take place over two weekends, May 9 to 10 and May 16 to 17.",
      "ko": "공사는 5월 9~10일, 5월 16~17일 두 번의 주말에 걸쳐 진행됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "The garage will be completely closed on those days.",
      "ko": "그 기간에는 주차장이 완전히 폐쇄됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "Tenants may park at the Harbor Street lot across the road instead.",
      "ko": "입주자분들은 대신 길 건너편 하버 스트리트 주차장을 이용하실 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "Parking there will be free as long as you show your building ID card.",
      "ko": "건물 출입증을 보여 주시기만 하면 그곳 주차는 무료입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "Tenants without a card can get one at the security desk in the lobby.",
      "ko": "출입증이 없는 입주자는 로비 보안 데스크에서 받으실 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "We apologize for any inconvenience this may cause.",
      "ko": "이로 인해 불편을 끼쳐 드리게 되어 죄송합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "The building management office will send updates by e-mail as the work progresses.",
      "ko": "건물 관리 사무소는 공사가 진행되는 동안 이메일로 소식을 보내 드릴 예정입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p4",
      "en": "Thank you for your patience.",
      "ko": "양해해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
