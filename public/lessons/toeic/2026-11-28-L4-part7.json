  "questions": [
    {
      "type": "part7-purpose",
      "prompt": "Why did Ms. Brandt write to Mr. Okafor?",
      "choices": [
        {
          "key": "A",
          "text": "To thank him for attending a forum"
        },
        {
          "key": "B",
          "text": "To request feedback on a marketing summit"
        },
        {
          "key": "C",
          "text": "To ask him to give a talk at an event"
        },
        {
          "key": "D",
          "text": "To offer him a position on a committee"
        }
      ],
      "answer": "C",
      "explanationKo": "s2에서 '서밋에서 연설해 달라고 초대한다(invite you to speak)'고 밝히고, 이후 발표 주제·사례·일정을 안내한다. invite you to speak를 give a talk로 바꿔 말한 C가 정답.",
      "choiceNotesKo": {
        "A": "포럼에 참석한 사람은 오카포 씨가 아니라 위원들이며, 그가 강연한 자리였다.",
        "D": "committee는 편지를 보낸 조직위원회로만 나오고 자리를 제안하지 않는다."
      },
      "evidenceSentenceIds": [
        "s2"
      ],
      "skill": "목적 찾기",
      "id": "q1",
      "number": 1
    },
    {
      "type": "part7-detail",
      "prompt": "What is Mr. Okafor asked to discuss?",
      "choices": [
