  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "개정된 직원 안내서는 이제 회사 인트라넷에서 볼 수 있다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "Hoffman 씨는 지점의 고객 서비스 개선에 헌신한 것으로 칭찬받았다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "텔레비전 광고가 방송된 이후 새 믹서기의 판매량이 급격히 늘었다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "최근 고객 설문 조사 결과는 경영진에게 매우 고무적이었다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "지난달 우리가 고용한 컨설턴트는 벌써 몇 가지 유용한 변화를 제안했다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "5층의 모든 회의실에 새 화상 스크린이 설치되었다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "Nakamura 씨는 제품 출시를 4월로 미루는 것을 고려하고 있다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "날씨가 좋지 않아서 회사 야유회는 호텔 연회장으로 옮겨졌다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "인턴십 프로그램 지원서는 6월 30일 마감일 이후에는 받지 않는다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "우리 기술자들이 겨울이 시작되기 전에 모든 건물의 난방 시스템을 점검할 것이다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The updated employee handbook is now accessible on the company intranet.",
      "ko": "개정된 직원 안내서는 이제 회사 인트라넷에서 볼 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Mr. Hoffman was praised for his dedication to improving customer service at the branch.",
      "ko": "Hoffman 씨는 지점의 고객 서비스 개선에 헌신한 것으로 칭찬받았다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Sales of the new blender have increased dramatically since the television advertisement aired.",
      "ko": "텔레비전 광고가 방송된 이후 새 믹서기의 판매량이 급격히 늘었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "The results of the latest customer survey were very encouraging for the management team.",
      "ko": "최근 고객 설문 조사 결과는 경영진에게 매우 고무적이었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The consultant whom we hired last month has already suggested several useful changes.",
      "ko": "지난달 우리가 고용한 컨설턴트는 벌써 몇 가지 유용한 변화를 제안했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "All of the conference rooms on the fifth floor have been equipped with new video screens.",
      "ko": "5층의 모든 회의실에 새 화상 스크린이 설치되었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Ms. Nakamura is considering postponing the product launch until April.",
      "ko": "Nakamura 씨는 제품 출시를 4월로 미루는 것을 고려하고 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Because the weather was poor, the company picnic was moved to the hotel ballroom.",
      "ko": "날씨가 좋지 않아서 회사 야유회는 호텔 연회장으로 옮겨졌다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Applications for the internship program will not be accepted after the June 30 deadline.",
      "ko": "인턴십 프로그램 지원서는 6월 30일 마감일 이후에는 받지 않는다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Our technicians will inspect the heating system in every building before winter begins.",
      "ko": "우리 기술자들이 겨울이 시작되기 전에 모든 건물의 난방 시스템을 점검할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
