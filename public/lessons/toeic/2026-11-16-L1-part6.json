  "grammar": [
    {
      "id": "g1",
      "title": "while(접속사) vs during(전치사)",
      "tags": [
        "접속사",
        "전치사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "While the work is being done"
      ],
      "explanation": "while 뒤에는 주어 + 동사가 있는 절이 오고, during 뒤에는 명사(구)만 온다. 여기서는 the work is being done이라는 절이 이어진다.",
      "example": {
        "en": "During the meeting, please turn off your phone.",
        "ko": "회의 중에는 휴대 전화를 꺼 주세요."
      },
      "note": "빈칸 뒤 주어+동사 → while / 명사만 → during."
    },
    {
      "id": "g2",
      "title": "미래 수동태와 과거분사 수식",
      "tags": [
        "수동태",
        "분사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "left after that",
        "will be thrown away"
      ],
      "explanation": "물품은 스스로 버리는 것이 아니라 '버려지는' 것이므로 will be + p.p. 또 left(남겨진)는 명사 items 뒤에서 꾸며 준다.",
      "example": {
        "en": "Packages delivered after 6 p.m. will be stored at the front desk.",
        "ko": "오후 6시 이후 배달된 소포는 안내 데스크에 보관될 것이다."
      },
      "note": "명사 + p.p. ~ + 동사 구조에서 진짜 동사를 찾자."
    }
  ],
