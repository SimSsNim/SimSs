  "grammar": [
    {
      "id": "g1",
      "title": "not A until B",
      "tags": [
        "부사절",
        "어휘"
      ],
      "sentenceId": "s7",
      "highlight": [
        "will not be available until December 12"
      ],
      "explanation": "not ~ until + 시점은 '그 시점까지는 ~하지 않다', 즉 '그때가 되어서야 ~하다'라는 뜻이다. 계속되는 상태(not available)와 함께 until을 쓴다.",
      "example": {
        "en": "The store will not open until ten o'clock.",
        "ko": "그 가게는 10시가 되어서야 문을 연다."
      },
      "note": "not ~ until 구문에서는 by가 아니라 until이 짝이다."
    },
    {
      "id": "g2",
      "title": "to부정사의 수동형 (to be p.p.)",
      "tags": [
        "to부정사",
        "수동태"
      ],
      "sentenceId": "s8",
      "highlight": [
        "ready to be shipped"
      ],
      "explanation": "to부정사의 의미상 주어가 동작을 '받으면' to be + p.p.를 쓴다. 책상은 '발송되는' 것이므로 ready to be shipped.",
      "example": {
        "en": "The documents are ready to be signed.",
        "ko": "서류는 서명할 준비가 되어 있다."
      },
      "note": "be ready to be p.p. / need to be p.p. 같은 수동 to부정사가 자주 보인다."
    },
    {
      "id": "g3",
      "title": "조건 부사절의 현재 시제",
      "tags": [
        "시제",
        "부사절"
      ],
      "sentenceId": "s16",
      "highlight": [
        "If we do not hear from you"
      ],
      "explanation": "시간·조건의 부사절(if, when, as soon as 등)에서는 미래의 일도 현재 시제로 쓴다. 주절에는 will을 쓴다.",
      "example": {
        "en": "If it rains tomorrow, the picnic will be canceled.",
        "ko": "내일 비가 오면 소풍은 취소될 것이다."
      },
      "note": "If/When 절 안에 will이 보기로 나오면 대개 오답."
    }
  ],
