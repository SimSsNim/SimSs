  "grammar": [
    {
      "id": "g1",
      "title": "전치사 + 동명사",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "for handling"
      ],
      "explanation": "전치사 for 뒤에는 명사나 동명사가 온다. 동명사 handling은 뒤에 목적어 customer requests를 거느린다.",
      "example": {
        "en": "Thank you for completing the survey.",
        "ko": "설문을 작성해 주셔서 감사합니다."
      },
      "note": "전치사 뒤 + 목적어 있음 → 동명사(-ing)."
    },
    {
      "id": "g2",
      "title": "기한의 by vs 계속의 until",
      "tags": [
        "전치사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "by March 28"
      ],
      "explanation": "by는 '~까지(그 전에 한 번 끝내면 됨)', until은 '~까지 계속'. 참석을 한 번 끝내야 하는 기한이므로 by.",
      "example": {
        "en": "Please return the form by Friday.",
        "ko": "금요일까지 양식을 제출해 주세요."
      },
      "note": "완료 기한 → by, 상태 지속 → until."
    },
    {
      "id": "g3",
      "title": "목적의 so that + 수동태",
      "tags": [
        "부사절"
      ],
      "sentenceId": "s13",
      "highlight": [
        "so that an alternative date can be arranged"
      ],
      "explanation": "so that + 주어 + can/will은 '~하도록'. 날짜는 '잡히는' 대상이라 can be arranged(수동태).",
      "example": {
        "en": "Please arrive early so that we can start on time.",
        "ko": "제시간에 시작할 수 있도록 일찍 와 주세요."
      },
      "note": "so that 뒤에는 절, in order to 뒤에는 동사원형."
    }
  ],
