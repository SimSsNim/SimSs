 "paragraphs": [
  {
   "id": "p1",
   "sentenceIds": [
    "s1"
   ],
   "ko": "오카포 씨는 지난주 자신에게 전달된 모든 고객 불만에 신속하게 대응했다."
  },
  {
   "id": "p2",
   "sentenceIds": [
    "s2"
   ],
   "ko": "호텔 경영진은 로비 보수 공사 기간 동안 기다려 준 투숙객들에게 감사를 표했다."
  },
  {
   "id": "p3",
   "sentenceIds": [
    "s3"
   ],
   "ko": "마케팅팀은 지역 음료 시장의 소비자 동향에 대한 광범위한 분석을 준비했다."
  },
  {
   "id": "p4",
   "sentenceIds": [
    "s4"
   ],
   "ko": "목요일 교육에 참석하는 모든 직원은 새 소프트웨어가 설치된 노트북을 가져와야 한다."
  },
  {
   "id": "p5",
   "sentenceIds": [
    "s5"
   ],
   "ko": "배송품이 제때 창고를 떠났더라면 월요일까지 매장에 도착했을 것이다."
  },
  {
   "id": "p6",
   "sentenceIds": [
    "s6"
   ],
   "ko": "1998년에 설립된 카버 로지스틱스는 현재 6개국에서 물류 센터를 운영한다."
  },
  {
   "id": "p7",
   "sentenceIds": [
    "s7"
   ],
   "ko": "오후에 강풍이 예상되어 야외 제품 시연회가 실내로 옮겨졌다."
  },
  {
   "id": "p8",
   "sentenceIds": [
    "s8"
   ],
   "ko": "총비용이 부서 예산 안에 머문다면 브란트 씨는 출장 요청을 승인할 것이다."
  },
  {
   "id": "p9",
   "sentenceIds": [
    "s9"
   ],
   "ko": "계약은 이달 말에 만료되기 전에 갱신되어야 한다."
  },
  {
   "id": "p10",
   "sentenceIds": [
    "s10"
   ],
   "ko": "공장 방문객은 생산 현장에 있는 동안 항상 보호 안경을 착용해야 한다."
  }
 ],
 "sentences": [
  {
   "id": "s1",
   "paragraphId": "p1",
   "en": "Ms. Okafor responded promptly to every customer complaint that was forwarded to her last week.",
   "ko": "오카포 씨는 지난주 자신에게 전달된 모든 고객 불만에 신속하게 대응했다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s2",
   "paragraphId": "p2",
   "en": "The hotel's management expressed its appreciation to guests for their patience during the lobby renovation.",
   "ko": "호텔 경영진은 로비 보수 공사 기간 동안 기다려 준 투숙객들에게 감사를 표했다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s3",
   "paragraphId": "p3",
   "en": "The marketing team prepared an extensive analysis of consumer trends in the regional beverage market.",
   "ko": "마케팅팀은 지역 음료 시장의 소비자 동향에 대한 광범위한 분석을 준비했다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s4",
   "paragraphId": "p4",
   "en": "All employees attending the training session on Thursday should bring a laptop with the new software installed.",
   "ko": "목요일 교육에 참석하는 모든 직원은 새 소프트웨어가 설치된 노트북을 가져와야 한다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s5",
   "paragraphId": "p5",
   "en": "If the shipment had left the warehouse on time, it would have reached the store by Monday.",
   "ko": "배송품이 제때 창고를 떠났더라면 월요일까지 매장에 도착했을 것이다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s6",
   "paragraphId": "p6",
   "en": "Founded in 1998, Carver Logistics now operates distribution centers in six countries.",
   "ko": "1998년에 설립된 카버 로지스틱스는 현재 6개국에서 물류 센터를 운영한다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s7",
   "paragraphId": "p7",
   "en": "The outdoor product demonstration was moved indoors due to the strong winds expected in the afternoon.",
   "ko": "오후에 강풍이 예상되어 야외 제품 시연회가 실내로 옮겨졌다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s8",
   "paragraphId": "p8",
   "en": "Ms. Brandt will approve the travel request as long as the total cost stays within the department's budget.",
   "ko": "총비용이 부서 예산 안에 머문다면 브란트 씨는 출장 요청을 승인할 것이다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s9",
   "paragraphId": "p9",
   "en": "The contract must be renewed before it expires at the end of the month.",
   "ko": "계약은 이달 말에 만료되기 전에 갱신되어야 한다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s10",
   "paragraphId": "p10",
   "en": "Visitors to the factory must wear protective glasses at all times while on the production floor.",
   "ko": "공장 방문객은 생산 현장에 있는 동안 항상 보호 안경을 착용해야 한다.",
   "audioStartSec": null,
   "audioEndSec": null
  }
 ],
