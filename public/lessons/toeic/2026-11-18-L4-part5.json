  "grammar": [
    {
      "id": "g1",
      "title": "부정어 도치 (Rarely + 조동사 + S)",
      "tags": [
        "도치",
        "일치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Rarely has the company received"
      ],
      "explanation": "Rarely, Seldom, Never, Hardly 같은 부정 부사가 문장 맨 앞에 오면 의문문 어순(조동사 + 주어)이 된다. 조동사는 주어 the company(단수)에 맞춰 has.",
      "example": {
        "en": "Seldom do we see such strong results.",
        "ko": "이렇게 강한 실적은 좀처럼 보기 어렵다."
      },
      "note": "뒤에 p.p.(received)가 있으면 has/have, 동사원형이면 do/does/did를 고른다."
    },
    {
      "id": "g2",
      "title": "가정법 과거완료 도치 (Had + S + p.p.)",
      "tags": [
        "가정법",
        "도치"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Had the shipment arrived",
        "would have been"
      ],
      "explanation": "If를 생략하면 Had가 주어 앞으로 나간다. 주절은 would have + p.p.로 과거 사실의 반대를 나타낸다.",
      "example": {
        "en": "Had I known about the delay, I would have called.",
        "ko": "지연을 알았다면 전화했을 텐데."
      },
      "note": "콤마 앞 절이 주어 + p.p.로 시작하고 주절이 would have p.p.면 빈칸은 Had."
    },
    {
      "id": "g3",
      "title": "복합관계형용사 whatever + 명사",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Whatever changes the board decides to make"
      ],
      "explanation": "whatever + 명사는 '어떤 ~을 …하든'이라는 양보의 뜻으로 부사절을 이끈다. 명사(changes)를 바로 꾸밀 수 있는 것은 whatever/whichever.",
      "example": {
        "en": "Whatever decision you make, we will support you.",
        "ko": "어떤 결정을 내리든 우리는 당신을 지지할 것이다."
      },
      "note": "빈칸 바로 뒤에 관사 없는 명사가 오면 However·Whenever가 아니라 Whatever."
    }
  ],
