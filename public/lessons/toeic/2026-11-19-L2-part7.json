  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "Why was the letter sent?",
      "evidenceSentenceIds": [
        "s3"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To announce the opening of a new store"
        },
        {
          "key": "B",
          "text": "To apologize for a delivery delay"
        },
        {
          "key": "C",
          "text": "To explain updates to a membership program"
        },
        {
          "key": "D",
          "text": "To invite customers to a cooking event"
        }
      ],
      "answer": "C",
      "explanationKo": "We are writing to inform you of several changes ... 회원 프로그램의 변경 사항을 알리는 편지다. changes → updates로 바꿔 말했다.",
      "choiceNotesKo": {
        "B": "배달은 포인트로 낼 수 있게 된다는 내용일 뿐 지연 이야기는 없다.",
        "A": "새 매장 개점 이야기는 없다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "According to the letter, what will happen to points that are not used for a year?",
      "evidenceSentenceIds": [
        "s7"
      ],
      "choices": [
        {
          "key": "A",
          "text": "They will no longer be valid."
        },
        {
          "key": "B",
          "text": "They will be changed into cash."
        },
        {
          "key": "C",
          "text": "They will be doubled automatically."
        },
        {
          "key": "D",
          "text": "They will be sent to the mobile app."
        }
      ],
      "answer": "A",
      "explanationKo": "points will expire if they are not used within twelve months → 12개월 안에 쓰지 않으면 소멸된다. expire를 '더 이상 유효하지 않다(no longer be valid)'로 바꿔 말했다.",
      "choiceNotesKo": {
        "C": "2배는 신선 과일·채소를 살 때 받는 포인트 이야기다.",
        "D": "앱은 잔액을 확인하는 곳이다."
      },
      "skill": "세부 사항"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-synonym",
      "prompt": "In the letter, the word \"flat\" in paragraph 2 is closest in meaning to",
      "evidenceSentenceIds": [
        "s6"
      ],
      "choices": [
        {
          "key": "A",
          "text": "level"
        },
        {
          "key": "B",
          "text": "smooth"
        },
        {
          "key": "C",
          "text": "low"
        },
        {
          "key": "D",
          "text": "fixed"
        }
      ],
      "answer": "D",
      "explanationKo": "a flat fee of five dollars는 '5달러로 정해진 요금'이라는 뜻이다. 여기서 flat은 '고정된(fixed)'.",
      "choiceNotesKo": {
        "A": "level은 '평평한'으로, 땅이나 표면에 쓰는 뜻이다.",
        "C": "요금이 싸다는 뜻이 아니라 금액이 정해져 있다는 뜻이다."
      },
      "skill": "동의어"
    }
  ]
