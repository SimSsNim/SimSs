 "paragraphs": [
  {
   "id": "p1",
   "sentenceIds": [
    "s1"
   ],
   "ko": "오카포 씨는 창고 직원들에게 새 안전 절차를 자세히 설명했다."
  },
  {
   "id": "p2",
   "sentenceIds": [
    "s2"
   ],
   "ko": "연례 주주 총회는 다음 주 목요일 대강당에서 열릴 것이다."
  },
  {
   "id": "p3",
   "sentenceIds": [
    "s3"
   ],
   "ko": "폭설에도 불구하고 대부분의 직원이 제시간에 출근했다."
  },
  {
   "id": "p4",
   "sentenceIds": [
    "s4"
   ],
   "ko": "리더십 워크숍에 참석하고 싶은 직원은 금요일까지 하다드 씨에게 연락해야 한다."
  },
  {
   "id": "p5",
   "sentenceIds": [
    "s5"
   ],
   "ko": "텔레비전 광고가 시작된 이후 새 믹서기의 판매량이 빠르게 늘었다."
  },
  {
   "id": "p6",
   "sentenceIds": [
    "s6"
   ],
   "ko": "매장 관리자는 연말 성수기를 위해 계산원을 두 명 더 고용하기로 했다."
  },
  {
   "id": "p7",
   "sentenceIds": [
    "s7"
   ],
   "ko": "우리 기술자들은 모든 공장 설비를 정기적으로 점검·정비한다."
  },
  {
   "id": "p8",
   "sentenceIds": [
    "s8"
   ],
   "ko": "알바레스 씨는 수정된 가격표를 받자마자 고객에게 전화할 것이다."
  },
  {
   "id": "p9",
   "sentenceIds": [
    "s9"
   ],
   "ko": "새 지점장은 팀원들에게 회의 때마다 의견을 나누도록 권해 왔다."
  },
  {
   "id": "p10",
   "sentenceIds": [
    "s10"
   ],
   "ko": "모든 출장비는 지급되기 전에 부서장의 승인을 받아야 한다."
  }
 ],
 "sentences": [
  {
   "id": "s1",
   "paragraphId": "p1",
   "en": "Ms. Okafor gave a detailed explanation of the new safety procedures to the warehouse staff.",
   "ko": "오카포 씨는 창고 직원들에게 새 안전 절차를 자세히 설명했다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s2",
   "paragraphId": "p2",
   "en": "The annual shareholders' meeting will be held in the main auditorium next Thursday.",
   "ko": "연례 주주 총회는 다음 주 목요일 대강당에서 열릴 것이다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s3",
   "paragraphId": "p3",
   "en": "Despite the heavy snow, most employees arrived at work on time.",
   "ko": "폭설에도 불구하고 대부분의 직원이 제시간에 출근했다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s4",
   "paragraphId": "p4",
   "en": "Employees who wish to attend the leadership workshop should contact Mr. Haddad by Friday.",
   "ko": "리더십 워크숍에 참석하고 싶은 직원은 금요일까지 하다드 씨에게 연락해야 한다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s5",
   "paragraphId": "p5",
   "en": "Sales of the new blender have increased rapidly since the television advertisement began.",
   "ko": "텔레비전 광고가 시작된 이후 새 믹서기의 판매량이 빠르게 늘었다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s6",
   "paragraphId": "p6",
   "en": "The store manager decided to hire two more cashiers for the holiday season.",
   "ko": "매장 관리자는 연말 성수기를 위해 계산원을 두 명 더 고용하기로 했다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s7",
   "paragraphId": "p7",
   "en": "Our technicians carry out regular maintenance on all factory equipment.",
   "ko": "우리 기술자들은 모든 공장 설비를 정기적으로 점검·정비한다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s8",
   "paragraphId": "p8",
   "en": "Mr. Alvarez will call the client as soon as he receives the updated price list.",
   "ko": "알바레스 씨는 수정된 가격표를 받자마자 고객에게 전화할 것이다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s9",
   "paragraphId": "p9",
   "en": "The new branch manager has encouraged the team to share ideas at every meeting.",
   "ko": "새 지점장은 팀원들에게 회의 때마다 의견을 나누도록 권해 왔다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s10",
   "paragraphId": "p10",
   "en": "All travel expenses must be approved by a department head before they are paid.",
   "ko": "모든 출장비는 지급되기 전에 부서장의 승인을 받아야 한다.",
   "audioStartSec": null,
   "audioEndSec": null
  }
 ],
