 "grammar": [
  {
   "id": "g1",
   "title": "despite + 명사 / although + 절",
   "tags": [
    "접속사"
   ],
   "sentenceId": "s3",
   "highlight": [
    "Despite the heavy snow"
   ],
   "explanation": "despite(~에도 불구하고)는 전치사라 뒤에 명사(구)가 온다. 같은 뜻이라도 although는 접속사라 뒤에 '주어 + 동사'가 온다.",
   "example": {
    "en": "Although it snowed heavily, we arrived on time.",
    "ko": "눈이 많이 왔지만 우리는 제시간에 도착했다."
   },
   "note": "빈칸 뒤가 명사구냐 절이냐를 먼저 본다."
  },
  {
   "id": "g2",
   "title": "decide + to부정사",
   "tags": [
    "to부정사"
   ],
   "sentenceId": "s6",
   "highlight": [
    "decided to hire"
   ],
   "explanation": "decide, plan, hope, want 같은 동사는 목적어로 to부정사를 쓴다.",
   "example": {
    "en": "We decided to move the meeting to Monday.",
    "ko": "우리는 회의를 월요일로 옮기기로 했다."
   },
   "note": "decide -ing는 틀린 형태."
  },
  {
   "id": "g3",
   "title": "현재완료 + since",
   "tags": [
    "시제"
   ],
   "sentenceId": "s5",
   "highlight": [
    "have increased",
    "since"
   ],
   "explanation": "since(~이후로) + 과거 시점이 있으면 주절은 현재완료를 쓴다. 과거부터 지금까지 이어진 변화를 나타낸다.",
   "example": {
    "en": "Prices have risen since January.",
    "ko": "1월 이후로 가격이 올랐다."
   },
   "note": "since가 보이면 현재완료를 먼저 떠올린다."
  }
 ],
