  "grammar": [
    {
      "id": "g1",
      "title": "Only + 부사절 도치",
      "tags": [
        "도치"
      ],
      "sentenceId": "s10",
      "highlight": [
        "Only after all requests have been reviewed will the executive committee"
      ],
      "explanation": "Only after/Only when/Only if 같은 표현이 문장 앞에 오면 주절은 조동사 + 주어 + 동사 순서로 도치된다.",
      "example": {
        "en": "Only when the contract is signed will we begin production.",
        "ko": "계약서에 서명이 되어야 비로소 생산을 시작할 것이다."
      },
      "note": "주절이 will + 주어로 시작하면 앞 빈칸은 Only after/Only when."
    },
    {
      "id": "g2",
      "title": "명사를 뒤에서 꾸미는 현재분사 (-ing)",
      "tags": [
        "분사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "Requests lacking supporting documents"
      ],
      "explanation": "lacking 이하가 Requests를 꾸민다. 요청서가 서류를 '빠뜨리고 있는' 능동 관계이고 뒤에 목적어가 있으므로 현재분사. that lack ~과 같은 뜻.",
      "example": {
        "en": "Passengers carrying large bags must use the side entrance.",
        "ko": "큰 가방을 든 승객은 옆 출입구를 이용해야 한다."
      },
      "note": "명사 뒤 빈칸 + 목적어 있음 → -ing, 목적어 없음 → p.p."
    },
    {
      "id": "g3",
      "title": "소유격 관계대명사 whose",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s11",
      "highlight": [
        "Managers whose proposals exceed"
      ],
      "explanation": "선행사 Managers와 proposals가 '부서장의 제안'이라는 소유 관계. whose 뒤에는 관사 없는 명사가 바로 온다.",
      "example": {
        "en": "Applicants whose forms are incomplete will be contacted.",
        "ko": "서류가 미완성인 지원자에게는 연락이 갈 것이다."
      },
      "note": "관계사 뒤 명사 + 동사가 바로 이어지면 whose."
    }
  ],
