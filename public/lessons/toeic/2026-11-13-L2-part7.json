  "grammar": [
    {
      "id": "g1",
      "title": "배수 + as 원급 as (~의 몇 배/몇 분의 일만큼 …한)",
      "tags": [
        "비교"
      ],
      "sentenceId": "s4",
      "highlight": [
        "half as loud as"
      ],
      "explanation": "as + 형용사 원급 + as는 '~만큼 …한'. 앞에 half, twice 같은 말을 붙이면 '~의 절반만큼/두 배만큼'이 된다.",
      "example": {
        "en": "This bag is twice as heavy as that one.",
        "ko": "이 가방은 저것보다 두 배 무겁다."
      },
      "note": "as ~ as 사이에는 비교급(louder)이 아니라 원급(loud)이 온다."
    },
    {
      "id": "g2",
      "title": "spend + 시간 + -ing (~하는 데 시간을 쓰다)",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "spent nearly two years developing"
      ],
      "explanation": "spend 뒤에 시간이나 돈을 쓰고 이어서 동명사(-ing)를 쓴다. to develop은 쓰지 않는다.",
      "example": {
        "en": "She spent the morning answering e-mails.",
        "ko": "그녀는 이메일에 답하느라 오전을 보냈다."
      },
      "note": "spend + 시간/돈 + (in) -ing는 토익 Part 5 빈출 짝."
    },
    {
      "id": "g3",
      "title": "미래 수동태 will be + p.p.",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s8",
      "highlight": [
        "will be sold"
      ],
      "explanation": "제품은 스스로 파는 게 아니라 '팔리는' 것이고, 다음 달 출시라 미래 수동태를 쓴다.",
      "example": {
        "en": "The results will be announced on Friday.",
        "ko": "결과는 금요일에 발표될 것이다."
      },
      "note": "Part 7에서는 가격·판매처를 묻는 문제의 근거로 자주 나온다."
    }
  ],
