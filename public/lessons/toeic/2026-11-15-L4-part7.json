  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the main purpose of the review?",
      "evidenceSentenceIds": [
        "s3",
        "s4"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To compare projectors made by several companies"
        },
        {
          "key": "B",
          "text": "To announce the release date of a new device"
        },
        {
          "key": "C",
          "text": "To assess a company's first product in an unfamiliar category"
        },
        {
          "key": "D",
          "text": "To explain how to repair a damaged projector"
        }
      ],
      "answer": "C",
      "explanationKo": "주방 가전 회사가 처음 내놓은 휴대용 프로젝터(its first portable projector)를 3주간 써 보고 장단점을 평가하는 글이다. '익숙하지 않은 분야의 첫 제품을 평가하기 위해'로 바꿔 말한 C가 정답.",
      "choiceNotesKo": {
        "A": "다른 회사 제품은 가격 비교에서만 잠깐 언급될 뿐 여러 제품을 비교하는 글이 아니다.",
        "B": "제품은 이미 지난봄 발표되었다."
      },
      "skill": "목적 찾기"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "According to the reviewer, what is true about the projector's battery?",
      "evidenceSentenceIds": [
        "s11"
      ],
      "choices": [
        {
          "key": "A",
          "text": "It lasted longer than the manufacturer said it would."
        },
        {
          "key": "B",
          "text": "It takes about four hours to charge fully."
        },
        {
          "key": "C",
          "text": "It must be replaced after a few months."
        },
        {
          "key": "D",
          "text": "It drains quickly when the image is very bright."
        }
      ],
      "answer": "A",
      "explanationKo": "제조사는 4시간이라고 했지만 테스트에서는 꾸준히 4시간 반 가까이 갔다(lasted closer to four and a half). '제조사가 말한 것보다 오래 갔다'로 바꿔 말한 A가 정답.",
      "choiceNotesKo": {
        "B": "4시간은 한 번 충전으로 쓰는 시간이지 충전에 걸리는 시간이 아니다.",
        "D": "밝기 때문에 배터리가 빨리 닳는다는 내용은 없다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-not-true",
      "prompt": "What is NOT mentioned about the Lumora Beam S2?",
      "evidenceSentenceIds": [
        "s5",
        "s9",
        "s14"
      ],
      "choices": [
        {
          "key": "A",
          "text": "It can be set up quickly."
        },
        {
          "key": "B",
          "text": "Its speaker is not ideal for large rooms."
        },
        {
          "key": "C",
          "text": "It costs less than many similar models."
        },
        {
          "key": "D",
          "text": "It comes with a protective carrying case."
        }
      ],
      "answer": "D",
      "explanationKo": "설치가 1분도 안 걸린다(A, s5), 넓은 공간에서는 스피커 소리가 빈약하다(B, s9), 비슷한 밝기의 경쟁 제품보다 훨씬 싸다(C, s14)는 모두 나온다. 노트북 가방에 들어간다는 말은 있지만 전용 케이스가 함께 온다는 말은 없다 → D.",
      "choiceNotesKo": {
        "A": "setup takes less than a minute = can be set up quickly.",
        "C": "priced well below most competitors = costs less than many similar models."
      },
      "skill": "사실이 아닌 것(NOT)"
    }
  ]
