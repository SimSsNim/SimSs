  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is being advertised?",
      "choices": [
        {
          "key": "A",
          "text": "A new airport shuttle service"
        },
        {
          "key": "B",
          "text": "The opening of a hotel restaurant"
        },
        {
          "key": "C",
          "text": "Discounted rooms for weekend travelers"
        },
        {
          "key": "D",
          "text": "A limited-time offer for business events"
        }
      ],
      "answer": "D",
      "explanationKo": "'This fall, we are introducing a special business package'와 9월 1일~11월 30일이라는 기간이 핵심. 이를 '기간 한정 비즈니스 행사 혜택'으로 바꿔 말한 D가 정답.",
      "choiceNotesKo": {
        "A": "공항은 위치를 설명하려고 나왔을 뿐 셔틀 서비스는 언급되지 않는다.",
        "C": "주말 행사에는 패키지를 쓸 수 없다고 했다."
      },
      "skill": "광고의 주제",
      "evidenceSentenceIds": [
        "s5",
        "s6"
      ]
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What will a company receive if it books a full-day event in October?",
      "choices": [
        {
          "key": "A",
          "text": "A complimentary meal for participants"
        },
        {
          "key": "B",
          "text": "A free night's stay for the organizer"
        },
        {
          "key": "C",
          "text": "Half-price use of a projector"
        },
        {
          "key": "D",
          "text": "A discount on airport parking"
        }
      ],
      "answer": "A",
      "explanationKo": "10월은 9월 1일~11월 30일 사이이므로 혜택 대상. 'a free lunch buffet for all guests'를 'complimentary meal for participants(참석자 무료 식사)'로 바꿔 말한 A가 정답.",
      "choiceNotesKo": {
        "B": "숙박은 무료가 아니라 20% 할인이다.",
        "C": "프로젝터는 모든 회의실에 기본으로 있다고 했을 뿐 가격 이야기는 없다."
      },
      "skill": "세부 사항(패러프레이징)",
      "evidenceSentenceIds": [
        "s6"
      ]
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-not-true",
      "prompt": "What is NOT stated about the Seabrook Hotel?",
      "choices": [
        {
          "key": "A",
          "text": "It is close to an airport."
        },
        {
          "key": "B",
          "text": "It has a swimming pool for guests."
        },
        {
          "key": "C",
          "text": "Its meeting rooms have internet access."
        },
        {
          "key": "D",
          "text": "It has staff who help plan events."
        }
      ],
      "answer": "B",
      "explanationKo": "수영장은 광고 어디에도 나오지 않는다. A는 '공항에서 5분', C는 'high-speed internet', D는 'event coordinators will help you'에서 확인된다.",
      "choiceNotesKo": {
        "A": "just five minutes from Harbor City Airport를 close to an airport로 바꿔 말한 것.",
        "D": "event coordinators(행사 담당자)를 staff who help plan events로 바꿔 말한 것."
      },
      "skill": "사실이 아닌 것(NOT)",
      "evidenceSentenceIds": [
