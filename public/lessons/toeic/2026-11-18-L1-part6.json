  "grammar": [
    {
      "id": "g1",
      "title": "전치사 + 동명사",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "for choosing"
      ],
      "explanation": "전치사 for 뒤에는 명사나 동명사(-ing)가 온다. Thank you for -ing = ~해 주셔서 감사합니다.",
      "example": {
        "en": "Thank you for coming today.",
        "ko": "오늘 와 주셔서 감사합니다."
      },
      "note": "전치사 바로 뒤 동사 빈칸 → -ing."
    },
    {
      "id": "g2",
      "title": "미래 진행: will be -ing",
      "tags": [
        "시제"
      ],
      "sentenceId": "s4",
      "highlight": [
        "will be waiting"
      ],
      "explanation": "미래의 어느 때(도착할 때)에 진행 중일 일을 말할 때 will be + -ing를 쓴다.",
      "example": {
        "en": "I will be working at three o'clock.",
        "ko": "나는 3시에 일하고 있을 것이다."
      },
      "note": "When 절(현재형)과 함께 미래 진행이 자주 나온다."
    },
    {
      "id": "g3",
      "title": "between A and B",
