  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "오티즈 씨께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5"
      ],
      "ko": "시카고 출장에 힐크레스트 여행사를 선택해 주셔서 감사합니다. 항공편은 5월 4일 아침 8시에 출발합니다. 도착하시면 호텔 기사가 공항에서 기다리고 있을 것입니다. 기사가 레이크뷰 호텔까지 바로 모셔다 드릴 것입니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s6",
        "s7",
        "s8",
        "s9",
        "s10"
      ],
      "ko": "객실에는 책상과 빠른 인터넷이 있어 편하게 일하실 수 있습니다. 아침 식사는 무료이며 매일 아침 6시 30분부터 10시 사이에 제공됩니다. 전체 여행 일정은 이 이메일에 첨부되어 있습니다. 바꾸고 싶은 것이 있으면 전화 주세요. 즐거운 여행 되시기 바랍니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s11"
      ],
      "ko": "감사합니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s12"
      ],
      "ko": "대니얼 무어, 여행 담당자"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Ms. Ortiz,",
      "ko": "오티즈 씨께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for choosing Hillcrest Travel for your business trip to Chicago.",
      "ko": "시카고 출장에 힐크레스트 여행사를 선택해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "Your flight leaves at eight o'clock on the morning of May 4.",
      "ko": "항공편은 5월 4일 아침 8시에 출발합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "When you arrive, a driver from the hotel will be waiting for you at the airport.",
      "ko": "도착하시면 호텔 기사가 공항에서 기다리고 있을 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "He will take you directly to the Lakeview Hotel.",
      "ko": "기사가 레이크뷰 호텔까지 바로 모셔다 드릴 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "Your room has a desk and fast Internet, so you can work comfortably.",
      "ko": "객실에는 책상과 빠른 인터넷이 있어 편하게 일하실 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "Breakfast is free and is served between 6:30 and 10:00 every morning.",
      "ko": "아침 식사는 무료이며 매일 아침 6시 30분부터 10시 사이에 제공됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "Your complete travel schedule is attached to this e-mail.",
      "ko": "전체 여행 일정은 이 이메일에 첨부되어 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p3",
      "en": "Please call me if you would like to change anything.",
      "ko": "바꾸고 싶은 것이 있으면 전화 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p3",
      "en": "I hope you have a pleasant trip.",
      "ko": "즐거운 여행 되시기 바랍니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p4",
      "en": "Best regards,",
      "ko": "감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p5",
      "en": "Daniel Moore, Travel Coordinator",
      "ko": "대니얼 무어, 여행 담당자",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
