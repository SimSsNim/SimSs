  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "베르데 테이블과 함께라면 점심 회의도 간편하게"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4"
      ],
      "ko": "팀이 점심을 먹으며 회의할 때마다 똑같은 샌드위치를 주문하는 데 지치셨나요? 12년 동안 하버 지구에서 영업해 온 식당 베르데 테이블이 이제 특별히 기업을 위해 마련한 점심 배달 서비스를 제공합니다. 모든 주문은 행사 당일 오전에 지역 농장의 신선한 재료로 준비됩니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s5",
        "s6",
        "s7",
        "s8"
      ],
      "ko": "인원 규모에 맞게 세 가지 패키지 중에서 고르세요. 에센셜 패키지는 최대 15명 단체를 위한 샐러드, 샌드위치, 생수를 포함합니다. 이그제큐티브 패키지는 따뜻한 요리, 디저트, 갓 내린 커피가 추가되며 최대 40명까지 대접할 수 있습니다. 더 큰 모임이라면 커스텀 패키지로 주방장과 직접 상의해 필요에 맞는 메뉴를 만들 수 있습니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s9",
        "s10",
        "s11"
      ],
      "ko": "모든 패키지에는 접시, 냅킨, 식기류가 추가 요금 없이 함께 제공됩니다. 주문은 최소 영업일 기준 이틀 전에 하셔야 하며, 배달은 월요일부터 금요일까지 가능합니다. 저희 직원이 회의 시작 30분 전에 도착해 음식을 차려 드립니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s12",
        "s13"
      ],
      "ko": "이 서비스 출시를 기념해 4월 30일 이전에 주문하는 모든 패키지에 대해 첫 이용 고객께 15퍼센트 할인을 드립니다. 555-0172로 전화하시거나 저희 웹사이트를 방문해 메뉴 견본을 보고 주문하세요."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Lunch Meetings Made Easy with Verde Table",
      "ko": "베르데 테이블과 함께라면 점심 회의도 간편하게",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Are you tired of ordering the same sandwiches every time your team meets over lunch?",
      "ko": "팀이 점심을 먹으며 회의할 때마다 똑같은 샌드위치를 주문하는 데 지치셨나요?",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "Verde Table, a restaurant that has served the Harbor District for twelve years, is now offering a lunch delivery service designed especially for businesses.",
      "ko": "12년 동안 하버 지구에서 영업해 온 식당 베르데 테이블이 이제 특별히 기업을 위해 마련한 점심 배달 서비스를 제공합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "Each order is prepared on the morning of your event using fresh ingredients from local farms.",
      "ko": "모든 주문은 행사 당일 오전에 지역 농장의 신선한 재료로 준비됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p3",
      "en": "Choose from three packages to suit the size of your group.",
      "ko": "인원 규모에 맞게 세 가지 패키지 중에서 고르세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "The Essential package includes salads, sandwiches, and bottled water for groups of up to fifteen people.",
      "ko": "에센셜 패키지는 최대 15명 단체를 위한 샐러드, 샌드위치, 생수를 포함합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "The Executive package adds hot dishes, desserts, and freshly brewed coffee, and it can serve as many as forty guests.",
      "ko": "이그제큐티브 패키지는 따뜻한 요리, 디저트, 갓 내린 커피가 추가되며 최대 40명까지 대접할 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "For larger gatherings, our Custom package lets you work directly with our head chef to create a menu that meets your needs.",
      "ko": "더 큰 모임이라면 커스텀 패키지로 주방장과 직접 상의해 필요에 맞는 메뉴를 만들 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "All packages come with plates, napkins, and utensils at no additional charge.",
      "ko": "모든 패키지에는 접시, 냅킨, 식기류가 추가 요금 없이 함께 제공됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "Orders must be placed at least two business days in advance, and deliveries are available Monday through Friday.",
      "ko": "주문은 최소 영업일 기준 이틀 전에 하셔야 하며, 배달은 월요일부터 금요일까지 가능합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p4",
      "en": "Our staff will arrive thirty minutes before your meeting begins to set up the food.",
      "ko": "저희 직원이 회의 시작 30분 전에 도착해 음식을 차려 드립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p5",
      "en": "To celebrate the launch of this service, we are offering first-time customers fifteen percent off any package ordered before April 30.",
      "ko": "이 서비스 출시를 기념해 4월 30일 이전에 주문하는 모든 패키지에 대해 첫 이용 고객께 15퍼센트 할인을 드립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s13",
      "paragraphId": "p5",
      "en": "Call 555-0172 or visit our Web site to see sample menus and place your order.",
      "ko": "555-0172로 전화하시거나 저희 웹사이트를 방문해 메뉴 견본을 보고 주문하세요.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
