  "grammar": [
    {
      "id": "g1",
      "title": "Enclosed 도치 구문",
      "tags": [
        "도치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Enclosed you will find"
      ],
      "explanation": "보어 enclosed가 문장 앞으로 나간 관용 표현. Enclosed is/are + 주어 형태로도 쓴다(Enclosed is a copy of ~).",
      "example": {
        "en": "Attached you will find the revised schedule.",
        "ko": "수정된 일정표를 첨부했으니 확인해 주세요."
      },
      "note": "편지·이메일 첫머리 빈칸 + you will find → Enclosed/Attached."
    },
    {
      "id": "g2",
      "title": "if 생략 가정법 도치 Should",
      "tags": [
        "가정법",
        "도치"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Should you prefer"
      ],
      "explanation": "If you should prefer ~에서 if를 빼고 should를 주어 앞으로 보낸 형태. '혹시 ~하시면'이라는 정중한 조건.",
      "example": {
        "en": "Should you need help, please call the front desk.",
        "ko": "도움이 필요하시면 프런트에 전화 주세요."
      },
      "note": "문두 Should + 주어 + 동사원형 → 조건절, 주절은 주로 명령문."
    },
    {
      "id": "g3",
      "title": "복합관계형용사 whichever",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "whichever moving company"
      ],
      "explanation": "whichever + 명사: '어느 ~이든'. 정해진 선택지 가운데 무엇을 고르든 상관없다는 뜻이다.",
      "example": {
        "en": "You may choose whichever seat you like.",
        "ko": "원하는 아무 자리나 고르셔도 됩니다."
      },
      "note": "빈칸 뒤에 명사가 바로 오면 whichever/whatever 같은 복합관계형용사."
    }
  ],
