  "grammar": [
    {
      "id": "g1",
      "title": "invite + 목적어 + to V",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "invite you to renew"
      ],
      "explanation": "invite, ask, encourage 같은 동사는 '목적어 + to + 동사원형'을 쓴다. 그래서 to 뒤 빈칸에는 동사원형 renew.",
      "example": {
        "en": "We encourage you to apply early.",
        "ko": "일찍 지원하시기를 권합니다."
      },
      "note": "to 뒤 빈칸이 to부정사인지 전치사 to인지 먼저 확인한다."
    },
    {
      "id": "g2",
      "title": "목적격 관계대명사 that",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "the rate that new tenants pay"
      ],
      "explanation": "that 뒤 절(new tenants pay)에 목적어가 빠져 있고, 그 목적어가 앞의 the rate다. 사물 선행사 + 목적격 → that/which.",
      "example": {
        "en": "This is the book that I bought yesterday.",
        "ko": "이것이 내가 어제 산 책이다."
      },
      "note": "선행사 뒤 빈칸 + 목적어 없는 절 → that/which."
    },
    {
      "id": "g3",
      "title": "기간 전치사 within",
      "tags": [
        "전치사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "within two weeks"
      ],
      "explanation": "within + 기간 = '~ 이내에'. 기한 안에 무엇을 하라고 할 때 쓴다.",
      "example": {
        "en": "Please reply within three days.",
        "ko": "3일 이내에 답장해 주세요."
      },
      "note": "within + 기간 / by + 시점(날짜)을 구별한다."
    }
  ],
