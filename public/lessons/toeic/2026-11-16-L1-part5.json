  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "새 프린터는 조용하게 작동해서 직원들을 방해하지 않을 것이다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "사무용 의자 배송품이 어제 오후 창고에 도착했다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "월말 전까지 회계 사무실로 대금을 보내 주세요."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "야외 행사는 폭우 때문에 취소되었다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "워크숍 점심은 지역 식당에서 제공될 것이다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "설명서의 안내는 명확하고 따라 하기 쉽다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "이 씨는 다음 주 월요일에 새 지점을 방문할 계획이다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "이 양식을 작성해서 접수 담당자에게 건네주세요."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "그 회사는 본사 공장의 확장을 발표했다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "사무실을 나가기 전에 불을 꺼 주세요."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The new printer works quietly, so it will not disturb the staff.",
      "ko": "새 프린터는 조용하게 작동해서 직원들을 방해하지 않을 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The shipment of office chairs arrived at the warehouse yesterday afternoon.",
      "ko": "사무용 의자 배송품이 어제 오후 창고에 도착했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Please send your payment to the accounting office before the end of the month.",
      "ko": "월말 전까지 회계 사무실로 대금을 보내 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "The outdoor event was canceled because of the heavy rain.",
      "ko": "야외 행사는 폭우 때문에 취소되었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Lunch for the workshop will be provided by a local restaurant.",
      "ko": "워크숍 점심은 지역 식당에서 제공될 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The instructions in the manual are clear and simple to follow.",
      "ko": "설명서의 안내는 명확하고 따라 하기 쉽다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Ms. Lee plans to visit the new branch office next Monday.",
      "ko": "이 씨는 다음 주 월요일에 새 지점을 방문할 계획이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Please fill out this form and hand it to the receptionist.",
      "ko": "이 양식을 작성해서 접수 담당자에게 건네주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The company has announced an expansion of its main factory.",
      "ko": "그 회사는 본사 공장의 확장을 발표했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Please turn off the lights before you leave the office.",
      "ko": "사무실을 나가기 전에 불을 꺼 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
