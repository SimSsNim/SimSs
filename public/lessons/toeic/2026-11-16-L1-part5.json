  "grammar": [
    {
      "id": "g1",
      "title": "미래 수동태 will be p.p.",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s5",
      "highlight": [
        "will be provided by"
      ],
      "explanation": "점심은 스스로 제공하는 것이 아니라 '제공되는' 것이다. 미래의 수동태는 will be + 과거분사(p.p.)로 쓴다.",
      "example": {
        "en": "The tickets will be sent by e-mail.",
        "ko": "표는 이메일로 발송될 것이다."
      },
      "note": "be 동사 뒤 빈칸 + by ~ → 과거분사."
    },
    {
      "id": "g2",
      "title": "과거 시제와 yesterday",
      "tags": [
        "시제"
      ],
      "sentenceId": "s2",
      "highlight": [
        "arrived",
        "yesterday afternoon"
      ],
      "explanation": "yesterday(어제)처럼 지난 때를 나타내는 말이 있으면 동사는 과거형을 쓴다.",
      "example": {
        "en": "We met the new client yesterday.",
        "ko": "우리는 어제 새 고객을 만났다."
      },
      "note": "yesterday, last week, ago → 과거 시제 단서."
    },
    {
      "id": "g3",
      "title": "plan + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "plans to visit"
      ],
      "explanation": "plan(계획하다)은 뒤에 to + 동사원형을 쓴다. 앞으로 할 일을 나타낸다.",
      "example": {
        "en": "We plan to hire two new designers.",
        "ko": "우리는 디자이너 두 명을 새로 채용할 계획이다."
      },
      "note": "plan, want, decide, hope 뒤 → to부정사."
    }
  ],
