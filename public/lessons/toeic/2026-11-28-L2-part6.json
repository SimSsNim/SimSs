  "grammar": [
    {
      "id": "g1",
      "title": "시간 부사절 안의 수동태",
      "tags": [
        "수동태",
        "부사절"
      ],
      "sentenceId": "s8",
      "highlight": [
        "while this important work is carried out"
      ],
      "explanation": "작업은 '수행되는' 대상이라 수동태 is carried out. while(~하는 동안) 같은 시간 접속사 뒤에서는 미래 일도 현재형으로 쓴다.",
      "example": {
        "en": "Please wait outside while the room is cleaned.",
        "ko": "방이 청소되는 동안 밖에서 기다려 주세요."
      },
      "note": "carry out(수행하다)의 수동태 be carried out은 공사·조사 지문에 자주 나온다."
    },
    {
      "id": "g2",
      "title": "recommend that + 동사원형",
      "tags": [
        "명사절"
      ],
      "sentenceId": "s5",
      "highlight": [
        "recommend that you store"
      ],
      "explanation": "recommend, suggest, request 뒤 that절에는 주어와 상관없이 동사원형을 쓴다(should가 생략된 형태).",
      "example": {
        "en": "We suggest that he arrive early.",
        "ko": "그가 일찍 도착할 것을 권한다."
      },
      "note": "주어가 he여도 arrives가 아니라 arrive — Part 5에서 자주 묻는다."
    },
    {
      "id": "g3",
      "title": "전치사 During vs 접속사 While",
      "tags": [
        "전치사",
        "접속사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "During this time"
      ],
      "explanation": "During은 뒤에 명사(this time), While은 뒤에 '주어 + 동사'가 온다. 뜻은 둘 다 '~동안'.",
      "example": {
        "en": "During the meeting, phones must be turned off.",
        "ko": "회의 중에는 휴대 전화를 꺼야 한다."
      },
      "note": "이 지문에는 During(s3)과 while(s8)이 둘 다 나온다 — 뒤 구조를 비교해 보자."
    }
  ],
