  "wordCount": 109,
  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Rivera 님께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4"
      ],
      "ko": "Maple Table을 선택해 주셔서 감사합니다. 이 이메일은 12월 5일 토요일 저녁 7시, 8명 예약을 확인해 드립니다. 고객님 일행은 2층 별실로 안내될 것입니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s5",
        "s6",
        "s7"
      ],
      "ko": "저희 셰프가 이번 달을 위한 특별 연말 메뉴를 준비했습니다. 이 메뉴는 세 가지 코스와 디저트로 구성됩니다. 일행 중 식품 알레르기가 있는 분이 계시면 목요일 전에 알려 주세요."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s8",
        "s9",
        "s10"
      ],
      "ko": "식당 뒤편에 무료 주차가 가능합니다. 예약을 변경하거나 취소하셔야 하면 적어도 하루 전에 전화해 주세요. 고객님을 맞이하기를 고대합니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s11"
      ],
      "ko": "드림,"
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s12"
      ],
      "ko": "Daniel Ortiz, 고객 서비스 매니저"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Ms. Rivera,",
      "ko": "Rivera 님께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for choosing Maple Table.",
      "ko": "Maple Table을 선택해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "This e-mail confirms your reservation for eight people on Saturday, December 5, at seven in the evening.",
      "ko": "이 이메일은 12월 5일 토요일 저녁 7시, 8명 예약을 확인해 드립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "Your group will be seated in our private room on the second floor.",
      "ko": "고객님 일행은 2층 별실로 안내될 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p3",
      "en": "Our chef has prepared a special holiday menu for this month.",
      "ko": "저희 셰프가 이번 달을 위한 특별 연말 메뉴를 준비했습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "It includes three courses and a dessert.",
      "ko": "이 메뉴는 세 가지 코스와 디저트로 구성됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "If anyone in your group has a food allergy, please let us know before Thursday.",
      "ko": "일행 중 식품 알레르기가 있는 분이 계시면 목요일 전에 알려 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p4",
      "en": "Free parking is available behind the restaurant.",
      "ko": "식당 뒤편에 무료 주차가 가능합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "If you need to change or cancel your reservation, please call us at least one day in advance.",
      "ko": "예약을 변경하거나 취소하셔야 하면 적어도 하루 전에 전화해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "We look forward to welcoming you.",
      "ko": "고객님을 맞이하기를 고대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p5",
      "en": "Sincerely,",
      "ko": "드림,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p6",
      "en": "Daniel Ortiz, Guest Services Manager",
      "ko": "Daniel Ortiz, 고객 서비스 매니저",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
