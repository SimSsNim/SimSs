  "grammar": [
    {
      "id": "g1",
      "title": "현재 수동태 is p.p.",
      "tags": [
        "수동태"
      ],
      "sentenceId": "s8",
      "highlight": [
        "is served"
      ],
      "explanation": "아침 식사는 '제공되는' 대상이므로 be + 과거분사(is served). 매일 반복되는 일이라 현재형이다.",
      "example": {
        "en": "Lunch is served from noon to two.",
        "ko": "점심은 12시부터 2시까지 제공된다."
      },
      "note": "호텔·식당 지문에서 is served, is included, is located 같은 수동태가 자주 나온다."
    },
    {
      "id": "g2",
      "title": "주어-동사 수 일치(3인칭 단수)",
      "tags": [
        "일치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Your room includes"
      ],
      "explanation": "주어 Your room은 단수(3인칭)이므로 현재형 동사에 -s를 붙인다: include → includes.",
      "example": {
        "en": "The package includes a free map.",
        "ko": "그 패키지에는 무료 지도가 포함되어 있다."
      },
      "note": "주어가 단수인지 복수인지 먼저 확인하면 동사 문제를 쉽게 푼다."
    },
    {
      "id": "g3",
      "title": "조건의 if절",
      "tags": [
        "부사절",
        "접속사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "If you need to change your plans"
      ],
      "explanation": "If + 주어 + 동사(현재형)는 '~하면'이라는 조건을 나타낸다. 뒤에 please + 동사원형의 부탁이 자주 온다.",
      "example": {
        "en": "If you have questions, please call us.",
        "ko": "질문이 있으시면 전화 주세요."
      },
      "note": "이메일 끝부분의 'If you ..., please ...' 문장은 Part 6 단골 표현."
    }
  ],
