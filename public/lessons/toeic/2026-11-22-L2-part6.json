  "grammar": [
    {
      "id": "g1",
      "title": "감정 동사의 수동태",
      "tags": [
        "수동태",
        "분사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "were impressed by"
      ],
      "explanation": "impress(감명을 주다) 같은 감정 동사는 사람이 감정을 느낄 때 수동형(impressed)을 쓴다. 감정을 주는 사물은 -ing/-ive(impressive).",
      "example": {
        "en": "I was surprised by the news.",
        "ko": "나는 그 소식에 놀랐다."
      },
      "note": "사람 주어 + be + ___ + by → p.p.(impressed, satisfied, interested)"
    },
    {
      "id": "g2",
      "title": "be asked to V",
      "tags": [
        "수동태",
        "to부정사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "be asked to take"
      ],
      "explanation": "ask + 사람 + to V가 수동태가 되면 사람 + be asked to V. to부정사는 그대로 남는다.",
      "example": {
        "en": "Guests are asked to check out by noon.",
        "ko": "투숙객은 정오까지 체크아웃해야 한다."
      },
      "note": "be asked/required/encouraged 뒤 빈칸 → to V"
    },
    {
      "id": "g3",
      "title": "접속부사 In addition",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "In addition"
      ],
      "explanation": "In addition은 앞 내용에 정보를 '더할' 때 문장 앞에 쓰고 콤마를 찍는다. 문장과 문장을 의미로 이을 뿐, 두 절을 문법적으로 잇지는 못한다.",
      "example": {
        "en": "The hotel is cheap. In addition, it is close to the station.",
        "ko": "그 호텔은 싸다. 게다가 역에서도 가깝다."
      },
      "note": "Part 6 접속부사: 추가 In addition, 대조 However, 결과 Therefore"
    }
  ],
