  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Hughes 님께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4"
      ],
      "ko": "Norwell Logistics의 사무장 자리에 지원해 주셔서 감사합니다. 귀하의 경력이 인상적이어서 면접에 모시고자 합니다. 면접은 3월 4일 목요일 오후 2시로 잡혀 있습니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s5",
        "s6",
        "s7",
        "s8"
      ],
      "ko": "면접에서는 저희 경영진 두 명을 만나시게 됩니다. 또한 짧은 컴퓨터 활용 능력 시험을 보시게 됩니다. 시험은 보통 30분 정도 걸립니다. 그리고 업무 관련 추천인 3명의 명단을 가져와 주세요."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s9",
        "s10"
      ],
      "ko": "참석 가능 여부를 확인해 주시도록 월요일까지 이 이메일에 회신해 주세요. 뵙기를 기대합니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s11"
      ],
      "ko": "감사합니다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s12"
      ],
      "ko": "Kevin Marsh"
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s13"
      ],
      "ko": "Norwell Logistics 인사부장"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Ms. Hughes,",
      "ko": "Hughes 님께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for applying for the position of office manager at Norwell Logistics.",
      "ko": "Norwell Logistics의 사무장 자리에 지원해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "We were impressed by your experience, and we would like to invite you for an interview.",
      "ko": "귀하의 경력이 인상적이어서 면접에 모시고자 합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "The interview is scheduled for Thursday, March 4, at two in the afternoon.",
      "ko": "면접은 3월 4일 목요일 오후 2시로 잡혀 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p3",
      "en": "During the interview, you will meet with two members of our management team.",
      "ko": "면접에서는 저희 경영진 두 명을 만나시게 됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "You will also be asked to take a short computer skills test.",
      "ko": "또한 짧은 컴퓨터 활용 능력 시험을 보시게 됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "The test usually takes about thirty minutes.",
      "ko": "시험은 보통 30분 정도 걸립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "In addition, please bring a list of three professional references.",
      "ko": "그리고 업무 관련 추천인 3명의 명단을 가져와 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "Please reply to this e-mail by Monday to confirm that you are available.",
      "ko": "참석 가능 여부를 확인해 주시도록 월요일까지 이 이메일에 회신해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "We look forward to meeting you.",
      "ko": "뵙기를 기대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p5",
      "en": "Sincerely,",
      "ko": "감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p6",
      "en": "Kevin Marsh",
      "ko": "Kevin Marsh",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s13",
      "paragraphId": "p7",
      "en": "Human Resources Manager, Norwell Logistics",
      "ko": "Norwell Logistics 인사부장",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
