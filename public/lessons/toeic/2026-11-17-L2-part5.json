  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "재무팀은 지난 분기 지출에 관한 종합 보고서를 준비했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "지난봄에 개조된 그 회의실은 최대 50명까지 수용할 수 있다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "가너 씨는 시상식 만찬에서 개회 연설을 하기로 동의했다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "배송품이 늦게 도착하면 매장은 고객에게 이메일로 연락할 것이다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "텔레비전 광고가 방송된 이후 새 믹서기 판매량이 꾸준히 늘었다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "개정된 안전 지침은 다음 주 월요일에 모든 공장 직원에게 배포될 것이다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "하미드 씨는 20년 근속을 인정받아 상을 받았다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "모든 방문객은 실험실에 들어가기 전에 보안 데스크에서 출입 기록을 해야 한다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "공연 중에는 휴대 전화 사용을 삼가 주세요."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "저희 고객 서비스 상담원은 하루 24시간 질문에 답해 드릴 수 있습니다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The finance team prepared a comprehensive report on last quarter's spending.",
      "ko": "재무팀은 지난 분기 지출에 관한 종합 보고서를 준비했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The conference room, which was renovated last spring, can hold up to fifty people.",
      "ko": "지난봄에 개조된 그 회의실은 최대 50명까지 수용할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Ms. Garner has agreed to give the opening speech at the awards dinner.",
      "ko": "가너 씨는 시상식 만찬에서 개회 연설을 하기로 동의했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "If the shipment arrives late, the store will contact customers by e-mail.",
      "ko": "배송품이 늦게 도착하면 매장은 고객에게 이메일로 연락할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Sales of the new blender have increased steadily since the television advertisement aired.",
      "ko": "텔레비전 광고가 방송된 이후 새 믹서기 판매량이 꾸준히 늘었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The updated safety guidelines will be distributed to all factory staff next Monday.",
      "ko": "개정된 안전 지침은 다음 주 월요일에 모든 공장 직원에게 배포될 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Mr. Hamid received an award in recognition of his twenty years of service.",
      "ko": "하미드 씨는 20년 근속을 인정받아 상을 받았다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "All visitors must sign in at the security desk before entering the laboratory.",
      "ko": "모든 방문객은 실험실에 들어가기 전에 보안 데스크에서 출입 기록을 해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Please refrain from using your mobile phone during the performance.",
      "ko": "공연 중에는 휴대 전화 사용을 삼가 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Our customer service representatives are available to answer questions twenty-four hours a day.",
      "ko": "저희 고객 서비스 상담원은 하루 24시간 질문에 답해 드릴 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
