  "grammar": [
    {
      "id": "g1",
      "title": "계속적 용법 관계대명사 , which",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s2",
      "highlight": [
        ", which was renovated"
      ],
      "explanation": "콤마 뒤에서 사물을 덧붙여 설명할 때는 which를 쓴다. that은 콤마 뒤에 쓸 수 없다.",
      "example": {
        "en": "Our new office, which opened in May, is near the station.",
        "ko": "5월에 문을 연 우리 새 사무실은 역 근처에 있다."
      },
      "note": "콤마 + 빈칸 + 동사 → 사물이면 which, 사람이면 who. that은 탈락."
    },
    {
      "id": "g2",
      "title": "agree + to V",
      "tags": [
