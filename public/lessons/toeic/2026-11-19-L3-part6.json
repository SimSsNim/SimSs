  "grammar": [
    {
      "id": "g1",
      "title": "명사 뒤에서 꾸미는 과거분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "performed by Corvane Mechanical"
      ],
      "explanation": "작업(The work)은 회사에 의해 '수행되는' 것이므로 과거분사 performed가 뒤에서 꾸민다. 이미 동사 is expected가 있으므로 빈칸에 동사(performs)는 올 수 없다.",
      "example": {
        "en": "The report, written by Ms. Kim, was very clear.",
        "ko": "김 씨가 쓴 보고서는 매우 명확했다."
      },
      "note": "문장에 동사가 이미 있고 빈칸 뒤에 by가 오면 과거분사(p.p.)."
    },
    {
      "id": "g2",
      "title": "미래 수동태",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s4",
      "highlight": [
        "will be replaced"
      ],
      "explanation": "시스템은 '교체되는' 대상이므로 수동태. 다음 주 일이므로 will be + p.p.",
      "example": {
        "en": "The windows will be cleaned on Saturday.",
        "ko": "창문은 토요일에 청소될 것이다."
      },
      "note": "주어가 사물이고 뒤에 목적어가 없으면 수동태를 먼저 의심한다."
    },
    {
      "id": "g3",
      "title": "비교급 less/more",
      "tags": [
        "비교"
      ],
      "sentenceId": "s10",
      "highlight": [
        "less energy than",
        "more comfortable"
      ],
      "explanation": "less + 명사 + than은 '~보다 적은 …', more + 형용사는 '더 ~한'. comfortable처럼 긴 형용사는 -er 대신 more를 쓴다.",
      "example": {
        "en": "This model is more affordable than the old one.",
        "ko": "이 모델은 이전 모델보다 더 저렴하다."
      },
      "note": "a more ___ + 명사 → 빈칸은 형용사."
    }
  ],
