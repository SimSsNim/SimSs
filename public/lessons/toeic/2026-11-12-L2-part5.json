  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "마케팅팀은 어제 새 광고 캠페인에 대해 자세한 발표를 했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "모든 출장 경비는 표를 예매하기 전에 부서장의 승인을 받아야 한다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "그 호텔은 공항에서 멀리 떨어져 있지만, 많은 손님이 훌륭한 서비스 때문에 그곳을 선택한다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "파텔 씨의 팀은 사무실 이전을 예정보다 이틀 앞당겨 성공적으로 마쳤다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "이력서가 선정된 지원자들은 다음 주에 면접 연락을 받게 된다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "그 회사는 올해 말까지 부산에 새 지점 두 곳을 열 계획이다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "고객은 원래 영수증을 가지고 있으면 30일 안에 결함 있는 제품을 교환할 수 있다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "새 일정 관리 소프트웨어는 창고의 지연을 줄이는 데 매우 효과적이었다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "공장 안에 있는 동안에는 항상 신분증 배지가 보이도록 해 주세요."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "3층 회의실은 매일 오후 직원 회의용으로 이용할 수 있다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The marketing team gave a detailed presentation on the new advertising campaign yesterday.",
      "ko": "마케팅팀은 어제 새 광고 캠페인에 대해 자세한 발표를 했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "All travel expenses must be approved by a department manager before tickets are booked.",
      "ko": "모든 출장 경비는 표를 예매하기 전에 부서장의 승인을 받아야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Although the hotel is located far from the airport, many guests choose it for its excellent service.",
      "ko": "그 호텔은 공항에서 멀리 떨어져 있지만, 많은 손님이 훌륭한 서비스 때문에 그곳을 선택한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Ms. Patel's team successfully completed the office relocation two days ahead of schedule.",
      "ko": "파텔 씨의 팀은 사무실 이전을 예정보다 이틀 앞당겨 성공적으로 마쳤다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Applicants whose resumes are selected will be contacted for an interview next week.",
      "ko": "이력서가 선정된 지원자들은 다음 주에 면접 연락을 받게 된다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The company plans to open two new branches in Busan by the end of the year.",
      "ko": "그 회사는 올해 말까지 부산에 새 지점 두 곳을 열 계획이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Customers can exchange defective items within 30 days if they keep the original receipt.",
      "ko": "고객은 원래 영수증을 가지고 있으면 30일 안에 결함 있는 제품을 교환할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "The new scheduling software has been very effective in reducing delays at the warehouse.",
      "ko": "새 일정 관리 소프트웨어는 창고의 지연을 줄이는 데 매우 효과적이었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Please keep your identification badge visible at all times while you are inside the factory.",
      "ko": "공장 안에 있는 동안에는 항상 신분증 배지가 보이도록 해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "The conference room on the third floor is available for staff meetings every afternoon.",
      "ko": "3층 회의실은 매일 오후 직원 회의용으로 이용할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
