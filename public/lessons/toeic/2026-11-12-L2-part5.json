  "grammar": [
    {
      "id": "g1",
      "title": "조동사 + be + p.p. (수동태)",
      "tags": [
        "수동태",
        "조동사"
      ],
      "sentenceId": "s2",
      "highlight": [
        "must be approved by"
      ],
      "explanation": "주어 expenses(경비)는 스스로 승인하는 게 아니라 '승인을 받는' 대상이다. 조동사 뒤에는 be + p.p.를 쓴다. 뒤의 by + 사람도 수동태 단서.",
      "example": {
        "en": "The report should be checked by Friday.",
        "ko": "그 보고서는 금요일까지 확인되어야 한다."
      },
      "note": "빈칸 앞 be동사 + 뒤에 목적어 없이 by가 오면 p.p.를 고른다."
    },
    {
      "id": "g2",
      "title": "소유격 관계대명사 whose",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Applicants whose resumes"
      ],
      "explanation": "whose 뒤에는 관사 없는 명사가 바로 온다. '지원자들의 이력서'처럼 소유 관계를 나타낸다.",
      "example": {
        "en": "I met a writer whose books are very popular.",
        "ko": "나는 책이 아주 인기 있는 작가를 만났다."
      },
      "note": "빈칸 뒤에 명사 + 동사가 이어지면 whose를 먼저 떠올린다."
    },
    {
      "id": "g3",
      "title": "plan + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "plans to open"
      ],
      "explanation": "plan, decide, hope, want, agree 같은 동사는 목적어로 to부정사를 쓴다. 동명사(opening)는 올 수 없다.",
      "example": {
        "en": "We decided to hire two more people.",
        "ko": "우리는 두 명을 더 채용하기로 했다."
      },
      "note": "plan/decide/hope/agree + to V는 토익 단골 짝꿍."
    }
  ],
