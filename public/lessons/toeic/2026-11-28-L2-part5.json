  "grammar": [
    {
      "id": "g1",
      "title": "계속적 용법의 관계대명사 which",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "guidelines, which explain"
      ],
      "explanation": "콤마 뒤 which는 앞의 사물 명사(guidelines)를 받아 추가 설명을 덧붙인다. which 뒤에 바로 동사(explain)가 오는 주격 관계대명사.",
      "example": {
        "en": "I sent the report, which includes the new figures.",
        "ko": "보고서를 보냈는데, 거기에는 새 수치가 들어 있다."
      },
      "note": "콤마 뒤에는 that을 쓸 수 없다 — 사물이면 which, 사람이면 who."
    },
    {
      "id": "g2",
      "title": "avoid + 동명사",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "avoid sending"
      ],
      "explanation": "avoid(피하다)는 to부정사가 아니라 동명사(-ing)를 목적어로 쓴다. avoid to send(×).",
      "example": {
        "en": "Try to avoid driving during rush hour.",
        "ko": "출퇴근 시간에는 운전을 피하도록 하세요."
      },
      "note": "동명사만 목적어로 쓰는 동사: avoid, consider, suggest, finish, mind, recommend."
    },
    {
      "id": "g3",
      "title": "Unless(~하지 않으면) vs Despite(~에도 불구하고)",
      "tags": [
        "접속사",
        "전치사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "Despite the heavy rain"
      ],
      "explanation": "Unless는 접속사라 뒤에 '주어 + 동사', Despite는 전치사라 뒤에 명사(구)가 온다. 둘 다 빈칸 뒤 구조를 보고 고른다.",
      "example": {
        "en": "Despite the delay, the meeting started on time.",
        "ko": "지연에도 불구하고 회의는 제시간에 시작했다."
      },
      "note": "Despite = In spite of. Although는 같은 뜻의 접속사."
    }
  ],
