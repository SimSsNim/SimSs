  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "우리의 새 웹사이트는 온라인으로 쇼핑하는 고객들에게 매우 유용하다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "Garcia 씨는 우리에게 퇴근 전까지 그 결제 내역을 확인해 달라고 부탁했다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "매니저는 방문객들의 모든 질문에 정중하게 답했다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "다른 나라의 고객과 일할 때는 원활한 의사소통이 중요하다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "마케팅 팀은 다음 주 월요일에 설문 조사 결과를 발표할 것이다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "새 프린터들이 어제 3층에 설치되었다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "사무실을 나간 뒤에는 문을 잠가 주세요."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "10시부터 정오 사이에 회의실을 사용할 수 있습니다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "고객은 언제든지 우리 웹사이트에서 주문 상태를 조회할 수 있다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "올해 봄 할인 행사는 작년 행사보다 훨씬 규모가 컸다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Our new website is very useful for customers who shop online.",
      "ko": "우리의 새 웹사이트는 온라인으로 쇼핑하는 고객들에게 매우 유용하다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Ms. Garcia asked us to check the payment before the end of the day.",
      "ko": "Garcia 씨는 우리에게 퇴근 전까지 그 결제 내역을 확인해 달라고 부탁했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The manager politely answered every question from the visitors.",
      "ko": "매니저는 방문객들의 모든 질문에 정중하게 답했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Good communication is important when you work with clients in other countries.",
      "ko": "다른 나라의 고객과 일할 때는 원활한 의사소통이 중요하다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The marketing team will present the survey results next Monday.",
      "ko": "마케팅 팀은 다음 주 월요일에 설문 조사 결과를 발표할 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The new printers were installed on the third floor yesterday.",
      "ko": "새 프린터들이 어제 3층에 설치되었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Please lock the door after you leave the office.",
      "ko": "사무실을 나간 뒤에는 문을 잠가 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "You can use the conference room between ten o'clock and noon.",
      "ko": "10시부터 정오 사이에 회의실을 사용할 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Customers can track their orders on our website at any time.",
      "ko": "고객은 언제든지 우리 웹사이트에서 주문 상태를 조회할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "This year's spring sale was much larger than last year's.",
      "ko": "올해 봄 할인 행사는 작년 행사보다 훨씬 규모가 컸다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
