  "grammar": [
    {
      "id": "g1",
      "title": "미래 수동태 will be + p.p.",
      "tags": [
        "수동태",
        "시제"
      ],
      "sentenceId": "s2",
      "highlight": [
        "will be closed"
      ],
      "explanation": "주차장은 '닫히는' 대상이므로 수동태. 앞으로 있을 일이라 will be closed.",
      "example": {
        "en": "The store will be closed on Sunday.",
        "ko": "그 가게는 일요일에 문을 닫는다."
      },
      "note": "from A to B(A부터 B까지)는 기간을 나타내는 토익 단골 표현."
    },
    {
      "id": "g2",
      "title": "전치사 during + 명사",
      "tags": [
        "전치사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "During this time"
      ],
      "explanation": "during(~ 동안)은 전치사라 뒤에 명사(this time)가 온다. 뒤에 '주어 + 동사'가 오면 while을 쓴다.",
      "example": {
        "en": "Please turn off your phone during the meeting.",
        "ko": "회의 중에는 휴대폰을 꺼 주세요."
      },
      "note": "during + 명사 / while + 주어 + 동사."
    },
    {
      "id": "g3",
      "title": "주격 관계대명사 who",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "who drive to work"
      ],
      "explanation": "사람 명사(Employees) 뒤에서 who + 동사가 그 사람을 설명한다. who 뒤 동사 drive는 앞의 복수 명사에 맞춘다.",
      "example": {
        "en": "Students who live nearby can walk to school.",
        "ko": "근처에 사는 학생들은 걸어서 등교할 수 있다."
      },
      "note": "사람 + who + 동사, 사물 + which + 동사."
    }
  ],
