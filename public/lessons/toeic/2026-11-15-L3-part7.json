  "grammar": [
    {
      "id": "g1",
      "title": "목적격 관계대명사 생략",
      "tags": [
        "관계사",
        "생략"
      ],
      "sentenceId": "s9",
      "highlight": [
        "Any documents you wish to drop off"
      ],
      "explanation": "명사 뒤에 '주어 + 동사'가 바로 오면 목적격 관계대명사(that/which)가 생략된 것이다. documents (that) you wish to drop off.",
      "example": {
        "en": "The report you requested is attached.",
        "ko": "요청하신 보고서를 첨부합니다."
      },
      "note": "명사 + 주어 + 동사 ~ 뒤에 나오는 동사가 문장의 진짜 동사다."
    },
    {
      "id": "g2",
      "title": "명사를 뒤에서 꾸미는 과거분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s10",
      "highlight": [
        "an appointment scheduled during the closure"
      ],
      "explanation": "scheduled during the closure가 appointment를 꾸민다. 예약은 '잡히는' 대상이라 과거분사를 쓴다.",
      "example": {
        "en": "All orders placed before noon will ship today.",
        "ko": "정오 전에 들어온 주문은 모두 오늘 발송된다."
      },
      "note": "명사와 수동 관계면 p.p., 능동 관계면 -ing."
    },
    {
      "id": "g3",
      "title": "양보 접속사 although",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "although responses may take slightly longer than usual"
      ],
      "explanation": "although는 '비록 ~이지만'이라는 뜻의 접속사로 뒤에 절이 온다. 같은 뜻의 전치사 despite 뒤에는 명사가 온다.",
      "example": {
        "en": "The event was a success, although attendance was low.",
        "ko": "참석자는 적었지만 행사는 성공적이었다."
      },
      "note": "slightly longer than usual = 평소보다 약간 더 오래."
    }
  ],
