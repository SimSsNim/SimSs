 "grammar": [
  {
   "title": "So + 형용사 도치",
   "tags": [
    "도치"
   ],
   "sentenceId": "s5",
   "highlight": [
    "So popular was the evening cooking class"
   ],
   "explanation": "so ~ that 구문에서 \"So + 형용사\"가 문장 앞으로 오면 동사와 주어의 순서가 바뀐다. 주어 the evening cooking class가 단수이므로 동사는 was.",
   "example": {
    "en": "So successful was the campaign that it was extended for a month.",
    "ko": "캠페인이 워낙 성공적이어서 한 달 연장되었다."
   },
   "note": "도치 문장에서는 뒤에 나오는 진짜 주어에 동사 수를 맞춘다.",
   "id": "g1"
  },
  {
   "title": "복합관계부사 no matter how(= however)",
   "tags": [
    "관계사",
    "부사절"
   ],
   "sentenceId": "s6",
   "highlight": [
    "No matter how carefully"
   ],
   "explanation": "no matter how/however + 형용사·부사 + 주어 + 동사 = \"아무리 ~해도\". 형용사나 부사가 how 바로 뒤에 붙는 것이 특징이다.",
   "example": {
    "en": "However busy you are, please reply by Friday.",
    "ko": "아무리 바쁘더라도 금요일까지 회신해 주세요."
   },
   "note": "빈칸 뒤에 부사/형용사 + 주어 + 동사가 오면 no matter how / however.",
   "id": "g2"
  },
  {
   "title": "제안·요구 동사 + that + 동사원형",
   "tags": [
    "가정법",
    "일치"
   ],
   "sentenceId": "s7",
   "highlight": [
    "recommended that every new hire attend"
   ],
   "explanation": "recommend, suggest, request, insist 등 제안·요구를 나타내는 동사 뒤 that절에서는 (should) + 동사원형을 쓴다. 주어가 단수(every new hire)라도 attends가 아니라 attend.",
   "example": {
    "en": "The manager requested that the report be revised.",
    "ko": "관리자는 보고서를 수정할 것을 요청했다."
   },
   "note": "that절 주어가 3인칭 단수인데 동사원형이 정답 → 당위의 should 생략.",
   "id": "g3"
  }
 ],
