 "paragraphs": [
  {
   "id": "p1",
   "sentenceIds": [
    "s1"
   ],
   "ko": "컨설턴트의 권고안은 공장의 일상 업무에 지장을 최소화하기 위해 점진적으로 시행되었다."
  },
  {
   "id": "p2",
   "sentenceIds": [
    "s2"
   ],
   "ko": "제품 출시의 성공은 대체로 공급업체들의 신뢰성 덕분으로 여겨졌다."
  },
  {
   "id": "p3",
   "sentenceIds": [
    "s3"
   ],
   "ko": "규모가 크지 않은데도 그 빵집은 지난봄 온라인 주문을 도입한 이후 눈에 띄게 수익성이 좋아졌다."
  },
  {
   "id": "p4",
   "sentenceIds": [
    "s4"
   ],
   "ko": "직원들은 분기마다 배포되는 사내 설문을 통해 익명으로 제안을 제출하도록 권장된다."
  },
  {
   "id": "p5",
   "sentenceIds": [
    "s5"
   ],
   "ko": "저녁 요리 강좌가 워낙 인기가 많아서 등록이 시작된 지 한 시간 안에 마감되었다."
  },
  {
   "id": "p6",
   "sentenceIds": [
    "s6"
   ],
   "ko": "설명서를 아무리 꼼꼼하게 써도 일부 고객은 여전히 고객 지원 전화를 걸 것이다."
  },
  {
   "id": "p7",
   "sentenceIds": [
    "s7"
   ],
   "ko": "인사 이사는 모든 신입 사원이 안전 오리엔테이션에 직접 참석할 것을 권고했다."
  },
  {
   "id": "p8",
   "sentenceIds": [
    "s8"
   ],
   "ko": "기조연설자의 항공편이 지연될 경우에는 오후로 예정된 패널 토론이 먼저 시작된다."
  },
  {
   "id": "p9",
   "sentenceIds": [
    "s9"
   ],
   "ko": "벨몬트 제약에 입사하기 전에 루이즈 씨는 10년 동안 병원 행정 분야에서 일했다."
  },
  {
   "id": "p10",
   "sentenceIds": [
    "s10"
   ],
   "ko": "저희 호텔의 모든 투숙객은 체크인할 때 무료 생수 한 병을 받는다."
  }
 ],
 "sentences": [
  {
   "id": "s1",
   "paragraphId": "p1",
   "en": "The consultant's recommendations were implemented gradually to minimize disruption to daily operations at the plant.",
   "ko": "컨설턴트의 권고안은 공장의 일상 업무에 지장을 최소화하기 위해 점진적으로 시행되었다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s2",
   "paragraphId": "p2",
   "en": "The success of the product launch was largely attributed to the dependability of our suppliers.",
   "ko": "제품 출시의 성공은 대체로 공급업체들의 신뢰성 덕분으로 여겨졌다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s3",
   "paragraphId": "p3",
   "en": "Despite its modest size, the bakery has become remarkably profitable since it introduced online ordering last spring.",
   "ko": "규모가 크지 않은데도 그 빵집은 지난봄 온라인 주문을 도입한 이후 눈에 띄게 수익성이 좋아졌다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s4",
   "paragraphId": "p4",
   "en": "Employees are encouraged to submit their suggestions anonymously through the internal survey distributed each quarter.",
   "ko": "직원들은 분기마다 배포되는 사내 설문을 통해 익명으로 제안을 제출하도록 권장된다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s5",
   "paragraphId": "p5",
   "en": "So popular was the evening cooking class that registration closed within an hour of opening.",
   "ko": "저녁 요리 강좌가 워낙 인기가 많아서 등록이 시작된 지 한 시간 안에 마감되었다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s6",
   "paragraphId": "p6",
   "en": "No matter how carefully the instructions are written, some customers will still call the help line.",
   "ko": "설명서를 아무리 꼼꼼하게 써도 일부 고객은 여전히 고객 지원 전화를 걸 것이다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s7",
   "paragraphId": "p7",
   "en": "The personnel director recommended that every new hire attend the safety orientation in person.",
   "ko": "인사 이사는 모든 신입 사원이 안전 오리엔테이션에 직접 참석할 것을 권고했다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s8",
   "paragraphId": "p8",
   "en": "In the event that the keynote speaker's flight is delayed, the panel discussion scheduled for the afternoon will begin first.",
   "ko": "기조연설자의 항공편이 지연될 경우에는 오후로 예정된 패널 토론이 먼저 시작된다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s9",
   "paragraphId": "p9",
   "en": "Prior to joining Velmont Pharmaceuticals, Mr. Ruiz spent ten years in hospital administration.",
   "ko": "벨몬트 제약에 입사하기 전에 루이즈 씨는 10년 동안 병원 행정 분야에서 일했다.",
   "audioStartSec": null,
   "audioEndSec": null
  },
  {
   "id": "s10",
   "paragraphId": "p10",
   "en": "Every guest at our hotel receives a complimentary bottle of mineral water upon checking in.",
   "ko": "저희 호텔의 모든 투숙객은 체크인할 때 무료 생수 한 병을 받는다.",
   "audioStartSec": null,
   "audioEndSec": null
  }
 ],
