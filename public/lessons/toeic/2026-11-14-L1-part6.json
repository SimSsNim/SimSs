  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "오카포 씨께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5",
        "s6",
        "s7"
      ],
      "ko": "팀 저녁 식사 장소로 벨몬트 그릴을 선택해 주셔서 감사합니다. 3월 6일 금요일 저녁 7시, 12명 예약을 확인해 드리게 되어 기쁩니다. 일행분들은 2층에 있는 단독 식사 공간(프라이빗 룸)으로 안내됩니다. 이 방은 조용해서 업무 식사에 아주 좋습니다. 또한 10명 이상 단체를 위한 특별 세트 메뉴도 있습니다. 그 메뉴를 주문하고 싶으시면 수요일까지 알려 주세요."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s8",
        "s9"
      ],
      "ko": "계획이 바뀌면 555-0148로 전화 주세요. 고객님과 팀원분들을 모시게 되기를 기대합니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s10"
      ],
      "ko": "감사합니다,"
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s11"
      ],
      "ko": "리나 모로"
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s12"
      ],
      "ko": "예약 담당 매니저"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Ms. Okafor,",
      "ko": "오카포 씨께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for choosing Bellmont Grill for your team dinner.",
      "ko": "팀 저녁 식사 장소로 벨몬트 그릴을 선택해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "We are happy to confirm your reservation for twelve people on Friday, March 6, at seven in the evening.",
      "ko": "3월 6일 금요일 저녁 7시, 12명 예약을 확인해 드리게 되어 기쁩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "Your group will be seated in our private dining room on the second floor.",
      "ko": "일행분들은 2층에 있는 단독 식사 공간(프라이빗 룸)으로 안내됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "This room is quiet, so it is perfect for business meals.",
      "ko": "이 방은 조용해서 업무 식사에 아주 좋습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p2",
      "en": "We also offer a special set menu for groups of ten or more.",
      "ko": "또한 10명 이상 단체를 위한 특별 세트 메뉴도 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p2",
      "en": "Please let us know by Wednesday if you would like to order it.",
      "ko": "그 메뉴를 주문하고 싶으시면 수요일까지 알려 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "If your plans change, please call us at 555-0148.",
      "ko": "계획이 바뀌면 555-0148로 전화 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p3",
      "en": "We look forward to serving you and your team.",
      "ko": "고객님과 팀원분들을 모시게 되기를 기대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "Best regards,",
      "ko": "감사합니다,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p5",
      "en": "Lina Moreau",
      "ko": "리나 모로",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p6",
      "en": "Reservations Manager",
      "ko": "예약 담당 매니저",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
