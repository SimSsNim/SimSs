  "structures": [
    {
      "id": "st1",
      "sentenceId": "s6",
      "chunks": [
        {
          "text": "Located just two blocks from the central station,",
          "role": "M",
          "ko": "중앙역에서 두 블록 떨어진 곳에 있어서"
        },
        {
          "text": "the Brightwater Hotel",
          "role": "S",
          "ko": "브라이트워터 호텔은"
        },
        {
          "text": "is",
          "role": "V",
          "ko": "~이다"
        },
        {
          "text": "popular",
          "role": "C",
          "ko": "인기 있는"
        },
        {
          "text": "with business travelers.",
          "role": "M",
          "ko": "출장객들에게"
        }
      ],
      "skeleton": "(Being) p.p. ~, S + V + C",
      "explanation": "앞의 Located ~ station은 수동 분사구문으로 주절 주어(호텔)를 설명한다. 주절은 2형식 S + be + 형용사."
    },
    {
      "id": "st2",
      "sentenceId": "s8",
      "chunks": [
        {
          "text": "While",
          "role": "CONJ",
          "ko": "~하는 동안"
        },
        {
          "text": "the conference room",
          "role": "S",
          "ko": "회의실이",
          "sub": true
        },
        {
          "text": "is being painted,",
          "role": "V",
          "ko": "칠해지고 있다",
          "sub": true
        },
        {
          "text": "the weekly staff meeting",
          "role": "S",
          "ko": "주간 직원 회의는"
        },
        {
          "text": "will be held",
          "role": "V",
          "ko": "열릴 것이다"
        },
        {
          "text": "in the cafeteria.",
          "role": "M",
          "ko": "구내식당에서"
        }
      ],
      "skeleton": "While + S + V(진행 수동), S + V(미래 수동)",
      "explanation": "While이 이끄는 시간 부사절 안에 진행형 수동태(is being p.p.)가, 주절에는 미래 수동태(will be p.p.)가 쓰였다."
    }
  ],
  "grammar": [
    {
      "id": "g1",
      "title": "감정 분사: -ing(주는 쪽) vs -ed(느끼는 쪽)",
      "tags": [
        "분사",
        "품사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "were disappointing"
      ],
      "explanation": "감정 동사(disappoint, interest, satisfy 등)는 감정을 일으키는 사물·일이 주어면 -ing, 감정을 느끼는 사람이 주어면 -ed를 쓴다.",
      "example": {
        "en": "The staff were disappointed by the results.",
        "ko": "직원들은 그 결과에 실망했다."
      },
      "note": "주어가 사물(results, news, report)이면 -ing, 사람이면 -ed부터 의심하자."
    },
    {
      "id": "g2",
      "title": "수동 분사구문 (Located ~)",
      "tags": [
        "분사구문",
        "분사"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Located just two blocks from the central station"
      ],
      "explanation": "As the hotel is located ~를 줄이면 접속사·주어·Being이 빠지고 Located만 남는다. 주절 주어가 '~되는' 쪽이면 과거분사로 시작한다.",
      "example": {
        "en": "Built in 1920, the library is the oldest building in town.",
        "ko": "1920년에 지어진 그 도서관은 마을에서 가장 오래된 건물이다."
      },
      "note": "콤마 앞 빈칸 + 주절 주어가 사물 → 과거분사(p.p.)가 정답인 경우가 많다."
    },
    {
      "id": "g3",
      "title": "가정법 과거",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s7",
      "highlight": [
        "If our company had",
        "would order"
      ],
      "explanation": "현재 사실과 반대되는 상황은 If + 주어 + 과거형, 주어 + would/could + 동사원형으로 쓴다. 실제로는 공간이 없다는 뜻이다.",
      "example": {
        "en": "If I had a car, I would drive to work.",
        "ko": "내게 차가 있다면 차로 출근할 텐데."
      },
      "note": "주절에 would + 동사원형이 보이면 if절은 과거형(be동사는 were)."
    }
  ],
