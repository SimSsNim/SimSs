  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "이 씨는 전화로 고객 질문에 항상 정중하게 답한다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "마케팅팀은 지난 월요일에 새 포스터 디자인을 만들었다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "영업직 지원서는 인사부 사무실로 보내 주세요."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "프린터가 고장 나서 첸 씨는 파일을 복사 가게로 보냈다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "우리가 3일 동안 머무는 동안 호텔 직원들은 매우 친절했다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "모든 소포는 매일 정오 전에 안내 데스크로 배달된다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "회의 전에 첨부된 문서에 오류가 있는지 확인해 주세요."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "루카 그릴은 주말에 시내에서 가장 붐비는 식당이다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "연례 회사 야유회는 매년 6월에 열린다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "박 씨는 회의에서 새 소프트웨어에 대해 짧은 발표를 했다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Ms. Lee always answers customer questions politely on the phone.",
      "ko": "이 씨는 전화로 고객 질문에 항상 정중하게 답한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The marketing team created a new poster design last Monday.",
      "ko": "마케팅팀은 지난 월요일에 새 포스터 디자인을 만들었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Please send your application for the sales position to the human resources office.",
      "ko": "영업직 지원서는 인사부 사무실로 보내 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "The printer was broken, so Mr. Chen sent the files to the copy shop.",
      "ko": "프린터가 고장 나서 첸 씨는 파일을 복사 가게로 보냈다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The hotel staff were very friendly during our three-day stay.",
      "ko": "우리가 3일 동안 머무는 동안 호텔 직원들은 매우 친절했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "All packages are delivered to the front desk before noon every day.",
      "ko": "모든 소포는 매일 정오 전에 안내 데스크로 배달된다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Please check the attached document for errors before the meeting.",
      "ko": "회의 전에 첨부된 문서에 오류가 있는지 확인해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Lucca Grill is the busiest restaurant in the downtown area on weekends.",
      "ko": "루카 그릴은 주말에 시내에서 가장 붐비는 식당이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The annual company picnic is held in June every year.",
      "ko": "연례 회사 야유회는 매년 6월에 열린다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Mr. Park gave a short presentation about the new software at the meeting.",
      "ko": "박 씨는 회의에서 새 소프트웨어에 대해 짧은 발표를 했다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
