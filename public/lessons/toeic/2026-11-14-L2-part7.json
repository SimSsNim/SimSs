  "grammar": [
    {
      "id": "g1",
      "title": "so + 형용사 + that",
      "tags": [
        "접속사",
        "부사절"
      ],
      "sentenceId": "s6",
      "highlight": [
        "so quiet that"
      ],
      "explanation": "'너무 ~해서 …하다'라는 결과를 말할 때 so 뒤에 형용사·부사, 그 뒤에 that절을 쓴다.",
      "example": {
        "en": "The room was so dark that I could not read.",
        "ko": "방이 너무 어두워서 책을 읽을 수 없었다."
      },
      "note": "빈칸 뒤에 that절이 있으면 so, 명사가 있으면 such를 고른다."
    },
    {
      "id": "g2",
      "title": "동명사 주어",
      "tags": [
        "동명사",
        "일치"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Putting it together took"
      ],
      "explanation": "동사 put을 주어로 쓰려면 동명사 Putting으로 바꾼다. 동명사 주어는 단수 취급.",
      "example": {
        "en": "Exercising every day is good for your health.",
        "ko": "매일 운동하는 것은 건강에 좋다."
      },
      "note": "문장 맨 앞 빈칸 + 바로 뒤 목적어 + 동사 → 동명사 주어."
    },
    {
      "id": "g3",
      "title": "과거완료 수동태 had been p.p.",
      "tags": [
        "시제",
        "수동태"
      ],
      "sentenceId": "s10",
      "highlight": [
        "had been delayed"
      ],
      "explanation": "상담원이 설명한(과거) 시점보다 배송 지연이 먼저 일어났으므로 과거완료. 물량은 '지연되는' 대상이라 수동태.",
      "example": {
        "en": "The meeting had been canceled before I arrived.",
        "ko": "내가 도착하기 전에 회의가 취소되었었다."
      },
      "note": "과거보다 더 이전의 일 → had + p.p."
    }
  ],
