  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the main purpose of the e-mail?",
      "choices": [
        {
          "key": "A",
          "text": "To announce a reduction in travel budgets"
        },
        {
          "key": "B",
          "text": "To introduce a new procedure for getting repaid for work costs"
        },
        {
          "key": "C",
          "text": "To remind staff about an upcoming financial audit"
        },
        {
          "key": "D",
          "text": "To ask managers to approve pending claims"
        }
      ],
      "answer": "B",
      "evidenceSentenceIds": [
        "s5",
        "s6"
      ],
      "explanationKo": "첫 단락에서 종이 경비 보고서를 온라인 시스템으로 바꾼다고 알리고, 이후 사용법·교육 일정을 안내한다. '경비 환급 보고 방식'을 '업무 비용을 돌려받는 새 절차'로 바꿔 말한 B가 정답.",
      "choiceNotesKo": {
        "A": "식비 한도 등은 그대로라고 했으며 예산 삭감 이야기는 없다.",
        "C": "감사인(auditors)은 영수증 보관 이유로만 잠깐 언급된다."
      },
      "skill": "목적 찾기"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-not-true",
      "prompt": "What is NOT mentioned as a requirement of the new system?",
      "choices": [
