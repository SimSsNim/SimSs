  "grammar": [
    {
      "id": "g1",
      "title": "allow + 목적어 + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "allows employees to submit"
      ],
      "explanation": "allow, enable, encourage, require 등은 '목적어 + to부정사'를 이끈다. allow employees submitting은 틀린 형태.",
      "example": {
        "en": "The app allows users to track their orders.",
        "ko": "그 앱은 사용자가 주문을 추적할 수 있게 해 준다."
      },
      "note": "allow/enable/permit + O + to V가 Part 5·6 단골."
    },
    {
      "id": "g2",
      "title": "expect + 목적어 + to be p.p.",
      "tags": [
        "to부정사",
        "수동태"
      ],
      "sentenceId": "s7",
      "highlight": [
        "expect most claims to be paid"
      ],
      "explanation": "expect + 목적어 + to부정사에서 목적어(claims)가 '지급되는' 대상이므로 to be paid로 수동형을 쓴다.",
      "example": {
        "en": "We expect the order to be shipped tomorrow.",
        "ko": "주문품이 내일 발송될 것으로 예상합니다."
      },
      "note": "목적어가 동작을 받는 쪽이면 to be p.p."
    },
    {
      "id": "g3",
      "title": "명사 뒤에서 꾸미는 현재분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s15",
      "highlight": [
        "sessions lasting roughly thirty minutes"
      ],
      "explanation": "교육이 30분간 '지속되는' 것이므로 능동의 현재분사 lasting. 자동사 last는 과거분사로 명사를 꾸미지 않는다.",
      "example": {
        "en": "Passengers waiting at Gate 5 may now board.",
        "ko": "5번 게이트에서 기다리는 승객은 지금 탑승할 수 있습니다."
      },
