  "grammar": [
    {
      "id": "g1",
      "title": "가정법 과거완료",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s4",
      "highlight": [
        "had arrived",
        "would have opened"
      ],
      "explanation": "과거 사실과 반대로 가정할 때 If절은 had + p.p., 주절은 would/could/might have + p.p.를 쓴다.",
      "example": {
        "en": "If we had booked earlier, we could have gotten a discount.",
        "ko": "더 일찍 예약했더라면 할인을 받을 수 있었을 것이다."
      },
      "note": "주절에 would have p.p.가 보이면 If절 빈칸은 had p.p."
    },
    {
      "id": "g2",
      "title": "완료형 분사구문 (Having p.p.)",
      "tags": [
        "분사구문"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Having completed"
      ],
      "explanation": "주절보다 먼저 일어난 일을 분사구문으로 나타낼 때 Having + p.p.를 쓴다. 주어(new employees)가 직접 '마친' 능동 관계다.",
      "example": {
        "en": "Having reviewed the contract, the lawyer signed it.",
        "ko": "계약서를 검토한 뒤 변호사는 서명했다."
      },
      "note": "뒤에 목적어가 있으면 능동(Having p.p./-ing), 없으면 수동(p.p.)을 먼저 의심한다."
    },
    {
      "id": "g3",
      "title": "목적의 접속사 so that",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "so that payment can be processed"
      ],
      "explanation": "so that + 주어 + can/will + 동사는 '~하도록, ~할 수 있게'라는 목적을 나타낸다. in order to는 뒤에 동사원형이 와야 한다.",
      "example": {
        "en": "Speak clearly so that everyone can hear you.",
        "ko": "모두가 들을 수 있도록 또렷하게 말하세요."
      },
      "note": "빈칸 뒤가 '주어 + 동사' 절이면 so that, 동사원형이면 in order to."
    }
  ],
