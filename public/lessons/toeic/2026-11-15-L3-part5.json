  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "새로 단장한 회의장은 최대 300명의 손님을 여유 있게 수용할 수 있다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "영업직 지원자는 재고 관리 소프트웨어에 매우 익숙하다는 것을 보여 주어야 한다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "오카포 씨는 화요일에 이사회에서 매우 설득력 있는 발표를 했다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "배송품이 제때 도착했더라면 매장은 예정대로 문을 열었을 것이다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "분기 매출 수치는 이번 주에 회계팀이 검토하고 있다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "안전 교육을 마친 신입 직원은 신분증 배지를 받게 된다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "월말 전에 지급이 처리될 수 있도록 금요일까지 경비 보고서를 제출해 주십시오."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "연말 휴가철 내내 매장은 저녁 10시까지 문을 연다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "마케팅 이사는 팀에게 캠페인에 쓸 더 매력적인 슬로건을 생각해 내라고 요청했다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "하다드 씨는 새 난방 시스템 설치를 감독해 달라는 요청을 받았다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The renovated conference hall can comfortably accommodate up to three hundred guests.",
      "ko": "새로 단장한 회의장은 최대 300명의 손님을 여유 있게 수용할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Applicants for the sales position must demonstrate a strong familiarity with inventory software.",
      "ko": "영업직 지원자는 재고 관리 소프트웨어에 매우 익숙하다는 것을 보여 주어야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Ms. Okafor gave a highly persuasive presentation to the board of directors on Tuesday.",
      "ko": "오카포 씨는 화요일에 이사회에서 매우 설득력 있는 발표를 했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "If the shipment had arrived on time, the store would have opened as scheduled.",
      "ko": "배송품이 제때 도착했더라면 매장은 예정대로 문을 열었을 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The quarterly sales figures are being reviewed by the accounting team this week.",
      "ko": "분기 매출 수치는 이번 주에 회계팀이 검토하고 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Having completed the safety training, new employees will receive an identification badge.",
      "ko": "안전 교육을 마친 신입 직원은 신분증 배지를 받게 된다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Please submit your expense report by Friday so that payment can be processed before the end of the month.",
      "ko": "월말 전에 지급이 처리될 수 있도록 금요일까지 경비 보고서를 제출해 주십시오.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Throughout the holiday season, the store will stay open until ten in the evening.",
      "ko": "연말 휴가철 내내 매장은 저녁 10시까지 문을 연다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "The marketing director asked the team to come up with a more appealing slogan for the campaign.",
      "ko": "마케팅 이사는 팀에게 캠페인에 쓸 더 매력적인 슬로건을 생각해 내라고 요청했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Mr. Haddad has been asked to oversee the installation of the new heating system.",
      "ko": "하다드 씨는 새 난방 시스템 설치를 감독해 달라는 요청을 받았다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
