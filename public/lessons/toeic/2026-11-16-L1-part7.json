  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "Why did Mr. Ortiz send the e-mail?",
      "evidenceSentenceIds": [
        "s6"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To announce a sale on office supplies"
        },
        {
          "key": "B",
          "text": "To explain that part of an order is delayed"
        },
        {
          "key": "C",
          "text": "To ask Ms. Kim to pay for an order"
        },
        {
          "key": "D",
          "text": "To confirm a change of address"
        }
      ],
      "answer": "B",
      "explanationKo": "두 번째 문장에서 주문 상품 하나가 늦게 도착한다(one item ... will arrive late)고 알린다. → part of an order is delayed로 바꿔 말했다.",
      "choiceNotesKo": {
        "A": "할인 쿠폰은 사과의 뜻일 뿐, 세일을 알리는 메일이 아니다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What has already been sent to Ms. Kim?",
      "evidenceSentenceIds": [
        "s9"
      ],
      "choices": [
        {
          "key": "A",
          "text": "A desk lamp"
        },
        {
          "key": "B",
          "text": "A gift card"
        },
        {
          "key": "C",
          "text": "Paper and writing supplies"
        },
        {
          "key": "D",
          "text": "A new printer"
        }
      ],
      "answer": "C",
      "explanationKo": "the printer paper and the pens, were shipped this morning → 종이와 필기구(writing supplies)가 이미 발송되었다.",
      "choiceNotesKo": {
        "A": "스탠드는 재고가 없어 아직 보내지 않았다.",
        "D": "printer는 '프린터 용지'의 일부일 뿐 프린터를 보낸 것이 아니다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-not-true",
      "prompt": "What is NOT true according to the e-mail?",
      "evidenceSentenceIds": [
        "s7",
        "s11",
        "s12",
        "s13"
      ],
      "choices": [
        {
          "key": "A",
          "text": "Ms. Kim must call the store to cancel the lamp."
        },
        {
          "key": "B",
          "text": "The lamp is not available right now."
        },
        {
          "key": "C",
          "text": "Ms. Kim can get her money back for the lamp."
        },
        {
          "key": "D",
          "text": "Ms. Kim will receive a discount on a future order."
        }
      ],
      "answer": "A",
      "explanationKo": "취소하려면 이 이메일에 답장하면 된다(reply to this e-mail)고 했지, 전화하라는 말은 없다. B는 out of stock, C는 full refund, D는 ten percent off your next purchase와 일치한다.",
      "choiceNotesKo": {
        "D": "coupon for ten percent off your next purchase = 다음 주문 할인."
      },
      "skill": "사실이 아닌 것(NOT)"
    }
  ]
}
