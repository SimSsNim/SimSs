  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Okafor 씨께,"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4"
      ],
      "ko": "Brightline 물류의 사무실 관리자 직책에 지원해 주셔서 감사합니다. 귀하의 경력이 인상적이어서 면접에 모시고자 합니다. 면접은 4월 8일 화요일 오전 10시에 진행됩니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s5",
        "s6",
        "s7",
        "s8"
      ],
      "ko": "면접에서는 운영 이사 Daniel Reyes 씨를 만나시게 되며, 그분이 관리 경험에 대해 질문할 것입니다. 또한 짧은 컴퓨터 활용 능력 시험을 보시게 됩니다. 이력서 사본 한 부와 추천인 두 명의 명단을 가져와 주세요. 2층 접수 직원에게 방문 등록을 하실 수 있도록 10분 일찍 도착하시기를 권합니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s9",
        "s10"
      ],
      "ko": "이 시간이 편하지 않으시면 4월 3일까지 이 이메일에 답장해 주세요. 만나 뵙기를 기대합니다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s11"
      ],
      "ko": "드림,"
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s12"
      ],
      "ko": "Grace Lin"
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s13"
      ],
      "ko": "인사부장"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Dear Ms. Okafor,",
      "ko": "Okafor 씨께,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Thank you for applying for the position of office manager at Brightline Logistics.",
      "ko": "Brightline 물류의 사무실 관리자 직책에 지원해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "We were impressed by your experience, and we would like to invite you to an interview.",
      "ko": "귀하의 경력이 인상적이어서 면접에 모시고자 합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "The interview will take place on Tuesday, April 8, at ten o'clock in the morning.",
      "ko": "면접은 4월 8일 화요일 오전 10시에 진행됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p3",
      "en": "During the interview, you will meet with our operations director, Mr. Daniel Reyes, who will ask you about your management experience.",
      "ko": "면접에서는 운영 이사 Daniel Reyes 씨를 만나시게 되며, 그분이 관리 경험에 대해 질문할 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "You will also be asked to complete a short computer skills test.",
      "ko": "또한 짧은 컴퓨터 활용 능력 시험을 보시게 됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "Please bring a copy of your resume and a list of two references.",
      "ko": "이력서 사본 한 부와 추천인 두 명의 명단을 가져와 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "We recommend that you arrive ten minutes early to check in with the receptionist on the second floor.",
      "ko": "2층 접수 직원에게 방문 등록을 하실 수 있도록 10분 일찍 도착하시기를 권합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "If this time is not convenient for you, please reply to this e-mail by April 3.",
      "ko": "이 시간이 편하지 않으시면 4월 3일까지 이 이메일에 답장해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "We look forward to meeting you.",
      "ko": "만나 뵙기를 기대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s11",
      "paragraphId": "p5",
      "en": "Sincerely,",
      "ko": "드림,",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s12",
      "paragraphId": "p6",
      "en": "Grace Lin",
      "ko": "Grace Lin",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s13",
      "paragraphId": "p7",
      "en": "Human Resources Manager",
      "ko": "인사부장",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
