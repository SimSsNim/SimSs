  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "전 직원께:"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5",
        "s6",
        "s7"
      ],
      "ko": "다음 주 화요일에 우리 건물 엘리베이터 점검이 있습니다. 점검은 오전 8시에 시작해 정오까지 끝날 예정입니다. 작업이 일찍 끝나면 이메일로 알려 드리겠습니다. 이 시간 동안에는 건물 동쪽 계단을 이용해 주세요. 일부 직원분들께는 불편할 수 있다는 점 이해합니다. 무거운 물건을 옮기는 데 도움이 필요한 직원은 안내 데스크에 연락하시면 됩니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s8"
      ],
      "ko": "양해와 협조에 감사드립니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s9"
      ],
      "ko": "시설 관리팀"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "To all employees:",
      "ko": "전 직원께:",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The elevators in our building will be inspected next Tuesday.",
      "ko": "다음 주 화요일에 우리 건물 엘리베이터 점검이 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "The inspection will begin at 8:00 in the morning and should be finished by noon.",
      "ko": "점검은 오전 8시에 시작해 정오까지 끝날 예정입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "If the work finishes early, we will send an e-mail to let you know.",
      "ko": "작업이 일찍 끝나면 이메일로 알려 드리겠습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "During this time, please use the stairs on the east side of the building.",
      "ko": "이 시간 동안에는 건물 동쪽 계단을 이용해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p2",
      "en": "We understand that this may be inconvenient for some of you.",
      "ko": "일부 직원분들께는 불편할 수 있다는 점 이해합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p2",
      "en": "Employees who need help carrying heavy items can contact the front desk.",
      "ko": "무거운 물건을 옮기는 데 도움이 필요한 직원은 안내 데스크에 연락하시면 됩니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "Thank you for your patience and cooperation.",
      "ko": "양해와 협조에 감사드립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "Facilities Management Team",
      "ko": "시설 관리팀",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
