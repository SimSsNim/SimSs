  "grammar": [
    {
      "id": "g1",
      "title": "during + 명사 / while + 주어 + 동사",
      "tags": [
        "전치사",
        "접속사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "During this time"
      ],
      "explanation": "뜻은 둘 다 '~하는 동안'이지만 during은 전치사라 명사가, while은 접속사라 문장이 뒤에 온다.",
      "example": {
        "en": "I slept during the movie.",
        "ko": "나는 영화 보는 동안 잤다."
      },
      "note": "빈칸 뒤가 명사구인지 '주어+동사'인지부터 본다."
    },
    {
      "id": "g2",
      "title": "긴 주어 속 진짜 동사 찾기 (관계대명사절)",
      "tags": [
        "관계사",
        "일치"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Employees who need help",
        "can contact"
      ],
      "explanation": "주어 뒤에 who절이 붙어 길어져도 문장 동사는 하나(can contact). 동사 자리 문제에서 자주 나온다.",
      "example": {
        "en": "The man who lives next door is a doctor.",
        "ko": "옆집에 사는 남자는 의사다."
      },
      "note": null
    },
    {
      "id": "g3",
      "title": "미래 수동태 will be + p.p.",
      "tags": [
        "수동태",
