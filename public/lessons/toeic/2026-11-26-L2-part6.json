  "grammar": [
    {
      "id": "g1",
      "title": "계속적 용법의 관계대명사 which",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s3",
      "highlight": [
        "which has the same number"
      ],
      "explanation": "콤마(,) 뒤에서 앞의 명사에 정보를 덧붙일 때는 which(사물)나 who(사람)를 쓴다. that은 콤마 뒤에 쓸 수 없다.",
      "example": {
        "en": "The report, which was due today, is not finished.",
        "ko": "오늘 마감이던 그 보고서는 끝나지 않았다."
      },
      "note": "콤마 + 빈칸 + 동사 → that은 오답, which/who가 정답."
    },
    {
      "id": "g2",
      "title": "prevent A from -ing",
      "tags": [
        "전치사",
        "동명사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "prevent anyone else from using"
      ],
      "explanation": "prevent A from -ing = A가 ~하는 것을 막다. from은 전치사라 뒤에 동명사 using이 온다.",
      "example": {
        "en": "Heavy rain prevented us from leaving.",
        "ko": "폭우 때문에 우리는 떠나지 못했다."
      },
      "note": "stop/keep A from -ing도 같은 뜻으로 토익에 자주 나온다."
    },
    {
      "id": "g3",
      "title": "수단의 by + 동명사",
      "tags": [
        "전치사",
        "동명사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "by calling"
      ],
      "explanation": "by + -ing = ~함으로써(방법). 전치사 by 뒤라 동사는 동명사 calling, visiting으로 쓴다.",
      "example": {
        "en": "You can save money by shopping online.",
        "ko": "온라인 쇼핑으로 돈을 아낄 수 있다."
      },
      "note": "or로 연결된 두 by -ing는 형태를 똑같이 맞춘다(병렬)."
    }
  ],
