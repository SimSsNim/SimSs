  "grammar": [
    {
      "id": "g1",
      "title": "부정어구 도치 (Under no circumstances + 조동사 + 주어)",
      "tags": [
        "도치"
      ],
      "sentenceId": "s8",
      "highlight": [
        "Under no circumstances should employees book"
      ],
      "explanation": "never, rarely, under no circumstances, at no time 같은 부정 표현이 문장 맨 앞에 오면 의문문처럼 조동사(be/have/do)가 주어 앞으로 나온다.",
      "example": {
        "en": "At no time did the manager mention a deadline.",
        "ko": "관리자는 한 번도 마감일을 언급하지 않았다."
      },
      "note": "부정어구로 시작하는 문장의 빈칸은 조동사·be동사 자리 — 뒤에 오는 동사 형태(원형/p.p.)로 고른다."
    },
    {
      "id": "g2",
      "title": "make + 목적어 + 형용사 + to부정사",
      "tags": [
        "to부정사",
        "어순"
      ],
      "sentenceId": "s10",
      "highlight": [
        "make some projects more difficult to carry out"
      ],
      "explanation": "make는 '목적어를 ~하게 만들다'라는 5형식 동사로, 형용사 목적격 보어(more difficult)가 온다. 그 뒤 to carry out은 '수행하기에'라는 뜻으로 형용사를 꾸민다.",
      "example": {
        "en": "The new software makes reports easier to read.",
        "ko": "새 소프트웨어 덕분에 보고서가 읽기 쉬워졌다."
      },
      "note": "make + O + 빈칸 → 부사가 아닌 형용사가 정답."
    },
    {
      "id": "g3",
      "title": "명사절 접속사 whether",
      "tags": [
        "명사절",
        "접속사"
      ],
      "sentenceId": "s12",
      "highlight": [
        "whether a particular expense qualifies"
      ],
      "explanation": "whether는 '~인지 아닌지'라는 명사절을 이끈다. unsure, ask, wonder, decide 뒤에 자주 온다.",
      "example": {
        "en": "We have not decided whether the event will be held outdoors.",
        "ko": "우리는 행사를 야외에서 열지 아직 정하지 않았다."
      },
      "note": "whether 뒤에는 완전한 절이 오며, or not을 붙일 수 있다."
    }
  ],
