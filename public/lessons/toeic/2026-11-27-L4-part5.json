  "grammar": [
    {
      "id": "g1",
      "title": "부정어 도치 (Seldom + 조동사 + 주어)",
      "tags": [
        "도치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Seldom have we received"
      ],
      "explanation": "Seldom, Rarely, Never, Hardly 같은 부정 부사가 문장 맨 앞에 오면 주어와 조동사의 순서가 바뀐다. We have seldom received → Seldom have we received.",
      "example": {
        "en": "Rarely does the manager leave before six.",
        "ko": "그 관리자는 6시 전에 퇴근하는 일이 거의 없다."
      },
      "note": "문두 부정어 뒤 빈칸 → '조동사 + 주어' 어순 보기를 고른다."
    },
    {
      "id": "g2",
      "title": "복합관계부사 wherever",
      "tags": [
        "관계사",
        "부사절"
      ],
      "sentenceId": "s5",
      "highlight": [
        "Wherever"
      ],
      "explanation": "wherever = at any place where(~하는 곳은 어디든지). 뒤에 완전한 절이 온다. whatever, whoever는 뒤에 주어나 목적어가 빠진 절이 와야 한다.",
      "example": {
        "en": "Wherever you travel, you can use this card.",
        "ko": "어디를 여행하든 이 카드를 쓸 수 있다."
      },
      "note": "뒤 절이 완전하면 복합관계부사(wherever/whenever/however), 불완전하면 복합관계대명사."
    },
    {
      "id": "g3",
      "title": "요구·제안 동사 + that + S + (should) 동사원형",
      "tags": [
        "가정법",
        "수동태"
      ],
      "sentenceId": "s6",
      "highlight": [
        "requested that",
        "be submitted"
      ],
      "explanation": "request, require, suggest, recommend, insist 뒤 that절에서는 should가 생략되어 동사원형이 온다. 설계도는 '제출되는' 대상이라 be submitted.",
      "example": {
        "en": "The manager suggested that the meeting be postponed.",
        "ko": "관리자는 회의를 연기하자고 제안했다."
      },
      "note": "request that 뒤 빈칸 → 주어와 수에 상관없이 동사원형(be p.p.)."
    }
  ],
