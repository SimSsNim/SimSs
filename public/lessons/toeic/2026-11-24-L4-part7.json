          "key": "B",
          "text": "She opened distribution centers in three states."
        },
        {
          "key": "C",
          "text": "She reduced the number of warehouse employees."
        },
        {
          "key": "D",
          "text": "She designed tracking software for several firms."
        }
      ],
      "answer": "A",
      "evidenceSentenceIds": [
