  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "Park 씨는 직원 회의에서 새 휴가 규정을 명확하게 설명했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "마케팅팀은 현재 봄 할인 행사를 위한 새 광고를 준비하고 있다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "회사는 부산의 새 사무실에 관해 중요한 발표를 했다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "그 가게는 작지만 여러 종류의 신선한 빵을 판다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "3층의 새 프린터는 예전 것보다 더 믿을 만하다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "그 회의실은 매주 월요일 아침 이사회 회의를 위해 예약되어 있다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "기념품 가게는 아침 9시부터 저녁 6시까지 문을 연다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "우리 사무실 근처의 그 식당은 신선한 해산물 요리로 유명하다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "Garcia 씨는 다음 주에 텍사스의 새 공장을 방문하고 싶어 한다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "그 교육 시간은 신입 직원들에게 회사에 관한 유용한 정보를 주었다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Mr. Park explained the new vacation policy clearly at the staff meeting.",
      "ko": "Park 씨는 직원 회의에서 새 휴가 규정을 명확하게 설명했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The marketing team is currently preparing a new advertisement for the spring sale.",
      "ko": "마케팅팀은 현재 봄 할인 행사를 위한 새 광고를 준비하고 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The company made an important announcement about its new office in Busan.",
      "ko": "회사는 부산의 새 사무실에 관해 중요한 발표를 했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Although the store is small, it sells many kinds of fresh bread.",
      "ko": "그 가게는 작지만 여러 종류의 신선한 빵을 판다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The new printer on the third floor is more reliable than the old one.",
      "ko": "3층의 새 프린터는 예전 것보다 더 믿을 만하다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The conference room is reserved for the board meeting every Monday morning.",
      "ko": "그 회의실은 매주 월요일 아침 이사회 회의를 위해 예약되어 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "The gift shop is open from nine in the morning to six in the evening.",
      "ko": "기념품 가게는 아침 9시부터 저녁 6시까지 문을 연다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "The restaurant near our office is famous for its fresh seafood dishes.",
      "ko": "우리 사무실 근처의 그 식당은 신선한 해산물 요리로 유명하다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Mr. Garcia wants to visit the new factory in Texas next week.",
      "ko": "Garcia 씨는 다음 주에 텍사스의 새 공장을 방문하고 싶어 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "The training session gave new employees useful information about the company.",
      "ko": "그 교육 시간은 신입 직원들에게 회사에 관한 유용한 정보를 주었다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
