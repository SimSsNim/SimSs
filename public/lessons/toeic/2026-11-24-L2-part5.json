  "grammar": [
    {
      "title": "관계부사 where",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "where last year's event also took place"
      ],
      "explanation": "장소 명사 뒤에서 '그곳에서 ~하다'라고 설명할 때 where를 쓴다. 뒤 절(last year's event also took place)이 빠진 성분 없이 완전하다는 점이 which와 다르다.",
      "example": {
        "en": "This is the office where I worked for ten years.",
        "ko": "여기가 내가 10년 동안 일한 사무실이다."
      },
      "note": "관계사 뒤가 완전한 절이면 where, 주어·목적어가 빠져 있으면 which.",
      "id": "g1"
    },
    {
      "title": "전치사 + 동명사",
      "tags": [
        "동명사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "for taking"
      ],
      "explanation": "for는 전치사라 뒤에 동사를 쓰려면 -ing(동명사)로 바꾼다. Thank you for -ing = ~해 주셔서 감사합니다.",
      "example": {
        "en": "Thank you for waiting.",
        "ko": "기다려 주셔서 감사합니다."
      },
      "note": "전치사 뒤 동사 자리는 무조건 -ing.",
      "id": "g2"
    },
    {
      "title": "현재완료 + since",
      "tags": [
        "시제"
      ],
      "sentenceId": "s3",
      "highlight": [
        "have increased",
        "since"
      ],
      "explanation": "since(~ 이후로)는 과거의 한 시점부터 지금까지 이어지는 일을 말하므로 현재완료(have + p.p.)와 함께 쓴다.",
      "example": {
        "en": "She has worked here since 2020.",
        "ko": "그녀는 2020년부터 여기서 일해 왔다."
      },
      "note": "since + 과거 시점 → 주절은 현재완료.",
      "id": "g3"
    }
  ],
