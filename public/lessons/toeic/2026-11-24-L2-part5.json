  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "새 회계 소프트웨어는 기존 컴퓨터 시스템 대부분과 호환된다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "지원자는 이전 고용주의 추천서를 제출해야 한다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "광고 캠페인이 시작된 이후 새 스마트워치의 판매가 꾸준히 늘었다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "워크숍 참가자 전원은 수료증을 받게 된다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "회의는 Bayview 센터에서 열리는데, 그곳은 작년 행사도 열린 곳이다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "분기 영업 보고서가 어제 모든 부서장에게 보내졌다."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "시간을 내어 고객 설문을 작성해 주셔서 감사합니다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "폭설 때문에 토론토행 항공편이 세 시간 지연되었다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "직원들은 주간 보고서를 제때 끝내기만 하면 금요일에 재택근무를 할 수 있다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "Ito 씨는 회사에서 5년을 일한 뒤 지역 관리자로 승진했다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The new accounting software is compatible with most of our existing computer systems.",
      "ko": "새 회계 소프트웨어는 기존 컴퓨터 시스템 대부분과 호환된다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Applicants must submit a letter of recommendation from a previous employer.",
      "ko": "지원자는 이전 고용주의 추천서를 제출해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "Sales of the new smartwatch have increased steadily since the advertising campaign began.",
      "ko": "광고 캠페인이 시작된 이후 새 스마트워치의 판매가 꾸준히 늘었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "All participants in the workshop will receive a certificate of completion.",
      "ko": "워크숍 참가자 전원은 수료증을 받게 된다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "The conference will be held at the Bayview Center, where last year's event also took place.",
      "ko": "회의는 Bayview 센터에서 열리는데, 그곳은 작년 행사도 열린 곳이다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "The quarterly sales report was sent to all department heads yesterday.",
      "ko": "분기 영업 보고서가 어제 모든 부서장에게 보내졌다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "Thank you for taking the time to fill out our customer survey.",
      "ko": "시간을 내어 고객 설문을 작성해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Due to the heavy snow, the flight to Toronto was delayed by three hours.",
      "ko": "폭설 때문에 토론토행 항공편이 세 시간 지연되었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Employees may work from home on Fridays provided that they finish their weekly reports on time.",
      "ko": "직원들은 주간 보고서를 제때 끝내기만 하면 금요일에 재택근무를 할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "Ms. Ito was promoted to regional manager after five years with the company.",
      "ko": "Ito 씨는 회사에서 5년을 일한 뒤 지역 관리자로 승진했다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
