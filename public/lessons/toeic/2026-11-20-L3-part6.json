  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "브레이든 인터넷 고객 여러분께 알립니다"
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2",
        "s3",
        "s4",
        "s5"
      ],
      "ko": "3월 3일부터 고객 센터는 여러분을 더 잘 모시기 위해 운영 시간을 늘립니다. 상담원은 월요일부터 토요일까지 오전 7시부터 밤 10시까지 응대합니다. 전화를 원하지 않는 고객은 웹사이트의 실시간 채팅 기능으로도 연락하실 수 있습니다. 이 방법은 근무 시간 중에 도움이 필요한 분들께 특히 인기가 많습니다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s6",
        "s7",
        "s8"
      ],
      "ko": "저희 팀은 이메일 문의에도 이전보다 더 빠르게 답변드릴 것입니다. 밤 10시 이후에 받은 메시지는 다음 날 정오까지 답변드립니다. 또한 자동 전화 시스템은 잔액 확인과 요금 납부를 위해 계속 24시간 이용하실 수 있습니다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s9",
        "s10"
      ],
      "ko": "브레이든 인터넷을 선택해 주셔서 감사합니다. 브레이든 인터넷 고객 관리팀"
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Attention, Brayden Internet Customers",
      "ko": "브레이든 인터넷 고객 여러분께 알립니다",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "Beginning on March 3, our customer service center will extend its hours to serve you better.",
      "ko": "3월 3일부터 고객 센터는 여러분을 더 잘 모시기 위해 운영 시간을 늘립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p2",
      "en": "Representatives will be available from seven in the morning until ten at night, Monday through Saturday.",
      "ko": "상담원은 월요일부터 토요일까지 오전 7시부터 밤 10시까지 응대합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p2",
      "en": "Customers who prefer not to call can also reach us through the live chat feature on our Web site.",
      "ko": "전화를 원하지 않는 고객은 웹사이트의 실시간 채팅 기능으로도 연락하실 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p2",
      "en": "This option is especially popular with people who need help during working hours.",
      "ko": "이 방법은 근무 시간 중에 도움이 필요한 분들께 특히 인기가 많습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p3",
      "en": "Our team will also respond to e-mail inquiries more quickly than before.",
      "ko": "저희 팀은 이메일 문의에도 이전보다 더 빠르게 답변드릴 것입니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p3",
      "en": "Messages received after ten at night will be answered by noon the next day.",
      "ko": "밤 10시 이후에 받은 메시지는 다음 날 정오까지 답변드립니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p3",
      "en": "In addition, our automated phone system will remain available 24 hours a day for checking your balance and making payments.",
      "ko": "또한 자동 전화 시스템은 잔액 확인과 요금 납부를 위해 계속 24시간 이용하실 수 있습니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p4",
      "en": "Thank you for choosing Brayden Internet.",
      "ko": "브레이든 인터넷을 선택해 주셔서 감사합니다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p4",
      "en": "Brayden Internet Customer Care Team",
      "ko": "브레이든 인터넷 고객 관리팀",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
