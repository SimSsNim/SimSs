  "grammar": [
    {
      "id": "g1",
      "title": "주격 관계대명사 who",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Customers who prefer"
      ],
      "explanation": "선행사가 사람(Customers)이고 관계절 안에 주어가 없으므로 주격 관계대명사 who를 쓴다.",
      "example": {
        "en": "Employees who work at night receive extra pay.",
        "ko": "야간에 일하는 직원은 추가 수당을 받는다."
      },
      "note": "사람 선행사 + 빈칸 + 동사 → who. 빈칸 뒤에 명사가 바로 오면 whose."
    },
    {
      "id": "g2",
      "title": "명사 뒤에서 꾸미는 과거분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s7",
      "highlight": [
        "Messages received after ten at night"
      ],
      "explanation": "메시지는 '받아지는' 대상이므로 과거분사 received가 뒤에서 꾸민다. 문장의 동사는 will be answered다.",
      "example": {
        "en": "Orders placed online are shipped within two days.",
        "ko": "온라인으로 한 주문은 이틀 안에 발송된다."
      },
      "note": "명사 뒤 빈칸 다음에 목적어 없이 시간·장소 표현이 오면 과거분사."
    },
    {
      "id": "g3",
      "title": "추가를 나타내는 접속부사",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "In addition"
      ],
      "explanation": "앞 문장(이메일 답변 안내)에 이어 또 다른 서비스(자동 전화 시스템)를 덧붙이므로 '게다가, 또한'을 뜻하는 In addition이 알맞다.",
      "example": {
        "en": "The hotel has a pool. In addition, it offers free parking.",
        "ko": "그 호텔에는 수영장이 있다. 또한 무료 주차도 제공한다."
      },
      "note": "Part 6 접속부사는 앞 문장과의 관계(추가·대조·결과·예시)를 먼저 따진다."
    }
  ],
