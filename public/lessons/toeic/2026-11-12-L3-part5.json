  "grammar": [
    {
      "id": "g1",
      "title": "완료 분사구문 Having p.p.",
      "tags": [
        "분사구문"
      ],
      "sentenceId": "s2",
      "highlight": [
        "Having reviewed"
      ],
      "explanation": "주절의 동작보다 먼저 끝난 일을 분사구문으로 말할 때 Having + p.p.를 쓴다. 주어(the finance director)가 직접 검토했으니 능동이다.",
      "example": {
        "en": "Having finished the report, she went home early.",
        "ko": "보고서를 끝낸 뒤 그녀는 일찍 퇴근했다."
      },
      "note": "빈칸 뒤에 목적어가 있고 콤마 뒤에 주절이 오면 분사구문 자리 → 능동 Having p.p.가 정답 후보."
    },
    {
      "id": "g2",
      "title": "가정법 과거완료",
      "tags": [
        "가정법"
      ],
      "sentenceId": "s5",
      "highlight": [
        "had been completed",
        "would have reopened"
      ],
      "explanation": "과거 사실의 반대를 말할 때 If + 주어 + had p.p., 주어 + would have p.p.를 쓴다. 실제로는 공사가 늦게 끝나서 연휴 전에 못 열었다는 뜻.",
      "example": {
        "en": "If we had left earlier, we would have caught the train.",
        "ko": "더 일찍 출발했더라면 기차를 탔을 텐데."
      },
      "note": "주절에 would have p.p.가 보이면 if절은 had p.p."
    },
    {
      "id": "g3",
      "title": "명사를 뒤에서 꾸미는 과거분사",
      "tags": [
        "분사"
      ],
      "sentenceId": "s8",
      "highlight": [
        "submitted by"
      ],
      "explanation": "보고서는 '제출되는' 대상이므로 과거분사 submitted가 명사 뒤에서 꾸민다. 뒤에 by + 행위자가 오면 과거분사가 강력한 단서.",
      "example": {
        "en": "The products ordered last week have arrived.",
        "ko": "지난주에 주문한 제품들이 도착했다."
      },
      "note": "명사 + ------- + by ~ 구조면 과거분사."
    }
  ],
