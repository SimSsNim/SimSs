  "grammar": [
    {
      "id": "g1",
      "title": "보어 도치 (Attached + be + 주어)",
      "tags": [
        "도치",
        "일치"
      ],
      "sentenceId": "s4",
      "highlight": [
        "Attached are the revised floor plans"
      ],
      "explanation": "Attached, Enclosed, Included 같은 과거분사 보어가 문장 앞에 오면 'be동사 + 주어' 순서로 도치된다. be동사의 수는 뒤에 오는 주어에 맞춘다.",
      "example": {
        "en": "Enclosed is a copy of the contract.",
        "ko": "계약서 사본을 동봉합니다."
      },
      "note": "Attached/Enclosed + 빈칸 + 주어 → 주어가 복수면 are, 단수면 is."
    },
    {
      "id": "g2",
      "title": "가정법 도치 (Should + 주어 + 동사원형)",
      "tags": [
        "가정법",
        "도치"
      ],
      "sentenceId": "s6",
      "highlight": [
        "Should you require"
      ],
      "explanation": "If you should require에서 If를 생략하면 Should가 주어 앞으로 나간다. '혹시 ~하시면'이라는 공손한 표현으로 안내문·이메일 끝에 자주 쓰인다.",
      "example": {
        "en": "Should you have any questions, feel free to call us.",
        "ko": "궁금한 점이 있으시면 편하게 전화 주세요."
      },
      "note": "빈칸 + 주어 + 동사원형 ~, please ... → Should."
    },
    {
      "id": "g3",
      "title": "복합관계형용사 whichever",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s5",
      "highlight": [
        "whichever of the three afternoon workshops best matches"
      ],
      "explanation": "whichever는 '어느 ~이든'이라는 뜻으로, 정해진 몇 개 중에서 고를 때 쓴다. whichever of + 복수 명사 + 동사 형태로 명사절을 이끌며, 이 절이 for의 목적어가 된다.",
      "example": {
        "en": "Take whichever seat you like.",
        "ko": "마음에 드는 자리 아무 데나 앉으세요."
      },
      "note": "정해진 선택지(of the three ~) 중 하나 → whichever. 사람이면 whoever."
    }
  ],
