  "grammar": [
    {
      "id": "g1",
      "title": "계속적 용법의 관계부사 where",
      "tags": [
        "관계사"
      ],
      "sentenceId": "s11",
      "highlight": [
        ", where they learn"
      ],
      "explanation": "장소 명사 뒤 콤마 + where는 '그리고 그곳에서'라는 뜻으로 정보를 덧붙인다. 뒤에는 완전한 절이 온다.",
      "example": {
        "en": "We visited the factory, where the parts are assembled.",
        "ko": "우리는 부품이 조립되는 공장을 방문했다."
      },
      "note": "장소 명사 + , + 빈칸 + 완전한 절 → where."
    },
    {
      "id": "g2",
      "title": "조건 접속사 as long as",
      "tags": [
        "접속사"
      ],
      "sentenceId": "s9",
      "highlight": [
        "as long as you submit"
      ],
      "explanation": "as long as는 '~하기만 하면, ~하는 한'이라는 조건. 조건 부사절이라 미래 내용도 현재형(submit)으로 쓴다.",
      "example": {
        "en": "You may use the car as long as you return it by six.",
        "ko": "6시까지 돌려주기만 하면 차를 써도 된다."
      },
      "note": "조건·시간 부사절은 미래 대신 현재 시제."
    },
    {
      "id": "g3",
      "title": "목적격 관계대명사 생략",
      "tags": [
        "관계사",
        "생략"
      ],
      "sentenceId": "s11",
      "highlight": [
        "the software we use"
      ],
      "explanation": "the software (that/which) we use에서 목적격 관계대명사가 빠졌다. 명사 바로 뒤에 주어+동사가 오면 생략을 의심한다.",
      "example": {
        "en": "The report you requested is on your desk.",
        "ko": "요청하신 보고서는 책상 위에 있습니다."
      },
      "note": "명사 + 주어 + 타동사(목적어 없음) → 관계대명사 생략."
    }
  ],
