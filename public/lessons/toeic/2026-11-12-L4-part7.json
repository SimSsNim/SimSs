  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the main purpose of the announcement?",
      "evidenceSentenceIds": [
        "s2",
        "s3"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To announce a cut in travel budgets"
        },
        {
          "key": "B",
          "text": "To introduce a change in how staff request repayment"
        },
        {
          "key": "C",
          "text": "To recruit new staff for the finance department"
        },
        {
          "key": "D",
          "text": "To explain a new policy on company phones"
        }
      ],
      "answer": "B",
      "explanationKo": "첫 문단에서 종이 경비 보고를 온라인 플랫폼으로 바꾼다고 알린다. reimbursement requests → request repayment로 바꿔 말했다.",
      "choiceNotesKo": {
        "A": "비용 절감은 언급되지만 출장 예산 삭감 이야기가 아니다.",
        "D": "휴대 전화는 플랫폼을 쓰는 수단으로만 나온다."
      },
      "skill": "목적 찾기"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "According to the announcement, what is needed for requests of more than $500?",
      "evidenceSentenceIds": [
        "s7"
      ],
      "choices": [
        {
          "key": "A",
          "text": "A paper receipt mailed to a manager"
        },
        {
          "key": "B",
          "text": "A certificate of training"
        },
        {
          "key": "C",
          "text": "An additional review by the finance department"
        },
        {
          "key": "D",
          "text": "A signature from the company president"
        }
      ],
      "answer": "C",
      "explanationKo": "'Requests that exceed $500 will still require a second approval from the finance department'를 바꿔 말한 것이 정답. exceed → more than, second approval → additional review.",
      "choiceNotesKo": {
        "A": "영수증은 사진으로 올리며 우편 발송은 없다.",
        "B": "교육 참석은 모든 해당 직원의 의무이지 500달러 초과 요청의 조건이 아니다."
      },
      "skill": "세부 정보 + 패러프레이징"
    },
