  "paragraphs": [
    {
      "id": "p1",
      "sentenceIds": [
        "s1"
      ],
      "ko": "파텔 씨가 새 주차 규칙에 대해 짧게 공지했다."
    },
    {
      "id": "p2",
      "sentenceIds": [
        "s2"
      ],
      "ko": "기술자가 오늘 아침 복사기를 매우 능숙하게(효율적으로) 고쳤다."
    },
    {
      "id": "p3",
      "sentenceIds": [
        "s3"
      ],
      "ko": "출장 기간 동안 호텔 직원들이 매우 친절하게 도와주었다."
    },
    {
      "id": "p4",
      "sentenceIds": [
        "s4"
      ],
      "ko": "린드그렌 씨는 지난 목요일 덴버에 있는 고객을 방문했다."
    },
    {
      "id": "p5",
      "sentenceIds": [
        "s5"
      ],
      "ko": "신입 직원은 각자 첫날 노트북을 받는다."
    },
    {
      "id": "p6",
      "sentenceIds": [
        "s6"
      ],
      "ko": "회의실을 나갈 때 불을 꺼 주세요."
    },
    {
      "id": "p7",
      "sentenceIds": [
        "s7"
      ],
      "ko": "본사는 연휴 주말 동안 문을 닫는다."
    },
    {
      "id": "p8",
      "sentenceIds": [
        "s8"
      ],
      "ko": "고객은 언제든지 온라인으로 주문 상황을 조회할 수 있다."
    },
    {
      "id": "p9",
      "sentenceIds": [
        "s9"
      ],
      "ko": "이번 달 매출은 지난달 매출보다 높았다."
    },
    {
      "id": "p10",
      "sentenceIds": [
        "s10"
      ],
      "ko": "그 식당은 주말마다 모든 손님에게 무료 디저트를 제공한다."
    }
  ],
  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "Ms. Patel made a brief announcement about the new parking rules.",
      "ko": "파텔 씨가 새 주차 규칙에 대해 짧게 공지했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The technician repaired the copy machine very efficiently this morning.",
      "ko": "기술자가 오늘 아침 복사기를 매우 능숙하게(효율적으로) 고쳤다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The hotel staff were very helpful during our business trip.",
      "ko": "출장 기간 동안 호텔 직원들이 매우 친절하게 도와주었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Mr. Lindgren visited a client in Denver last Thursday.",
      "ko": "린드그렌 씨는 지난 목요일 덴버에 있는 고객을 방문했다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Each new employee receives a laptop on the first day.",
      "ko": "신입 직원은 각자 첫날 노트북을 받는다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Please turn off the lights when you leave the meeting room.",
      "ko": "회의실을 나갈 때 불을 꺼 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "The main office will be closed during the holiday weekend.",
      "ko": "본사는 연휴 주말 동안 문을 닫는다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Customers can track their orders online at any time.",
      "ko": "고객은 언제든지 온라인으로 주문 상황을 조회할 수 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Sales this month were higher than sales last month.",
      "ko": "이번 달 매출은 지난달 매출보다 높았다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "The restaurant offers a free dessert to every guest on weekends.",
      "ko": "그 식당은 주말마다 모든 손님에게 무료 디저트를 제공한다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
  ],
