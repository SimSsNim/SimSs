  "grammar": [
    {
      "id": "g1",
      "title": "주격 관계대명사 who + 수 일치",
      "tags": [
        "관계사",
        "일치"
      ],
      "sentenceId": "s2",
      "highlight": [
        "associates who start"
      ],
      "explanation": "who는 사람 선행사를 꾸미고 관계절 안에서 주어 역할을 한다. 동사는 선행사(associates, 복수)에 맞춰 start.",
      "example": {
        "en": "We need someone who speaks Spanish.",
        "ko": "스페인어를 하는 사람이 필요하다."
      },
      "note": "관계절 동사의 수는 바로 앞 선행사에 맞춘다."
    },
    {
      "id": "g2",
      "title": "ask + 목적어 + to부정사",
      "tags": [
        "to부정사"
      ],
      "sentenceId": "s15",
      "highlight": [
        "asked the facilities team to replace"
      ],
      "explanation": "ask·tell·want·encourage 뒤에 '목적어 + to V'가 오면 '(목적어)에게 ~하라고/해 달라고'.",
      "example": {
        "en": "My manager asked me to call the client.",
        "ko": "매니저가 나에게 고객에게 전화하라고 했다."
      },
      "note": "목적어 뒤 동사 자리는 to부정사. replace / replacing은 오답."
    },
    {
      "id": "g3",
      "title": "시간 접속사 once (~하자마자, ~하면)",
      "tags": [
        "접속사",
        "부사절",
        "시제"
      ],
      "sentenceId": "s19",
      "highlight": [
        "once it's done"
      ],
      "explanation": "once는 '일단 ~하면'이라는 시간 접속사. 시간 부사절이므로 미래 일이라도 현재 시제(it's done)를 쓴다.",
      "example": {
        "en": "Call me once you arrive.",
        "ko": "도착하면 전화 주세요."
      },
      "note": "once / as soon as / when + 현재 시제, 주절은 will."
    }
  ],
