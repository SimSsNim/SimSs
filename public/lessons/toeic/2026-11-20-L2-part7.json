  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "Why did Ms. Lin start the online chat discussion?",
      "evidenceSentenceIds": [
        "s2",
        "s3"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To introduce new team members"
        },
        {
          "key": "B",
          "text": "To find a space for a training event"
        },
        {
          "key": "C",
          "text": "To ask for help with a sales presentation"
        },
        {
          "key": "D",
          "text": "To report a broken projector"
        }
      ],
      "answer": "B",
      "explanationKo": "신입 사원 오리엔테이션을 계획 중이며 교육실이 비어 있는지 묻는다. orientation → training event, room → space로 바꿔 말했다.",
      "choiceNotesKo": {
        "A": "신입 사원 이야기는 나오지만 소개하려는 것이 아니다.",
        "D": "고장 이야기는 Mr. Romero가 나중에 꺼낸 스피커 문제다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "Why can Ms. Lin NOT use the large training room on January 4?",
      "evidenceSentenceIds": [
        "s5"
      ],
      "choices": [
        {
          "key": "A",
          "text": "It is being repaired."
        },
        {
          "key": "B",
          "text": "It is too small for the group."
        },
        {
          "key": "C",
          "text": "It has already been booked for another event."
        },
        {
          "key": "D",
          "text": "It does not have a projector."
        }
      ],
      "answer": "C",
      "explanationKo": "대형 교육실은 1월 4·5일에 지역 관리자 회의로 예약되어 있다(is reserved for the regional managers' meeting). → already booked for another event.",
      "choiceNotesKo": {
        "B": "작은 것은 3층 방이고, 대형 교육실이 작다는 말은 없다.",
