  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "part7-purpose",
      "prompt": "What is the purpose of the notice?",
      "evidenceSentenceIds": [
        "s2"
      ],
      "choices": [
        {
          "key": "A",
          "text": "To introduce a new dentist"
        },
        {
          "key": "B",
          "text": "To announce a change of address"
        },
        {
          "key": "C",
          "text": "To explain new prices"
        },
        {
          "key": "D",
          "text": "To ask patients to book appointments"
        }
      ],
      "answer": "B",
      "explanationKo": "첫 문장에서 치과가 3월 3일에 새 장소로 옮긴다(move to a new location)고 알린다. 이를 '주소 변경을 알리기 위해'로 바꿔 말한 B가 정답.",
      "choiceNotesKo": {
        "D": "예약을 새로 하라는 말은 없다. 오히려 할 일이 없다고 했다."
      },
      "skill": "글의 목적"
    },
    {
      "id": "q2",
      "number": 2,
      "type": "part7-detail",
      "prompt": "What can patients do while the clinic is closed?",
      "evidenceSentenceIds": [
        "s7"
      ],
      "choices": [
        {
          "key": "A",
          "text": "Visit the new office before March 3"
        },
        {
          "key": "B",
          "text": "Send an e-mail to a new address"
        },
        {
          "key": "C",
          "text": "Receive a call back from a dentist"
        },
        {
          "key": "D",
          "text": "Book an appointment online"
        }
      ],
      "answer": "C",
      "explanationKo": "휴진 기간에 급한 환자가 전화하면 치과의사가 한 시간 안에 다시 전화해 준다(will return the call). 이를 바꿔 말한 C가 정답.",
      "choiceNotesKo": {
        "B": "이메일 주소는 그대로라고 했다(will stay the same).",
        "A": "새 진료실은 3월 3일부터 문을 연다."
      },
      "skill": "세부 사항(패러프레이징)"
    },
    {
      "id": "q3",
      "number": 3,
      "type": "part7-inference",
      "prompt": "What is suggested about patients who have an appointment in early March?",
      "evidenceSentenceIds": [
        "s9",
        "s10"
      ],
      "choices": [
        {
          "key": "A",
          "text": "They should call to confirm it."
        },
        {
          "key": "B",
          "text": "They will need a new phone number."
        },
        {
          "key": "C",
          "text": "They will be seen at the old office."
        },
        {
          "key": "D",
          "text": "They do not have to change their plans."
        }
      ],
      "answer": "D",
      "explanationKo": "3월 초 예약이 있으면 아무것도 할 필요가 없다(do not need to do anything)고 했다. 즉 계획을 바꿀 필요가 없다는 D가 정답.",
      "choiceNotesKo": {
        "A": "따로 전화할 필요가 없다고 했다.",
        "C": "3월 3일부터는 새 진료실에서 진료한다."
      },
      "skill": "추론"
    }
  ]
