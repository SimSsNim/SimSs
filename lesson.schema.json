{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Lesson",
  "description": "필사 학습 레슨 1개. 파일 위치: public/lessons/<track>/<id>.json. 문자열 일치 규칙(문장·청크·matchText·highlight)은 scripts/validate_lessons.py 와 src/lib/validateLesson.ts 가 추가로 검사한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "track", "date", "level", "title", "titleKo", "genre", "wordCount", "source", "audio", "paragraphs", "vocab", "structures", "grammar"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "파일 이름(확장자 제외)과 같아야 한다. 보통 date와 같다." },
    "track": { "enum": ["general", "toeic"], "description": "들어 있는 폴더 이름과 같아야 한다." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Asia/Seoul 기준 학습 날짜" },
    "level": { "type": "integer", "minimum": 1, "maximum": 5 },
    "title": { "type": "string", "minLength": 1 },
    "titleKo": { "type": "string", "minLength": 1 },
    "genre": { "type": "string", "minLength": 1, "description": "예: fable, story, speech, email, notice, advertisement, article, memo, chat" },
    "genreKo": { "type": "string", "description": "장르 한글 이름(선택). 없으면 앱이 genre로 표시 이름을 정한다." },
    "wordCount": { "type": "integer", "minimum": 1, "description": "모든 문단 en을 공백으로 나눈 토큰 수" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license"],
      "properties": {
        "author": { "type": "string" },
        "work": { "type": "string" },
        "translator": { "type": "string" },
        "year": { "type": "integer" },
        "url": { "type": "string" },
        "license": { "enum": ["public-domain", "us-government-work", "original"], "description": "general = public-domain 또는 us-government-work(VOA 등), toeic = original" },
        "note": { "type": "string" }
      }
    },
    "audio": {
      "description": "toeic은 항상 null",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mp3"],
          "properties": {
            "mp3": { "type": "string", "pattern": "^https://" },
            "mp3Low": { "type": ["string", "null"], "pattern": "^https://" },
            "reader": { "type": "string" },
            "durationSec": { "type": ["number", "null"], "minimum": 0 },
            "librivoxUrl": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "en", "ko", "sentences"],
        "properties": {
          "id": { "type": "string", "pattern": "^p\\d+$" },
          "en": { "type": "string", "minLength": 1, "description": "sentences[].en 을 공백 하나로 이은 것과 정확히 같다" },
          "ko": { "type": "string" },
          "sentences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "en", "ko"],
              "properties": {
                "id": { "type": "string", "pattern": "^s\\d+$" },
                "en": { "type": "string", "minLength": 1 },
                "ko": { "type": "string", "minLength": 1 },
                "audioStartSec": { "type": ["number", "null"], "minimum": 0 },
                "audioEndSec": { "type": ["number", "null"], "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "vocab": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "term", "pos", "meaningKo", "sentenceId", "matchText"],
        "properties": {
          "id": { "type": "string", "pattern": "^v\\d+$" },
          "term": { "type": "string", "minLength": 1, "description": "사전형(원형)" },
          "pos": { "type": "string", "description": "품사 약어: n, v, adj, adv, prep, conj, phr ..." },
          "ipa": { "type": "string" },
          "meaningKo": { "type": "string", "minLength": 1 },
          "sentenceId": { "type": "string" },
          "matchText": { "type": "string", "minLength": 1, "description": "해당 문장 en 에 그대로 들어 있는 문자열(본문 속 실제 형태)" },
          "example": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "ko"],
            "properties": { "en": { "type": "string" }, "ko": { "type": "string" } }
          },
          "synonyms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "바꿔 쓸 수 있는 표현(패러프레이징). 주로 토익" }
        }
      }
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sentenceId", "chunks", "skeleton", "explanationKo"],
        "properties": {
          "sentenceId": { "type": "string" },
          "chunks": {
            "type": "array",
            "minItems": 2,
            "description": "text 를 공백 하나로 이으면 문장 en 과 정확히 같다",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "role", "ko"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "role": { "enum": ["S", "V", "O", "C", "M", "CONJ"] },
                "sub": { "type": "boolean", "description": "종속절 성분이면 true (S′, V′ 로 표시)" },
                "ko": { "type": "string" }
              }
            }
          },
          "skeleton": { "type": "string", "minLength": 1, "description": "문장 뼈대. 예: 'A Fox saw a Crow'" },
          "explanationKo": { "type": "string" }
        }
      }
    },
    "grammar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "tags", "sentenceId", "highlight", "explanationKo"],
        "properties": {
          "id": { "type": "string", "pattern": "^g\\d+$" },
          "title": { "type": "string", "minLength": 1 },
          "tags": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "예: 시제, 비교, 도치, 관계사, 분사, to부정사, 수동태" },
          "sentenceId": { "type": "string" },
          "highlight": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "해당 문장 en 에 그대로 들어 있는 문자열" },
          "explanationKo": { "type": "string", "minLength": 1 },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["en", "ko"],
              "properties": { "en": { "type": "string" }, "ko": { "type": "string" } }
            }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
