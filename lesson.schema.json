{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lesson.schema.json",
  "title": "Daily English Lesson (일반 필사 / 토익 Part 5·6·7)",
  "description": "파일 위치: public/lessons/<track>/<id>.json. general id = YYYY-MM-DD-L<level>, toeic id = YYYY-MM-DD-L<level>-part5|part6|part7",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "track", "id", "date", "level", "title", "titleKo", "genre", "source", "audio", "wordCount", "paragraphs", "sentences", "vocab", "structures", "grammar"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "track": { "enum": ["general", "toeic"] },
    "chapter": { "enum": ["part5", "part6", "part7"], "description": "토익만. general에는 넣지 않음" },
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-L[1-4](-part[567]|-[2-9]|-news[2-9]?)?$" },
    "date": { "type": "string", "format": "date", "description": "Asia/Seoul 기준 날짜" },
    "level": { "type": "integer", "minimum": 1, "maximum": 4 },
    "title": { "type": "string", "minLength": 1 },
    "titleKo": { "type": "string", "minLength": 1 },
    "genre": { "enum": ["fable", "fairy-tale", "short-story", "speech", "essay", "news", "email", "letter", "memo", "notice", "announcement", "advertisement", "article", "review", "schedule", "chat", "form", "sentences"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work", "author", "year", "url", "license"],
      "properties": {
        "work": { "type": "string" },
        "author": { "type": "string" },
        "translator": { "type": ["string", "null"] },
        "year": { "type": "integer" },
        "edition": { "type": "string" },
        "url": { "type": ["string", "null"], "format": "uri", "description": "original이면 null" },
        "license": { "enum": ["public-domain", "us-government-work", "original"], "description": "original = 직접 쓴 글(토익 트랙)" },
        "excerptNote": { "type": ["string", "null"] }
      }
    },
    "audio": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mp3", "pageUrl", "reader", "durationSec"],
          "properties": {
            "mp3": { "type": "string", "format": "uri" },
            "mp3Low": { "type": ["string", "null"], "format": "uri" },
            "pageUrl": { "type": "string", "format": "uri" },
            "reader": { "type": "string" },
            "durationSec": { "type": "number", "minimum": 0 },
            "startSec": { "type": ["number", "null"], "minimum": 0 },
            "endSec": { "type": ["number", "null"], "minimum": 0 },
            "note": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "wordCount": { "type": "integer", "minimum": 1 },
    "paragraphs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sentenceIds", "ko"],
        "properties": {
          "id": { "type": "string", "pattern": "^p\\d+$" },
          "sentenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "ko": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sentences": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "paragraphId", "en", "ko"],
        "properties": {
          "id": { "type": "string", "pattern": "^s\\d+$" },
          "paragraphId": { "type": "string" },
          "en": { "type": "string", "minLength": 1, "description": "토익 Part 5·6은 정답이 들어간 완성 문장" },
          "ko": { "type": "string", "minLength": 1 },
          "audioStartSec": { "type": ["number", "null"] },
          "audioEndSec": { "type": ["number", "null"] }
        }
      }
    },
    "vocab": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "term", "pos", "meaningKo", "matchText", "sentenceId", "example"],
        "properties": {
          "id": { "type": "string", "pattern": "^v\\d+$" },
          "term": { "type": "string" },
          "pos": { "enum": ["noun", "verb", "adjective", "adverb", "preposition", "conjunction", "phrase", "idiom", "phrasal-verb"] },
          "meaningKo": { "type": "string" },
          "ipa": { "type": ["string", "null"] },
          "synonyms": { "type": "array", "items": { "type": "string" } },
          "matchText": { "type": "string" },
          "sentenceId": { "type": "string" },
          "example": {
            "type": "object", "additionalProperties": false, "required": ["en", "ko"],
            "properties": { "en": { "type": "string" }, "ko": { "type": "string" } }
          }
        }
      }
    },
    "structures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sentenceId", "chunks", "skeleton", "explanation"],
        "properties": {
          "id": { "type": "string", "pattern": "^st\\d+$" },
          "sentenceId": { "type": "string" },
          "chunks": {
            "type": "array", "minItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["text", "role", "ko"],
              "properties": {
                "text": { "type": "string" },
                "role": { "enum": ["S", "V", "O", "IO", "C", "OC", "M", "CONJ"] },
                "sub": { "type": "boolean" },
                "ko": { "type": "string" }
              }
            }
          },
          "skeleton": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "grammar": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "tags", "sentenceId", "highlight", "explanation", "example"],
        "properties": {
          "id": { "type": "string", "pattern": "^g\\d+$" },
          "title": { "type": "string" },
          "tags": { "type": "array", "minItems": 1, "items": { "enum": ["시제", "조동사", "수동태", "to부정사", "동명사", "분사", "분사구문", "관계사", "접속사", "가정법", "비교", "도치", "강조", "생략", "일치", "명사절", "부사절", "전치사", "어순", "품사", "대명사", "어휘", "기타"] } },
          "sentenceId": { "type": "string" },
          "highlight": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "explanation": { "type": "string" },
          "example": {
            "type": "object", "additionalProperties": false, "required": ["en", "ko"],
            "properties": { "en": { "type": "string" }, "ko": { "type": "string" } }
          },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "questions": {
      "description": "토익만. part5 = 10문제, part6 = 5문제, part7 = 3문제",
      "type": "array", "minItems": 3, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "number", "type", "prompt", "choices", "answer", "explanationKo"],
        "properties": {
          "id": { "type": "string", "pattern": "^q\\d+$" },
          "number": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["part5-word-form", "part5-grammar", "part5-vocabulary", "part5-connector", "part6-word", "part6-sentence", "part7-purpose", "part7-detail", "part7-inference", "part7-not-true", "part7-synonym"] },
          "prompt": { "type": ["string", "null"], "description": "Part 7 질문 문장. Part 5·6은 null(앱이 blank로 빈칸 문장을 만든다)" },
          "blank": {
            "type": "object", "additionalProperties": false, "required": ["sentenceId", "answerText"],
            "description": "Part 5·6만. answerText를 그 문장에서 '-------'로 바꿔 보여 준다",
            "properties": { "sentenceId": { "type": "string" }, "answerText": { "type": "string" } }
          },
          "evidenceSentenceIds": { "type": "array", "items": { "type": "string" }, "description": "Part 7 정답 근거 문장" },
          "choices": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["key", "text"],
              "properties": { "key": { "enum": ["A", "B", "C", "D"] }, "text": { "type": "string", "minLength": 1 } }
            }
          },
          "answer": { "enum": ["A", "B", "C", "D"] },
          "explanationKo": { "type": "string", "minLength": 1 },
          "choiceNotesKo": {
            "type": "object", "additionalProperties": false, "description": "보기별로 왜 맞고 틀리는지",
            "properties": { "A": { "type": "string" }, "B": { "type": "string" }, "C": { "type": "string" }, "D": { "type": "string" } }
          },
          "skill": { "type": "string", "description": "예: 형용사 자리, 수동태, 전치사 vs 접속사" }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "track": { "const": "toeic" } } }, "then": { "required": ["chapter", "questions"] } },
    { "if": { "properties": { "track": { "const": "general" } } }, "then": { "not": { "anyOf": [ { "required": ["chapter"] }, { "required": ["questions"] } ] } } }
  ]
}
