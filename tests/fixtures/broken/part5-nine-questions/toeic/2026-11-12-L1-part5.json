  "sentences": [
    {
      "id": "s1",
      "paragraphId": "p1",
      "en": "The new coffee machine in the break room is very easy to use.",
      "ko": "휴게실에 새로 들어온 커피 머신은 사용하기 아주 쉽다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s2",
      "paragraphId": "p2",
      "en": "The quarterly sales report was sent to all managers yesterday.",
      "ko": "분기별 매출 보고서가 어제 모든 관리자에게 발송되었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s3",
      "paragraphId": "p3",
      "en": "The outdoor event was canceled because of the heavy rain.",
      "ko": "폭우 때문에 야외 행사가 취소되었다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s4",
      "paragraphId": "p4",
      "en": "Please submit your expense report to the accounting department by Friday.",
      "ko": "금요일까지 경비 보고서를 회계 부서에 제출해 주세요.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s5",
      "paragraphId": "p5",
      "en": "Mr. Kim is responsible for training new employees.",
      "ko": "김 씨는 신입 사원 교육을 맡고 있다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s6",
      "paragraphId": "p6",
      "en": "Our customer service team answers calls quickly and politely.",
      "ko": "우리 고객 서비스 팀은 전화를 빠르고 정중하게 받는다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s7",
      "paragraphId": "p7",
      "en": "The hotel offers free breakfast to all guests who stay more than two nights.",
      "ko": "그 호텔은 이틀 넘게 묵는 모든 투숙객에게 무료 조식을 제공한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s8",
      "paragraphId": "p8",
      "en": "Ms. Rivera has worked at the company since 2019.",
      "ko": "리베라 씨는 2019년부터 그 회사에서 일해 왔다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s9",
      "paragraphId": "p9",
      "en": "Visitors must sign in at the front desk before entering the building.",
      "ko": "방문객은 건물에 들어가기 전에 안내 데스크에서 방문 기록을 해야 한다.",
      "audioStartSec": null,
      "audioEndSec": null
    },
    {
      "id": "s10",
      "paragraphId": "p10",
      "en": "The marketing team will hold a meeting to discuss the new advertising plan.",
      "ko": "마케팅 팀은 새 광고 계획을 논의하기 위해 회의를 열 것이다.",
      "audioStartSec": null,
      "audioEndSec": null
    }
